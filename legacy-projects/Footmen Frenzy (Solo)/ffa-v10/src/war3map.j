    if ( not ( udg_mh_status == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_init_Actions takes nothing returns nothing
    call SetGameSpeed(MAP_SPEED_NORMAL)
    set udg_Host=Player(0)
    set udg_eight_player_mode=false
    set udg_mode_selector[2]=gg_unit_h01G_0081
    set udg_AI_on=false
    // Set Variables
    set udg_t_voting=7.00
    set udg_all_players=GetPlayersAll()
    set udg_ap_number_of_heros=3
    set udg_spawnprotection=true
    set udg_maxunitnumber=50
    set udg_version=5
    set udg_mh_status=false
    set udg_MH_security_lv=1
    set udg_colossal_on=true
    set udg_colossal_max_wave=10
    set udg_mode_pub=true
    set udg_mode_no_pool=false
    set udg_hp_buff=1.00
    call IssueImmediateOrderBJ(gg_unit_nfro_0137, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_necr_0140, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_nech_0143, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_nrac_0146, "holdposition")
    set udg_X=1
    loop
        exitwhen udg_X > 12
        set udg_player_start[udg_X]=GetPlayerStartLocationLoc(ConvertedPlayer(udg_X))
        set udg_X=udg_X + 1
    endloop
    // Fake Shops
    set udg_X=19
    loop
        exitwhen udg_X > 23
        call GroupAddUnitSimple(udg_fake_shop[udg_X], udg_fakeshops)
        set udg_X=udg_X + 1
    endloop
    set udg_X=19
    loop
        exitwhen udg_X > 23
        call GroupAddUnitSimple(udg_real_shop[udg_X], udg_realshops)
        set udg_X=udg_X + 1
    endloop
    // Move all heros
    set udg_temp_unitgroup=GetUnitsInRectOfPlayer(gg_rct_HERO_START, Player(PLAYER_NEUTRAL_PASSIVE))
    set udg_temp_unitgroup2=GetUnitsInRectOfPlayer(gg_rct_HERO_START_NEW, Player(PLAYER_NEUTRAL_PASSIVE))
    set udg_temp_unitgroup3=GetUnitsInRectOfPlayer(gg_rct_HERO_START_OLD, Player(PLAYER_NEUTRAL_PASSIVE))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_init_Func032A)
    call ForGroupBJ(udg_temp_unitgroup2, function Trig_init_Func033A)
    call ForGroupBJ(udg_temp_unitgroup3, function Trig_init_Func034A)
    set udg_loc_tavern=GetRectCenter(gg_rct_TAVERN_AREA)
    // Check if Player in game
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_init_Func037Func001C() ) then
            call SetPlayerMaxHeroesAllowed(2, ConvertedPlayer(udg_X))
            call SetPlayerStateBJ(ConvertedPlayer(udg_X), PLAYER_STATE_RESOURCE_FOOD_CAP, 5)
            call SetPlayerFlagBJ(PLAYER_STATE_GIVES_BOUNTY, true, ConvertedPlayer(udg_X))
            call ForceAddPlayerSimple(ConvertedPlayer(udg_X), udg_Active_PlayGroup)
            set udg_orig_player_name[udg_X]=GetPlayerName(ConvertedPlayer(udg_X))
            set udg_number_of_spawned_units[udg_X]=2
            set udg_unit_production[udg_X]=true
            set udg_guided[udg_X]=false
            set udg_autosend[udg_X]=true
            set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_X))
            set udg_player_active[udg_X]=true
            call CreateNUnitsAtLoc(1, 'hbar', ConvertedPlayer(udg_X), udg_temp_point, bj_UNIT_FACING)
            set udg_base[udg_X]=GetLastCreatedUnit()
            call CreateNUnitsAtLoc(1, 'h01S', ConvertedPlayer(udg_X), udg_temp_point, bj_UNIT_FACING)
            call UnitAddAbilityBJ('Avul', udg_base[udg_X])
            call RemoveLocation(udg_temp_point)
            if ( Trig_init_Func037Func001Func019C() ) then
                set udg_AI_player[udg_X]=true
            else
                set udg_AI_player[udg_X]=false
            endif
        else
            call ForGroupBJ(GetUnitsOfPlayerAll(ConvertedPlayer(udg_X)), function Trig_init_Func037Func001Func020002)
            call RemoveUnit(udg_fake_shop[udg_X])
        endif
        set udg_X=udg_X + 1
    endloop
    // Set Points
    set udg_tavern[1]=GetRectCenter(gg_rct_TAVERN1)
    set udg_tavern[2]=GetRectCenter(gg_rct_TAVERN2)
    set udg_tavern[3]=GetRectCenter(gg_rct_TAVERN3)
    set udg_tavern[4]=GetRectCenter(gg_rct_TAVERN4)
    set udg_tavern[5]=GetRectCenter(gg_rct_TAVERN5)
    set udg_tavern[6]=GetRectCenter(gg_rct_TAVERN6)
    set udg_tavern[7]=GetRectCenter(gg_rct_TAVERN7)
    set udg_tavern[8]=GetRectCenter(gg_rct_TAVERN8)
    set udg_tavern[9]=GetRectCenter(gg_rct_TAVERN9)
    set udg_SDtavern[1]=GetRectCenter(gg_rct_SD_TAVERN1)
    set udg_SDtavern[2]=GetRectCenter(gg_rct_SD_TAVERN2)
    set udg_SDtavern[3]=GetRectCenter(gg_rct_SD_TAVERN3)
    set udg_SDtavern[4]=GetRectCenter(gg_rct_SD_TAVERN4)
    set udg_centermap=GetRectCenter(gg_rct_MAP_CENTER)
    set udg_X=1
    loop
        exitwhen udg_X > 3
        if ( Trig_init_Func053Func001C() ) then
            set udg_safe_point[udg_X]=GetRectCenter(gg_rct_T1_SHOP_KILL_1)
        else
        endif
        set udg_X=udg_X + 1
    endloop
    set udg_X=4
    loop
        exitwhen udg_X > 6
        if ( Trig_init_Func054Func001C() ) then
            set udg_safe_point[udg_X]=GetRectCenter(gg_rct_T2_SHOP_KILL_1)
        else
        endif
        set udg_X=udg_X + 1
    endloop
    set udg_X=7
    loop
        exitwhen udg_X > 9
        if ( Trig_init_Func055Func001C() ) then
            set udg_safe_point[udg_X]=GetRectCenter(gg_rct_T3_SHOP_KILL_1)
        else
        endif
        set udg_X=udg_X + 1
    endloop
    set udg_X=10
    loop
        exitwhen udg_X > 12
        if ( Trig_init_Func056Func001C() ) then
            set udg_safe_point[udg_X]=GetRectCenter(gg_rct_T4_SHOP_KILL_1)
        else
        endif
        set udg_X=udg_X + 1
    endloop
    // Set Allies
    // Set Standard
    call ForForce(udg_all_players, function Trig_init_Func059A)
    // Set Teams
    call ForceAddPlayerSimple(Player(0), udg_team[1])
    set udg_teamnumber[1]=1
    call ForceAddPlayerSimple(Player(4), udg_team[2])
    set udg_teamnumber[5]=2
    call ForceAddPlayerSimple(Player(7), udg_team[3])
    set udg_teamnumber[8]=3
    call ForceAddPlayerSimple(Player(11), udg_team[4])
    set udg_teamnumber[12]=4
    // OBSERVERS:
    set udg_X=13
    loop
        exitwhen udg_X > 24
        call ForceAddPlayerSimple(ConvertedPlayer(udg_X), udg_team[5])
        set udg_X=udg_X + 1
    endloop
    // save orig player name
    set udg_X=1
    loop
        exitwhen udg_X > 12
        set udg_X=udg_X + 1
    endloop
    // frostbolt = lv1
    set udg_X=1
    loop
        exitwhen udg_X > 4
        set udg_frostbolt_upgrade_level[udg_X]=1
        set udg_X=udg_X + 1
    endloop
    // camera to tavern
    call ForForce(udg_all_players, function Trig_init_Func076A)
    // select unit
    set udg_mode_selector[1]=gg_unit_h03Y_0147
    set udg_X=3
    loop
        exitwhen udg_X > 12
        call ForGroupBJ(GetUnitsOfPlayerAndTypeId(ConvertedPlayer(udg_X), 'h01G'), function Trig_init_Func079Func001A)
        set udg_X=udg_X + 1
    endloop
    // visibility
    call ForForce(udg_all_players, function Trig_init_Func081A)
    call ForForce(udg_team[1], function Trig_init_Func082A)
    call ForForce(udg_team[2], function Trig_init_Func083A)
    call ForForce(udg_team[3], function Trig_init_Func084A)
    call ForForce(udg_team[4], function Trig_init_Func085A)
    // MH protect
    if ( Trig_init_Func087C() ) then
        // Fake Shops
        set udg_fake_shop[24]=gg_unit_nhef_0114
        // Real Shops
        set udg_real_shop[19]=gg_unit_n000_0054
        set udg_real_shop[20]=gg_unit_n01B_0055
        set udg_real_shop[21]=gg_unit_n01B_0056
        set udg_real_shop[22]=gg_unit_n004_0057
        set udg_real_shop[23]=gg_unit_n004_0058
        call EnableTrigger(gg_trg_MH_hide_fake_shop_rat)
        call EnableTrigger(gg_trg_MH_hide_fake_shop_truesight)
        call EnableTrigger(gg_trg_MH_shop_click)
        call EnableTrigger(gg_trg_MH_shop_redirect)
        call EnableTrigger(gg_trg_MH_truesight_add_units)
        call EnableTrigger(gg_trg_MH_truesight_remove_units)
        call EnableTrigger(gg_trg_MH_uhide_fake_shop_truesight)
        call EnableTrigger(gg_trg_MH_unhide_fake_shop_rat)
        call EnableTrigger(gg_trg_turn_off_mh)
        call EnableTrigger(gg_trg_turn_on_mh)
        set udg_block_point[1]=GetRectCenter(gg_rct_OUTSIDEBLOCK1)
        set udg_block_point[2]=GetRectCenter(gg_rct_OUTSIDEBLOCK2)
        set udg_block_point[3]=GetRectCenter(gg_rct_OUTSIDEBLOCK3)
        set udg_block_point[4]=GetRectCenter(gg_rct_OUTSIDEBLOCK4)
        set udg_block_point[5]=GetRectCenter(gg_rct_OUTSIDEBLOCK5)
        set udg_block_point[6]=GetRectCenter(gg_rct_OUTSIDEBLOCK6)
        set udg_block_point[7]=GetRectCenter(gg_rct_OUTSIDEBLOCK7)
        set udg_block_point[8]=GetRectCenter(gg_rct_OUTSIDEBLOCK8)
        set udg_block_point[9]=GetRectCenter(gg_rct_B1)
        set udg_block_point[10]=GetRectCenter(gg_rct_B2)
        set udg_block_point[11]=GetRectCenter(gg_rct_B3)
        set udg_block_point[12]=GetRectCenter(gg_rct_B4)
        set udg_block_point[13]=GetRectCenter(gg_rct_B5)
        set udg_block_point[14]=GetRectCenter(gg_rct_B6)
        set udg_block_point[15]=GetRectCenter(gg_rct_B7)
        set udg_block_point[16]=GetRectCenter(gg_rct_B8)
        set udg_block_point[17]=udg_centermap
    else
        call DoNothing()
    endif
    // set colours
    set udg_colour[1]="|cffff0303"
    set udg_colour[2]="|cff0042ff"
    set udg_colour[3]="|cff1be7ba"
    set udg_colour[4]="|cff550081"
    set udg_colour[5]="|cfffefc00"
    set udg_colour[6]="|cfffe890d"
    set udg_colour[7]="|cff21bf00"
    set udg_colour[8]="|cffe45caf"
    set udg_colour[9]="|cff939596"
    set udg_colour[10]="|cff7ebff1"
    set udg_colour[11]="|cff106247"
    set udg_colour[12]="|cff4f2b05"
    // destroy
    call DestroyGroup(udg_temp_unitgroup)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyGroup(udg_temp_unitgroup2)
    call DestroyGroup(udg_temp_unitgroup3)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

