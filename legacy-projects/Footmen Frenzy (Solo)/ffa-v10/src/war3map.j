function Trig_HERO_Reptile_Decapitate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Reptile_Decapitate_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_target=GetSpellTargetUnit()
    // actions
    set udg_temp_real=( GetUnitStateSwap(UNIT_STATE_LIFE, udg_temp_target) * ( 0.50 * I2R(udg_abilitylevel) ) )
    call SetUnitLifeBJ(udg_temp_unit, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_temp_unit) + udg_temp_real ))
    set udg_temp_real=( GetUnitStateSwap(UNIT_STATE_MANA, udg_temp_target) * ( 0.10 * I2R(udg_abilitylevel) ) )
    call SetUnitManaBJ(udg_temp_unit, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_temp_unit) + udg_temp_real ))
    call KillUnit(udg_temp_target)
endfunction

function InitTrig_HERO_Reptile_Decapitate takes nothing returns nothing
