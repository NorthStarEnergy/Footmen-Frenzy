function Trig_HERO_Elemental_Hellfire_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Elemental_Hellfire_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))
    set udg_casting_hero[udg_temp_playernumber]=GetTriggerUnit()
    set udg_temp_player=ConvertedPlayer(udg_temp_playernumber)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_casting_hero[udg_temp_playernumber])
    set udg_temp_point_caster=GetUnitLoc(udg_casting_hero[udg_temp_playernumber])
    set udg_temp_real=( 200.00 + ( 25.00 * I2R(udg_abilitylevel) ) )
    set udg_temp_X[2]=1
    loop
        exitwhen udg_temp_X[2] > 6
        set udg_hellfire_point[udg_temp_X[2]]=PolarProjectionBJ(udg_temp_point_caster, udg_temp_real, ( 60.00 * I2R(udg_temp_X[2]) ))
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_hellfire_point[udg_temp_X[2]], bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0CD', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0CD', udg_dummy, udg_abilitylevel)
        call IssuePointOrderLocBJ(udg_dummy, "flamestrike", udg_hellfire_point[udg_temp_X[2]])
        call UnitApplyTimedLifeBJ(4.00, 'BTLF', udg_dummy)
        call RemoveLocation(udg_hellfire_point[udg_temp_X[2]])
        set udg_temp_X[2]=udg_temp_X[2] + 1
    endloop
    call RemoveLocation(udg_temp_point_caster)
    call RemoveLocation(udg_temp_point)
endfunction

