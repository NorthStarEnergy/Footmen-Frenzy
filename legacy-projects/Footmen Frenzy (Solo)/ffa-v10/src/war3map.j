    return true
endfunction

function Trig_suicide_after_10_seconds_Actions takes nothing returns nothing
    // Local variables are safe to use after Waits:
    local integer i= udg_temp_playernumber
    //                                                                                                     
    call PolledWait(GetRandomReal(7.00, 20.00))
    //                                                                                                     
    set udg_temp_playernumber=i
    //                                                                                                     
    if ( Trig_suicide_after_10_seconds_Func008C() ) then
        set udg_unitgroup_kill=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_temp_playernumber), Condition(function Trig_suicide_after_10_seconds_Func008Func001002002))
        call ForGroupBJ(udg_unitgroup_kill, function Trig_suicide_after_10_seconds_Func008Func002002)
        call DestroyGroup(udg_unitgroup_kill)
    else
    endif
endfunction

