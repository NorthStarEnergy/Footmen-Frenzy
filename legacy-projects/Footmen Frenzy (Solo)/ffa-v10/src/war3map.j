    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", udg_temp_point)
    call RemoveLocation(udg_temp_point)
endfunction

function Trig_BASE_FullSend_Func003Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_temp_unitgroup_array[udg_X]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_FullSend_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_X=0
    loop
        exitwhen udg_X > 25
        set udg_temp_unitgroup_array[udg_X]=GetUnitsOfPlayerAndTypeId(ConvertedPlayer(udg_temp_playernumber), udg_spawn_unit[udg_X])
        if ( Trig_BASE_FullSend_Func003Func002C() ) then
            call ForGroupBJ(udg_temp_unitgroup_array[udg_X], function Trig_BASE_FullSend_Func003Func002Func003A)
            call DestroyGroup(udg_temp_unitgroup_array[udg_X])
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_BASE_FullSend takes nothing returns nothing
    set gg_trg_BASE_FullSend=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BASE_FullSend, EVENT_PLAYER_UNIT_SPELL_EFFECT)
