function SKMergeScore takes integer oldKing, integer newKing returns nothing
    set udg_KOTH_Team_Gold_Earned_Total[S8Team(newKing)]=udg_KOTH_Team_Gold_Earned_Total[S8Team(newKing)]+udg_KOTH_Team_Gold_Earned_Total[S8Team(oldKing)]
    set udg_KOTH_Team_Gold_Earned_Total[S8Team(oldKing)]=0
    set SKTroopKills[newKing]=SKTroopKills[newKing]+SKTroopKills[oldKing]
    set SKHeroKills[newKing]=SKHeroKills[newKing]+SKHeroKills[oldKing]
    set SKCaptures[newKing]=SKCaptures[newKing]+SKCaptures[oldKing]
    set SKTroopKills[oldKing]=0
    set SKHeroKills[oldKing]=0
    set SKCaptures[oldKing]=0
endfunction

function SKNormalize takes nothing returns nothing
    local integer i=1
    local integer j
    local integer pn
    local integer oldKing
    local integer successor
    local boolean changed=false
    loop
        exitwhen i > 8
        set pn=S8Player(i)
        if SKActive(pn) and not SKActive(SKKing[pn]) then
            set oldKing=SKKing[pn]
            set successor=pn
            set j=1
            loop
                exitwhen j > 8
                if SKActive(S8Player(j)) and SKKing[S8Player(j)] == oldKing then
                    set SKKing[S8Player(j)]=successor
                endif
                set j=j+1
            endloop
            call SKMergeScore(oldKing, successor)
            set changed=true
            call DisplayTextToForce(udg_all_players, "King Mode: " + GetPlayerName(Player(successor-1)) + " succeeds the departed king.")
        endif
        set i=i+1
    endloop
    if changed then
        call SKSync()
    endif
endfunction

function SKUnifiedKing takes nothing returns integer
    local integer i=1
    local integer king=0
    local integer pn
    loop
        exitwhen i > 8
        set pn=S8Player(i)
        if SKActive(pn) then
            if king == 0 then
                set king=SKKing[pn]
            elseif king != SKKing[pn] then
                return 0
            endif
        endif
        set i=i+1
    endloop
    return king
endfunction

function SKCheckVictory takes nothing returns nothing
    local integer king
    local integer i=1
    local integer pn
    if not SKReady or SoloFoots_EndGameStarted or SKInitialPlayers < 2 then
        return
    endif
    call SKNormalize()
    set king=SKUnifiedKing()
    if king == 0 then
        if SKPendingKing != 0 then
            call DisplayTextToForce(udg_all_players, "King Mode: the takeover has been broken. The battle continues!")
        endif
        set SKPendingKing=0
        set SKWinAt=0
    elseif SKPendingKing != king then
        set SKPendingKing=king
        set SKWinAt=SKClock+20
        call DisplayTextToForce(udg_all_players, "King Mode: " + GetPlayerName(Player(king-1)) + " controls every active player. Victory in 20 seconds unless someone uses -defect!")
    elseif SKClock >= SKWinAt then
        set SKWinner=king
        set SoloFoots_EndGameStarted=true
        call DisplayTextToForce(udg_all_players, "King Mode: " + GetPlayerName(Player(king-1)) + " has conquered the map! Their kingdom wins!")
        loop
            exitwhen i > 8
            set pn=S8Player(i)
            if SKActive(pn) and SKKing[pn] == king then
                call CustomVictoryBJ(Player(pn-1), true, true)
            endif
            set i=i+1
        endloop
    endif
endfunction

function Trig_KICK_execute_Actions takes nothing returns nothing
    if ( Trig_KICK_execute_Func002C() ) then
        set udg_New_Kick_Is_Active=false
        call DialogDisplayBJ(false, udg_New_Kick_Dialog, udg_New_Kick_Decider)
        set udg_temp_playergroup=GetForceOfPlayer(udg_New_Kick_Decider)
        call SoloFootsDisplayMessageToForce(udg_temp_playergroup , "TRIGSTR_5168")
        call DestroyForce(udg_temp_playergroup)
        return
    endif
    if ( Trig_KICK_execute_Func005C() ) then
        if ( Trig_KICK_execute_Func005Func001C() ) then
            set udg_New_Kick_Current_Page=( udg_New_Kick_Current_Page + 1 )
        else
            set udg_New_Kick_Current_Page=1
        endif
        call TriggerExecute(gg_trg_KICK_rebuild_dialog)
        return
    endif
    if ( Trig_KICK_execute_Func008C() ) then
        if ( Trig_KICK_execute_Func008Func001C() ) then
            set udg_New_Kick_Current_Page=( udg_New_Kick_Current_Page - 1 )
        else
            set udg_New_Kick_Current_Page=udg_New_Kick_Total_Pages
        endif
        call TriggerExecute(gg_trg_KICK_rebuild_dialog)
        return
    endif
    set udg_X=1
    loop
        exitwhen udg_X > 24
        if ( Trig_KICK_execute_Func011Func001C() ) then
            set udg_New_Kick_Is_Active=false
            call DialogDisplayBJ(false, udg_New_Kick_Dialog, udg_New_Kick_Decider)
            call SoloFootsDisplayMessageToForce(GetPlayersAll() , ( GetPlayerName(udg_New_Kick_Decider) + " has removed " + GetPlayerName(ConvertedPlayer(udg_X)) + " from the game." ))
            call CustomDefeatBJ(ConvertedPlayer(udg_X), "TRIGSTR_16610")
            if ( Trig_KICK_execute_Func011Func001Func009C() and udg_player_active[udg_X] ) then
                if udg_mode_koth and udg_KOTH_Player==Player(udg_X-1) then
                    call TriggerExecute(gg_trg_KOTH_Set_Neutral_Hill)
                    call TriggerExecute(gg_trg_KOTH_Reset_Hill)
                endif
                set SoloFoots_LastEliminatedPlayerNumber=udg_X
                set SoloFoots_FinalStrikePlayer=null
                set SoloFoots_FinalEliminationWasLeave=true
                set udg_player_active[udg_X]=false
                if SKEnabled then
                    set SKRespawnIn[udg_X]=0
                    call SKNormalize()
                    call SKSync()
                    call SKCheckVictory()
                endif
                call ForceRemovePlayerSimple(ConvertedPlayer(udg_X), udg_Active_PlayGroup)
                set SafeRemoval_GraceTicks=0
                call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
                call EnableTrigger(gg_trg_Visibility)
                call ConditionalTriggerExecute(gg_trg_Visibility)
                call ConditionalTriggerExecute(gg_trg_END)
                call EnableTrigger(gg_trg_check_if_team_active)
            endif
            return
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

