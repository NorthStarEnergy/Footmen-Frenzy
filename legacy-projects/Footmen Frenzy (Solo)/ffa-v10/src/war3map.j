function Trig_HERO_Hook_Throw_Copy_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0L3' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Throw_Copy_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_hook_degree_Copy[udg_temp_playernumber]=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    call CreateNUnitsAtLoc(1, 'h04D', udg_temp_player, udg_temp_point_caster, udg_hook_degree_Copy[udg_X])
    set udg_dummy_hook_Copy[udg_temp_playernumber]=GetLastCreatedUnit()
    set udg_hook_level_Copy[GetUnitUserData(GetLastCreatedUnit())]=udg_abilitylevel
    set udg_hook_start_location_Copy[udg_temp_playernumber]=udg_temp_point_caster
    set udg_hook_location_Copy[udg_temp_playernumber]=udg_temp_point_caster
    set udg_hook_send_active_Copy[udg_temp_playernumber]=true
    set udg_hook_return_active_Copy[udg_temp_playernumber]=false
    set udg_hook_target_aquired_Copy[udg_temp_playernumber]=false
    set udg_hook_first_Copy[udg_temp_playernumber]=true
    set udg_hook_range_Copy[udg_abilitylevel]=BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_temp_unit, 'A0L3'), ABILITY_RLF_CAST_RANGE, ( udg_abilitylevel - 1 ))
    call EnableTrigger(gg_trg_HERO_Hook_Loop_Copy)
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

function InitTrig_HERO_Hook_Throw_Copy takes nothing returns nothing
    set gg_trg_HERO_Hook_Throw_Copy=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Hook_Throw_Copy, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Hook_Throw_Copy, Condition(function Trig_HERO_Hook_Throw_Copy_Conditions))
    call TriggerAddAction(gg_trg_HERO_Hook_Throw_Copy, function Trig_HERO_Hook_Throw_Copy_Actions)
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func002C takes nothing returns boolean
    if ( not ( udg_hook_first_Copy[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func003002003001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), ConvertedPlayer(udg_X)) == true )
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func003002003002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func003002003 takes nothing returns boolean
    return GetBooleanAnd(Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func003002003001(), Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func003002003002())
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func004Func001Func001C takes nothing returns boolean
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_ANCIENT) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_SLEEPING) == true ) ) then
        return true
    endif
    if ( ( BlzIsUnitInvulnerable(GetEnumUnit()) == true ) ) then
        return true
    endif
    if ( ( IsUnitInvisible(GetEnumUnit(), ConvertedPlayer(udg_X)) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return true
    endif
    if ( ( GetUnitDefaultMoveSpeed(GetEnumUnit()) < 1.00 ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func004Func001C takes nothing returns boolean
    if ( not Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func004Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func004A takes nothing returns nothing
    if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func004Func001C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_hook_target_group_Copy[udg_X])
    else
        call DoNothing()
    endif
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func005Func005A takes nothing returns nothing
    set udg_hook_target_Copy[udg_X]=GetEnumUnit()
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_hook_target_group_Copy[udg_X]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_hook_start_location_Copy[udg_X], udg_hook_location_Copy[udg_X]) >= udg_hook_range_Copy[udg_abilitylevel] ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003C takes nothing returns boolean
    if ( not ( udg_hook_send_active_Copy[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func004Func007Func001C takes nothing returns boolean
    if ( ( DistanceBetweenPoints(udg_hook_start_location_Copy[udg_X], udg_hook_location_Copy[udg_X]) <= 100.00 ) ) then
        return true
    endif
    if ( ( BlzIsUnitInvulnerable(udg_hook_target_Copy[udg_X]) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func004Func007Func004C takes nothing returns boolean
    if ( not ( udg_hook_target_aquired_Copy[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func004Func007C takes nothing returns boolean
    if ( not Trig_HERO_Hook_Loop_Copy_Func001Func001Func004Func007Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001Func004C takes nothing returns boolean
    if ( not ( udg_hook_return_active_Copy[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_herO[udg_X]) == 'H04F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Hook_Loop_Copy_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Hook_Loop_Copy_Func001Func001C() ) then
            set udg_abilitylevel=udg_hook_level_Copy[GetUnitUserData(udg_dummy_hook_Copy[udg_X])]
            set udg_hook_start_location_Copy[udg_X]=GetUnitLoc(udg_herO[udg_X])
            if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func003C() ) then
                // SEND HOOK
                if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func002C() ) then
                    set udg_hook_first_Copy[udg_X]=false
                    set udg_hook_location_Copy[udg_X]=PolarProjectionBJ(udg_hook_start_location_Copy[udg_X], 62.00, udg_hook_degree_Copy[udg_X])
                    call AddLightningLoc("LEAS", udg_hook_start_location_Copy[udg_X], udg_hook_location_Copy[udg_X])
                    set udg_hook_lightning_Copy[udg_X]=GetLastCreatedLightningBJ()
                else
                    set udg_hook_location_Copy[udg_X]=PolarProjectionBJ(udg_hook_location_Copy[udg_X], 62.00, udg_hook_degree_Copy[udg_X])
                endif
                call SetUnitPositionLocFacingBJ(udg_dummy_hook_Copy[udg_X], udg_hook_location_Copy[udg_X], udg_hook_degree_Copy[udg_X])
                call MoveLightningLoc(udg_hook_lightning_Copy[udg_X], udg_hook_start_location_Copy[udg_X], udg_hook_location_Copy[udg_X])
                if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005C() ) then
                    // NO TARGET, ACTIVATE RETURN
                    set udg_hook_send_active_Copy[udg_X]=false
                    set udg_hook_return_active_Copy[udg_X]=true
                    set udg_hook_target_aquired_Copy[udg_X]=false
                else
                    // TARGET FOUND , ACTIVATE RETURN
                    set udg_hook_target_group_Copy[udg_X]=GetUnitsInRangeOfLocMatching(110.00, udg_hook_location_Copy[udg_X], Condition(function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func003002003))
                    call ForGroupBJ(udg_hook_target_group_Copy[udg_X], function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func004A)
                    if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func005C() ) then
                        set udg_hook_send_active_Copy[udg_X]=false
                        set udg_hook_return_active_Copy[udg_X]=true
                        set udg_hook_target_aquired_Copy[udg_X]=true
                        call ForGroupBJ(GetRandomSubGroup(1, udg_hook_target_group_Copy[udg_X]), function Trig_HERO_Hook_Loop_Copy_Func001Func001Func003Func005Func005Func005A)
                    else
                        call DoNothing()
                    endif
                    call DestroyGroup(udg_mjolnir_target[udg_X])
                endif
            else
                call DoNothing()
            endif
            if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func004C() ) then
                // RETURN HOOK
                set udg_hook_degree_Copy[udg_X]=AngleBetweenPoints(udg_hook_start_location_Copy[udg_X], udg_hook_location_Copy[udg_X])
                set udg_hook_location_Copy[udg_X]=PolarProjectionBJ(udg_hook_location_Copy[udg_X], - 45.00, udg_hook_degree_Copy[udg_X])
                call SetUnitPositionLocFacingBJ(udg_dummy_hook_Copy[udg_X], udg_hook_location_Copy[udg_X], udg_hook_degree_Copy[udg_X])
                call SetUnitPositionLocFacingBJ(udg_hook_target_Copy[udg_X], udg_hook_location_Copy[udg_X], udg_hook_degree_Copy[udg_X])
                call MoveLightningLoc(udg_hook_lightning_Copy[udg_X], udg_hook_start_location_Copy[udg_X], udg_hook_location_Copy[udg_X])
                if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func004Func007C() ) then
                    // HOOK RETURNED
                    if ( Trig_HERO_Hook_Loop_Copy_Func001Func001Func004Func007Func004C() ) then
                        call UnitAddAbilityBJ('A0GX', udg_dummy_hook_Copy[udg_X])
                        call SetUnitAbilityLevelSwapped('A0GX', udg_dummy_hook_Copy[udg_X], udg_abilitylevel)
                        call IssueTargetOrderBJ(udg_dummy_hook_Copy[udg_X], "firebolt", udg_hook_target_Copy[udg_X])
                    else
                        call DoNothing()
                    endif
                    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_hook_Copy[udg_X])
                    set udg_hook_return_active_Copy[udg_X]=false
                    set udg_hook_target_Copy[udg_X]=null
                    call DestroyLightningBJ(udg_hook_lightning_Copy[udg_X])
                    call RemoveLocation(udg_hook_location_Copy[udg_X])
                    call RemoveLocation(udg_hook_start_location_Copy[udg_X])
                    call DisableTrigger(GetTriggeringTrigger())
                else
                    call DoNothing()
                endif
            else
                call DoNothing()
            endif
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

