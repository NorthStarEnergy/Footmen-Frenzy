function Trig_ITEM_Thunderfury_Staff_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0QM' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Thunderfury_Staff_Func010C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_temp_target, udg_temp_player) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Thunderfury_Staff_Actions takes nothing returns nothing
    // SET BASE VARIABLES
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_target=GetSpellTargetUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    // ACTION TIME
    if ( Trig_ITEM_Thunderfury_Staff_Func010C() ) then
        // TARGET = ENEMY
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0QN', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0QN', udg_dummy, 1)
        call IssueTargetOrderBJ(udg_dummy, "purge", udg_temp_target)
        call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_dummy)
    else
        // TARGET = FRIEND
        call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
        set udg_dummy=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0QE', udg_dummy)
        call SetUnitAbilityLevelSwapped('A0QE', udg_dummy, udg_abilitylevel)
        call IssueTargetOrderBJ(udg_dummy, "purge", udg_temp_target)
        call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_dummy)
    endif
    // CLEANUP TIME
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

function InitTrig_ITEM_Thunderfury_Staff takes nothing returns nothing
    set gg_trg_ITEM_Thunderfury_Staff=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_Thunderfury_Staff, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ITEM_Thunderfury_Staff, Condition(function Trig_ITEM_Thunderfury_Staff_Conditions))
    call TriggerAddAction(gg_trg_ITEM_Thunderfury_Staff, function Trig_ITEM_Thunderfury_Staff_Actions)
endfunction

