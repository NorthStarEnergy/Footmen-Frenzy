    if ( not ( CountUnitsInGroup(udg_HU_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001Func003Func008Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_HU_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001Func003Func008C takes nothing returns boolean
    if ( not ( udg_HU_Duration[udg_HU_CV] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HU_Hero, 'B01J') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Loop_Func001A takes nothing returns nothing
    set udg_HU_Hero=GetEnumUnit()
    //                                                                                                     
    if ( Trig_Hammer_Ulti_Loop_Func001Func003C() ) then
        set udg_HU_CV=GetUnitUserData(udg_HU_Hero)
        //                                                                                                     
        set udg_HU_Duration[udg_HU_CV]=( udg_HU_Duration[udg_HU_CV] - 1 )
        //                                                                                                     
        if ( Trig_Hammer_Ulti_Loop_Func001Func003Func008C() ) then
            call UnitRemoveAbilityBJ('AHUL', udg_HU_Hero)
            call UnitRemoveBuffBJ('B01J', udg_HU_Hero)
            //                                                                                                     
            call GroupRemoveUnitSimple(udg_HU_Hero, udg_HU_Group)
            if ( Trig_Hammer_Ulti_Loop_Func001Func003Func008Func005C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        else
        endif
    else
        // Hero is dead / lost the buff:
        call GroupRemoveUnitSimple(udg_HU_Hero, udg_HU_Group)
        if ( Trig_Hammer_Ulti_Loop_Func001Func003Func003C() ) then
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    endif
endfunction

function Trig_Hammer_Ulti_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_HU_Group, function Trig_Hammer_Ulti_Loop_Func001A)
endfunction

