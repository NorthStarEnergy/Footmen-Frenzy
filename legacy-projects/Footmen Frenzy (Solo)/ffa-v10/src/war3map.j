endfunction

function Trig_BASE__Overdrive_END_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_BASE__Overdrive_END_Func001Func001C() ) then
            set udg_number_of_spawned_units[udg_X]=1
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

