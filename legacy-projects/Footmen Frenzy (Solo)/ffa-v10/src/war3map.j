function Trig_Altar_Hero_Summon_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point_caster=GetUnitLoc(GetTriggerUnit())
    set udg_triggeringability=GetSpellAbilityId()
    call SetPlayerTechResearchedSwap('R00J', 0, udg_temp_player)
    if ( Trig_Altar_Hero_Summon_Func009C() ) then
        set udg_temp_int=GetRandomInt(0, 5)
        set udg_random_creep[0]='U012'
        set udg_random_creep[1]='O01A'
        set udg_random_creep[2]='U013'
        set udg_random_creep[3]='N02F'
        set udg_random_creep[4]='N032'
        set udg_random_creep[5]='E01D'
        call CreateNUnitsAtLoc(1, udg_random_creep[udg_temp_int], udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_Altar_Hero_Summon_Func010C() ) then
        set udg_temp_int=GetRandomInt(0, 5)
        set udg_random_creep[0]='H04Z'
        set udg_random_creep[1]='O01D'
        set udg_random_creep[2]='U019'
        set udg_random_creep[3]='N039'
        set udg_random_creep[4]='H05Y'
        set udg_random_creep[5]='H05P'
        call CreateNUnitsAtLoc(1, udg_random_creep[udg_temp_int], udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_Altar_Hero_Summon_Func011C() ) then
        set udg_temp_int=GetRandomInt(0, 4)
        set udg_random_creep[0]='U018'
        set udg_random_creep[1]='H05R'
        set udg_random_creep[2]='H05Z'
        set udg_random_creep[3]='H05O'
        set udg_random_creep[4]='H05R'
        call CreateNUnitsAtLoc(1, udg_random_creep[udg_temp_int], udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_Altar_Hero_Summon_Func012C() ) then
        set udg_temp_int=GetRandomInt(0, 4)
        set udg_random_creep[0]='E016'
        set udg_random_creep[1]='H052'
        set udg_random_creep[2]='O01G'
        set udg_random_creep[3]='H05X'
        set udg_random_creep[4]='H061'
        call CreateNUnitsAtLoc(1, udg_random_creep[udg_temp_int], udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_Altar_Hero_Summon_Func013C() ) then
        set udg_temp_int=GetRandomInt(0, 5)
        set udg_random_creep[0]='H060'
        set udg_random_creep[1]='H05I'
        set udg_random_creep[2]='O01M'
        set udg_random_creep[3]='N031'
        set udg_random_creep[4]='E01C'
        set udg_random_creep[5]='O01N'
        call CreateNUnitsAtLoc(1, udg_random_creep[udg_temp_int], udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_Altar_Hero_Summon_Func014C() ) then
        set udg_temp_int=GetRandomInt(0, 5)
        set udg_random_creep[0]='H015'
        set udg_random_creep[1]='E00E'
        set udg_random_creep[2]='H02J'
        set udg_random_creep[3]='N01C'
        set udg_random_creep[4]='H04Y'
        set udg_random_creep[5]='H02G'
        call CreateNUnitsAtLoc(1, udg_random_creep[udg_temp_int], udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
        set udg_temp_unit=GetLastCreatedUnit()
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
    else
        call DoNothing()
    endif
    call RemoveLocation(udg_temp_point_caster)
endfunction

