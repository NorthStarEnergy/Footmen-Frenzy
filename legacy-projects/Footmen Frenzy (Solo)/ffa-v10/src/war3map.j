    set gg_trg_HERO_Blooddancer_Illusions_Warhymn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Blooddancer_Illusions_Warhymn, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Blooddancer_Illusions_Warhymn, Condition(function Trig_HERO_Blooddancer_Illusions_Warhymn_Conditions))
