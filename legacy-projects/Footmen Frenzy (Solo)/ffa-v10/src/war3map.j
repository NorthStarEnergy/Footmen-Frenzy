function Trig_Multishot_Tower_doubleup_Func004002002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == GetUnitTypeId(udg_temp_unit) )
endfunction

function Trig_Multishot_Tower_doubleup_Func004002002002 takes nothing returns boolean
    return ( IsUnitAlly(GetFilterUnit(), udg_temp_player) == true )
endfunction

function Trig_Multishot_Tower_doubleup_Func004002002 takes nothing returns boolean
    return GetBooleanAnd(Trig_Multishot_Tower_doubleup_Func004002002001(), Trig_Multishot_Tower_doubleup_Func004002002002())
endfunction

function Trig_Multishot_Tower_doubleup_Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_temp_unitgroup) > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multishot_Tower_doubleup_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_unitgroup=GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Multishot_Tower_doubleup_Func004002002))
    set udg_temp_int=BlzGetUnitIntegerField(udg_temp_unit, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE)
