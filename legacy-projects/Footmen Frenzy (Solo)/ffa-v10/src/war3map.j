endfunction

function Trig_Avalanche_Trample_Loop_Func001Func028C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop]) == 'H03N' ) ) then
        return false
