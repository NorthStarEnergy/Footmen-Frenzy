    endfunction

    function MissileAttach takes nothing returns nothing
        local integer missile= udg_Missile
        
        set bj_lastCreatedEffect=s__Missiles_attach(missile,udg_MissileAttachModel , udg_MissileAttachX , udg_MissileAttachY , udg_MissileAttachZ , udg_MissileAttachScale)
    endfunction

    function MissileDetach takes nothing returns nothing
        local integer missile= udg_Missile
        
        call s__Missiles_detach(missile,udg_MissileDetachEffect)
