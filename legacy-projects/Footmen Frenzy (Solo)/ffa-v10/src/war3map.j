    if ( not ( GetSpellAbilityId() == 'A0JO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dash_Wooj_Func027C takes nothing returns boolean
    if ( not ( udg_Avalanche_TR_Index == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dash_Wooj_Actions takes nothing returns nothing
    // Create a new instance of Trample:
    set udg_Avalanche_TR_Index=( udg_Avalanche_TR_Index + 1 )
    //                                                                                                                    
    // ================================================
    // Define the animation played, speed per interval, and max duration:
    // Note: Each animation has it's own integer index. It starts at 0 and works it's way up.
    set udg_Avalanche_TR_Animation[udg_Avalanche_TR_Index]=10
    set udg_Avalanche_TR_Speed[udg_Avalanche_TR_Index]=26.00
    set udg_Avalanche_TR_Max_Duration[udg_Avalanche_TR_Index]=31
    // ================================================
    //                                                                                                          
    // Store data about Trample which we will reference in the For Loop:
    set udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index]=GetTriggerUnit()
    set udg_Avalanche_TR_Duration[udg_Avalanche_TR_Index]=0
    set udg_Avalanche_TR_Interval[udg_Avalanche_TR_Index]=9999
    //                                                                                                          
    set udg_Avalanche_TR_Point[0]=GetUnitLoc(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index])
    set udg_Avalanche_TR_Point[1]=GetSpellTargetLoc()
    set udg_Avalanche_TR_Angle[udg_Avalanche_TR_Index]=AngleBetweenPoints(udg_Avalanche_TR_Point[0], udg_Avalanche_TR_Point[1])
    //                                                                                                          
    call RemoveLocation(udg_Avalanche_TR_Point[0])
    call RemoveLocation(udg_Avalanche_TR_Point[1])
    //                                                                                                          
    // Start the Trample loop:
    if ( Trig_Dash_Wooj_Func027C() ) then
        call EnableTrigger(gg_trg_Avalanche_Trample_Loop)
    else
    endif
endfunction

function InitTrig_Dash_Wooj takes nothing returns nothing
