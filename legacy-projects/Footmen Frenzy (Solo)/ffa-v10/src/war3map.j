function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'H048' ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func003C takes nothing returns boolean
    if ( not ( udg_mjolnir_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func005002003001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), ConvertedPlayer(udg_X)) == true )
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func005002003002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func005002003 takes nothing returns boolean
    return GetBooleanAnd(Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func005002003001(), Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func005002003002())
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func006Func001A takes nothing returns nothing
    call UnitAddAbilityBJ('A0EB', udg_dummy_mjolnir[udg_X])
    call SetUnitAbilityLevelSwapped('A0EB', udg_dummy_mjolnir[udg_X], udg_mjolnir_level_Copy[GetUnitUserData(udg_dummy_mjolnir[udg_X])])
    call IssueTargetOrderBJ(udg_dummy_mjolnir[udg_X], "firebolt", GetEnumUnit())
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_mjolnir_target[udg_X]) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func007C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_mjolnir_start_location[udg_X], udg_mjolnir_location[udg_X]) >= 1100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001C takes nothing returns boolean
    if ( not Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Mjolnir_Loop_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Thor_Mjolnir_Loop_Func001Func001C() ) then
            set udg_mjolnir_start_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
            if ( Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func003C() ) then
                set udg_mjolnir_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
                set udg_mjolnir_active[udg_X]=false
            else
                set udg_mjolnir_location[udg_X]=PolarProjectionBJ(udg_mjolnir_location[udg_X], 20.00, udg_mjolnir_degree[udg_X])
            endif
            call SetUnitPositionLocFacingBJ(udg_dummy_mjolnir[udg_X], udg_mjolnir_location[udg_X], udg_mjolnir_degree[udg_X])
            set udg_mjolnir_target[udg_X]=GetUnitsInRangeOfLocMatching(110.00, udg_mjolnir_location[udg_X], Condition(function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func005002003))
            if ( Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func006C() ) then
                call ForGroupBJ(GetRandomSubGroup(1, udg_mjolnir_target[udg_X]), function Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func006Func001A)
                call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_mjolnir[udg_X])
                call SetUnitPositionLocFacingBJ(udg_herO[udg_X], udg_mjolnir_location[udg_X], udg_mjolnir_degree[udg_X])
                call RemoveLocation(udg_mjolnir_location[udg_X])
                call RemoveLocation(udg_mjolnir_start_location[udg_X])
                set udg_mjolnir_active[udg_X]=false
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            if ( Trig_HERO_Thor_Mjolnir_Loop_Func001Func001Func007C() ) then
                call RemoveUnit(udg_dummy_mjolnir[udg_X])
                call RemoveLocation(udg_mjolnir_location[udg_X])
                set udg_mjolnir_active[udg_X]=false
                call RemoveLocation(udg_mjolnir_start_location[udg_X])
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            call DestroyGroup(udg_mjolnir_target[udg_X])
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_HERO_Thor_Mjolnir_Loop takes nothing returns nothing
    set gg_trg_HERO_Thor_Mjolnir_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_HERO_Thor_Mjolnir_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_HERO_Thor_Mjolnir_Loop, 0.02)
    call TriggerAddAction(gg_trg_HERO_Thor_Mjolnir_Loop, function Trig_HERO_Thor_Mjolnir_Loop_Actions)
endfunction

function Trig_HERO_Thor_Powerhit_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0ED' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Powerhit_Func009Func005C takes nothing returns boolean
    if ( not ( IsTerrainPathableBJ(udg_temp_point, PATHING_TYPE_WALKABILITY) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Powerhit_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_target=GetSpellTargetUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_temp_degree=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_X=1
    loop
        exitwhen udg_X > ( 30 + ( 10 * udg_abilitylevel ) )
        set udg_temp_point=PolarProjectionBJ(udg_temp_point, 15.00, udg_temp_degree)
        call SetUnitPositionLocFacingBJ(udg_temp_target, udg_temp_point, udg_temp_degree)
        call AddSpecialEffectLocBJ(udg_temp_point, "Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        if ( Trig_HERO_Thor_Powerhit_Func009Func005C() ) then
            set udg_temp_point=PolarProjectionBJ(udg_temp_point, - 16.50, udg_temp_degree)
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
    call RemoveLocation(udg_temp_point_caster)
    call RemoveLocation(udg_temp_point)
endfunction

function InitTrig_HERO_Thor_Powerhit takes nothing returns nothing
    set gg_trg_HERO_Thor_Powerhit=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Thor_Powerhit, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Thor_Powerhit, Condition(function Trig_HERO_Thor_Powerhit_Conditions))
