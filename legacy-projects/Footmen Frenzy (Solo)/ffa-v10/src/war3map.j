function Trig_HERO_HdH_Ulti_Func012A takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'h01K', GetTriggerPlayer(), udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A06B', udg_dummy)
    call SetUnitAbilityLevelSwapped('A06B', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "invisibility", GetEnumUnit())
    call UnitAddAbilityBJ('A06V', udg_dummy)
    call SetUnitAbilityLevelSwapped('A06V', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "antimagicshell", GetEnumUnit())
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
endfunction

function Trig_HERO_HdH_Ulti_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    call CreateNUnitsAtLoc(1, 'h01K', GetTriggerPlayer(), udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    if ( Trig_HERO_HdH_Ulti_Func007C() ) then
        set udg_temp_AoE=350.00
        call UnitAddItemByIdSwapped('I01F', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01F'))
    else
        call DoNothing()
    endif
    if ( Trig_HERO_HdH_Ulti_Func008C() ) then
        set udg_temp_AoE=400.00
        call UnitAddItemByIdSwapped('I018', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I018'))
    else
        call DoNothing()
    endif
    if ( Trig_HERO_HdH_Ulti_Func009C() ) then
        set udg_temp_AoE=500.00
        call UnitAddItemByIdSwapped('I019', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I019'))
    else
        call DoNothing()
    endif
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_HdH_Ulti_Func011002003))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_HdH_Ulti_Func012A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

