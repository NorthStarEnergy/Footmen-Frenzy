function Trig_Update_base_variable_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_base[udg_temp_playernumber]=GetTriggerUnit()
    if SKEnabled and SKProtectUntil[udg_temp_playernumber]>SKClock then
        call SetUnitInvulnerable(udg_base[udg_temp_playernumber],true)
    endif
    if ( Trig_Update_base_variable_Func004C() ) then
        call UnitAddAbilityBJ('A082', udg_base[udg_temp_playernumber])
        call BlzStartUnitAbilityCooldown(udg_base[udg_temp_playernumber], 'A082', TimerGetRemaining(udg_timer_overdrive_CD[udg_temp_playernumber]))
    else
        call DoNothing()
    endif
    if ( Trig_Update_base_variable_Func005C() ) then
        call BlzSetUnitMaxHP(udg_base[udg_temp_playernumber], ( BlzGetUnitMaxHP(udg_base[udg_temp_playernumber]) + 750 ))
        call BlzSetUnitRealFieldBJ(udg_base[udg_temp_playernumber], UNIT_RF_HP, I2R(BlzGetUnitMaxHP(udg_base[udg_temp_playernumber])))
    else
        call DoNothing()
    endif
endfunction

