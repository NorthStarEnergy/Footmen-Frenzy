    endif
    return false
endfunction

function Trig_ITEM_Wall_Conditions takes nothing returns boolean
    if ( not Trig_ITEM_Wall_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Wall_Func006001 takes nothing returns boolean
    return ( udg_wall_ID == 20 )
endfunction

function Trig_ITEM_Wall_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_ITEM_Wall_countdown)
    set udg_temp_unit=GetConstructedStructure()
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
    if ( Trig_ITEM_Wall_Func006001() ) then
        set udg_wall_ID=0
    else
        call DoNothing()
    endif
    set udg_wall_ID=( udg_wall_ID + 1 )
    call SetUnitUserData(udg_temp_unit, udg_wall_ID)
    call UnitApplyTimedLifeBJ(40.00, 'BTLF', udg_temp_unit)
    call StartTimerBJ(udg_wall_timer[udg_wall_ID], false, 40.00)
    call CreateTextTagLocBJ(R2SW(TimerGetRemaining(udg_wall_timer[udg_wall_ID]), 2, 0), udg_temp_point, 0, 9.00, 100, 100, 100, 25.00)
    set udg_wall_timer_text[udg_wall_ID]=GetLastCreatedTextTag()
    call SetTextTagLifespanBJ(udg_wall_timer_text[udg_wall_ID], 40.00)
endfunction

