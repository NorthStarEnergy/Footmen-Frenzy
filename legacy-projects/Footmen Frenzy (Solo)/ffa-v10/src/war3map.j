function Trig_Remove_Invul_from_buildings_Actions takes nothing returns nothing
    // remove invu from buildings
    set udg_temp_unitgroup=GetUnitsOfTypeIdAll('hwtw')
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Remove_Invul_from_buildings_Func004A)
    set udg_X=1
    loop
        exitwhen udg_X > 12
        call UnitRemoveAbilityBJ('Avul', udg_base[udg_X])
        set udg_X=udg_X + 1
    endloop
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

