function Trig_Mute_Player_Command_Conditions takes nothing returns boolean
    if ( not ( udg_admin_level[GetConvertedPlayerId(GetTriggerPlayer())] >= 90 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mute_Player_Command_Func007Func004Func011C takes nothing returns boolean
    if ( not ( udg_Mute_Player_Original_Name[udg_Mute_Player_Number] == "" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mute_Player_Command_Func007Func004C takes nothing returns boolean
    if ( not ( udg_Mute_Is_Player_Muted[udg_Mute_Player_Number] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mute_Player_Command_Func007C takes nothing returns boolean
    if ( not ( udg_Mute_Player_Number >= 1 ) ) then
        return false
    endif
    if ( not ( udg_Mute_Player_Number <= 24 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mute_Player_Command_Actions takes nothing returns nothing
    // Note: Events are added to this trigger in Mute Setup!
    //                                                                                                                                     
    set udg_Mute_Player_Number=0
    set udg_Mute_Player_Number=S2I(SubStringBJ(GetEventPlayerChatString(), 7, StringLength(GetEventPlayerChatString())))
    //                                                                                                                                     
    if ( Trig_Mute_Player_Command_Func007C() ) then
        set udg_Mute_Player=ConvertedPlayer(udg_Mute_Player_Number)
        //                                                                                                                                     
        // Toggle the muting:
        if ( Trig_Mute_Player_Command_Func007Func004C() ) then
            set udg_Mute_Is_Player_Muted[udg_Mute_Player_Number]=true
            //                                                                                                                                     
            // Cache their name to preserve it's original value:
            if ( Trig_Mute_Player_Command_Func007Func004Func011C() ) then
                set udg_Mute_Player_Original_Name[udg_Mute_Player_Number]=GetPlayerName(udg_Mute_Player)
            else
            endif
            //                                                                                                                                     
            // Change their name to this ridiculous value to mute them:
            call SetPlayerName(udg_Mute_Player, "TRIGSTR_16263")
            //                                                                                                                                     
            call DisplayTimedTextToForce(GetPlayersAll(), 2.00, ( udg_Mute_Player_Original_Name[udg_Mute_Player_Number] + " |cff808080has been muted.|r" ))
        else
            set udg_Mute_Is_Player_Muted[udg_Mute_Player_Number]=false
            //                                                                                                                                     
            // Reset their name to unmute:
            call SetPlayerName(udg_Mute_Player, udg_Mute_Player_Original_Name[udg_Mute_Player_Number])
            //                                                                                                                                     
            call DisplayTimedTextToForce(GetPlayersAll(), 2.00, ( udg_Mute_Player_Original_Name[udg_Mute_Player_Number] + " has been unmuted." ))
        endif
    else
    endif
endfunction

function InitTrig_Mute_Player_Command takes nothing returns nothing
    set gg_trg_Mute_Player_Command=CreateTrigger()
    call DisableTrigger(gg_trg_Mute_Player_Command)
    call TriggerAddCondition(gg_trg_Mute_Player_Command, Condition(function Trig_Mute_Player_Command_Conditions))
    call TriggerAddAction(gg_trg_Mute_Player_Command, function Trig_Mute_Player_Command_Actions)
endfunction

function Trig_Unit_Indexer_Func017Func004C takes nothing returns boolean
    if ( not ( udg_UDexRecycle == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Indexer_Func017C takes nothing returns boolean
    if ( not ( udg_UnitIndexerEnabled == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Indexer_Func030Func005C takes nothing returns boolean
    if ( not ( GetUnitUserData(udg_UDexUnits[udg_UDex]) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Indexer_Func030C takes nothing returns boolean
    if ( not ( udg_UDexWasted == 15 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Indexer_Func034C takes nothing returns boolean
    if ( not ( GetUnitUserData(GetFilterUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Indexer_Actions takes nothing returns nothing
        call ExecuteFunc("InitializeUnitIndexer")
    endfunction

    function IndexUnit takes nothing returns boolean
        local integer pdex= udg_UDex
    //  
    // You can use the boolean UnitIndexerEnabled to protect some of your undesirable units from being indexed
    // - Example:
    // -- Set UnitIndexerEnabled = False
    // -- Unit - Create 1 Dummy for (Triggering player) at TempLoc facing 0.00 degrees
    // -- Set UnitIndexerEnabled = True
    //  
    // You can also customize the following block - if conditions are false the (Matching unit) won't be indexed.
    //  
    if ( Trig_Unit_Indexer_Func017C() ) then
        //  
        // Generate a unique integer index for this unit
        //  
        if ( Trig_Unit_Indexer_Func017Func004C() ) then
            set udg_UDex=( udg_UDexGen + 1 )
            set udg_UDexGen=udg_UDex
        else
            set udg_UDex=udg_UDexRecycle
            set udg_UDexRecycle=udg_UDexNext[udg_UDex]
        endif
        //  
        // Link index to unit, unit to index
        //  
        set udg_UDexUnits[udg_UDex]=GetFilterUnit()
        call SetUnitUserData(udg_UDexUnits[udg_UDex], udg_UDex)
        //  
        // Use a doubly-linked list to store all active indexes
        //  
        set udg_UDexPrev[udg_UDexNext[0]]=udg_UDex
        set udg_UDexNext[udg_UDex]=udg_UDexNext[0]
        set udg_UDexNext[0]=udg_UDex
        //  
        // Fire index event for UDex
        //  
        set udg_UnitIndexEvent=0.00
        set udg_UnitIndexEvent=1.00
        set udg_UnitIndexEvent=0.00
        set udg_UDex=pdex
    else
    endif
        return false
    endfunction

    function IndexNewUnit takes nothing returns boolean
        local integer pdex= udg_UDex
        local integer ndex
    //  
    // Recycle indices of units no longer in-play every (15) units created
    //  
    set udg_UDexWasted=( udg_UDexWasted + 1 )
    if ( Trig_Unit_Indexer_Func030C() ) then
        set udg_UDexWasted=0
        set udg_UDex=udg_UDexNext[0]
        loop
            exitwhen udg_UDex == 0
        if ( Trig_Unit_Indexer_Func030Func005C() ) then
            //  
            // Remove index from linked list
            //  
            set ndex=udg_UDexNext[udg_UDex]
            set udg_UDexNext[udg_UDexPrev[udg_UDex]]=ndex
            set udg_UDexPrev[ndex]=udg_UDexPrev[udg_UDex]
            set udg_UDexPrev[udg_UDex]=0
            //  
            // Fire deindex event for UDex
            //  
            set udg_UnitIndexEvent=2.00
            set udg_UnitIndexEvent=0.00
            //  
            // Recycle the index for later use
            //  
            set udg_UDexUnits[udg_UDex]=null
            set udg_UDexNext[udg_UDex]=udg_UDexRecycle
            set udg_UDexRecycle=udg_UDex
            set udg_UDex=ndex
        else
            set udg_UDex=udg_UDexNext[udg_UDex]
        endif
        endloop
        set udg_UDex=pdex
    else
    endif
    //  
    // Handle the entering unit (Matching unit)
    //  
    if ( Trig_Unit_Indexer_Func034C() ) then
        call IndexUnit()
    else
    endif
        return false
    endfunction

    function InitializeUnitIndexer takes nothing returns nothing
        local integer i= 0
        local region re= CreateRegion()
        local rect r= GetWorldBounds()
    set udg_UnitIndexerEnabled=true
        call RegionAddRect(re, r)
        call TriggerRegisterEnterRegion(CreateTrigger(), re, Filter(function IndexNewUnit))
        call RemoveRect(r)
        set re=null
        set r=null
        loop
            call GroupEnumUnitsOfPlayer(bj_lastCreatedGroup, Player(i), Filter(function IndexUnit))
            set i=i + 1
            exitwhen i == 16
        endloop
    //  
    // This is the "Unit Indexer Initialized" event, use it instead of "Map Initialization" for best results
    //  
    set udg_UnitIndexEvent=3.00
    set udg_UnitIndexEvent=0.00
endfunction

function InitTrig_Unit_Indexer takes nothing returns nothing
    set gg_trg_Unit_Indexer=CreateTrigger()
    call TriggerAddAction(gg_trg_Unit_Indexer, function Trig_Unit_Indexer_Actions)
endfunction

