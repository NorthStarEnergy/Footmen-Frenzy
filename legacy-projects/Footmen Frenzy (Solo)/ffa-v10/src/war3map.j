    if ( not ( udg_mode_debugmode == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Santa_Snowball_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_ship_destination[udg_temp_playernumber]=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_real=( 522.00 * ( DistanceBetweenPoints(udg_temp_point_caster, udg_ship_destination[udg_temp_playernumber]) / 1000.00 ) )
    if ( Trig_HERO_Santa_Snowball_Func008C() ) then
        call DisplayTextToForce(udg_all_players, ( "temp real = " + R2S(udg_temp_real) ))
        call DisplayTextToForce(udg_all_players, ( "distance = " + R2S(DistanceBetweenPoints(udg_temp_point_caster, udg_ship_destination[udg_temp_playernumber])) ))
    else
    endif
    call CreateNUnitsAtLocFacingLocBJ(1, 'h03R', udg_temp_player, udg_temp_point_caster, udg_temp_point)
    set udg_dummy_ship[udg_temp_playernumber]=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_dummy_ship[udg_temp_playernumber], udg_temp_real)
    call UnitAddAbilityBJ('A0LR', udg_dummy_ship[udg_temp_playernumber])
    call SetUnitAbilityLevelSwapped('A0LR', udg_dummy_ship[udg_temp_playernumber], udg_abilitylevel)
    call IssuePointOrderLocBJ(udg_dummy_ship[udg_temp_playernumber], "move", udg_ship_destination[udg_temp_playernumber])
    call RemoveLocation(udg_temp_point_caster)
    call RemoveLocation(udg_ship_destination[udg_temp_playernumber])
    call StartTimerBJ(udg_timer_ship[udg_temp_playernumber], false, 2.30)
    call UnitApplyTimedLifeBJ(2.50, 'BTLF', udg_dummy_ship[udg_temp_playernumber])
endfunction

