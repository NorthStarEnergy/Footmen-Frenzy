function SoloFootsTeamRepresentative takes integer playerNumber returns integer
    return playerNumber
endfunction

function SoloFootsFindWinner takes nothing returns integer
    local integer i=1
    local integer winner=0
    local integer count=0
    loop
        exitwhen i > 12
        if udg_player_active[i] then
            set count=count + 1
            set winner=i
        endif
        set i=i + 1
    endloop
    if count == 1 then
        return winner
    endif
    return 0
endfunction

function SoloFootsPrepareEndGame takes nothing returns boolean
    local integer winner
    local integer finalOpponent
    if SoloFoots_EndGameStarted then
        return false
    endif
    set winner=SoloFootsFindWinner()
    if winner == 0 then
        return false
    endif
    set finalOpponent=SoloFootsTeamRepresentative(SoloFoots_LastEliminatedPlayerNumber)
    if finalOpponent == 0 or finalOpponent == winner then
        return false
    endif
    set SoloFoots_FinalOpponentPlayerNumber=finalOpponent
    set SoloFoots_EndGameStarted=true
    return true
endfunction

function SoloFootsWinnerAnnouncement takes string winnerLabel returns string
    if SoloFoots_FinalEliminationWasLeave then
        return GetPlayerName(ConvertedPlayer(SoloFoots_FinalOpponentPlayerNumber)) + " has left the game, " + winnerLabel + " wins!"
    endif
    if SoloFoots_FinalStrikePlayer != null then
        return GetPlayerName(SoloFoots_FinalStrikePlayer) + " has made the final strike, " + winnerLabel + " wins!"
    endif
    return winnerLabel + " wins!"
endfunction

function Trig_END_Actions takes nothing returns nothing
    local integer winner=SoloFootsFindWinner()
    if SKEnabled then
        call SKCheckVictory()
        return
    endif
    if winner == 0 or not SoloFootsPrepareEndGame() then
        return
    endif
    call DisplayTextToForce(GetPlayersAll(), GetPlayerName(Player(winner - 1)) + " wins!")
    call CustomVictoryBJ(Player(winner - 1), true, true)
endfunction

function InitTrig_END takes nothing returns nothing
    set gg_trg_END=CreateTrigger()
    call TriggerAddAction(gg_trg_END, function Trig_END_Actions)
endfunction

function AntiMH_Clamp takes integer value returns integer
    if value < - 400000 then
        return - 400000
    endif
    if value > 499999 then
        return 499999
    endif
    return value
endfunction

function AntiMH_Encode takes integer value returns string
    return I2S(AntiMH_Clamp(value) + 500000)
endfunction

function AntiMH_Decode takes string payload,integer index returns integer
    return S2I(SubString(payload, index * 6, index * 6 + 6)) - 500000
endfunction

function AntiMH_IsWatched takes integer playerIndex returns boolean
    if playerIndex < 0 or playerIndex >= 12 then
        return false
    endif
    if GetPlayerSlotState(Player(playerIndex)) != PLAYER_SLOT_STATE_PLAYING then
        return false
    endif
    return GetPlayerController(Player(playerIndex)) == MAP_CONTROL_USER
endfunction

function AntiMH_AddScore takes integer playerIndex,integer amount,string kind,string detail returns nothing
    set AntiMH_Score[playerIndex]=AntiMH_Score[playerIndex] + amount
    if AntiMH_Score[playerIndex] >= 100 and not AntiMH_Flagged[playerIndex] then
        set AntiMH_Flagged[playerIndex]=true
    endif
endfunction

function AntiMH_ProbeSend takes nothing returns nothing
    local integer flags=0
    local string payload
    if IsFogEnabled() then
        set flags=flags + 1
    endif
    if IsFogMaskEnabled() then
        set flags=flags + 2
    endif
    set payload=AntiMH_Encode(AntiMH_Round) + AntiMH_Encode(flags) + AntiMH_Encode(R2I(GetCameraBoundMinX())) + AntiMH_Encode(R2I(GetCameraBoundMaxX())) + AntiMH_Encode(R2I(GetCameraBoundMinY())) + AntiMH_Encode(R2I(GetCameraBoundMaxY())) + AntiMH_Encode(R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE))) + AntiMH_Encode(R2I(GetCameraField(CAMERA_FIELD_FARZ)))
    call BlzSendSyncData("amh", payload)
endfunction

function AntiMH_OnSync takes nothing returns nothing
    local integer playerIndex=GetPlayerId(GetTriggerPlayer())
    local string payload=BlzGetTriggerSyncData()
    if not AntiMH_IsWatched(playerIndex) then
        return
    endif
    if StringLength(payload) != 48 then
        return
    endif
    if AntiMH_Decode(payload , 0) != AntiMH_Round then
        return
    endif
    set AntiMH_Replied[playerIndex]=true
    set AntiMH_RepFlags[playerIndex]=AntiMH_Decode(payload , 1)
    set AntiMH_RepMinX[playerIndex]=AntiMH_Decode(payload , 2)
    set AntiMH_RepMaxX[playerIndex]=AntiMH_Decode(payload , 3)
    set AntiMH_RepMinY[playerIndex]=AntiMH_Decode(payload , 4)
    set AntiMH_RepMaxY[playerIndex]=AntiMH_Decode(payload , 5)
    set AntiMH_RepZoom[playerIndex]=AntiMH_Decode(payload , 6)
    set AntiMH_RepFarZ[playerIndex]=AntiMH_Decode(payload , 7)
endfunction

function AntiMH_Sample takes integer field,integer playerIndex returns integer
    if field == 1 then
        return AntiMH_RepFlags[playerIndex]
    elseif field == 2 then
        return AntiMH_RepMinX[playerIndex]
    elseif field == 3 then
        return AntiMH_RepMaxX[playerIndex]
    elseif field == 4 then
        return AntiMH_RepMinY[playerIndex]
    elseif field == 5 then
        return AntiMH_RepMaxY[playerIndex]
    elseif field == 7 then
        return AntiMH_RepFarZ[playerIndex]
    endif
    return AntiMH_RepZoom[playerIndex]
endfunction

function AntiMH_Consensus takes integer field returns integer
    local integer i=0
    local integer j
    local integer value
    local integer count
    local integer best=0
    local integer bestCount=0
    loop
        exitwhen i >= 12
        if AntiMH_Replied[i] then
            set value=AntiMH_Sample(field , i)
            set count=0
            set j=0
            loop
                exitwhen j >= 12
                if AntiMH_Replied[j] and AntiMH_Sample(field , j) == value then
                    set count=count + 1
                endif
                set j=j + 1
            endloop
            if count > bestCount then
                set bestCount=count
                set best=value
            endif
        endif
        set i=i + 1
    endloop
    set AntiMH_ConsensusCount=bestCount
    return best
endfunction

function AntiMH_HasMajority takes integer responders returns boolean
    return AntiMH_ConsensusCount >= 2 and AntiMH_ConsensusCount * 2 > responders
endfunction

function AntiMH_ResetRound takes nothing returns nothing
    local integer i=0
    loop
        exitwhen i >= 12
        set AntiMH_Replied[i]=false
        set i=i + 1
    endloop
endfunction

function AntiMH_Evaluate takes nothing returns nothing
    local integer i=0
    local integer responders=0
    local integer fogValue
    local boolean fogJudgeable
    local integer minXValue
    local integer maxXValue
    local integer minYValue
    local integer maxYValue
    local boolean boundsJudgeable
    local integer farZValue
    local boolean farZJudgeable

    loop
        exitwhen i >= 12
        if AntiMH_IsWatched(i) and AntiMH_Replied[i] then
            set responders=responders + 1
        endif
        set i=i + 1
    endloop

    // Penalize silence only after at least two other clients prove the round
    // worked. A completely failed probe is a map problem, not player evidence.
    if responders >= 2 then
        set i=0
        loop
            exitwhen i >= 12
            if AntiMH_IsWatched(i) then
                if AntiMH_Replied[i] then
                    set AntiMH_Silent[i]=0
                else
                    set AntiMH_Silent[i]=AntiMH_Silent[i] + 1
                    if AntiMH_Silent[i] >= 4 then
                        call AntiMH_AddScore(i , 100 , "silent" , "no sync reply x" + I2S(AntiMH_Silent[i]))
                    else
                        call AntiMH_AddScore(i , 15 , "silent" , "no sync reply x" + I2S(AntiMH_Silent[i]))
                    endif
                endif
            endif
            set i=i + 1
        endloop
    endif

    // Zoom is checked independently so it still works in one- and two-player
    // Solo Foots tests. The supported camera controls are capped at 6000;
    // allow a small reporting tolerance before treating wider values as suspect.
    set i=0
    loop
        exitwhen i >= 12
        if AntiMH_IsWatched(i) and AntiMH_Replied[i] and udg_admin_level[i + 1] < 90 then
            if AntiMH_RepZoom[i] > 6200 then
                set AntiMH_ZoomHits[i]=AntiMH_ZoomHits[i] + 1
                if AntiMH_ZoomHits[i] >= 2 then
                    call AntiMH_AddScore(i , 60 , "zoom" , I2S(AntiMH_RepZoom[i]) + " over clamp 6000")
                else
                endif
            else
                set AntiMH_ZoomHits[i]=0
            endif
        endif
        set i=i + 1
    endloop

    // Fog and camera consensus requires three responders. Smaller lobbies
    // cannot distinguish an honest client from an outlier safely.
    if responders < 3 then
        return
    endif

    set fogValue=AntiMH_Consensus(1)
    set fogJudgeable=AntiMH_HasMajority(responders)
    set minXValue=AntiMH_Consensus(2)
    set boundsJudgeable=AntiMH_HasMajority(responders)
    set maxXValue=AntiMH_Consensus(3)
    set boundsJudgeable=boundsJudgeable and AntiMH_HasMajority(responders)
    set minYValue=AntiMH_Consensus(4)
    set boundsJudgeable=boundsJudgeable and AntiMH_HasMajority(responders)
    set maxYValue=AntiMH_Consensus(5)
    set boundsJudgeable=boundsJudgeable and AntiMH_HasMajority(responders)
    set farZValue=AntiMH_Consensus(7)
    set farZJudgeable=AntiMH_HasMajority(responders)

    set i=0
    loop
        exitwhen i >= 12
        if AntiMH_IsWatched(i) and AntiMH_Replied[i] then
            if fogJudgeable and AntiMH_RepFlags[i] != fogValue then
                call AntiMH_AddScore(i , 100 , "fog" , "flags " + I2S(AntiMH_RepFlags[i]) + " vs " + I2S(fogValue))
            endif
            if boundsJudgeable and ( AntiMH_RepMinX[i] != minXValue or AntiMH_RepMaxX[i] != maxXValue or AntiMH_RepMinY[i] != minYValue or AntiMH_RepMaxY[i] != maxYValue ) then
                call AntiMH_AddScore(i , 100 , "bounds" , I2S(AntiMH_RepMinX[i]) + "/" + I2S(AntiMH_RepMaxX[i]) + "/" + I2S(AntiMH_RepMinY[i]) + "/" + I2S(AntiMH_RepMaxY[i]) + " vs " + I2S(minXValue) + "/" + I2S(maxXValue) + "/" + I2S(minYValue) + "/" + I2S(maxYValue))
            endif
            if farZJudgeable and AntiMH_RepFarZ[i] != farZValue then
                call AntiMH_AddScore(i , 40 , "farz" , I2S(AntiMH_RepFarZ[i]) + " vs " + I2S(farZValue))
            endif
        endif
        set i=i + 1
    endloop
endfunction

function AntiMH_Tick takes nothing returns nothing
    if AntiMH_Warmup < 4 then
        set AntiMH_Warmup=AntiMH_Warmup + 1
        return
    endif
    if AntiMH_Collecting then
        call AntiMH_Evaluate()
    endif
    set AntiMH_Round=AntiMH_Round + 1
    if AntiMH_Round > 100000 then
        set AntiMH_Round=1
    endif
    call AntiMH_ResetRound()
    set AntiMH_Collecting=true
    call AntiMH_ProbeSend()
endfunction

function AntiMH_OrderCheck takes nothing returns nothing
    local unit ordered=GetTriggerUnit()
    local unit target=GetOrderTargetUnit()
    local player owner
    local integer playerIndex
    if ordered == null or target == null then
        set ordered=null
        set target=null
        return
    endif
    set owner=GetOwningPlayer(ordered)
    set playerIndex=GetPlayerId(owner)
    // Locust units are unselectable spell dummies, so their scripted orders
    // are not evidence of a player's map visibility.
    if AntiMH_IsWatched(playerIndex) and GetUnitAbilityLevel(ordered, 'Aloc') == 0 and IsPlayerEnemy(owner, GetOwningPlayer(target)) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) and not IsUnitHidden(target) and GetWidgetLife(target) > 0.405 and not IsUnitVisible(target, owner) then
        set AntiMH_OrderHits[playerIndex]=AntiMH_OrderHits[playerIndex] + 1
        call AntiMH_AddScore(playerIndex , 25 , "order" , GetUnitName(target) + " order " + I2S(GetIssuedOrderId()) + " hit " + I2S(AntiMH_OrderHits[playerIndex]))
    endif
    set ordered=null
    set target=null
    set owner=null
endfunction

function AntiMH_Report takes nothing returns nothing
    local player viewer=GetTriggerPlayer()
    local integer playerIndex=GetPlayerId(viewer)
    local integer i=0
    local integer shown=0
    if playerIndex < 0 or playerIndex >= 12 then
        set viewer=null
        return
    endif
    if udg_admin_level[playerIndex + 1] < 90 then
        set viewer=null
        return
    endif
    call SoloFootsDisplayTimedMessageToPlayer(viewer , 0 , 0 , 25.00 , "|cffffcc00Anti-maphack telemetry|r - round " + I2S(AntiMH_Round))
    loop
        exitwhen i >= 12
        if AntiMH_IsWatched(i) and AntiMH_Score[i] > 0 then
            set shown=shown + 1
            call SoloFootsDisplayTimedMessageToPlayer(viewer , 0 , 0 , 25.00 , "  " + GetPlayerName(Player(i)) + ": " + I2S(AntiMH_Score[i]) + " (orders " + I2S(AntiMH_OrderHits[i]) + ", zoom " + I2S(AntiMH_ZoomHits[i]) + ", silent " + I2S(AntiMH_Silent[i]) + ")")
        endif
        set i=i + 1
    endloop
    if shown == 0 then
        call SoloFootsDisplayTimedMessageToPlayer(viewer , 0 , 0 , 25.00 , "  nothing scored")
    endif
    set viewer=null
endfunction

function AntiMH_Init takes nothing returns nothing
    local trigger syncTrigger=CreateTrigger()
    local trigger orderTrigger=CreateTrigger()
    local trigger reportTrigger=CreateTrigger()
    local trigger probeTrigger=CreateTrigger()
    local integer i=0
    loop
        exitwhen i >= 12
        set AntiMH_Score[i]=0
        set AntiMH_Silent[i]=0
        set AntiMH_ZoomHits[i]=0
        set AntiMH_OrderHits[i]=0
        set AntiMH_Flagged[i]=false
        set AntiMH_Replied[i]=false
        call BlzTriggerRegisterPlayerSyncEvent(syncTrigger, Player(i), "amh", false)
        call TriggerRegisterPlayerUnitEvent(orderTrigger, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
        call TriggerRegisterPlayerChatEvent(reportTrigger, Player(i), "-mhlog", true)
        set i=i + 1
    endloop
    call TriggerAddAction(syncTrigger, function AntiMH_OnSync)
    call TriggerAddAction(orderTrigger, function AntiMH_OrderCheck)
    call TriggerAddAction(reportTrigger, function AntiMH_Report)
    call TriggerRegisterTimerEvent(probeTrigger, 11.00, true)
    call TriggerAddAction(probeTrigger, function AntiMH_Tick)
    set syncTrigger=null
    set orderTrigger=null
    set reportTrigger=null
    set probeTrigger=null
endfunction

function Trig_Altar_limit_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetConstructingStructure()) == 'hhou'
endfunction

function Trig_Altar_limit_CountAltars takes player owner returns integer
    local group g=CreateGroup()
    local integer i=0
    local integer size
    local integer count=0
    local unit checked=null
    call GroupEnumUnitsOfPlayer(g, owner, null)
    set size=BlzGroupGetSize(g)
    loop
        exitwhen i >= size
        set checked=BlzGroupUnitAt(g, i)
        if GetUnitTypeId(checked) == 'hhou' and GetUnitState(checked, UNIT_STATE_LIFE) > 0.00 then
            set count=count + 1
        endif
        set i=i + 1
    endloop
    call GroupClear(g)
    call DestroyGroup(g)
    set g=null
    set checked=null
    return count
endfunction

function Trig_Altar_limit_Actions takes nothing returns nothing
    local unit built=GetConstructingStructure()
    local player owner=GetOwningPlayer(built)
    // `built` is already in the count, so >1 means one was standing before this one.
    // That only happens if two placements land in the same tick, before the button
    // is greyed out; cancelling refunds the player.
    if Trig_Altar_limit_CountAltars(owner) > 1 then
        call IssueImmediateOrder(built, "cancel")
    else
        call SetPlayerUnitAvailableBJ('hhou', false, owner)
    endif
    set built=null
    set owner=null
endfunction

function InitTrig_Altar_limit takes nothing returns nothing
    set gg_trg_Altar_limit=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Altar_limit, EVENT_PLAYER_UNIT_CONSTRUCT_START)
    call TriggerAddCondition(gg_trg_Altar_limit, Condition(function Trig_Altar_limit_Conditions))
    call TriggerAddAction(gg_trg_Altar_limit, function Trig_Altar_limit_Actions)
endfunction

function Trig_Altar_limit_Release_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'hhou'
endfunction

function Trig_Altar_limit_Release_Actions takes nothing returns nothing
    call SetPlayerUnitAvailableBJ('hhou', true, GetOwningPlayer(GetTriggerUnit()))
endfunction

function InitTrig_Altar_limit_Release takes nothing returns nothing
    local trigger t=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DEATH)
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_CONSTRUCT_CANCEL)
    call TriggerAddCondition(t, Condition(function Trig_Altar_limit_Release_Conditions))
    call TriggerAddAction(t, function Trig_Altar_limit_Release_Actions)
    set t=null
endfunction

function SoloFootsAltarStockClear takes unit altar returns nothing
    local integer i=1
    loop
        exitwhen i > udg_total_hero_count
        if udg_hero_type[i] != 0 then
            call RemoveUnitFromStock(altar, udg_hero_type[i])
        endif
        set i=i + 1
    endloop
    call RemoveUnitFromStock(altar, 'hPgN')
    call RemoveUnitFromStock(altar, 'hPgN')
endfunction

function SoloFootsAltarStockAddPage takes unit altar,integer page returns nothing
    local integer altarKey=GetHandleId(altar)
    local integer slot=1
    local integer heroIndex
    if SF_HeroCount[GetPlayerId(GetOwningPlayer(altar)) + 1] >= 2 then
        return
    endif
    loop
        exitwhen slot > 11
        set heroIndex=LoadInteger(GST_Hash, altarKey, ( page * 100 ) + slot)
        if heroIndex != 0 then
            call SetPlayerUnitAvailableBJ(udg_hero_type[heroIndex], true, GetOwningPlayer(altar))
            call AddUnitToStockBJ(udg_hero_type[heroIndex], altar, 1, 1)
        endif
        set slot=slot + 1
    endloop
    if page == 1 then
        call AddUnitToStockBJ('hPgN', altar, 1, 1)
    else
        call AddUnitToStockBJ('hPgN', altar, 1, 1)
    endif
endfunction

function SoloFootsAltarStockPick takes unit altar,integer child returns nothing
    local integer altarKey=GetHandleId(altar)
    local integer heroIndex=GetRandomInt(1, udg_total_hero_count)
    local integer checked=0
    loop
        exitwhen checked >= udg_total_hero_count
        if not HaveSavedBoolean(GST_Hash, altarKey, heroIndex) and udg_hero_type[heroIndex] != 0 and not SoloFootsIsNoMuteHeroType(udg_hero_type[heroIndex]) then
            call SaveBoolean(GST_Hash, altarKey, heroIndex, true)
            call SaveInteger(GST_Hash, altarKey, child, heroIndex)
            return
        endif
        set heroIndex=heroIndex + 1
        if heroIndex > udg_total_hero_count then
            set heroIndex=1
        endif
        set checked=checked + 1
    endloop
endfunction

function SoloFootsAltarStockPopulate takes unit altar returns nothing
    local integer altarKey=GetHandleId(altar)
    local integer page=1
    local integer slot
    call SetUnitScale(altar,.85,.85,.85)
    call SetUnitVertexColor(altar,255,255,255,255)
    call ShowUnit(altar,true)
    call UnitAddAbility(altar, 'Asud')
    call UnitRemoveAbility(altar, 'A0H7')
    call UnitRemoveAbility(altar, 'A0EO')
    call UnitRemoveAbility(altar, 'A0GE')
    call UnitRemoveAbility(altar, 'A0EA')
    call UnitRemoveAbility(altar, 'A0EG')
    call UnitRemoveAbility(altar, 'A0GG')
    call SoloFootsAltarStockClear(altar)
    call SaveInteger(GST_Hash, altarKey, 900, 0)
    // Page 1 always contains one Transmute hero and one Healing Wave hero.
    // E00E is the Transmute hero at index 18; N027 is the Healing Wave hero at index 48.
    call SaveBoolean(GST_Hash, altarKey, 18, true)
    call SaveBoolean(GST_Hash, altarKey, 48, true)
    call SaveInteger(GST_Hash, altarKey, 101, 18)
    call SaveInteger(GST_Hash, altarKey, 102, 48)
    loop
        exitwhen page > 2
        if page == 1 then
            set slot=3
        else
            set slot=1
        endif
        loop
            exitwhen slot > 11
            call SoloFootsAltarStockPick(altar , ( page * 100 ) + slot)
            set slot=slot + 1
        endloop
        set page=page + 1
    endloop
    call SaveInteger(GST_Hash, altarKey, 900, 1)
    call SoloFootsAltarStockAddPage(altar , 1)
    call SaveBoolean(GST_Hash, GetHandleId(altar), 902, true)
endfunction

function SoloFootsAltarStockFlipPage takes unit altar returns nothing
    local integer altarKey=GetHandleId(altar)
    local integer page=LoadInteger(GST_Hash, altarKey, 900)
    call SoloFootsAltarStockClear(altar)
    if page == 1 then
        call SoloFootsAltarStockAddPage(altar , 2)
        call SaveInteger(GST_Hash, altarKey, 900, 2)
    else
        call SoloFootsAltarStockAddPage(altar , 1)
        call SaveInteger(GST_Hash, altarKey, 900, 1)
    endif
endfunction

function SoloFootsAltarHeroIndex takes integer heroType returns integer
    local integer i=1
    loop
        exitwhen i > udg_total_hero_count
        if udg_hero_type[i] == heroType then
            return i
        endif
        set i=i + 1
    endloop
    return 0
endfunction

function SoloFootsApplyAltarHeroStats takes unit hero returns nothing
    local integer i=SoloFootsAltarHeroIndex(GetUnitTypeId(hero))
    if i == 0 then
        return
    endif
    call BlzSetUnitIntegerField(hero, UNIT_IF_STRENGTH, R2I(udg_hero_STR_base[i]))
    call BlzSetUnitIntegerField(hero, UNIT_IF_AGILITY, R2I(udg_hero_AGI_base[i]))
    call BlzSetUnitIntegerField(hero, UNIT_IF_INTELLIGENCE, R2I(udg_hero_INT_base[i]))
    call BlzSetUnitRealField(hero, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[i])
    call BlzSetUnitRealField(hero, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[i])
    call BlzSetUnitRealField(hero, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[i])
    call SetUnitMoveSpeed(hero, udg_hero_move_base[i])
    call BlzSetUnitRealField(hero, UNIT_RF_TURN_RATE, udg_hero_turnrate[i])
endfunction

function Trig_altar_hero_stock_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetSellingUnit()) == 'hhou'
endfunction

function Trig_altar_hero_stock_Actions takes nothing returns nothing
    local unit altar=GetSellingUnit()
    local unit sold=GetSoldUnit()
    local player owner=GetOwningPlayer(altar)
    local integer p=GetPlayerId(owner) + 1
    local integer kind=GetUnitTypeId(sold)
    local group g
    local unit u
    if kind == 'hPgN' then
        call RemoveUnit(sold)
        call SoloFootsAltarStockFlipPage(altar)
        call SelectUnitForPlayerSingle(altar, owner)
    elseif SoloFootsAltarHeroIndex(kind) != 0 then
        if SF_HeroCount[p] >= 2 then
            call RemoveUnit(sold)
            call DisplayTextToPlayer(owner, 0., 0., "Maximum two heroes per player.")
        else
            set SF_HeroCount[p]=SF_HeroCount[p] + 1
            call SoloFootsApplyAltarHeroStats(sold)
            call UnitAddItemById(sold, 'stwp')
            call UnitAddItemById(sold, 'I001')
            call DisplayTextToPlayer(owner, 0., 0., "Second hero purchased. Your two-hero limit is reached.")
            set g=CreateGroup()
            call GroupEnumUnitsOfPlayer(g, owner, null)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)
                if GetUnitTypeId(u) == 'hhou' then
                    call SoloFootsAltarStockClear(u)
                endif
            endloop
            call DestroyGroup(g)
        endif
    endif
    set g=null
    set u=null
    set altar=null
    set sold=null
    set owner=null
endfunction

function Trig_altar_hero_stock_Construct_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'hhou'
endfunction

function Trig_altar_hero_stock_Construct_Actions takes nothing returns nothing
    call SoloFootsAltarStockPopulate(GetTriggerUnit())
endfunction

function Trig_altar_hero_stock_ScanEnum takes nothing returns nothing
    local unit altar=GetEnumUnit()
    if not HaveSavedBoolean(GST_Hash, GetHandleId(altar), 902) then
        call SoloFootsAltarStockPopulate(altar)
    endif
    set altar=null
endfunction

function Trig_altar_hero_stock_Scan_Actions takes nothing returns nothing
    local group altars=GetUnitsOfTypeIdAll('hhou')
    call ForGroup(altars, function Trig_altar_hero_stock_ScanEnum)
    call DestroyGroup(altars)
    set altars=null
endfunction

function InitTrig_altar_hero_stock takes nothing returns nothing
    local trigger t=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(t, Condition(function Trig_altar_hero_stock_Construct_Conditions))
    call TriggerAddAction(t, function Trig_altar_hero_stock_Construct_Actions)
    set t=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SELL)
    call TriggerAddCondition(t, Condition(function Trig_altar_hero_stock_Conditions))
    call TriggerAddAction(t, function Trig_altar_hero_stock_Actions)
    set t=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(t, 1.00)
    call TriggerAddAction(t, function Trig_altar_hero_stock_Scan_Actions)
endfunction

