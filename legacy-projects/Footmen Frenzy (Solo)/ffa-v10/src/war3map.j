        call DoNothing()
    endif
endfunction

function SKClearAttack takes nothing returns nothing
    local unit u=GetEnumUnit()
    local integer pn=GetPlayerId(GetOwningPlayer(u))+1
    if GetUnitCurrentOrder(u) == OrderId("attack") or GetUnitCurrentOrder(u) == OrderId("attackground") then
        call IssueImmediateOrder(u, "stop")
        if not IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and udg_autosend[pn] then
            call IssuePointOrder(u, "attack", 0.0, -256.0)
        endif
    endif
    set u=null
endfunction

function SKSync takes nothing returns nothing
    local integer i=1
    local integer j
    local integer pn
    local integer other
    local integer hillOwner
    local boolean allied
    local group g
    local integer visionKey
    loop
        exitwhen i > 8
        call ForceClear(udg_team[i])
        set i=i+1
    endloop
    set i=1
    loop
        exitwhen i > 8
        set pn=S8Player(i)
        if SKActive(pn) then
            call ForceAddPlayer(udg_team[S8Team(SKKing[pn])], Player(pn-1))
        endif
        if SKActive(pn) and udg_autopoolto[pn]>0 then
            if not SKActive(udg_autopoolto[pn]) or SKKing[udg_autopoolto[pn]]!=SKKing[pn] then
                set udg_autopoolto[pn]=0
            endif
        endif
        set j=1
        loop
            exitwhen j > 8
            set other=S8Player(j)
            if pn != other then
                set allied=SKActive(pn) and SKActive(other) and SKKing[pn] == SKKing[other]
                set visionKey=pn*16+other
                if SKBaseVision[visionKey]!=null then
                    call FogModifierStop(SKBaseVision[visionKey])
                    call DestroyFogModifier(SKBaseVision[visionKey])
                    set SKBaseVision[visionKey]=null
                endif
                if allied then
                    set SKBaseVision[visionKey]=CreateFogModifierRadius(Player(pn-1),FOG_OF_WAR_VISIBLE,SF_BaseX[other],SF_BaseY[other],1150.,false,false)
                    call FogModifierStart(SKBaseVision[visionKey])
                endif
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_PASSIVE, allied)
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_HELP_REQUEST, allied)
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_HELP_RESPONSE, allied)
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_SHARED_XP, allied)
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_SHARED_VISION, allied)
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_SHARED_CONTROL, false)
                call SetPlayerAlliance(Player(pn-1), Player(other-1), ALLIANCE_SHARED_ADVANCED_CONTROL, false)
            endif
            set j=j+1
        endloop
        if SKActive(pn) then
            set g=CreateGroup()
            call GroupEnumUnitsOfPlayer(g, Player(pn-1), null)
            call ForGroup(g, function SKClearAttack)
            call DestroyGroup(g)
        endif
        set i=i+1
    endloop
    if udg_mode_koth then
        set hillOwner=GetPlayerId(udg_KOTH_Player)+1
        if SKActive(hillOwner) then
            set udg_KOTH_Team_Number=S8Team(SKKing[hillOwner])
            set udg_KOTH_Team=udg_team[udg_KOTH_Team_Number]
        elseif hillOwner <= 12 then
            call TriggerExecute(gg_trg_KOTH_Set_Neutral_Hill)
            call TriggerExecute(gg_trg_KOTH_Reset_Hill)
        endif
    endif
    set g=null
endfunction

function SF_RestoreFFA takes nothing returns nothing
    local integer p=0
    local integer q
    if SKEnabled then
        call SKSync()
        return
    endif
    loop
        exitwhen p > 11
        set q=0
        loop
            exitwhen q > 11
            if p != q then
                call SetPlayerAllianceStateBJ(Player(p), Player(q), bj_ALLIANCE_UNALLIED)
            endif
            set q=q + 1
        endloop
        set p=p + 1
    endloop
endfunction

function Trig_Start_game_Actions takes nothing returns nothing
    call TriggerExecute(gg_trg_Multiboard_Create_with_KOTH)
    call ConditionalTriggerExecute(gg_trg_MODE_King_Of_The_Hill)
    //                                                                                                     
    call StartTimerBJ(udg_Fortification_Aura_Timer, false, 330.00)
    // COLOSSALS: ON / OFF
    if ( Trig_Start_game_Func006C() ) then
        call EnableTrigger(gg_trg_colossal_variables)
        call ConditionalTriggerExecute(gg_trg_colossal_variables)
        set udg_wmd[2]=( "|cff00ffffColossals:|r |cff00ff00On|r" )
        call StartTimerBJ(udg_timer_colossal, false, udg_t_colossal_initial)
        call CreateTimerDialogBJ(udg_timer_colossal, ( "Colossal Wave #" + ( I2S(udg_colossal_wave) + ( " / " + I2S(udg_colossal_max_wave) ) ) ))
        set udg_timer_window_colossal=GetLastCreatedTimerDialogBJ()
    else
        call DoNothing()
    endif
    //                                                                                                     
    // FLOATING TEXT
    // ADD AUTOSEND ABILITY TO MAIN
    // OBS: Visibility
    set udg_X=13
    loop
        exitwhen udg_X > 24
        set udg_X=udg_X + 1
    endloop
    // MODE: PRIV / PUB
    call TimerDialogDisplayBJ(true, udg_timer_window_colossal)
    // MODE: WONKY MODES
    call StartTimerBJ(udg_timer_upgradedelay, false, 90.00)
    if ( Trig_Start_game_Func016C() ) then
        set udg_startgold=2000
        call TriggerExecute(gg_trg_MODE_777)
    else
        call DoNothing()
    endif
    set udg_temp_unitgroup=GetUnitsOfTypeIdAll('hwtw')
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_game_Func018A)
    // SHARE ALWAYS
    set udg_X=1
    loop
        exitwhen udg_X > 12
        call SetPlayerHandicapReviveTimeBJ(ConvertedPlayer(udg_X), 30.00)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_X), udg_ally1[udg_X], bj_ALLIANCE_ALLIED_UNITS)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_X), udg_ally2[udg_X], bj_ALLIANCE_ALLIED_UNITS)
        set udg_X=udg_X + 1
    endloop
    set udg_temp_unitgroup=GetUnitsOfTypeIdAll('h01G')
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_game_Func022A)
    call ForForce(udg_all_players, function Trig_Start_game_Func023A)
    if ( Trig_Start_game_Func024C() ) then
        call ForForce(GetPlayersAll(), function Trig_Start_game_Func024Func002A)
    else
        call ForForce(GetPlayersAll(), function Trig_Start_game_Func024Func001A)
    endif
    call ForForce(udg_all_players, function Trig_Start_game_Func025A)
    call SF_RestoreFFA()
    // START TIMERS
    call ConditionalTriggerExecute(gg_trg_start_timers)
    // TURN VOTING STUFF, ETC OFF
    call ConditionalTriggerExecute(gg_trg_Destroy_Triggers_1)
    set udg_X=1
    loop
        exitwhen udg_X > 4
        call RemoveLocation(udg_SDtavern[udg_X])
        set udg_X=udg_X + 1
    endloop
    set udg_X=1
    loop
        exitwhen udg_X > 6
        call RemoveLocation(udg_tavern[udg_X])
        set udg_X=udg_X + 1
    endloop
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_Start_game takes nothing returns nothing
    set gg_trg_Start_game=CreateTrigger()
    call TriggerAddAction(gg_trg_Start_game, function Trig_Start_game_Actions)
endfunction

function SoloFootsTavernOwner takes integer teamIndex returns player
    if ( teamIndex == 2 ) then
        return Player(4)
    endif
    if ( teamIndex == 3 ) then
        return Player(7)
    endif
    if ( teamIndex == 4 ) then
        return Player(11)
    endif
    return Player(0)
endfunction

function SoloFootsRemoveTeamTaverns takes integer teamIndex returns nothing
    if ( teamIndex < 1 or teamIndex > 4 ) then
        return
    endif
    if ( udg_real_shop[teamIndex] != null ) then
        call GroupRemoveUnit(udg_realshops, udg_real_shop[teamIndex])
        call RemoveUnit(udg_real_shop[teamIndex])
        set udg_real_shop[teamIndex]=null
    endif
    if ( udg_solo_second_tavern[teamIndex] != null ) then
        call GroupRemoveUnit(udg_realshops, udg_solo_second_tavern[teamIndex])
        call RemoveUnit(udg_solo_second_tavern[teamIndex])
        set udg_solo_second_tavern[teamIndex]=null
    endif
endfunction

function SoloFootsRemoveAllPlayerTaverns takes nothing returns nothing
    local integer teamIndex=1
    loop
        exitwhen teamIndex > 4
        call SoloFootsRemoveTeamTaverns(teamIndex)
        set teamIndex=teamIndex + 1
    endloop
endfunction

function SoloFootsCreateTeamTaverns takes integer teamIndex returns nothing
    local player owner=SoloFootsTavernOwner(teamIndex)
    local real firstX=GetLocationX(udg_SDtavern[teamIndex])
    local real firstY=GetLocationY(udg_SDtavern[teamIndex])
    local real secondX=firstX + 192.00
    local real facing=130.00
    if ( teamIndex == 1 or teamIndex == 4 ) then
        set secondX=firstX - 192.00
    endif
    if ( teamIndex >= 3 ) then
        set facing=310.00
    endif
    call SoloFootsRemoveTeamTaverns(teamIndex)
    set udg_real_shop[teamIndex]=CreateUnit(owner, 'n02I', firstX, firstY, facing)
    set udg_solo_second_tavern[teamIndex]=CreateUnit(owner, 'n02I', secondX, firstY, facing)
    call UnitRemoveAbility(udg_real_shop[teamIndex], 'A05T')
    call UnitRemoveAbility(udg_solo_second_tavern[teamIndex], 'A05T')
    call GroupAddUnit(udg_realshops, udg_real_shop[teamIndex])
    call GroupAddUnit(udg_realshops, udg_solo_second_tavern[teamIndex])
    set owner=null
endfunction

function SoloFootsCreateAllPlayerTaverns takes nothing returns nothing
    local integer teamIndex=1
    loop
        exitwhen teamIndex > 4
        call SoloFootsCreateTeamTaverns(teamIndex)
        set teamIndex=teamIndex + 1
    endloop
endfunction

function SoloFootsIsNoMuteHeroType takes integer heroType returns boolean
    return heroType == 'E01G' or heroType == 'H05E' or heroType == 'H05N'
endfunction

function SoloFootsAddHeroTypeToTavern takes integer heroType,unit shop returns nothing
    if heroType != 0 and shop != null and not SoloFootsIsNoMuteHeroType(heroType) then
        call AddUnitToStockBJ(heroType, shop, 1, 1)
    endif
endfunction

function SoloFootsAddHeroToTavern takes integer heroIndex,unit shop returns nothing
    if heroIndex < 1 or heroIndex > udg_total_hero_count or shop == null then
        return
    endif
    call SoloFootsAddHeroTypeToTavern(udg_hero_type[heroIndex] , shop)
endfunction

function SoloFootsRemoveNoMuteHero takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function SoloFootsDisableNoMuteHeroes takes nothing returns nothing
    local integer playerIndex=0
    local group blocked=null
    loop
        exitwhen playerIndex > 23
        call SetPlayerUnitAvailableBJ('E01G', false, Player(playerIndex))
        call SetPlayerUnitAvailableBJ('H05E', false, Player(playerIndex))
        call SetPlayerUnitAvailableBJ('H05N', false, Player(playerIndex))
        set playerIndex=playerIndex + 1
    endloop
    set blocked=GetUnitsOfTypeIdAll('E01G')
    call ForGroup(blocked, function SoloFootsRemoveNoMuteHero)
    call DestroyGroup(blocked)
    set blocked=GetUnitsOfTypeIdAll('H05E')
    call ForGroup(blocked, function SoloFootsRemoveNoMuteHero)
    call DestroyGroup(blocked)
    set blocked=GetUnitsOfTypeIdAll('H05N')
    call ForGroup(blocked, function SoloFootsRemoveNoMuteHero)
    call DestroyGroup(blocked)
    set blocked=null
endfunction

function SoloFootsTakeTavernHero takes integer teamIndex,integer category returns integer
    local integer checked=0
    local integer heroIndex=GetRandomInt(1, udg_total_hero_count)
    loop
        exitwhen checked >= udg_total_hero_count
        if ( not udg_solo_tavern_hero_used[( teamIndex * 128 ) + heroIndex] and udg_hero_type[heroIndex] != 0 and not SoloFootsIsNoMuteHeroType(udg_hero_type[heroIndex]) ) then
            if ( category == 0 ) then
                if ( udg_hero_category[heroIndex] > 0 and udg_hero_category[heroIndex] <= udg_numberofSDcategories ) then
                    set udg_solo_tavern_hero_used[( teamIndex * 128 ) + heroIndex]=true
                    return heroIndex
                endif
            elseif ( udg_hero_category[heroIndex] == category ) then
                set udg_solo_tavern_hero_used[( teamIndex * 128 ) + heroIndex]=true
                return heroIndex
            endif
        endif
        set heroIndex=heroIndex + 1
        if ( heroIndex > udg_total_hero_count ) then
            set heroIndex=1
        endif
        set checked=checked + 1
    endloop
    return 0
endfunction

function SoloFootsStockTeamTaverns takes integer teamIndex returns nothing
    local integer heroIndex=1
    local integer page=1
    local integer category
    local integer stocked
    local unit shop
    loop
        exitwhen heroIndex > udg_total_hero_count
        set udg_solo_tavern_hero_used[( teamIndex * 128 ) + heroIndex]=false
        set heroIndex=heroIndex + 1
    endloop
    loop
        exitwhen page > 2
        if ( page == 1 ) then
            set shop=udg_real_shop[teamIndex]
        else
            set shop=udg_solo_second_tavern[teamIndex]
        endif
        set stocked=0
        set category=1
        loop
            exitwhen category > udg_numberofSDcategories
            set heroIndex=SoloFootsTakeTavernHero(teamIndex , category)
            if ( heroIndex != 0 ) then
                call SoloFootsAddHeroToTavern(heroIndex , shop)
                set stocked=stocked + 1
            endif
            set category=category + 1
        endloop
        loop
            exitwhen stocked >= 12
            set heroIndex=SoloFootsTakeTavernHero(teamIndex , 0)
            exitwhen heroIndex == 0
            call SoloFootsAddHeroToTavern(heroIndex , shop)
            set stocked=stocked + 1
        endloop
        set page=page + 1
    endloop
    set shop=null
endfunction

function SoloFootsStockAllPlayerTaverns takes nothing returns nothing
    local integer teamIndex=1
    loop
        exitwhen teamIndex > 4
        call SoloFootsStockTeamTaverns(teamIndex)
        set teamIndex=teamIndex + 1
    endloop
endfunction

