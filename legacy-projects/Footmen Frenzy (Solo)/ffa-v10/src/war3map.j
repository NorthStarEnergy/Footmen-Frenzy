function Trig_KICK_command_Conditions takes nothing returns boolean
    if ( not ( udg_New_Kick_Is_Active == false ) ) then
        return false
    endif
    if ( not ( udg_admin_level[GetConvertedPlayerId(GetTriggerPlayer())] >= 100 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_command_Func007Func001C takes nothing returns boolean
    if ( not ( udg_player_active[udg_X] == true ) ) then
        return false
    endif
    if ( not ( ConvertedPlayer(udg_X) != udg_New_Kick_Decider ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_command_Func009Func001C takes nothing returns boolean
    if ( not ( udg_New_Kick_Int[0] > 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_command_Func009C takes nothing returns boolean
    if ( not ( udg_New_Kick_Int[0] > 16 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_command_Actions takes nothing returns nothing
    set udg_New_Kick_Decider=GetTriggerPlayer()
    set udg_New_Kick_Is_Active=true
    set udg_New_Kick_Current_Page=1
    //                                                                                                                                         
    // Determine total number of pages ahead of time:
    set udg_New_Kick_Int[0]=0
    set udg_X=1
    loop
        exitwhen udg_X > 24
        if ( Trig_KICK_command_Func007Func001C() ) then
            set udg_New_Kick_Int[0]=( udg_New_Kick_Int[0] + 1 )
        else
        endif
        set udg_X=udg_X + 1
    endloop
    //                                                                                                                                         
    if ( Trig_KICK_command_Func009C() ) then
        set udg_New_Kick_Total_Pages=3
    else
        if ( Trig_KICK_command_Func009Func001C() ) then
            set udg_New_Kick_Total_Pages=2
        else
            set udg_New_Kick_Total_Pages=1
        endif
    endif
    //                                                                                                                                         
    call TriggerExecute(gg_trg_KICK_rebuild_dialog)
endfunction

