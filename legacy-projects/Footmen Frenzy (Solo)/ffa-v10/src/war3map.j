    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Summon_Brewer_Stats, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddCondition(gg_trg_HERO_Summon_Brewer_Stats, Condition(function Trig_HERO_Summon_Brewer_Stats_Conditions))
