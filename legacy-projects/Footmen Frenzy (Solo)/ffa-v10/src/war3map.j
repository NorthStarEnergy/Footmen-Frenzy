function Trig_ITEM_packhorse_buy_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_unit=GetBuyingUnit()
    set udg_temp_item=GetSoldItem()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    // Tome of Power
    if ( Trig_ITEM_packhorse_buy_Func007C() ) then
        call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_temp_unit)), "TRIGSTR_11286")
        call RemoveItem(udg_temp_item)
        call CreateItemLoc('tkno', udg_temp_point_caster)
    else
        call DoNothing()
    endif
    // Staff of Teleportation
    if ( Trig_ITEM_packhorse_buy_Func009C() ) then
        call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_temp_unit)), "TRIGSTR_10346")
        call RemoveItem(udg_temp_item)
        call CreateItemLoc('stel', udg_temp_point_caster)
    else
        call DoNothing()
    endif
    // Tome of Greater XP
    if ( Trig_ITEM_packhorse_buy_Func011C() ) then
        call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_temp_unit)), "TRIGSTR_708")
        call RemoveItem(udg_temp_item)
        call CreateItemLoc('tgxp', udg_temp_point_caster)
    else
        call DoNothing()
    endif
    if ( Trig_ITEM_packhorse_buy_Func012C() ) then
        call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_temp_unit)), "TRIGSTR_776")
        call RemoveItem(udg_temp_item)
    else
        call DoNothing()
    endif
    call RemoveLocation(udg_temp_point_caster)
endfunction

