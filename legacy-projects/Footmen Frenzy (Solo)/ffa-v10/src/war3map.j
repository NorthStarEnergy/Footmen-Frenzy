    if ( not ( udg_HCr_Elapsed_Time[udg_HCr_CV] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func001C takes nothing returns boolean
    if ( ( udg_HCr_Elapsed_Time[udg_HCr_CV] >= udg_HCr_Duration[udg_HCr_CV] ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_HCr_Caster) == false ) ) then
        return true
    endif
    return false
endfunction

