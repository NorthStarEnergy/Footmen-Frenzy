function F8_SpawnColo takes integer entry,real x,real y returns nothing
    set udg_X_colo=entry
    set udg_spawned_colo=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),udg_colossal_unit_type[udg_colossal_unit_id[entry]],x,y,Atan2(-256.-y,-x)*bj_RADTODEG)
    set udg_colossal_aggro_range=300.
    // calculate actual
    set udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
    set udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
    set udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
    // set
    call BlzSetUnitMaxHP(udg_spawned_colo, R2I(udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]))
    call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_HP, I2R(BlzGetUnitMaxHP(udg_spawned_colo)))
    call BlzSetUnitMaxMana(udg_spawned_colo, udg_colossal_unit_mp_base[udg_colossal_unit_id[udg_X_colo]])
    call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_MANA, I2R(BlzGetUnitMaxMana(udg_spawned_colo)))
    call BlzSetUnitBaseDamage(udg_spawned_colo, R2I(udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]), 0)
    call BlzSetUnitArmor(udg_spawned_colo, udg_colossal_unit_armor[udg_colossal_unit_id[udg_X_colo]])
    call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]))
    call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_ACQUISITION_RANGE, udg_colossal_aggro_range)
    call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_LEVEL, udg_colossal_unit_level[udg_colossal_unit_id[udg_X_colo]])
    call SetUnitState(udg_spawned_colo,UNIT_STATE_LIFE,I2R(BlzGetUnitMaxHP(udg_spawned_colo)))
endfunction

function Trig_colossal_spawn_Actions takes nothing returns nothing
local integer k=0
    local integer p
    local integer entry
    local integer n
    local integer offset
    local integer camp
    local integer big=1
    local real a
    local real x
    local real y
    call DestroyTimerDialogBJ(udg_timer_window_colossal)
    if ModuloInteger(udg_colossal_wave,2)==0 then
        set big=2
    endif
    loop
        exitwhen k>=4
        set a=I2R(k)*bj_PI/2.+bj_PI/4.
        call F8_SpawnColo(big,480.*Cos(a),-256.+480.*Sin(a))
        set k=k+1
    endloop
    set k=1
    loop
        exitwhen k>8
        set p=F8_Slot[k]+1
        if udg_player_active[p] then
            set a=SF_Angle[p]
            set entry=3
            set offset=0
            set camp=0
            loop
                exitwhen entry>22
                if ModuloInteger(udg_colossal_unit_id[entry]-udg_colossal_wave_id,10)==0 and udg_colossal_wave>=udg_colossal_min_wave[entry] then
                    set n=0
                    loop
                        exitwhen n>=udg_colossal_number_of_units[entry]
                        set x=(3080.+I2R(offset/3)*112.)*Cos(a)-I2R(ModuloInteger(offset,3)-1)*112.*Sin(a)
                        set y=-256.+(3080.+I2R(offset/3)*112.)*Sin(a)+I2R(ModuloInteger(offset,3)-1)*112.*Cos(a)
                        call F8_SpawnColo(entry,x,y)
                        set offset=offset+1
                        set n=n+1
                    endloop
                    call F8_SpawnColo(entry,2358.000*Cos(a)-I2R(camp)*160.*Sin(a),-256.+2358.000*Sin(a)+I2R(camp)*160.*Cos(a))
                    set camp=camp+1
                endif
                set entry=entry+1
            endloop
        endif
        set k=k+1
    endloop
    // start new timer
    if ( Trig_colossal_spawn_Func028C() ) then
        set udg_colossal_wave=( udg_colossal_wave + 1 )
        set udg_colossal_wave_id=( udg_colossal_wave_id + 1 )
        if ( Trig_colossal_spawn_Func028Func005C() ) then
            set udg_colossal_wave_id=1
        else
            call DoNothing()
        endif
        call StartTimerBJ(udg_timer_colossal, false, udg_t_colossal_reoccuring)
        call CreateTimerDialogBJ(udg_timer_colossal, ( "Colossal Wave #" + ( I2S(udg_colossal_wave) + ( " / " + I2S(udg_colossal_max_wave) ) ) ))
        set udg_timer_window_colossal=GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ(true, udg_timer_window_colossal)
    else
        call DoNothing()
    endif
endfunction

