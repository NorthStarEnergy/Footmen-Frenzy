function Trig_Avalanche_Craggy_Exterior_Stun_Actions takes nothing returns nothing
    if ( Trig_Avalanche_Craggy_Exterior_Stun_Func001C() ) then
        set udg_Avalanche=GetTriggerUnit()
        set udg_Avalanche_CE_Attacker=GetAttacker()
        //                                                                                                                    
        // Display the total number of Seismic Fury stacks:
        if ( Trig_Avalanche_Craggy_Exterior_Stun_Func001Func005C() ) then
            call ConditionalTriggerExecute(gg_trg_Avalanche_Seismic_Fury_Floating_Text)
        else
        endif
        //                                                                                                          
        if ( Trig_Avalanche_Craggy_Exterior_Stun_Func001Func007C() ) then
            // [MELEE ATTACKER] - No need for a distance check (more efficient):
            set udg_Avalanche_CE_Point[1]=GetUnitLoc(udg_Avalanche)
            set udg_Avalanche_CE_Level=GetUnitAbilityLevelSwapped('ACRA', udg_Avalanche)
            //                                                                                                          
            call UnitDamageTargetBJ(udg_Avalanche, udg_Avalanche_CE_Attacker, ( 30.00 * I2R(udg_Avalanche_CE_Level) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
            //                                                                                                          
            // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
            // SEISMIC FURY (ULTIMATE):
            set udg_Avalanche_CV=GetUnitUserData(udg_Avalanche)
            if ( Trig_Avalanche_Craggy_Exterior_Stun_Func001Func007Func011C() ) then
                set udg_Avalanche_SF_Stacks[udg_Avalanche_CV]=( udg_Avalanche_SF_Stacks[udg_Avalanche_CV] + 1 )
                call SetUnitVertexColorBJ(udg_Avalanche, 100, ( 100.00 - ( I2R(udg_Avalanche_SF_Stacks[udg_Avalanche_CV]) * 0.50 ) ), ( 100.00 - ( I2R(udg_Avalanche_SF_Stacks[udg_Avalanche_CV]) * 0.50 ) ), 0)
                //                                                                                                          
                if ( Trig_Avalanche_Craggy_Exterior_Stun_Func001Func007Func011Func004C() ) then
                    call TriggerExecute(gg_trg_Avalanche_Seismic_Fury_Enable)
                else
                endif
            else
            endif
            // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
            //                                                                                                          
            // Stun Dummy:
            call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Avalanche), udg_Avalanche_CE_Point[1], bj_UNIT_FACING)
            set udg_Avalanche_CE_Dummy=GetLastCreatedUnit()
            call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_Avalanche_CE_Dummy)
            call UnitAddAbilityBJ('ACRE', udg_Avalanche_CE_Dummy)
            call SetUnitAbilityLevelSwapped('ACRE', udg_Avalanche_CE_Dummy, udg_Avalanche_CE_Level)
            //                                                                                                          
            call IssueTargetOrderBJ(udg_Avalanche_CE_Dummy, "thunderbolt", udg_Avalanche_CE_Attacker)
            //                                                                                                          
            call RemoveLocation(udg_Avalanche_CE_Point[1])
        else
            // [RANGED ATTACKER] - Check distance!
            set udg_Avalanche_CE_Point[0]=GetUnitLoc(udg_Avalanche)
            set udg_Avalanche_CE_Point[1]=GetUnitLoc(udg_Avalanche_CE_Attacker)
            //                                                                                                          
            if ( Trig_Avalanche_Craggy_Exterior_Stun_Func001Func007Func027C() ) then
            else
                set udg_Avalanche_CE_Level=GetUnitAbilityLevelSwapped('ACRA', udg_Avalanche)
                //                                                                                                          
                call UnitDamageTargetBJ(udg_Avalanche, udg_Avalanche_CE_Attacker, ( 15.00 * I2R(udg_Avalanche_CE_Level) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
                //                                                                                                          
                call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Avalanche), udg_Avalanche_CE_Point[1], bj_UNIT_FACING)
                set udg_Avalanche_CE_Dummy=GetLastCreatedUnit()
                call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_Avalanche_CE_Dummy)
                call UnitAddAbilityBJ('ACRE', udg_Avalanche_CE_Dummy)
                call SetUnitAbilityLevelSwapped('ACRE', udg_Avalanche_CE_Dummy, udg_Avalanche_CE_Level)
                //                                                                                                          
                call IssueTargetOrderBJ(udg_Avalanche_CE_Dummy, "thunderbolt", udg_Avalanche_CE_Attacker)
            endif
            //                                                                                                          
            call RemoveLocation(udg_Avalanche_CE_Point[0])
            call RemoveLocation(udg_Avalanche_CE_Point[1])
        endif
    else
    endif
endfunction

