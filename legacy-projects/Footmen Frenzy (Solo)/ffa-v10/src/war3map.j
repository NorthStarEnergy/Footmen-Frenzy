function InitTrig_set_hero_stats takes nothing returns nothing
    set gg_trg_set_hero_stats=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_set_hero_stats, 1.00)
    call TriggerAddAction(gg_trg_set_hero_stats, function Trig_set_hero_stats_Actions)
endfunction

function Trig_admin_level_Conditions takes nothing returns boolean
    return true
endfunction

function Trig_admin_level_Func002Func002Func002C takes nothing returns boolean
    if ( ( udg_orig_player_name[udg_X] == "SpeedyIke#1560" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "chobo#1546" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "strOnglifter#1120" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "chieftanlust#1583" ) ) then
        return true
    endif
    return false
endfunction

function Trig_admin_level_Func002Func002C takes nothing returns boolean
    if ( not Trig_admin_level_Func002Func002Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_admin_level_Func002Func004Func002C takes nothing returns boolean
    if ( ( udg_orig_player_name[udg_X] == "RJE#11113" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "OHNOES#11901" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "ohnoes#11259" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "ixo#11451" ) ) then
        return true
    endif
    if ( ( udg_orig_player_name[udg_X] == "kookslam#1387" ) ) then
        return true
    endif
    return false
endfunction

function Trig_admin_level_Func002Func004C takes nothing returns boolean
    if ( not Trig_admin_level_Func002Func004Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_admin_level_Func002Func005C takes nothing returns boolean
    if ( not ( udg_orig_player_name[udg_X] == "RJE#11113" ) ) then
        return false
    endif
    if ( not ( udg_orig_player_name[udg_X] == "Toxin#11623" ) ) then
        return false
    endif
    return true
endfunction

function Trig_admin_level_Func002Func007C takes nothing returns boolean
    if ( not ( udg_admin_level[udg_X] >= 90 ) ) then
        return false
    endif
    return true
endfunction

function Trig_admin_level_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        // 20 = Wonky Mode Premium Subscriber
        if ( Trig_admin_level_Func002Func002C() ) then
            set udg_admin_level[udg_X]=20
        else
            call DoNothing()
        endif
        // 101
        if ( Trig_admin_level_Func002Func004C() ) then
            set udg_admin_level[udg_X]=101
        else
            call DoNothing()
        endif
        if ( Trig_admin_level_Func002Func005C() ) then
            set udg_admin_level[udg_X]=105
        else
            call DoNothing()
        endif
        // Turn on Triggers based on level
        if ( Trig_admin_level_Func002Func007C() ) then
            call EnableTrigger(gg_trg_summon_hero_for_player)
            call EnableTrigger(gg_trg_debugmode)
            call EnableTrigger(gg_trg_spawn_killa)
            call EnableTrigger(gg_trg_reveal)
            call EnableTrigger(gg_trg_fog)
            call EnableTrigger(gg_trg_summon_hero_for_player)
            call EnableTrigger(gg_trg_debugmode)
            call EnableTrigger(gg_trg_debug)
            call EnableTrigger(gg_trg_test_message)
            call EnableTrigger(gg_trg_status)
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_admin_level takes nothing returns nothing
    set gg_trg_admin_level=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_admin_level, 0.09)
    call TriggerAddCondition(gg_trg_admin_level, Condition(function Trig_admin_level_Conditions))
    call TriggerAddAction(gg_trg_admin_level, function Trig_admin_level_Actions)
endfunction

function Trig_playernameandtag_Conditions takes nothing returns boolean
    return true
endfunction

function Trig_playernameandtag_Func003Func002Func002C takes nothing returns boolean
    if ( not ( udg_temp_string == "#" ) ) then
        return false
    endif
    return true
endfunction

function Trig_playernameandtag_Func003Func002Func003C takes nothing returns boolean
    if ( not ( udg_temp_string == "" ) ) then
        return false
    endif
    return true
endfunction

function Trig_playernameandtag_Actions takes nothing returns nothing
    set udg_temp_playernumber=1
    loop
        exitwhen udg_temp_playernumber > 12
        set udg_name_length=50
        set udg_X=1
        loop
            exitwhen udg_X > udg_name_length
            set udg_temp_string=SubStringBJ(udg_orig_player_name[udg_temp_playernumber], udg_X, udg_X)
            if ( Trig_playernameandtag_Func003Func002Func002C() ) then
                set udg_hashtag_position[udg_temp_playernumber]=udg_X
            else
                call DoNothing()
            endif
            if ( Trig_playernameandtag_Func003Func002Func003C() ) then
                set udg_player_name_length[udg_temp_playernumber]=( udg_X - 1 )
                set udg_X=49
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
        set udg_playername[udg_temp_playernumber]=SubStringBJ(udg_orig_player_name[udg_temp_playernumber], 1, ( udg_hashtag_position[udg_temp_playernumber] - 1 ))
        set udg_battletag[udg_temp_playernumber]=S2I(SubStringBJ(udg_orig_player_name[udg_temp_playernumber], ( udg_hashtag_position[udg_temp_playernumber] + 1 ), udg_player_name_length[udg_temp_playernumber]))
        set udg_temp_playernumber=udg_temp_playernumber + 1
    endloop
endfunction

