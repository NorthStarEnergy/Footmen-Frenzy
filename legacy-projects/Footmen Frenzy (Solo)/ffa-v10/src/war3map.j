    if ( not ( GetTriggerUnit() == udg_fake_shop[udg_X] ) ) then
        return false
    endif
    return true
endfunction

function Trig_MH_shop_redirect_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 23
        if ( Trig_MH_shop_redirect_Func001Func001C() ) then
            call ClearSelectionForPlayer(GetTriggerPlayer())
            call SelectUnitForPlayerSingle(udg_real_shop[udg_X], GetTriggerPlayer())
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

