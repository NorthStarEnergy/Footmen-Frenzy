        return false
    endif
    return true
endfunction

function Trig_KICK_rebuild_dialog_Func009Func001C takes nothing returns boolean
    if ( not ( udg_player_active[udg_X] == true ) ) then
        return false
    endif
    if ( not ( ConvertedPlayer(udg_X) != udg_New_Kick_Decider ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_rebuild_dialog_Func012C takes nothing returns boolean
    if ( not ( udg_New_Kick_Total_Pages > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KICK_rebuild_dialog_Actions takes nothing returns nothing
    call DialogClearBJ(udg_New_Kick_Dialog)
    call DialogSetMessageBJ(udg_New_Kick_Dialog, "TRIGSTR_12323")
    //                                                                                                                                         
    // Page 1: Players 1 - 8  ||  Page 2: Players 9 - 16  ||  Page 3: Players 17 - 24.
    set udg_New_Kick_Int[1]=( - 7 + ( 8 * udg_New_Kick_Current_Page ) )
    set udg_New_Kick_Int[2]=( 8 * udg_New_Kick_Current_Page )
    //                                                                                                                                         
    // Create buttons for the players on the current page:
    set udg_X=udg_New_Kick_Int[1]
    loop
        exitwhen udg_X > udg_New_Kick_Int[2]
        if ( Trig_KICK_rebuild_dialog_Func009Func001C() ) then
            // Create button for player:
            if ( Trig_KICK_rebuild_dialog_Func009Func001Func002C() ) then
                call DialogAddButtonBJ(udg_New_Kick_Dialog, GetPlayerName(ConvertedPlayer(udg_X)))
            else
                // Muting a player changes their name so let's account for that here!
                call DialogAddButtonBJ(udg_New_Kick_Dialog, udg_Mute_Player_Original_Name[udg_X])
            endif
            set udg_New_Kick_Dialog_Buttons[udg_X]=GetLastCreatedButtonBJ()
        else
        endif
        set udg_X=udg_X + 1
    endloop
    //                                                                                                                                         
    // Only create next/prev page buttons if there's more than 1 page:
    if ( Trig_KICK_rebuild_dialog_Func012C() ) then
        call DialogAddButtonBJ(udg_New_Kick_Dialog, "TRIGSTR_13168")
        set udg_New_Kick_Dialog_Next_Button=GetLastCreatedButtonBJ()
        //                                                                                                                                         
        call DialogAddButtonBJ(udg_New_Kick_Dialog, "TRIGSTR_13169")
        set udg_New_Kick_Dialog_Prev_Button=GetLastCreatedButtonBJ()
    else
    endif
    //                                                                                                                                         
    call DialogAddButtonBJ(udg_New_Kick_Dialog, "TRIGSTR_12670")
    set udg_New_Kick_Dialog_Cancel_Button=GetLastCreatedButtonBJ()
    //                                                                                                                                         
    // Show the dialog to the person who started the vote kick:
    call DialogDisplayBJ(true, udg_New_Kick_Dialog, udg_New_Kick_Decider)
endfunction

