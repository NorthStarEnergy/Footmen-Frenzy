function Trig_Hammer_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_MissileHitUnit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitVisible(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_OnHit_Func015Func003C takes nothing returns boolean
    if ( not ( udg_MissileTravelled > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_OnHit_Func015Func005C takes nothing returns boolean
    if ( not ( udg_MissileTravelled > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_OnHit_Func015C takes nothing returns boolean
    if ( not ( udg_MissileData > 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_OnHit_Func018Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_NS_Target, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_NS_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_NS_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_NS_Target, UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_NS_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_NS_Target) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_OnHit_Func018A takes nothing returns nothing
    set udg_NS_Target=GetEnumUnit()
    if ( Trig_Hammer_OnHit_Func018Func002C() ) then
        call UnitDamageTargetBJ(udg_MissileSource, udg_NS_Target, udg_NS_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_NS_Dummy, "thunderbolt", udg_NS_Target)
    else
    endif
endfunction

function Trig_Hammer_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    //                                                                                                     
    call AddSpecialEffectLocBJ(udg_MissilePosition, "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    call CreateNUnitsAtLoc(1, 'dmmy', udg_MissileOwner, udg_MissilePosition, bj_UNIT_FACING)
    set udg_NS_Dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('AHAS', udg_NS_Dummy)
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_NS_Dummy)
    call SetUnitAbilityLevelSwapped('AHAS', udg_NS_Dummy, GetUnitAbilityLevelSwapped('ANSP', udg_MissileSource))
    //                                                                                                     
    // Deals base damage + (0% to 150%) bonus damage based on distance traveled:
    //                                                                                                     
    // Check if the ulti has empowered this hammer:
    if ( Trig_Hammer_OnHit_Func015C() ) then
        // MissileData when empowered by Ulti is equal to Hammer Level + 6 (so at least 7)
        set udg_NS_Damage[0]=udg_NS_Damage[( udg_MissileData - 6 )]
        if ( Trig_Hammer_OnHit_Func015Func005C() ) then
            set udg_NS_Damage[0]=( udg_NS_Damage[0] * ( 1 + ( udg_MissileTravelled / 1200.00 ) ) )
        else
        endif
        set udg_NS_Damage[0]=( udg_NS_Damage[0] + ( udg_HU_Damage_Per_Lvl[GetUnitAbilityLevelSwapped('AHAM', udg_MissileSource)] + 0.00 ) )
    else
        set udg_NS_Damage[0]=udg_NS_Damage[udg_MissileData]
        if ( Trig_Hammer_OnHit_Func015Func003C() ) then
            set udg_NS_Damage[0]=( udg_NS_Damage[0] * ( 1 + ( udg_MissileTravelled / 1200.00 ) ) )
        else
        endif
    endif
    //                                                                                                     
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(110.00, udg_MissilePosition), function Trig_Hammer_OnHit_Func018A)
endfunction

function InitTrig_Hammer_OnHit takes nothing returns nothing
    set gg_trg_Hammer_OnHit=CreateTrigger()
    call TriggerAddCondition(gg_trg_Hammer_OnHit, Condition(function Trig_Hammer_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Hammer_OnHit, function Trig_Hammer_OnHit_Actions)
endfunction

function Trig_Hammer_Ulti_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AHAM' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hammer_Ulti_Cast_Actions takes nothing returns nothing
    // ==================================================
    // DEFINE THE BONUS DAMAGE PER LEVEL:
    set udg_HU_Damage_Per_Lvl[1]=450.00
    set udg_HU_Damage_Per_Lvl[2]=750.00
    set udg_HU_Damage_Per_Lvl[3]=1200.00
    // ==================================================
    //                                                                                                     
    set udg_HU_Hero=GetTriggerUnit()
    set udg_HU_CV=GetUnitUserData(udg_HU_Hero)
    //                                                                                                     
    // Set the Duration in seconds:
    set udg_HU_Duration[udg_HU_CV]=25
    //                                                                                                     
    // RESET CD:
    call BlzStartUnitAbilityCooldown(udg_HU_Hero, 'ANSP', 0.10)
    call BlzStartUnitAbilityCooldown(udg_HU_Hero, 'A0QF', 0.10)
    //                                                                                                     
    call UnitAddAbilityBJ('AHUL', udg_HU_Hero)
    call GroupAddUnitSimple(udg_HU_Hero, udg_HU_Group)
    set udg_HU_Duration[udg_HU_CV]=( udg_HU_Duration[udg_HU_CV] * 4 )
    call EnableTrigger(gg_trg_Hammer_Ulti_Loop)
endfunction

function InitTrig_Hammer_Ulti_Cast takes nothing returns nothing
    set gg_trg_Hammer_Ulti_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Hammer_Ulti_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Hammer_Ulti_Cast, Condition(function Trig_Hammer_Ulti_Cast_Conditions))
    call TriggerAddAction(gg_trg_Hammer_Ulti_Cast, function Trig_Hammer_Ulti_Cast_Actions)
endfunction

