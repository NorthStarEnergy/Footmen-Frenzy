endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func002Func004C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Avalanche_SF_Caster_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Seismic_Fury_Loop_Func002Func004Func005Func009Func005Func002C takes nothing returns boolean
    if ( not ( udg_Avalanche_SF_Duration[udg_Avalanche_CV] == 80 ) ) then
