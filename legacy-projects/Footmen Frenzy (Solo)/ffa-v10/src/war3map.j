    //                                                                                                     
    // Update the second hill gold:
    set udg_KOTH_Level=5
    set udg_KOTH_HP=1750
    set udg_KOTH_Gold_Starting_Total=99999
    set udg_KOTH_Gold_Remaining=udg_KOTH_Gold_Starting_Total
    set udg_KOTH_Gold_Half_Remaining=( udg_KOTH_Gold_Starting_Total / 2 )
    set udg_KOTH_Gold_Division_Bonus=1
    set udg_KOTH_Gold_Bounty=60
    set udg_KOTH_Gold_Rewarded=18
