function Trig_SovietSniper_Decoy_Bomb_Loop_Func002A takes nothing returns nothing
    set udg_SovietSniper_Unit[0]=GetEnumUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper_Unit[0])
    //                                                                                                          
    // Taunt nearby enemies:
    if ( Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005C() ) then
        // Four taunts (level 3+):
        if ( Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005Func003C() ) then
            set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper_Unit[0])
            set udg_SovietSniper_Group[0]=GetUnitsInRangeOfLocAll(250.00, udg_SovietSniper_Point[0])
            //                                                                                                          
            // Taunt special effect:
            call AddSpecialEffectLocBJ(udg_SovietSniper_Point[0], "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                          
            call RemoveLocation(udg_SovietSniper_Point[0])
            //                                                                                                          
            call ForGroupBJ(udg_SovietSniper_Group[0], function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005Func003Func012A)
            //                                                                                                          
            call DestroyGroup(udg_SovietSniper_Group[0])
        else
        endif
    else
    endif
    //                                                                                                          
    set udg_SovietSniper_DB_Duration[udg_SovietSniper_CV]=( udg_SovietSniper_DB_Duration[udg_SovietSniper_CV] + 1 )
    //                                                                                                          
    if ( Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func009C() ) then
        set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper_Unit[0])
        set udg_SovietSniper_Group[0]=GetUnitsInRangeOfLocAll(250.00, udg_SovietSniper_Point[0])
        //                                                                                                          
        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[0], "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        //                                                                                                          
        set udg_SovietSniper_Integer[0]=GetUnitAbilityLevelSwapped('ADEC', udg_SovietSniper_DB_Hero[udg_SovietSniper_CV])
        set udg_SovietSniper_Real[0]=udg_SovietSniper_DB_Damage[udg_SovietSniper_CV]
        //                                                                                                          
        // Dummy Stun:
        call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_SovietSniper_Unit[0]), udg_SovietSniper_Point[0], bj_UNIT_FACING)
        set udg_SovietSniper_Unit[1]=GetLastCreatedUnit()
        call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_SovietSniper_Unit[1])
        call UnitAddAbilityBJ('A0IS', udg_SovietSniper_Unit[1])
        call SetUnitAbilityLevelSwapped('A0IS', udg_SovietSniper_Unit[1], udg_SovietSniper_Integer[0])
        call IssueImmediateOrderBJ(udg_SovietSniper_Unit[1], "stomp")
        //                                                                                                          
        call RemoveLocation(udg_SovietSniper_Point[0])
        //                                                                                                          
        // Deal damage!
        call ForGroupBJ(udg_SovietSniper_Group[0], function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func009Func021A)
        call DestroyGroup(udg_SovietSniper_Group[0])
        //                                                                                                          
        call GroupRemoveUnitSimple(udg_SovietSniper_Unit[0], udg_SovietSniper_DB_Bomb_Group)
        call RemoveUnit(udg_SovietSniper_Unit[0])
        if ( Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func009Func027C() ) then
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    else
    endif
endfunction

function Trig_SovietSniper_Decoy_Bomb_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_SovietSniper_DB_Bomb_Group, function Trig_SovietSniper_Decoy_Bomb_Loop_Func002A)
endfunction

