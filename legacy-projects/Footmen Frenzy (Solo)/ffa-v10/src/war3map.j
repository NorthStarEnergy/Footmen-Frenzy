    if ( not ( GetSpellAbilityId() == 'A0DA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Interchange_Actions takes nothing returns nothing
    local lightning l
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_casting_hero[udg_temp_playernumber]=GetSpellAbilityUnit()
    set udg_temp_unit=GetSpellTargetUnit()
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_point_caster=GetUnitLoc(udg_casting_hero[udg_temp_playernumber])
    //                                                                                         
    call AddLightningLoc("CHIM", udg_temp_point, udg_temp_point_caster)
    set l=bj_lastCreatedLightning
    //                                                                                         
    call PlaySoundOnUnitBJ(gg_snd_SoulPreservation, 90.00, udg_temp_unit)
    call SetUnitPositionLoc(udg_casting_hero[udg_temp_playernumber], udg_temp_point)
    call SetUnitPositionLoc(udg_temp_unit, udg_temp_point_caster)
    call StartTimerBJ(udg_timer_interchange[udg_temp_playernumber], false, 60.00)
    call BlzStartUnitAbilityCooldown(udg_casting_hero[udg_temp_playernumber], 'A0DA', TimerGetRemaining(udg_timer_interchange[udg_temp_playernumber]))
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
    call PolledWait(1.00)
    call DestroyLightning(l)
    set l=null
endfunction

function InitTrig_ITEM_Interchange takes nothing returns nothing
    set gg_trg_ITEM_Interchange=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_Interchange, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ITEM_Interchange, Condition(function Trig_ITEM_Interchange_Conditions))
    call TriggerAddAction(gg_trg_ITEM_Interchange, function Trig_ITEM_Interchange_Actions)
