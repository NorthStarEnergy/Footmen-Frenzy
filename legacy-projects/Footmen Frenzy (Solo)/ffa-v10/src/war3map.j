endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func006Func003A takes nothing returns nothing
    set udg_MadWizard_Bomb_Counter[udg_MadWizard_CV]=( udg_MadWizard_Bomb_Counter[udg_MadWizard_CV] + 1 )
    set udg_MadWizard_Bomb_Counter[GetUnitUserData(GetEnumUnit())]=udg_MadWizard_Bomb_Counter[udg_MadWizard_CV]
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func006C takes nothing returns boolean
    if ( not ( udg_MadWizard_Bomb_Counter[udg_MadWizard_CV] >= 1000000000 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func023002002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h01O' )
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func023002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func023002002 takes nothing returns boolean
    return GetBooleanAnd(Trig_HERO_Mad_Wizard_Bomb_plant_Func023002002001(), Trig_HERO_Mad_Wizard_Bomb_plant_Func023002002002())
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func025Func002Func001C takes nothing returns boolean
    if ( not ( udg_MadWizard_Bomb_Counter[GetUnitUserData(GetEnumUnit())] < udg_MadWizard_Bomb_Counter[0] ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func025Func002A takes nothing returns nothing
    if ( Trig_HERO_Mad_Wizard_Bomb_plant_Func025Func002Func001C() ) then
        set udg_MadWizard_Bomb_Counter[0]=udg_MadWizard_Bomb_Counter[GetUnitUserData(GetEnumUnit())]
        set udg_MadWizard_Bomb=GetEnumUnit()
    else
    endif
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Func025C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_MadWizard_Group) >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Mad_Wizard_Bomb_plant_Actions takes nothing returns nothing
    set udg_MadWizard=GetTriggerUnit()
    set udg_MadWizard_CV=GetUnitUserData(udg_MadWizard)
    set udg_MadWizard_Player=GetOwningPlayer(udg_MadWizard)
    //                                                                                                         
    set udg_MadWizard_Bomb_Counter[udg_MadWizard_CV]=( udg_MadWizard_Bomb_Counter[udg_MadWizard_CV] + 1 )
    if ( Trig_HERO_Mad_Wizard_Bomb_plant_Func006C() ) then
        set udg_MadWizard_Bomb_Counter[udg_MadWizard_CV]=0
        set udg_MadWizard_Group=GetUnitsOfPlayerMatching(udg_MadWizard_Player, Condition(function Trig_HERO_Mad_Wizard_Bomb_plant_Func006Func002002002))
        call ForGroupBJ(udg_MadWizard_Group, function Trig_HERO_Mad_Wizard_Bomb_plant_Func006Func003A)
        call DestroyGroup(udg_MadWizard_Group)
    else
    endif
    //                                                                                                         
    set udg_temp_point=GetUnitLoc(udg_MadWizard)
    call CreateNUnitsAtLoc(1, 'h01O', udg_MadWizard_Player, udg_temp_point, bj_UNIT_FACING)
    set udg_MadWizard_Bomb=GetLastCreatedUnit()
    set udg_MadWizard_Bomb_Counter[GetUnitUserData(udg_MadWizard_Bomb)]=udg_MadWizard_Bomb_Counter[udg_MadWizard_CV]
    call RemoveLocation(udg_temp_point)
    //                                                                                                         
    // Adjust bomb stats:
    call BlzSetUnitMaxHP(udg_MadWizard_Bomb, ( 250 + ( 250 * GetUnitAbilityLevelSwapped('A04C', udg_MadWizard) ) ))
    call BlzSetUnitArmor(udg_MadWizard_Bomb, I2R(GetUnitAbilityLevelSwapped('A04C', udg_MadWizard)))
    call SetUnitLifePercentBJ(udg_MadWizard_Bomb, 100)
    call UnitAddAbilityBJ('A083', udg_MadWizard_Bomb)
    call SetUnitAbilityLevelSwapped('A083', udg_MadWizard_Bomb, GetUnitAbilityLevelSwapped('A04C', udg_MadWizard))
    call BlzPauseUnitEx(udg_MadWizard_Bomb, true)
    //                                                                                                         
    // Destroy first bomb if you're about to create a third:
    set udg_MadWizard_Group=GetUnitsOfPlayerMatching(udg_MadWizard_Player, Condition(function Trig_HERO_Mad_Wizard_Bomb_plant_Func023002002))
    set udg_MadWizard_Bomb_Counter[0]=1000000000
    if ( Trig_HERO_Mad_Wizard_Bomb_plant_Func025C() ) then
        // Get first bomb:
        call ForGroupBJ(udg_MadWizard_Group, function Trig_HERO_Mad_Wizard_Bomb_plant_Func025Func002A)
        // Destroy first bomb:
        set udg_temp_point=GetUnitLoc(udg_MadWizard_Bomb)
        call AddSpecialEffectLocBJ(udg_temp_point, "Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call RemoveLocation(udg_temp_point)
        call KillUnit(udg_MadWizard_Bomb)
        call RemoveUnit(udg_MadWizard_Bomb)
    else
    endif
    call DestroyGroup(udg_MadWizard_Group)
endfunction

function InitTrig_HERO_Mad_Wizard_Bomb_plant takes nothing returns nothing
    set gg_trg_HERO_Mad_Wizard_Bomb_plant=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Mad_Wizard_Bomb_plant, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Mad_Wizard_Bomb_plant, Condition(function Trig_HERO_Mad_Wizard_Bomb_plant_Conditions))
    call TriggerAddAction(gg_trg_HERO_Mad_Wizard_Bomb_plant, function Trig_HERO_Mad_Wizard_Bomb_plant_Actions)
endfunction

