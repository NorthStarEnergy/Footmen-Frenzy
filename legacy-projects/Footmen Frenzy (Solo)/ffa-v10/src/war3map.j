function Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005Func037Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SovietSniper_Unit[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_SovietSniper_Unit[0], GetOwningPlayer(udg_SovietSniper)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SovietSniper_Unit[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_SovietSniper_Unit[0]) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_SovietSniper_Unit[0]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SovietSniper_Unit[0], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005Func037A takes nothing returns nothing
    set udg_SovietSniper_Unit[0]=GetEnumUnit()
    if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005Func037Func002C() ) then
        call AddSpecialEffectTargetUnitBJ("chest", udg_SovietSniper_Unit[0], "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call UnitDamageTargetBJ(udg_SovietSniper, udg_SovietSniper_Unit[0], udg_SovietSniper_Real[1], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_SovietSniper_Unit[1], "slow", udg_SovietSniper_Unit[0])
    else
    endif
endfunction

