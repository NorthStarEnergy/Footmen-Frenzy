function Trig_Searing_Bullet_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0OE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_Func002C takes nothing returns boolean
    if ( not ( udg_QS_Damage[1] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_Actions takes nothing returns nothing
    // DEFINE SEARING BULLET DAMAGE PER LEVEL:
    if ( Trig_Searing_Bullet_Func002C() ) then
        set udg_QS_Damage[1]=150.00
        set udg_QS_Damage[2]=250.00
        set udg_QS_Damage[3]=350.00
        set udg_QS_Damage[4]=450.00
        set udg_QS_Damage[5]=550.00
        set udg_QS_Damage[6]=750.00
    else
    endif
    //                                                                                                     
    set udg_QS_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_QS_Point[1]=GetSpellTargetLoc()
    set udg_QS_Angle=AngleBetweenPoints(udg_QS_Point[0], udg_QS_Point[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=GetUnitLoc(udg_MissileSource)
    set udg_MissileFinish=PolarProjectionBJ(udg_QS_Point[0], 1500.00, udg_QS_Angle)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="war3mapImported\\Deadly Plumage HD Gold.mdx"
    set udg_MissileScale=0.60
    set udg_MissileCollision=60.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=1800.00
    set udg_MissileVision=300.00
    set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Searing_Bullet_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_QS_Point[0])
    call RemoveLocation(udg_QS_Point[1])
endfunction

function InitTrig_Searing_Bullet takes nothing returns nothing
    set gg_trg_Searing_Bullet=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Searing_Bullet, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Searing_Bullet, Condition(function Trig_Searing_Bullet_Conditions))
    call TriggerAddAction(gg_trg_Searing_Bullet, function Trig_Searing_Bullet_Actions)
endfunction

function Trig_Searing_Bullet_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitVisible(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_MissileHitUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_OnHit_Func011Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_QS_Target, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_QS_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target, UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_QS_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_QS_Target) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Searing_Bullet_OnHit_Func011A takes nothing returns nothing
    set udg_QS_Target=GetEnumUnit()
    if ( Trig_Searing_Bullet_OnHit_Func011Func002C() ) then
        call UnitDamageTargetBJ(udg_MissileSource, udg_QS_Target, udg_QS_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call IssueTargetOrderBJ(udg_QS_Dummy, "thunderbolt", udg_QS_Target)
    else
    endif
endfunction

function Trig_Searing_Bullet_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    //                                                                                                     
    call CreateNUnitsAtLoc(1, 'dmmy', udg_MissileOwner, udg_MissilePosition, bj_UNIT_FACING)
    set udg_QS_Dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0OF', udg_QS_Dummy)
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_QS_Dummy)
    call SetUnitAbilityLevelSwapped('A0OF', udg_QS_Dummy, GetUnitAbilityLevelSwapped('A0OE', udg_MissileSource))
    set udg_QS_Damage[0]=udg_QS_Damage[udg_MissileData]
    //                                                                                                     
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(110.00, udg_MissilePosition), function Trig_Searing_Bullet_OnHit_Func011A)
endfunction

