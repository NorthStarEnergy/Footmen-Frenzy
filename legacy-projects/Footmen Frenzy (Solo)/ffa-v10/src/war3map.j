    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Cast_Actions takes nothing returns nothing
    set udg_SovietSniper=GetTriggerUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    // Define damage scaling per level (once):
    if ( Trig_SovietSniper_Decoy_Bomb_Cast_Func006C() ) then
        set udg_SovietSniper_DB_Damage_Per_Lvl[1]=25.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[2]=50.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[3]=75.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[4]=100.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[5]=125.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[6]=150.00
    else
    endif
    //                                                                                                          
    // Missile Properties:
    set udg_MissileData=udg_SovietSniper_CV
    set udg_MissileSource=udg_SovietSniper
    set udg_MissileStart=GetUnitLoc(udg_SovietSniper)
    set udg_MissileFinish=GetSpellTargetLoc()
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl"
    set udg_MissileScale=1.20
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=25.00
    set udg_MissileSpeed=700.00
    //                                                                                                     
    // Arc should be between 0.00 and 80.00:
    set udg_MissileArc=40.00
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onFinish=gg_trg_SovietSniper_Decoy_Bomb_Create_Bomb
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
endfunction

