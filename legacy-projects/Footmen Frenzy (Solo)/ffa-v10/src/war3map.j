function SKCreditKill takes nothing returns nothing
    local integer pn=GetPlayerId(GetOwningPlayer(GetKillingUnit()))+1
    local unit dead=GetDyingUnit()
    if SKReady and not SoloFoots_EndGameStarted and SKActive(pn) and GetKillingUnit() != null and not IsUnitIllusion(dead) and GetUnitAbilityLevel(dead, 'Aloc')==0 and IsUnitEnemy(dead, Player(pn-1)) then
        if IsUnitType(dead, UNIT_TYPE_HERO) then
            set SKHeroKills[SKKing[pn]]=SKHeroKills[SKKing[pn]]+1
        elseif not IsUnitType(dead, UNIT_TYPE_STRUCTURE) then
            set SKTroopKills[SKKing[pn]]=SKTroopKills[SKKing[pn]]+1
        endif
    endif
    set dead=null
endfunction

function Trig_Multiboard_Update_Actions takes nothing returns nothing
local unit victim=GetTriggerUnit()
    local unit killer=GetKillingUnit()
    local integer d=GetPlayerId(GetOwningPlayer(victim))+1
    local integer k=GetPlayerId(GetOwningPlayer(killer))+1
    local boolean valid=killer!=null and k<=12 and F8_Participant[k] and IsUnitEnemy(victim,Player(k-1))
    if SKEnabled then
        call SKCreditKill()
    endif
    if d<=12 and F8_Participant[d] then
        if IsUnitType(victim,UNIT_TYPE_HERO) then
            set udg_hero_deaths[d]=udg_hero_deaths[d]+1
            set udg_hero_killstreak[d]=0
            if valid then
                set udg_hero_kills[k]=udg_hero_kills[k]+1
                set udg_hero_killstreak[k]=udg_hero_killstreak[k]+1
            endif
        elseif victim==udg_base[d] then
            if valid then
                set udg_base_kills[k]=udg_base_kills[k]+1
            endif
        elseif not IsUnitType(victim,UNIT_TYPE_STRUCTURE) then
            set udg_unit_deaths[d]=udg_unit_deaths[d]+1
            if valid then
                set udg_unit_kills[k]=udg_unit_kills[k]+1
            endif
        endif
    endif
    call F8_UpdateBoard()
    set victim=null
    set killer=null
endfunction

function InitTrig_Multiboard_Update takes nothing returns nothing
    set gg_trg_Multiboard_Update=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Multiboard_Update, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Multiboard_Update, Condition(function Trig_Multiboard_Update_Conditions))
    call TriggerAddAction(gg_trg_Multiboard_Update, function Trig_Multiboard_Update_Actions)
endfunction

