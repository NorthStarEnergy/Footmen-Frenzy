function Trig_HERO_Blooddancer_Illusions_Warhymn_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_AoE=600.00
    set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_temp_point, Condition(function Trig_HERO_Blooddancer_Illusions_Warhymn_Func006002003))
    call BlzStartUnitAbilityCooldown(udg_temp_unit, 'A07C', 20.00)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Blooddancer_Illusions_Warhymn_Func008A)
    call CreateNUnitsAtLoc(1, 'h01K', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    if ( Trig_HERO_Blooddancer_Illusions_Warhymn_Func011C() ) then
        call UnitAddItemByIdSwapped('I01U', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01U'))
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Blooddancer_Illusions_Warhymn_Func012C() ) then
        call UnitAddItemByIdSwapped('I01T', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01T'))
    else
        call DoNothing()
    endif
    if ( Trig_HERO_Blooddancer_Illusions_Warhymn_Func013C() ) then
        call UnitAddItemByIdSwapped('I01V', udg_dummy)
        call UnitUseItem(udg_dummy, GetItemOfTypeFromUnitBJ(udg_dummy, 'I01V'))
    else
        call DoNothing()
    endif
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Blooddancer_Illusions_Warhymn_Func015A)
    call RemoveLocation(udg_temp_point)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

