function Trig_autorevive_Func004A takes nothing returns nothing
    call IssueTargetOrderBJ(GetEnumUnit(), "revive", GetTriggerUnit())
    call DisplayTextToForce(udg_temp_playergroup, ( "Your Hero " + ( GetUnitName(GetTriggerUnit()) + " will be automatically revived." ) ))
endfunction

function Trig_autorevive_Actions takes nothing returns nothing
    call TriggerSleepAction(10.00)
    set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetOwningPlayer(GetTriggerUnit()), Condition(function Trig_autorevive_Func002002002))
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_autorevive_Func004A)
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyForce(udg_temp_playergroup)
endfunction

function InitTrig_autorevive takes nothing returns nothing
    set gg_trg_autorevive=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_autorevive, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_autorevive, Condition(function Trig_autorevive_Conditions))
    call TriggerAddAction(gg_trg_autorevive, function Trig_autorevive_Actions)
endfunction

function Trig_change_Revive_time_based_on_level_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Func003Func002Func002Func002Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetDyingUnit()) >= 16 ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetDyingUnit()) <= 18 ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Func003Func002Func002Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetDyingUnit()) >= 13 ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetDyingUnit()) <= 15 ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Func003Func002Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetDyingUnit()) >= 10 ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetDyingUnit()) <= 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Func003Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetDyingUnit()) >= 7 ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetDyingUnit()) <= 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Func003Func002C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetDyingUnit()) >= 4 ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetDyingUnit()) <= 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Func003C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetDyingUnit()) >= 1 ) ) then
        return false
    endif
    if ( not ( GetUnitLevel(GetDyingUnit()) <= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_change_Revive_time_based_on_level_Actions takes nothing returns nothing
    call SetPlayerMaxHeroesAllowed(2, GetOwningPlayer(GetDyingUnit()))
    // Level 1-3
    if ( Trig_change_Revive_time_based_on_level_Func003C() ) then
        call SetPlayerHandicapReviveTimeBJ(GetOwningPlayer(GetDyingUnit()), 10.00)
    else
        // Level 4-6
        if ( Trig_change_Revive_time_based_on_level_Func003Func002C() ) then
            call SetPlayerHandicapReviveTimeBJ(GetOwningPlayer(GetDyingUnit()), 20.00)
        else
            // Level 7-9
            if ( Trig_change_Revive_time_based_on_level_Func003Func002Func002C() ) then
                call SetPlayerHandicapReviveTimeBJ(GetOwningPlayer(GetDyingUnit()), 30.00)
            else
                // Level 10-12
                if ( Trig_change_Revive_time_based_on_level_Func003Func002Func002Func002C() ) then
                    call SetPlayerHandicapReviveTimeBJ(GetOwningPlayer(GetDyingUnit()), 50.00)
                else
                    // Level 13-15
                    if ( Trig_change_Revive_time_based_on_level_Func003Func002Func002Func002Func002C() ) then
                        call SetPlayerHandicapReviveTimeBJ(GetOwningPlayer(GetDyingUnit()), 85.00)
                    else
                        // Level 16-18
                        if ( Trig_change_Revive_time_based_on_level_Func003Func002Func002Func002Func002Func002C() ) then
                            call SetPlayerHandicapReviveTimeBJ(GetOwningPlayer(GetDyingUnit()), 110.00)
                        else
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

function InitTrig_change_Revive_time_based_on_level takes nothing returns nothing
    set gg_trg_change_Revive_time_based_on_level=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_change_Revive_time_based_on_level, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_change_Revive_time_based_on_level, Condition(function Trig_change_Revive_time_based_on_level_Conditions))
    call TriggerAddAction(gg_trg_change_Revive_time_based_on_level, function Trig_change_Revive_time_based_on_level_Actions)
endfunction

function Trig_colossal_variables_Actions takes nothing returns nothing
    // SET COLOSSUS DIFFICULTY:
    set udg_colossal_difficulty=0.06
    //                                                                                                   
    call EnableTrigger(gg_trg_colossal_spawn)
    call EnableTrigger(gg_trg_colossal_death)
    call ConditionalTriggerExecute(gg_trg_colossal_stats)
    set udg_colossal_wave=1
    set udg_colossal_wave_id=1
    set udg_t_colossal_initial=150.00
    set udg_t_colossal_reoccuring=300.00
    //                                                                                                   
    // Colossal Timers (Spawn 10 seconds after expiring)
    //                                                                                                   
    // Colossal Items
    set udg_colossal_dropped_item[1]='rres'
    set udg_colossal_dropped_item[2]='tpow'
    set udg_colossal_dropped_item[21]='rhe3'
    set udg_colossal_dropped_item[31]='rma2'
    set udg_colossal_dropped_item[3]='I020'
    set udg_colossal_dropped_item[51]='sres'
    set udg_colossal_dropped_item[61]='pnvl'
    //                                                                                                   
    // Colossal Points
    set udg_colossal_point[1]=Location(- 1400.00, 1100.00)
    set udg_colossal_point[2]=Location(1450.00, 1100.00)
    set udg_colossal_point[3]=Location(1450.00, - 1600.00)
    set udg_colossal_point[4]=Location(- 1450.00, - 1600.00)
endfunction

function InitTrig_colossal_variables takes nothing returns nothing
    set gg_trg_colossal_variables=CreateTrigger()
    call DisableTrigger(gg_trg_colossal_variables)
    call TriggerAddAction(gg_trg_colossal_variables, function Trig_colossal_variables_Actions)
endfunction

function Trig_colossal_spawn_message_Func002C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_timer_colossal) < 10.50 ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_timer_colossal) > 9.50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_message_Conditions takes nothing returns boolean
    if ( not Trig_colossal_spawn_message_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_message_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_TheHornOfCenarius)
    call DisplayTimedTextToForce(udg_all_players, 5.00, "TRIGSTR_16436")
    call PingMinimapLocForForce(udg_all_players, udg_centermap, 1)
    set udg_X=1
    loop
        exitwhen udg_X > 8
        call PingMinimapLocForForce(udg_all_players, udg_colossal_point[udg_X], 1)
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_colossal_spawn_message takes nothing returns nothing
    set gg_trg_colossal_spawn_message=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_colossal_spawn_message, 1.00)
    call TriggerAddCondition(gg_trg_colossal_spawn_message, Condition(function Trig_colossal_spawn_message_Conditions))
    call TriggerAddAction(gg_trg_colossal_spawn_message, function Trig_colossal_spawn_message_Actions)
endfunction

