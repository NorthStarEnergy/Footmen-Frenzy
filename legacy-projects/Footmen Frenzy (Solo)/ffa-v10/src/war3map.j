function Trig_Start_SD_Func013Func042Func001Func001Func001A takes nothing returns nothing
    local integer heroType=GetUnitTypeId(GetEnumUnit())
    if not SoloFootsIsNoMuteHeroType(heroType) then
        call SoloFootsAddHeroTypeToTavern(heroType , udg_real_shop[udg_temp_int])
        if ( Trig_Start_SD_Func013Func042Func001Func001Func001Func002C() ) then
            set udg_carryhero[udg_temp_int]=heroType
        else
            call DoNothing()
        endif
        if ( Trig_Start_SD_Func013Func042Func001Func001Func001Func003C() ) then
            set udg_carryhero2[udg_temp_int]=heroType
        else
            call DoNothing()
        endif
        if ( Trig_Start_SD_Func013Func042Func001Func001Func001Func004C() ) then
            set udg_carryhero3[udg_temp_int]=heroType
        else
            call DoNothing()
        endif
    endif
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_hero_category_group[udg_X_category])
endfunction

