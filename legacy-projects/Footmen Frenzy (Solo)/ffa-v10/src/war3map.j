    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_smite_heal_unitgroup[udg_temp_playernumber]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Archangel_Smite_Func017Func002A takes nothing returns nothing
