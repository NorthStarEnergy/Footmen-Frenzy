        exitwhen udg_X > 3
        set udg_main[udg_X]=GetUnitsOfTypeIdAll(udg_new_base[udg_X])
        call ForGroupBJ(udg_main[udg_X], function Trig_eight_new_Func001Func002A)
        set udg_X=udg_X + 1
    endloop
    call RemoveLocation(udg_temp_point)
endfunction

