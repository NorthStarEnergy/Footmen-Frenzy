function Trig_Turn_on_Triggers_when_items_sold_Actions takes nothing returns nothing
    if ( Trig_Turn_on_Triggers_when_items_sold_Func001C() ) then
        call EnableTrigger(gg_trg_ITEM_Scroll_of_Invisibility)
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func002C() ) then
        call EnableTrigger(gg_trg_ITEM_Scroll_of_AntiMagic)
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func003C() ) then
        call EnableTrigger(gg_trg_ITEM_Scepter)
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func004C() ) then
        call EnableTrigger(gg_trg_ITEM_Illusion)
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func005C() ) then
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func006C() ) then
        call EnableTrigger(gg_trg_ITEM_Orb_of_Frost)
    else
        call DoNothing()
    endif
    if ( Trig_Turn_on_Triggers_when_items_sold_Func007C() ) then
        call EnableTrigger(gg_trg_ITEM_Wall)
        call EnableTrigger(gg_trg_ITEM_Wall_Convert_Press)
        call EnableTrigger(gg_trg_ITEM_Wall_Convert_execute)
        call EnableTrigger(gg_trg_ITEM_Wall_taunt)
    else
        call DoNothing()
    endif
endfunction

