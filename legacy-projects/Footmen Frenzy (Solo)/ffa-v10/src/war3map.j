            else
                set udg_StaffJungle_location[udg_X]=PolarProjectionBJ(udg_StaffJungle_location[udg_X], 20.00, udg_StaffJungle_degree[udg_X])
            endif
            call SetUnitPositionLocFacingBJ(udg_dummy_Jungle[udg_X], udg_StaffJungle_location[udg_X], udg_StaffJungle_degree[udg_X])
            set udg_StaffJungle_target[udg_X]=GetUnitsInRangeOfLocMatching(110.00, udg_StaffJungle_location[udg_X], Condition(function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003))
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func006C() ) then
                call SetUnitPositionLocFacingBJ(udg_herO[udg_X], udg_StaffJungle_location[udg_X], udg_StaffJungle_degree[udg_X])
                call AddSpecialEffectLocBJ(udg_StaffJungle_location[udg_X], "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                call UnitAddAbilityBJ('A0RF', udg_dummy_Jungle[udg_X])
                call SetUnitAbilityLevelSwapped('A0RF', udg_dummy_Jungle[udg_X], udg_StaffJungle_level[GetUnitUserData(udg_dummy_Jungle[udg_X])])
                call IssueImmediateOrderBJ(udg_dummy_Jungle[udg_X], "stomp")
                call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_Jungle[udg_X])
                call RemoveLocation(udg_StaffJungle_location[udg_X])
                call RemoveLocation(udg_StaffJungle_start_location[udg_X])
                set udg_StaffJungle_active[udg_X]=false
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func007C() ) then
                call RemoveUnit(udg_dummy_Jungle[udg_X])
                call RemoveLocation(udg_StaffJungle_location[udg_X])
                set udg_StaffJungle_active[udg_X]=false
                call RemoveLocation(udg_StaffJungle_start_location[udg_X])
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            call DestroyGroup(udg_StaffJungle_target[udg_X])
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_HERO_Monkey_Staff_of_the_Jungle_Loop takes nothing returns nothing
    set gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop)
