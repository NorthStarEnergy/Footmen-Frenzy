function SF_AcceptHero takes unit hero returns nothing
    local integer ownerId=GetPlayerId(GetOwningPlayer(hero)) + 1
    if ownerId > 12 or not udg_player_active[ownerId] or SF_Picked[ownerId] then
        return
    endif
    set SF_Picked[ownerId]=true
    set SF_HeroCount[ownerId]=1
    set udg_temp_unit=hero
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_temp_point=GetPlayerStartLocationLoc(GetOwningPlayer(udg_temp_unit))
    // Madness mode
    // TP HERO
    if true then
        set udg_tp_kill[udg_temp_playernumber]=true
        set udg_herO[udg_temp_playernumber]=udg_temp_unit
        call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
        // Starting Items
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
        call UnitAddItemByIdSwapped('pinv', udg_temp_unit)
        call UnitAddItemByIdSwapped('hslv', udg_temp_unit)
        call UnitAddItemByIdSwapped('I01C', udg_temp_unit)
        call PanCameraToTimedLocForPlayer(ConvertedPlayer(udg_temp_playernumber), udg_temp_point, 1.00)
        call zoom_RestoreFromCacheForPlayer(Player(udg_temp_playernumber - 1))
        call SetPlayerName(ConvertedPlayer(udg_temp_playernumber), ( ( "(" + ( GetUnitName(udg_temp_unit) + ") " ) ) + udg_orig_player_name[udg_temp_playernumber] ))
        set udg_coloured_playername[udg_temp_playernumber]=( udg_colour[udg_temp_playernumber] + ( GetPlayerName(ConvertedPlayer(udg_temp_playernumber)) + "|r" ) )
        // Assign Hero #
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            if ( Trig_TP_hero_Func006Func017Func001C() ) then
                set udg_picked_hero[udg_temp_playernumber]=udg_X
                // SD only 1x carry
                if ( Trig_TP_hero_Func006Func017Func001Func003C() ) then
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_STRENGTH, ( R2I(udg_hero_STR_base[udg_X]) + ( R2I(udg_hero_STR_inc[udg_X]) * 5 ) ))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_INTELLIGENCE, ( R2I(udg_hero_INT_base[udg_X]) + ( R2I(udg_hero_INT_inc[udg_X]) * 5 ) ))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_AGILITY, ( R2I(udg_hero_AGI_base[udg_X]) + ( R2I(udg_hero_AGI_inc[udg_X]) * 5 ) ))
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[udg_X])
                    call SetUnitMoveSpeed(udg_temp_unit, udg_hero_move_base[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_TURN_RATE, udg_hero_turnrate[udg_X])
                else
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_STRENGTH, R2I(udg_hero_STR_base[udg_X]))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_AGILITY, R2I(udg_hero_AGI_base[udg_X]))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_INTELLIGENCE, R2I(udg_hero_INT_base[udg_X]))
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[udg_X])
                    call SetUnitMoveSpeed(udg_temp_unit, udg_hero_move_base[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_TURN_RATE, udg_hero_turnrate[udg_X])
                endif
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        call DoNothing()
    endif
    set udg_X=udg_temp_playernumber
    set udg_temp_level=1
    set udg_hero_bounty_multiplier=1.00
    if ( Trig_TP_hero_Func010001() ) then
        set udg_hero_bounty_multiplier=0.50
    else
        call DoNothing()
    endif
    if ( Trig_TP_hero_Func011001() ) then
        set udg_hero_bounty_multiplier=1.50
    else
        call DoNothing()
    endif
    if ( Trig_TP_hero_Func012001() ) then
        set udg_hero_bounty_multiplier=1.25
    else
        call DoNothing()
    endif
    if ( Trig_TP_hero_Func013001() ) then
        set udg_hero_bounty_multiplier=1.10
    else
        call DoNothing()
    endif
    if ( Trig_TP_hero_Func014001() ) then
        set udg_hero_bounty_multiplier=1.25
    else
        call DoNothing()
    endif
    if ( Trig_TP_hero_Func015001() ) then
        set udg_hero_bounty_multiplier=1.00
    else
        call DoNothing()
    endif
    set udg_temp_real=( I2R(udg_hero_bounty_base[udg_temp_level]) * udg_hero_bounty_multiplier )
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_temp_real))
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, 0)
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, 0)
    if ( Trig_TP_hero_Func020C() ) then
        set udg_numberofSDcategories=6
    else
        set udg_numberofSDcategories=11
    endif
    call RemoveLocation(udg_temp_point)
    call SF_RemoveTavern(ownerId)
    call SelectUnitForPlayerSingle(hero, Player(ownerId - 1))
endfunction

function SF_OnSale takes nothing returns nothing
    local unit shop=GetSellingUnit()
    local unit sold=GetSoldUnit()
    local integer p=GetPlayerId(GetOwningPlayer(shop)) + 1
    local integer id=GetUnitTypeId(sold)
    if p <= 12 and GetUnitTypeId(shop) == 'nFHT' then
        if id == 'hPgN' then
            call RemoveUnit(sold)
            if SF_Tavern[p] != null and not SF_Picked[p] then
                set SF_Page[p]=SF_Page[p] + 1
                if SF_Page[p] * 10 >= SF_PoolCount[p] then
                    set SF_Page[p]=0
                endif
                call SF_RefreshPage(p)
                call SelectUnitForPlayerSingle(shop, Player(p - 1))
            endif
        elseif IsUnitType(sold, UNIT_TYPE_HERO) then
            call SF_AcceptHero(sold)
        endif
    endif
    set shop=null
    set sold=null
endfunction

function SF_AssignUnpicked takes nothing returns nothing
    local integer p=1
    local integer id
    local unit hero
    loop
        exitwhen p > 12
        if udg_player_active[p] and not SF_Picked[p] and udg_herO[p] == null then
            if SF_PoolCount[p] > 0 then
                set id=SF_Pool[p * 128 + GetRandomInt(1, SF_PoolCount[p])]
            else
                set id=udg_hero_type[1]
            endif
            set hero=CreateUnit(Player(p - 1), id, SF_BaseX[p] - 192. * Cos(SF_Angle[p]), SF_BaseY[p] - 192. * Sin(SF_Angle[p]), SF_Angle[p] * bj_RADTODEG + 180.)
            call SF_AcceptHero(hero)
            call DisplayTimedTextToPlayer(Player(p - 1), 0., 0., 8., "Hero selection closed: you received " + GetUnitName(hero) + ".")
        endif
        call SF_RemoveTavern(p)
        set p=p + 1
    endloop
    set hero=null
endfunction

function SF_StartDeadline takes nothing returns nothing
    if not SF_DeadlineStarted then
        set SF_DeadlineStarted=true
        call SF_OpenTaverns()
        call TimerStart(SF_Deadline, 15., false, function SF_AssignUnpicked)
    endif
endfunction

