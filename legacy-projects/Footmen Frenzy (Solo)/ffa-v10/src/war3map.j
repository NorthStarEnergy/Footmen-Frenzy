endfunction

function Trig_ITEM_Wall_countdown_Func001Func002001 takes nothing returns boolean
    return ( TimerGetRemaining(udg_wall_timer[GetForLoopIndexA()]) < 1.00 )
endfunction

function Trig_ITEM_Wall_countdown_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetTextTagTextBJ(udg_wall_timer_text[GetForLoopIndexA()], R2SW(TimerGetRemaining(udg_wall_timer[GetForLoopIndexA()]), 2, 0), 9.00)
        if ( Trig_ITEM_Wall_countdown_Func001Func002001() ) then
            call DestroyTextTagBJ(udg_wall_timer_text[GetForLoopIndexA()])
        else
            call DoNothing()
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

function InitTrig_ITEM_Wall_countdown takes nothing returns nothing
    set gg_trg_ITEM_Wall_countdown=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_ITEM_Wall_countdown, 1.00)
