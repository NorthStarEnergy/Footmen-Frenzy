    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[6])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[7])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[8])
