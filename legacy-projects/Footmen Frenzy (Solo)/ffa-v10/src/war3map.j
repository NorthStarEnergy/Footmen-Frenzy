function Trig_UNIT_Interchange_Allies_Actions takes nothing returns nothing
    local lightning l
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_casting_unit=GetSpellAbilityUnit()
    set udg_temp_unit=GetSpellTargetUnit()
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_casting_unit)
    //                                                                                         
    call AddLightningLoc("CHIM", udg_temp_point, udg_temp_point_caster)
    set l=bj_lastCreatedLightning
    //                                                                                         
    call PlaySoundOnUnitBJ(gg_snd_SoulPreservation, 90.00, udg_temp_unit)
    call SetUnitPositionLoc(udg_temp_casting_unit, udg_temp_point)
    call SetUnitPositionLoc(udg_temp_unit, udg_temp_point_caster)
    call StartTimerBJ(udg_timer_interchange[udg_temp_playernumber], false, 60.00)
    call BlzStartUnitAbilityCooldown(udg_temp_casting_unit, 'A074', TimerGetRemaining(udg_timer_interchange[udg_temp_playernumber]))
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
    call PolledWait(1.00)
    call DestroyLightning(l)
    set l=null
endfunction

function InitTrig_UNIT_Interchange_Allies takes nothing returns nothing
    set gg_trg_UNIT_Interchange_Allies=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_UNIT_Interchange_Allies, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_UNIT_Interchange_Allies, Condition(function Trig_UNIT_Interchange_Allies_Conditions))
    call TriggerAddAction(gg_trg_UNIT_Interchange_Allies, function Trig_UNIT_Interchange_Allies_Actions)
endfunction

function Trig_UNIT_Tower_of_Terror_Nuke_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_UNIT_Tower_of_Terror_Nuke_Actions takes nothing returns nothing
    set udg_temp_unit=GetSpellAbilityUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_degree=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    set udg_temp_point_caster=PolarProjectionBJ(udg_temp_point, - 100.00, udg_temp_degree)
    call CreateNUnitsAtLoc(1, 'h03A', udg_temp_player, udg_temp_point, bj_UNIT_FACING)
    set udg_target[udg_temp_playernumber]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h039', udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call IssuePointOrderLocBJ(udg_dummy, "attackground", udg_temp_point)
    call UnitAddAbilityBJ('A0QY', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0QY', udg_dummy, 1)
    call IssuePointOrderLocBJ(udg_dummy, "flamestrike", udg_temp_point)
    call UnitApplyTimedLifeBJ(1.50, 'BTLF', udg_target[udg_temp_playernumber])
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_dummy)
    call AddSpecialEffectLocBJ(udg_temp_point, "NuclearExplosion.mdx")
    call BlzSetSpecialEffectTimeScale(GetLastCreatedEffectBJ(), 3.00)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

function InitTrig_UNIT_Tower_of_Terror_Nuke takes nothing returns nothing
    set gg_trg_UNIT_Tower_of_Terror_Nuke=CreateTrigger()
