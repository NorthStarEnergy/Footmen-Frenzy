    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_move_unit_hero_showroom_Func004C takes nothing returns boolean
    if ( not ( IsUnitType(udg_temp_unit, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_move_unit_hero_showroom_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point=GetPlayerStartLocationLoc(GetOwningPlayer(udg_temp_unit))
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    if ( Trig_move_unit_hero_showroom_Func004C() ) then
        call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
        call KillUnit(udg_temp_unit)
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1093")
        call DestroyForce(udg_temp_playergroup)
    else
        call KillUnit(udg_temp_unit)
    endif
    call RemoveLocation(udg_temp_point)
endfunction

function InitTrig_move_unit_hero_showroom takes nothing returns nothing
    set gg_trg_move_unit_hero_showroom=CreateTrigger()
    call DisableTrigger(gg_trg_move_unit_hero_showroom)
    call TriggerRegisterEnterRectSimple(gg_trg_move_unit_hero_showroom, gg_rct_HEROshowroom)
    call TriggerRegisterEnterRectSimple(gg_trg_move_unit_hero_showroom, gg_rct_TAVERN_AREA)
    call TriggerAddCondition(gg_trg_move_unit_hero_showroom, Condition(function Trig_move_unit_hero_showroom_Conditions))
    call TriggerAddAction(gg_trg_move_unit_hero_showroom, function Trig_move_unit_hero_showroom_Actions)
endfunction

function Trig_start_timers_Actions takes nothing returns nothing
    // this trigger is being executed from the 'start game' trigger
    // Random selection now uses mass start + 15 seconds.
    call StartTimerBJ(udg_timer_foots_increase, false, 480.00)
    call StartTimerBJ(udg_timer_BountyIncrease, false, 2200.00)
    call StartTimerBJ(udg_timer_unit_ugrades, false, 70.00)
    call StartTimerBJ(udg_timer_tech_delay_t1, false, 60.00)
    call StartTimerBJ(udg_timer_tech_delay_t2, false, 100.00)
    call StartTimerBJ(udg_timer_game_starting, false, RMaxBJ(0., 55. - TimerGetElapsed(SF_GameClock)))
    call StartTimerBJ(udg_timer_3rd_hero, false, 140.00)
    call StartTimerBJ(udg_timer_altar_delay, false, 120.00)
    call CreateTimerDialogBJ(udg_timer_tech_delay_t1, "TRIGSTR_10041")
    set udg_timer_window_tech_delay=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_timer_window_tech_delay)
    call EnableTrigger(gg_trg_MASS_timer)
    call ConditionalTriggerExecute(gg_trg_MASS_timer)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_start_timers takes nothing returns nothing
    set gg_trg_start_timers=CreateTrigger()
    call TriggerAddAction(gg_trg_start_timers, function Trig_start_timers_Actions)
endfunction

