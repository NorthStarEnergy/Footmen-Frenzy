        return false
    endif
    return true
endfunction

function Trig_KOTH_Setup_Actions takes nothing returns nothing
    // THIS TIMER IS STARTED IN: Game mode/Game/MODE King Of The Hill
    //                                                                                                     
    // Define your King of the Hill variables:
    //                                                                                                     
    // The starting gold of the hill:
    set udg_KOTH_Gold_Starting_Total=99999
    set udg_KOTH_Gold_Remaining=udg_KOTH_Gold_Starting_Total
    //                                                                                                     
    // The default amount of gold rewarded whenever the income timer expires:
    set udg_KOTH_Gold_Rewarded=9
    set udg_KOTH_Gold_Division_Bonus=1
    if ( Trig_KOTH_Setup_Func012C() ) then
        set udg_KOTH_Gold_Rewarded=9
    else
        call DoNothing()
    endif
    //                                                                                                     
    // How much gold remaining is needed for the income reward to increase:
    set udg_KOTH_Gold_Half_Remaining=89000
    //                                                                                                     
    // How much gold a team can earn before the Hill resets:
    set udg_KOTH_Gold_Reset_Amount=300
    set udg_KOTH_Gold_Bounty=20
    //                                                                                                     
    // Create the starting hill:
    set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
    call CreateNUnitsAtLoc(1, 'koth', udg_KOTH_Player, udg_centermap, bj_UNIT_FACING)
    set udg_KOTH_Hill=GetLastCreatedUnit()
    call SetUnitPathing(udg_KOTH_Hill, false)
    call SetUnitX(udg_KOTH_Hill, GetLocationX(udg_centermap))
    call SetUnitY(udg_KOTH_Hill, GetLocationY(udg_centermap))
    call SetUnitVertexColorBJ(udg_KOTH_Hill, 100, 100, 100, 100.00)
    //                                                                                                     
    // Create the starting text:
    set udg_KOTH_Level=2
    call TriggerExecute(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    // Create the hero glow special effect:
    call TriggerExecute(gg_trg_KOTH_Create_Hill_Glow)
    //                                                                                                     
    //                                                                                                     
    // Starts timers for each level of the hill
    call StartTimerBJ(udg_KOTH_Second_Hill_Timer, false, 460.00)
    call StartTimerBJ(udg_KOTH_Third_Hill_Timer, false, 900.00)
endfunction

function InitTrig_KOTH_Setup takes nothing returns nothing
    set gg_trg_KOTH_Setup=CreateTrigger()
    call DisableTrigger(gg_trg_KOTH_Setup)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_KOTH_Setup, udg_KOTH_Setup_Timer)
    call TriggerAddAction(gg_trg_KOTH_Setup, function Trig_KOTH_Setup_Actions)
