function Trig_eight_new_Func001Func002Func001C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId(udg_spawn_unit[udg_X], GetOwningPlayer(GetEnumUnit())) <= udg_maxunitnumber ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
