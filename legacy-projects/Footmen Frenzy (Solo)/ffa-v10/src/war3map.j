        set udg_GST_Integer1=LoadInteger(GST_Hash, id, 1)
    
        // run the GUI trigger
        call TriggerExecute(trig)
    
        // the timer is not repeating so destroy it
        if ( repeating == false ) then
            call FlushChildHashtable(GST_Hash, id)
            call PauseTimer(t)
            call DestroyTimer(t)
        endif
    
        // clean up memory leaks
        set t=null
        set trig=null
    endfunction

