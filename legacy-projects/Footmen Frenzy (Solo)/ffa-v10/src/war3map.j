function Trig_ITEM_Forked_Fury_NEW_Func006C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_temp_unit, 'rat6') == true ) ) then
        return false
    endif
    if ( not ( udg_forked_fury_cd <= 0.00 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ITEM_Forked_Fury_NEW_Actions takes nothing returns nothing
    set udg_temp_unit=GetAttacker()
    set udg_targeted_unit=GetAttackedUnitBJ()
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    set udg_forked_fury_cd=BlzGetUnitAbilityCooldownRemaining(udg_temp_unit, 'A0DT')
    if ( Trig_ITEM_Forked_Fury_NEW_Func006C() ) then
        set udg_random_integer[udg_temp_playernumber]=GetRandomInt(1, 16)
        if ( Trig_ITEM_Forked_Fury_NEW_Func006Func003C() ) then
            set udg_temp_point=GetUnitLoc(udg_herO[udg_temp_playernumber])
            call CreateNUnitsAtLoc(1, 'h01K', ConvertedPlayer(udg_temp_playernumber), udg_temp_point, bj_UNIT_FACING)
            set udg_dummy=GetLastCreatedUnit()
            call UnitAddAbilityBJ('ACfl', udg_dummy)
            call IssueTargetOrderBJ(udg_dummy, "forkedlightning", udg_targeted_unit)
            call DisplayTextToForce(udg_temp_playergroup, ( "Target: " + GetUnitName(udg_targeted_unit) ))
            call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_dummy)
            call BlzStartUnitAbilityCooldown(udg_temp_unit, 'A0DT', 9.00)
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
endfunction

