function Trig_stop_TK_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetAttacker()), GetOwningPlayer(GetAttackedUnitBJ())) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) != 'o00Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_stop_TK_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'koth' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetAttackedUnitBJ()) == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_stop_TK_Actions takes nothing returns nothing
    // KOTH Fix:
    if ( Trig_stop_TK_Func002C() ) then
        return
    else
    endif
    //                                                                                                     
    set udg_temp_unit=GetAttacker()
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(udg_temp_unit))
    //                                                                                                     
    call IssueImmediateOrderBJ(udg_temp_unit, "stop")
    //                                                                                                     
    call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1096")
    //                                                                                                     
    call DestroyForce(udg_temp_playergroup)
endfunction

function InitTrig_stop_TK takes nothing returns nothing
    set gg_trg_stop_TK=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_stop_TK, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_stop_TK, Condition(function Trig_stop_TK_Conditions))
    call TriggerAddAction(gg_trg_stop_TK, function Trig_stop_TK_Actions)
