    call TriggerAddCondition(gg_trg_Avalanche_Seismic_Fury_Learn, Condition(function Trig_Avalanche_Seismic_Fury_Learn_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Seismic_Fury_Learn, function Trig_Avalanche_Seismic_Fury_Learn_Actions)
endfunction

function Trig_Avalanche_Seismic_Fury_Enable_Actions takes nothing returns nothing
    // Enable the ability (it should be disabled by default):
    call BlzUnitDisableAbility(udg_Avalanche, 'ASEF', false, false)
    //                                                                                                          
    // Visual indicator of ability being ready:
    call UnitAddAbilityBJ('ASEA', udg_Avalanche)
    //                                                                                                          
    // Cool special effect for eye candy:
    call AddSpecialEffectTargetUnitBJ("origin", udg_Avalanche, "Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
endfunction

