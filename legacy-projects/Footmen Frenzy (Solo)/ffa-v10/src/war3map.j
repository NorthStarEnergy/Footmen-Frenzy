    endif
    return true
endfunction

function Trig_Avalanche_Trample_Loop_Actions takes nothing returns nothing
    set udg_Avalanche_TR_Loop=1
    loop
        exitwhen udg_Avalanche_TR_Loop > udg_Avalanche_TR_Index
        // Get the current and next position:
        set udg_Avalanche_TR_Point[0]=GetUnitLoc(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop])
        set udg_Avalanche_TR_Point[1]=PolarProjectionBJ(udg_Avalanche_TR_Point[0], udg_Avalanche_TR_Speed[udg_Avalanche_TR_Loop], udg_Avalanche_TR_Angle[udg_Avalanche_TR_Loop])
        //                                                                                                          
        if ( Trig_Avalanche_Trample_Loop_Func001Func005C() ) then
            call BlzPauseUnitEx(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], true)
            call SetUnitAnimationByIndex(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], udg_Avalanche_TR_Animation[udg_Avalanche_TR_Loop])
        else
        endif
        //                                                                                                          
        // Test the next position for cliffs/obstacles:
        call SetItemVisibleBJ(true, udg_CPP_Pathing_Checker)
        call SetItemPositionLoc(udg_CPP_Pathing_Checker, udg_Avalanche_TR_Point[1])
        set udg_Avalanche_TR_Point[2]=GetItemLoc(udg_CPP_Pathing_Checker)
        call SetItemVisibleBJ(false, udg_CPP_Pathing_Checker)
        //                                                                                                          
        // Move our caster to the next position:
        if ( Trig_Avalanche_Trample_Loop_Func001Func014C() ) then
            call SetUnitPositionLoc(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], udg_Avalanche_TR_Point[1])
            call SetUnitX(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], GetLocationX(udg_Avalanche_TR_Point[1]))
            call SetUnitY(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], GetLocationY(udg_Avalanche_TR_Point[1]))
        else
        endif
        call RemoveLocation(udg_Avalanche_TR_Point[2])
        //                                                                                                          
        // Calculate the total distance traveled in order to determine when the spell should end:
        set udg_Avalanche_TR_Duration[udg_Avalanche_TR_Loop]=( udg_Avalanche_TR_Duration[udg_Avalanche_TR_Loop] + 1 )
        //                                                                                                          
        // If Interval is setup correctly then this spell will periodically damage and stun nearby enemy units:
        if ( Trig_Avalanche_Trample_Loop_Func001Func021C() ) then
            set udg_Avalanche_TR_Point[2]=GetUnitLoc(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop])
            //                                                                                                          
            call SetUnitPositionLoc(udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Loop], udg_Avalanche_TR_Point[2])
            call IssueImmediateOrderBJ(udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Loop], "stomp")
            //                                                                                                          
            set udg_Avalanche_TR_Group=GetUnitsInRangeOfLocAll(170.00, udg_Avalanche_TR_Point[2])
            call ForGroupBJ(udg_Avalanche_TR_Group, function Trig_Avalanche_Trample_Loop_Func001Func021Func007A)
            //                                                                                                          
            call AddSpecialEffectLocBJ(udg_Avalanche_TR_Point[2], "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                          
            // Clean up your memory leaks:
            call RemoveLocation(udg_Avalanche_TR_Point[2])
            call DestroyGroup(udg_Avalanche_TR_Group)
        else
        endif
        //                                                                                                          
        // Clean up your memory leaks:
        call RemoveLocation(udg_Avalanche_TR_Point[0])
        call RemoveLocation(udg_Avalanche_TR_Point[1])
        //                                                                                                          
        // Wooj dash ends early if he's disabled:
        if ( Trig_Avalanche_Trample_Loop_Func001Func028C() ) then
            set udg_Avalanche_TR_Duration[udg_Avalanche_TR_Loop]=999999
        else
        endif
        //                                                                                                          
        // Check if the spell should end:
        if ( Trig_Avalanche_Trample_Loop_Func001Func031C() ) then
            // Height fix for w-a-r-l-o-c-k:
            if ( Trig_Avalanche_Trample_Loop_Func001Func031Func002C() ) then
                call AddSpecialEffectTargetUnitBJ("origin", udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                //                                                                                                          
                call SetUnitFlyHeightBJ(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], 0.00, 0.00)
            else
            endif
            //                                                                                                          
            call RemoveUnit(udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Loop])
            if ( Trig_Avalanche_Trample_Loop_Func001Func031Func006C() ) then
                call ResetUnitAnimation(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop])
            else
            endif
            call BlzPauseUnitEx(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], false)
            call DestroyGroup(udg_Avalanche_TR_Group_Limit[udg_Avalanche_TR_Loop])
            //                                                                                                          
            // NEW - Invulnerable:
            call SetUnitInvulnerable(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop], false)
            //                                                                                                          
            // We swap the last index with the current one and then set the loop back a cycle in order to keep things running smoothly for our other instances:
            set udg_Avalanche_TR_Angle[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Angle[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Caster[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Duration[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Duration[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Damage[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Damage[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Speed[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Speed[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Max_Duration[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Max_Duration[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Interval[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Interval[udg_Avalanche_TR_Index]
            set udg_Avalanche_TR_Group_Limit[udg_Avalanche_TR_Loop]=udg_Avalanche_TR_Group_Limit[udg_Avalanche_TR_Index]
            //                                                                                                          
            set udg_Avalanche_TR_Index=( udg_Avalanche_TR_Index - 1 )
            set udg_Avalanche_TR_Loop=( udg_Avalanche_TR_Loop - 1 )
            //                                                                                                          
            // Once Index hits 0 we know that there are no Dash instances left and can disable this trigger for now:
            if ( Trig_Avalanche_Trample_Loop_Func001Func031Func028C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        else
        endif
        set udg_Avalanche_TR_Loop=udg_Avalanche_TR_Loop + 1
    endloop
endfunction

function InitTrig_Avalanche_Trample_Loop takes nothing returns nothing
    set gg_trg_Avalanche_Trample_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Avalanche_Trample_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Avalanche_Trample_Loop, 0.01)
    call TriggerAddAction(gg_trg_Avalanche_Trample_Loop, function Trig_Avalanche_Trample_Loop_Actions)
endfunction

