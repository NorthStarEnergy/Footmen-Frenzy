function SF_FlipRecipePage takes unit shop,player buyer returns nothing
    local integer key=GetHandleId(shop)
    local boolean second=not LoadBoolean(GST_Hash, key, 104701)
    call RemoveItemFromStock(shop, 'I00B')
    call RemoveItemFromStock(shop, 'I02L')
    call RemoveItemFromStock(shop, 'I00Z')
    call RemoveItemFromStock(shop, 'I00L')
    call RemoveItemFromStock(shop, 'I00M')
    call RemoveItemFromStock(shop, 'I00Q')
    call RemoveItemFromStock(shop, 'I00O')
    call RemoveItemFromStock(shop, 'I00N')
    call RemoveItemFromStock(shop, 'I02O')
    call RemoveItemFromStock(shop, 'I02X')
    call RemoveItemFromStock(shop, 'I03Z')
    call RemoveItemFromStock(shop, 'I015')
    call RemoveItemFromStock(shop, 'I04B')
    call RemoveItemFromStock(shop, 'I00S')
    call RemoveItemFromStock(shop, 'I00K')
    call RemoveItemFromStock(shop, 'I01I')
    call RemoveItemFromStock(shop, 'I01S')
    call SaveBoolean(GST_Hash, key, 104701, second)
    if second then
        call AddItemToStock(shop, 'I015', 1, 1)
        call AddItemToStock(shop, 'I04B', 1, 1)
        call AddItemToStock(shop, 'I00S', 1, 1)
        call AddItemToStock(shop, 'I00K', 1, 1)
        call AddItemToStock(shop, 'I01I', 1, 1)
        call AddItemToStock(shop, 'I01S', 1, 1)
    else
        call AddItemToStock(shop, 'I00B', 1, 1)
        call AddItemToStock(shop, 'I02L', 1, 1)
        call AddItemToStock(shop, 'I00Z', 1, 1)
        call AddItemToStock(shop, 'I00L', 1, 1)
        call AddItemToStock(shop, 'I00M', 1, 1)
        call AddItemToStock(shop, 'I00Q', 1, 1)
        call AddItemToStock(shop, 'I00O', 1, 1)
        call AddItemToStock(shop, 'I00N', 1, 1)
        call AddItemToStock(shop, 'I02O', 1, 1)
        call AddItemToStock(shop, 'I02X', 1, 1)
        call AddItemToStock(shop, 'I03Z', 1, 1)
    endif
    call SelectUnitForPlayerSingle(shop, buyer)
endfunction

function SF_RemoveTavern takes integer p returns nothing
    if SF_Tavern[p] != null then
        call RemoveUnit(SF_Tavern[p])
        set SF_Tavern[p]=null
    endif
endfunction

function SF_RefreshPage takes integer p returns nothing
    local integer i=1
    local integer first=SF_Page[p] * 10 + 1
    local integer last=first + 9
    loop
        exitwhen i > SF_PoolCount[p]
        call RemoveUnitFromStock(SF_Tavern[p], SF_Pool[p * 128 + i])
        set i=i + 1
    endloop
    call RemoveUnitFromStock(SF_Tavern[p], 'hPgN')
    call RemoveUnitFromStock(SF_Tavern[p], 'hPgP')
    set i=first
    loop
        exitwhen i > last or i > SF_PoolCount[p]
        call AddUnitToStock(SF_Tavern[p], SF_Pool[p * 128 + i], 1, 1)
        set i=i + 1
    endloop
    call AddUnitToStock(SF_Tavern[p], 'hPgN', 1, 1)
endfunction

function SF_OpenTaverns takes nothing returns nothing
    local integer p=1
    local integer i
    local integer h
    local integer category
    local real a
    if SF_Opened then
        return
    endif
    set SF_Opened=true
    set udg_numberofSDcategories=11
    loop
        exitwhen p > 12
        if udg_player_active[p] then
            set a=SF_Angle[p]
            set SF_Tavern[p]=CreateUnit(Player(p - 1), 'nFHT', SF_BaseX[p] + 320. * Cos(a) - 256. * Sin(a), SF_BaseY[p] + 320. * Sin(a) + 256. * Cos(a), Atan2(-256. - (SF_BaseY[p] + 320. * Sin(a) + 256. * Cos(a)), -(SF_BaseX[p] + 320. * Cos(a) - 256. * Sin(a))) * bj_RADTODEG)
            set i=1
            loop
                exitwhen i > udg_total_hero_count
                set udg_solo_tavern_hero_used[p * 128 + i]=false
                set i=i + 1
            endloop
            set category=1
            loop
                exitwhen category > 10
                set h=SoloFootsTakeTavernHero(p , category)
                if h != 0 then
                    set SF_PoolCount[p]=SF_PoolCount[p] + 1
                    set SF_Pool[p * 128 + SF_PoolCount[p]]=udg_hero_type[h]
                endif
                set category=category + 1
            endloop
            loop
                exitwhen SF_PoolCount[p] >= 24
                set h=SoloFootsTakeTavernHero(p , 0)
                exitwhen h == 0
                set SF_PoolCount[p]=SF_PoolCount[p] + 1
                set SF_Pool[p * 128 + SF_PoolCount[p]]=udg_hero_type[h]
            endloop
            call SF_RefreshPage(p)
            call SelectUnitForPlayerSingle(SF_Tavern[p], Player(p - 1))
            call SF_CenterBaseCamera(p)
            call DisplayTimedTextToPlayer(Player(p - 1), 0., 0., 15., "Choose a hero from your base tavern. Use Next page to cycle through all pages. Random hero at mass +15 seconds.")
        endif
        set p=p + 1
    endloop
endfunction

