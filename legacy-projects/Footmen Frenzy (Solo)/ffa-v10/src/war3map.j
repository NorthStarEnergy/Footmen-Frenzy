function Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002Func006C takes nothing returns boolean
    if ( not ( udg_HC_CurrentMagnetism > udg_HC_MagnetismCap ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_GROUND) == udg_HC_ConditionConfig[0] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_STRUCTURE) == udg_HC_ConditionConfig[1] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_MAGIC_IMMUNE) == udg_HC_ConditionConfig[2] ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_HC_TempUnit, udg_HC_OwningPlayer[udg_HC_Index]) == udg_HC_ConditionConfig[3] ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HC_TempUnit) == udg_HC_ConditionConfig[4] ) ) then
        return false
    endif
    if ( not ( IsUnitPausedBJ(udg_HC_TempUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func009A takes nothing returns nothing
    set udg_HC_TempUnit=GetEnumUnit()
    if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002C() ) then
        set udg_HC_TempPoint2=GetUnitLoc(udg_HC_TempUnit)
        set udg_HC_TempX=GetUnitX(udg_HC_TempUnit)
        set udg_HC_TempY=GetUnitY(udg_HC_TempUnit)
        set udg_HC_Angle=Atan2(GetUnitY(udg_HC_UnitIndex[udg_HC_Index]) - GetUnitY(udg_HC_TempUnit), GetUnitX(udg_HC_UnitIndex[udg_HC_Index]) - GetUnitX(udg_HC_TempUnit))
        set udg_HC_CurrentMagnetism=( udg_HC_MagnetismStrength[udg_HC_Index] / ( DistanceBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2) * udg_HC_MagnetismDistanceMultiplyer ) )
        if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func009Func002Func006C() ) then
            set udg_HC_CurrentMagnetism=udg_HC_MagnetismCap
        else
        endif
        call SetUnitX(udg_HC_TempUnit, udg_HC_TempX + udg_HC_CurrentMagnetism * Cos(udg_HC_Angle))
        call SetUnitY(udg_HC_TempUnit, udg_HC_TempY + udg_HC_CurrentMagnetism * Sin(udg_HC_Angle))
        call RemoveLocation(udg_HC_TempPoint2)
    else
    endif
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002Func009C takes nothing returns boolean
    if ( not ( udg_HC_BlastDistance[udg_HC_MaxIndex] > udg_HC_BlastCap ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_GROUND) == udg_HC_ConditionConfig[0] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_STRUCTURE) == udg_HC_ConditionConfig[1] ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HC_TempUnit, UNIT_TYPE_MAGIC_IMMUNE) == udg_HC_ConditionConfig[2] ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_HC_TempUnit, udg_HC_OwningPlayer[udg_HC_Index]) == udg_HC_ConditionConfig[3] ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HC_TempUnit) == udg_HC_ConditionConfig[4] ) ) then
        return false
    endif
    if ( not ( IsUnitPausedBJ(udg_HC_TempUnit) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003A takes nothing returns nothing
    set udg_HC_TempUnit=GetEnumUnit()
    if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002C() ) then
        set udg_HC_TempPoint2=GetUnitLoc(udg_HC_TempUnit)
        call UnitDamageTargetBJ(udg_HC_OriginalCaster[udg_HC_Index], udg_HC_TempUnit, udg_HC_ExplosionDamage[udg_HC_Index], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
        set udg_HC_MaxIndex=( udg_HC_MaxIndex + 1 )
        call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit, udg_HC_BurnSFX)
        set udg_HC_SpecialEffect[udg_HC_MaxIndex]=GetLastCreatedEffectBJ()
        set udg_HC_CurrentAngle[udg_HC_MaxIndex]=AngleBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2)
        set udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_BlastDistance[udg_HC_MaxIndex]=( udg_HC_BlastDistanceBase / ( DistanceBetweenPoints(udg_HC_TempPoint, udg_HC_TempPoint2) * udg_HC_BlastDistanceMultiplyer ) )
        if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003Func002Func009C() ) then
            set udg_HC_BlastDistance[udg_HC_MaxIndex]=udg_HC_BlastCap
        else
        endif
        set udg_HC_MaxHeight[udg_HC_MaxIndex]=( udg_HC_BlastDistance[udg_HC_MaxIndex] * udg_HC_HeightMultiplyer )
        set udg_HC_CurrentHeight[udg_HC_MaxIndex]=GetUnitFlyHeight(udg_HC_TempUnit)
        set udg_HC_StageID[udg_HC_MaxIndex]=4
        set udg_HC_UnitIndex[udg_HC_MaxIndex]=udg_HC_TempUnit
        //  
        set udg_HC_Aoe[udg_HC_MaxIndex]=0.00
        set udg_HC_OriginalCaster[udg_HC_MaxIndex]=udg_HC_TempUnit
        set udg_HC_OwningPlayer[udg_HC_MaxIndex]=GetOwningPlayer(udg_HC_TempUnit)
        set udg_HC_CurrentSunDistance[udg_HC_MaxIndex]=0.00
        set udg_HC_Core[udg_HC_MaxIndex]=udg_HC_TempUnit
        set udg_HC_ExplosionDamage[udg_HC_MaxIndex]=0.00
        set udg_HC_MagnetismStrength[udg_HC_MaxIndex]=0.00
        call UnitAddAbilityBJ('Arav', udg_HC_TempUnit)
        call UnitRemoveAbilityBJ('Arav', udg_HC_TempUnit)
        call PauseUnitBJ(true, udg_HC_TempUnit)
        call RemoveLocation(udg_HC_TempPoint2)
    else
    endif
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func006Func001C takes nothing returns boolean
    if ( not ( udg_HC_Core[udg_HC_SecondaryIndex] == udg_HC_UnitIndex[udg_HC_Index] ) ) then
        return false
    endif
    if ( not ( udg_HC_UnitIndex[udg_HC_SecondaryIndex] != udg_HC_UnitIndex[udg_HC_Index] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func034C takes nothing returns boolean
    if ( not ( udg_HC_MaxIndex == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004Func013C takes nothing returns boolean
    if ( not ( udg_HC_CurrentSunDistance[udg_HC_Index] >= udg_HC_Distance[udg_HC_Index] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func004C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func006C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002Func008C takes nothing returns boolean
    if ( not ( udg_HC_StageID[udg_HC_Index] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HC_UnitIndex[udg_HC_Index]) == udg_HC_DummyType ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Loop_Actions takes nothing returns nothing
    set udg_HC_Index=1
    loop
        exitwhen udg_HC_Index > udg_HC_MaxIndex
        set udg_HC_Angle=0.00
        if ( Trig_Helios_Collision_Loop_Func001Func002C() ) then
            // Control over Sun
            if ( Trig_Helios_Collision_Loop_Func001Func002Func004C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_SunSpeed * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_SunSpeed * Sin(udg_HC_Angle))
                // Magnetism Control
                set udg_HC_TempPoint=GetUnitLoc(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_TempGroup=GetUnitsInRangeOfLocAll(udg_HC_Aoe[udg_HC_Index], udg_HC_TempPoint)
                call ForGroupBJ(udg_HC_TempGroup, function Trig_Helios_Collision_Loop_Func001Func002Func004Func009A)
                call DestroyGroup(udg_HC_TempGroup)
                set udg_HC_CurrentSunDistance[udg_HC_Index]=( udg_HC_CurrentSunDistance[udg_HC_Index] + udg_HC_SunSpeed )
                // Explosion Control
                if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013C() ) then
                    set udg_HC_TempGroup=GetUnitsInRangeOfLocAll(udg_HC_ExplosionAOE, udg_HC_TempPoint)
                    // Effected Units
                    call ForGroupBJ(udg_HC_TempGroup, function Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func003A)
                    call DestroyGroup(udg_HC_TempGroup)
                    // Cleanup
                    set udg_HC_SecondaryIndex=1
                    loop
                        exitwhen udg_HC_SecondaryIndex > udg_HC_MaxIndex
                        if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func006Func001C() ) then
                            set udg_HC_TempUnit=udg_HC_UnitIndex[udg_HC_SecondaryIndex]
                            set udg_HC_TempPoint2=GetUnitLoc(udg_HC_TempUnit)
                            call DestroyEffectBJ(udg_HC_SpecialEffect[udg_HC_SecondaryIndex])
                            call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint2, bj_UNIT_FACING)
                            set udg_HC_TempUnit2=GetLastCreatedUnit()
                            call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit2, udg_HC_ExplosionSFX)
                            call SetUnitScalePercent(udg_HC_TempUnit2, udg_HC_EffectScalingBlast, 0.00, 0.00)
                            call SetUnitFlyHeightBJ(udg_HC_TempUnit2, udg_HC_EffectZBlast, 0.00)
                            call DestroyEffectBJ(GetLastCreatedEffectBJ())
                            call UnitApplyTimedLifeBJ(udg_HC_DummyExpirationTimers, 'BTLF', udg_HC_TempUnit2)
                            set udg_HC_StageID[udg_HC_SecondaryIndex]=udg_HC_StageID[udg_HC_MaxIndex]
                            set udg_HC_Aoe[udg_HC_SecondaryIndex]=udg_HC_Aoe[udg_HC_MaxIndex]
                            set udg_HC_OriginalCaster[udg_HC_SecondaryIndex]=udg_HC_OriginalCaster[udg_HC_MaxIndex]
                            set udg_HC_BlastDistance[udg_HC_SecondaryIndex]=udg_HC_BlastDistance[udg_HC_MaxIndex]
                            set udg_HC_CurrentAngle[udg_HC_SecondaryIndex]=udg_HC_CurrentAngle[udg_HC_MaxIndex]
                            set udg_HC_CurrentBlastDistance[udg_HC_SecondaryIndex]=udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]
                            set udg_HC_OwningPlayer[udg_HC_SecondaryIndex]=udg_HC_OwningPlayer[udg_HC_MaxIndex]
                            set udg_HC_MaxHeight[udg_HC_SecondaryIndex]=udg_HC_MaxHeight[udg_HC_MaxIndex]
                            set udg_HC_SpecialEffect[udg_HC_SecondaryIndex]=udg_HC_SpecialEffect[udg_HC_MaxIndex]
                            set udg_HC_CurrentHeight[udg_HC_SecondaryIndex]=udg_HC_CurrentHeight[udg_HC_MaxIndex]
                            set udg_HC_CurrentSunDistance[udg_HC_SecondaryIndex]=udg_HC_CurrentSunDistance[udg_HC_MaxIndex]
                            set udg_HC_ExplosionDamage[udg_HC_SecondaryIndex]=udg_HC_ExplosionDamage[udg_HC_MaxIndex]
                            set udg_HC_Core[udg_HC_SecondaryIndex]=udg_HC_Core[udg_HC_MaxIndex]
                            set udg_HC_UnitIndex[udg_HC_SecondaryIndex]=udg_HC_UnitIndex[udg_HC_MaxIndex]
                            set udg_HC_MagnetismStrength[udg_HC_SecondaryIndex]=udg_HC_MagnetismStrength[udg_HC_MaxIndex]
                            set udg_HC_MaxIndex=( udg_HC_MaxIndex - 1 )
                            set udg_HC_SecondaryIndex=( udg_HC_SecondaryIndex - 1 )
                            call RemoveUnit(udg_HC_TempUnit)
                            call RemoveLocation(udg_HC_TempPoint2)
                        else
                        endif
                        set udg_HC_SecondaryIndex=udg_HC_SecondaryIndex + 1
                    endloop
                    call CreateNUnitsAtLoc(1, udg_HC_DummyType, Player(PLAYER_NEUTRAL_PASSIVE), udg_HC_TempPoint, bj_UNIT_FACING)
                    set udg_HC_TempUnit=GetLastCreatedUnit()
                    call DestroyEffectBJ(udg_HC_SpecialEffect[udg_HC_Index])
                    call AddSpecialEffectTargetUnitBJ("origin", udg_HC_TempUnit, udg_HC_ExplosionSFX)
                    call SetUnitScalePercent(udg_HC_TempUnit, udg_HC_EffectScalingBlast, 0.00, 0.00)
                    call SetUnitFlyHeightBJ(udg_HC_TempUnit, udg_HC_EffectZBlast, 0.00)
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    call UnitApplyTimedLifeBJ(udg_HC_DummyExpirationTimers, 'BTLF', udg_HC_TempUnit)
                    set udg_HC_TempUnit=udg_HC_UnitIndex[udg_HC_Index]
                    set udg_HC_StageID[udg_HC_Index]=udg_HC_StageID[udg_HC_MaxIndex]
                    set udg_HC_Aoe[udg_HC_Index]=udg_HC_Aoe[udg_HC_MaxIndex]
                    set udg_HC_OriginalCaster[udg_HC_Index]=udg_HC_OriginalCaster[udg_HC_MaxIndex]
                    set udg_HC_BlastDistance[udg_HC_Index]=udg_HC_BlastDistance[udg_HC_MaxIndex]
                    set udg_HC_CurrentAngle[udg_HC_Index]=udg_HC_CurrentAngle[udg_HC_MaxIndex]
                    set udg_HC_OwningPlayer[udg_HC_Index]=udg_HC_OwningPlayer[udg_HC_MaxIndex]
                    set udg_HC_MaxHeight[udg_HC_Index]=udg_HC_MaxHeight[udg_HC_MaxIndex]
                    set udg_HC_CurrentBlastDistance[udg_HC_Index]=udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]
                    set udg_HC_CurrentHeight[udg_HC_Index]=udg_HC_CurrentHeight[udg_HC_MaxIndex]
                    set udg_HC_SpecialEffect[udg_HC_Index]=udg_HC_SpecialEffect[udg_HC_MaxIndex]
                    set udg_HC_CurrentSunDistance[udg_HC_Index]=udg_HC_CurrentSunDistance[udg_HC_MaxIndex]
                    set udg_HC_Core[udg_HC_Index]=udg_HC_Core[udg_HC_MaxIndex]
                    set udg_HC_UnitIndex[udg_HC_Index]=udg_HC_UnitIndex[udg_HC_MaxIndex]
                    set udg_HC_ExplosionDamage[udg_HC_Index]=udg_HC_ExplosionDamage[udg_HC_MaxIndex]
                    set udg_HC_MagnetismStrength[udg_HC_Index]=udg_HC_MagnetismStrength[udg_HC_MaxIndex]
                    set udg_HC_MaxIndex=( udg_HC_MaxIndex - 1 )
                    set udg_HC_Index=( udg_HC_Index - 1 )
                    call RemoveUnit(udg_HC_TempUnit)
                    if ( Trig_Helios_Collision_Loop_Func001Func002Func004Func013Func034C() ) then
                        call DisableTrigger(GetTriggeringTrigger())
                    else
                    endif
                else
                endif
                call RemoveLocation(udg_HC_TempPoint)
            else
            endif
            // Fire balls Spin Control
            if ( Trig_Helios_Collision_Loop_Func001Func002Func006C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_Core[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_Core[udg_HC_Index])
                set udg_HC_CurrentAngle[udg_HC_Index]=( udg_HC_CurrentAngle[udg_HC_Index] + udg_HC_FireOrbSpinSpeed )
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_OrbDistance * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_OrbDistance * Sin(udg_HC_Angle))
                set udg_HC_TempPoint=GetUnitLoc(udg_HC_Core[udg_HC_Index])
                call SetUnitFacingToFaceLocTimed(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempPoint, 0)
                call RemoveLocation(udg_HC_TempPoint)
            else
            endif
            // Wind Spin Control
            if ( Trig_Helios_Collision_Loop_Func001Func002Func008C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_Core[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_Core[udg_HC_Index])
                set udg_HC_CurrentAngle[udg_HC_Index]=( udg_HC_CurrentAngle[udg_HC_Index] + udg_HC_WindSpinSpeed )
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_WindDistance * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_WindDistance * Sin(udg_HC_Angle))
            else
            endif
        else
            //  Control of Knockbacked units
            if ( Trig_Helios_Collision_Loop_Func001Func002Func003C() ) then
                set udg_HC_TempX=GetUnitX(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_TempY=GetUnitY(udg_HC_UnitIndex[udg_HC_Index])
                set udg_HC_Angle=udg_HC_CurrentAngle[udg_HC_Index] * bj_DEGTORAD
                call SetUnitX(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempX + udg_HC_BlastSpeed * Cos(udg_HC_Angle))
                call SetUnitY(udg_HC_UnitIndex[udg_HC_Index], udg_HC_TempY + udg_HC_BlastSpeed * Sin(udg_HC_Angle))
                set udg_HC_CurrentBlastDistance[udg_HC_Index]=( udg_HC_CurrentBlastDistance[udg_HC_Index] + udg_HC_BlastSpeed )
                set udg_HC_CurrentHeight[udg_HC_Index]=( ( ( 4.00 * udg_HC_MaxHeight[udg_HC_Index] ) / udg_HC_BlastDistance[udg_HC_Index] ) * ( ( udg_HC_CurrentBlastDistance[udg_HC_Index] / udg_HC_BlastDistance[udg_HC_Index] ) * ( udg_HC_BlastDistance[udg_HC_Index] - udg_HC_CurrentBlastDistance[udg_HC_Index] ) ) )
                call SetUnitFlyHeightBJ(udg_HC_UnitIndex[udg_HC_Index], udg_HC_CurrentHeight[udg_HC_Index], 0.00)
                // Unit Release
                if ( Trig_Helios_Collision_Loop_Func001Func002Func003Func010C() ) then
                    call DestroyEffectBJ(udg_HC_SpecialEffect[udg_HC_Index])
                    call PauseUnitBJ(false, udg_HC_UnitIndex[udg_HC_Index])
                    set udg_HC_StageID[udg_HC_Index]=udg_HC_StageID[udg_HC_MaxIndex]
                    set udg_HC_Aoe[udg_HC_Index]=udg_HC_Aoe[udg_HC_MaxIndex]
                    set udg_HC_OriginalCaster[udg_HC_Index]=udg_HC_OriginalCaster[udg_HC_MaxIndex]
                    set udg_HC_OwningPlayer[udg_HC_Index]=udg_HC_OwningPlayer[udg_HC_MaxIndex]
                    set udg_HC_BlastDistance[udg_HC_Index]=udg_HC_BlastDistance[udg_HC_MaxIndex]
                    set udg_HC_CurrentAngle[udg_HC_Index]=udg_HC_CurrentAngle[udg_HC_MaxIndex]
                    set udg_HC_CurrentBlastDistance[udg_HC_Index]=udg_HC_CurrentBlastDistance[udg_HC_MaxIndex]
                    set udg_HC_SpecialEffect[udg_HC_Index]=udg_HC_SpecialEffect[udg_HC_MaxIndex]
                    set udg_HC_CurrentHeight[udg_HC_Index]=udg_HC_CurrentHeight[udg_HC_MaxIndex]
                    set udg_HC_MaxHeight[udg_HC_Index]=udg_HC_MaxHeight[udg_HC_MaxIndex]
                    set udg_HC_CurrentSunDistance[udg_HC_Index]=udg_HC_CurrentSunDistance[udg_HC_MaxIndex]
                    set udg_HC_Core[udg_HC_Index]=udg_HC_Core[udg_HC_MaxIndex]
                    set udg_HC_UnitIndex[udg_HC_Index]=udg_HC_UnitIndex[udg_HC_MaxIndex]
                    set udg_HC_ExplosionDamage[udg_HC_Index]=udg_HC_ExplosionDamage[udg_HC_MaxIndex]
                    set udg_HC_MagnetismStrength[udg_HC_Index]=udg_HC_MagnetismStrength[udg_HC_MaxIndex]
                    set udg_HC_MaxIndex=( udg_HC_MaxIndex - 1 )
                    set udg_HC_Index=( udg_HC_Index - 1 )
                    if ( Trig_Helios_Collision_Loop_Func001Func002Func003Func010Func020C() ) then
                        call DisableTrigger(GetTriggeringTrigger())
                    else
                    endif
                else
                endif
            else
            endif
        endif
        set udg_HC_Index=udg_HC_Index + 1
    endloop
endfunction

function InitTrig_Helios_Collision_Loop takes nothing returns nothing
    set gg_trg_Helios_Collision_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Helios_Collision_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Helios_Collision_Loop, 0.03)
    call TriggerAddAction(gg_trg_Helios_Collision_Loop, function Trig_Helios_Collision_Loop_Actions)
endfunction

function Trig_Helios_Collision_Dummy_Removal_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HC_TempUnit) == udg_HC_DummyType ) ) then
        return false
    endif
    return true
endfunction

function Trig_Helios_Collision_Dummy_Removal_Actions takes nothing returns nothing
    set udg_HC_TempUnit=GetTriggerUnit()
    if ( Trig_Helios_Collision_Dummy_Removal_Func002C() ) then
        call RemoveUnit(udg_HC_TempUnit)
    else
    endif
endfunction

function InitTrig_Helios_Collision_Dummy_Removal takes nothing returns nothing
    set gg_trg_Helios_Collision_Dummy_Removal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Helios_Collision_Dummy_Removal, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(gg_trg_Helios_Collision_Dummy_Removal, function Trig_Helios_Collision_Dummy_Removal_Actions)
endfunction

function Trig_Guardian_Force_Field_Learn_Conditions takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'AFg1' ) ) then
        return false
    endif
    if ( not ( GetLearnedSkillLevel() == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Learn_Actions takes nothing returns nothing
    if udg_Guardian_FF_Hash == null then
    call InitHashtableBJ()
    set udg_Guardian_FF_Hash=GetLastCreatedHashtableBJ()
    endif
endfunction

function InitTrig_Guardian_Force_Field_Learn takes nothing returns nothing
    set gg_trg_Guardian_Force_Field_Learn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Guardian_Force_Field_Learn, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_Guardian_Force_Field_Learn, Condition(function Trig_Guardian_Force_Field_Learn_Conditions))
    call TriggerAddAction(gg_trg_Guardian_Force_Field_Learn, function Trig_Guardian_Force_Field_Learn_Actions)
endfunction

function Trig_Guardian_Force_Field_Detonate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AFFD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Detonate_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Guardian == udg_Guardian_FF_Caster[udg_Guardian_FF_Loop] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Detonate_Actions takes nothing returns nothing
    set udg_Guardian=GetTriggerUnit()
    set udg_Guardian_FF_Loop=1
    loop
        exitwhen udg_Guardian_FF_Loop > udg_Guardian_FF_Index
        if ( Trig_Guardian_Force_Field_Detonate_Func002Func001C() ) then
            set udg_Guardian_FF_Duration[udg_Guardian_FF_Loop]=0.00
        else
        endif
        set udg_Guardian_FF_Loop=udg_Guardian_FF_Loop + 1
    endloop
endfunction

