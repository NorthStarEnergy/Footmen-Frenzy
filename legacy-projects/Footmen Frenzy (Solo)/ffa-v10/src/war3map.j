endfunction

function Trig_HERO_Corruptor_Defile_Action_Actions takes nothing returns nothing
    local integer i= 0
    loop
    exitwhen i > 24
    set i=i + 1
    if GetExpiredTimer() == udg_timer_defile[i] then
    set udg_X=i
    set i=100
    endif
    endloop
    //                                                                                            
    // ==================================================
    // DEFINE THE DAMAGE PER LVL:
    set udg_Defile_Damage[1]=50.00
    set udg_Defile_Damage[2]=90.00
    set udg_Defile_Damage[3]=175.00
    set udg_Defile_Damage[4]=250.00
    set udg_Defile_Damage[5]=300.00
    set udg_Defile_Damage[6]=400.00
    // ==================================================
    //                                                                                            
    set udg_Defile_Caster=udg_herO[udg_X]
    set udg_Defile_Level=GetUnitAbilityLevelSwapped('A0G8', udg_Defile_Caster)
    // 145 base AoE + 32 to account for the average collision size
    set udg_temp_AoE=165.00
    set udg_Defile_Group=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_defile_point[udg_X], Condition(function Trig_HERO_Corruptor_Defile_Action_Func025002003))
    call ForGroupBJ(udg_Defile_Group, function Trig_HERO_Corruptor_Defile_Action_Func026A)
    //                                                                                            
    call AddSpecialEffectLocBJ(udg_defile_point[udg_X], "Void Disc.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 0.50)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                            
    // SLOW ALL UNITS
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Defile_Caster), udg_defile_point[udg_X], bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0FZ', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0FZ', udg_dummy, udg_Defile_Level)
    call IssueImmediateOrderBJ(udg_dummy, "thunderclap")
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_dummy)
    //                                                                                            
    // Double damage on single target:
    if ( Trig_HERO_Corruptor_Defile_Action_Func041C() ) then
        set udg_Defile_Damage[0]=( udg_Defile_Damage[udg_Defile_Level] * 2.00 )
    else
        set udg_Defile_Damage[0]=( udg_Defile_Damage[udg_Defile_Level] + 0.00 )
    endif
    //                                                                                            
    call ForGroupBJ(udg_Defile_Group, function Trig_HERO_Corruptor_Defile_Action_Func043A)
    //                                                                                            
    call RemoveLocation(udg_defile_point[udg_X])
    call DestroyGroup(udg_Defile_Group)
endfunction

