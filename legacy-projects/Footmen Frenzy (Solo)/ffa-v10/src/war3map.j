        local integer missile= udg_Missile
        
        call s__Missiles_deflect(missile,GetLocationX(udg_MissileDeflectPosition) , GetLocationY(udg_MissileDeflectPosition) , udg_MissileDeflectZ)
        call RemoveLocation(udg_MissileDeflectPosition)
        
        set udg_MissileDeflectPosition=null
    endfunction

    function MissileFlush takes nothing returns nothing
        local integer missile= udg_Missile
        
        call s__Missiles_flush(missile,udg_MissileFlushUnit)
        
