function Trig_Shockwave_Loop_Func001Func010A takes nothing returns nothing
    set udg_SW_HitUnit=GetEnumUnit()
    if ( Trig_Shockwave_Loop_Func001Func010Func002C() ) then
        call UnitDamageTargetBJ(udg_SW_Caster[udg_SW_Loop], udg_SW_HitUnit, udg_SW_DamageX[udg_SW_Loop], udg_SW_AttackType[udg_SW_Loop], udg_SW_DamageType[udg_SW_Loop])
        if ( Trig_Shockwave_Loop_Func001Func010Func002Func002001() ) then
            call ConditionalTriggerExecute(udg_SW_ExtraEffectTarget[udg_SW_Loop])
        else
            call DoNothing()
        endif
        if ( Trig_Shockwave_Loop_Func001Func010Func002Func003001() ) then
            call GroupAddUnitSimple(udg_SW_HitUnit, udg_SW_GroupDone[udg_SW_Loop])
        else
            call DoNothing()
        endif
    else
    endif
    if ( Trig_Shockwave_Loop_Func001Func010Func003C() ) then
        if ( Trig_Shockwave_Loop_Func001Func010Func003Func001001() ) then
            call ConditionalTriggerExecute(udg_SW_ExtraEffectTarget[udg_SW_Loop])
        else
            call DoNothing()
        endif
        if ( Trig_Shockwave_Loop_Func001Func010Func003Func002001() ) then
            call GroupAddUnitSimple(udg_SW_HitUnit, udg_SW_GroupDone[udg_SW_Loop])
        else
            call DoNothing()
        endif
    else
    endif
endfunction

function Trig_Shockwave_Loop_Func001Func011C takes nothing returns boolean
    if ( not ( udg_SW_DistanceX[udg_SW_Loop] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shockwave_Loop_Func001Func015C takes nothing returns boolean
    if ( not ( udg_SW_Max == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shockwave_Loop_Actions takes nothing returns nothing
    set udg_SW_Loop=1
    loop
        exitwhen udg_SW_Loop > udg_SW_Max
        set udg_SW_DistanceX[udg_SW_Loop]=( udg_SW_DistanceX[udg_SW_Loop] - ( udg_SW_SpeedX[udg_SW_Loop] / ( 1 / 0.03 ) ) )
        set udg_SW_Angle=GetUnitFacing(udg_SW_Dummy[udg_SW_Loop])
        set udg_SW_NextPoint[0]=GetUnitLoc(udg_SW_Dummy[udg_SW_Loop])
        set udg_SW_NextPoint[1]=PolarProjectionBJ(udg_SW_NextPoint[0], ( udg_SW_SpeedX[udg_SW_Loop] / ( 1.00 / 0.03 ) ), udg_SW_Angle)
        set udg_SW_AreaCurrent[udg_SW_Loop]=( udg_SW_AreaCurrent[udg_SW_Loop] + udg_SW_AreaGrowth[udg_SW_Loop] )
        set udg_SW_Group=GetUnitsInRangeOfLocAll(udg_SW_AreaCurrent[udg_SW_Loop], udg_SW_NextPoint[1])
        call SetUnitPositionLocFacingBJ(udg_SW_Dummy[udg_SW_Loop], udg_SW_NextPoint[1], udg_SW_Angle)
        if ( Trig_Shockwave_Loop_Func001Func008001() ) then
            call ConditionalTriggerExecute(udg_SW_ExtraEffect[udg_SW_Loop])
        else
            call DoNothing()
        endif
        if ( Trig_Shockwave_Loop_Func001Func009C() ) then
            call AddSpecialEffectLocBJ(udg_SW_NextPoint[0], udg_SW_WaveEffectLoop[udg_SW_Loop])
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
        call ForGroupBJ(udg_SW_Group, function Trig_Shockwave_Loop_Func001Func010A)
        if ( Trig_Shockwave_Loop_Func001Func011C() ) then
            call AddSpecialEffectTargetUnitBJ("origin", udg_SW_Dummy[udg_SW_Loop], udg_SW_WaveEffectEnd[udg_SW_Loop])
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            call DestroyEffectBJ(udg_SW_Wave[udg_SW_Loop])
            call DestroyGroup(udg_SW_GroupDone[udg_SW_Loop])
            set udg_SW_GroupDone[udg_SW_Loop]=udg_SW_GroupDone[udg_SW_Max]
            set udg_SW_Caster[udg_SW_Loop]=udg_SW_Caster[udg_SW_Max]
            set udg_SW_Caster[udg_SW_Max]=null
            call KillUnit(udg_SW_Dummy[udg_SW_Loop])
            set udg_SW_Dummy[udg_SW_Loop]=udg_SW_Dummy[udg_SW_Max]
            set udg_SW_Dummy[udg_SW_Max]=null
            set udg_SW_Wave[udg_SW_Loop]=udg_SW_Wave[udg_SW_Max]
            set udg_SW_WaveEffectEnd[udg_SW_Loop]=udg_SW_WaveEffectEnd[udg_SW_Max]
            set udg_SW_WaveEffectLoop[udg_SW_Loop]=udg_SW_WaveEffectLoop[udg_SW_Max]
            set udg_SW_LoopingSfx[udg_SW_Loop]=udg_SW_LoopingSfx[udg_SW_Max]
            set udg_SW_ExtraEffectCheck[udg_SW_Loop]=udg_SW_ExtraEffectCheck[udg_SW_Max]
            set udg_SW_ExtraEffect[udg_SW_Loop]=udg_SW_ExtraEffect[udg_SW_Max]
            set udg_SW_ExtraEffectTargetCheck[udg_SW_Loop]=udg_SW_ExtraEffectTargetCheck[udg_SW_Max]
            set udg_SW_ExtraEffectTarget[udg_SW_Loop]=udg_SW_ExtraEffectTarget[udg_SW_Max]
            set udg_SW_AffectAlly[udg_SW_Loop]=udg_SW_AffectAlly[udg_SW_Max]
            set udg_SW_AffectEnemy[udg_SW_Loop]=udg_SW_AffectEnemy[udg_SW_Max]
            set udg_SW_AffectAir[udg_SW_Loop]=udg_SW_AffectAir[udg_SW_Max]
            set udg_SW_AffectStructure[udg_SW_Loop]=udg_SW_AffectStructure[udg_SW_Max]
            set udg_SW_AffectGround[udg_SW_Loop]=udg_SW_AffectGround[udg_SW_Max]
            set udg_SW_OneInstance[udg_SW_Loop]=udg_SW_OneInstance[udg_SW_Max]
            set udg_SW_AttackType[udg_SW_Loop]=udg_SW_AttackType[udg_SW_Max]
            set udg_SW_DamageType[udg_SW_Loop]=udg_SW_DamageType[udg_SW_Max]
            set udg_SW_DamageX[udg_SW_Loop]=udg_SW_DamageX[udg_SW_Max]
            set udg_SW_AreaCurrent[udg_SW_Loop]=udg_SW_AreaCurrent[udg_SW_Max]
            set udg_SW_AreaGrowth[udg_SW_Loop]=udg_SW_AreaGrowth[udg_SW_Max]
            set udg_SW_SpeedX[udg_SW_Loop]=udg_SW_SpeedX[udg_SW_Max]
            set udg_SW_DistanceX[udg_SW_Loop]=udg_SW_DistanceX[udg_SW_Max]
            set udg_SW_Lvl[udg_SW_Loop]=udg_SW_Lvl[udg_SW_Max]
            set udg_SW_Max=( udg_SW_Max - 1 )
            set udg_SW_Loop=( udg_SW_Loop - 1 )
        else
        endif
        call RemoveLocation(udg_SW_NextPoint[0])
        call RemoveLocation(udg_SW_NextPoint[1])
        call DestroyGroup(udg_SW_Group)
        if ( Trig_Shockwave_Loop_Func001Func015C() ) then
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
        set udg_SW_Loop=udg_SW_Loop + 1
    endloop
endfunction

function InitTrig_Shockwave_Loop takes nothing returns nothing
    set gg_trg_Shockwave_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Shockwave_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Shockwave_Loop, 0.03)
    call TriggerAddAction(gg_trg_Shockwave_Loop, function Trig_Shockwave_Loop_Actions)
endfunction

function Trig_HERO_Swift_Strike_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetAttacker(), 'B01F') == true ) ) then
        return false
    endif
    if ( not ( udg_b1ik[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Swift_Strike_Actions takes nothing returns nothing
    set udg_temp_unit=GetAttacker()
    set udg_temp_target=GetAttackedUnitBJ()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_temp_degree=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    // action
    call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl")
    call AddSpecialEffectLocBJ(udg_temp_point, "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

