function Trig_HERO_Footgirl_Interchange_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AINC' ) ) then
        return false
    endif
    if ( not ( udg_b1ik[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Footgirl_Interchange_Actions takes nothing returns nothing
    local lightning l
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_casting_hero[udg_temp_playernumber]=GetSpellAbilityUnit()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_casting_hero[udg_temp_playernumber])
    set udg_temp_unit=GetSpellTargetUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_point_caster=GetUnitLoc(udg_casting_hero[udg_temp_playernumber])
    //                                                                                         
    call AddLightningLoc("CHIM", udg_temp_point, udg_temp_point_caster)
    set l=bj_lastCreatedLightning
    //                                                                                         
    call PlaySoundOnUnitBJ(gg_snd_SoulPreservation, 90.00, udg_temp_unit)
    call SetUnitPositionLoc(udg_casting_hero[udg_temp_playernumber], udg_temp_point)
    call SetUnitPositionLoc(udg_temp_unit, udg_temp_point_caster)
    call StartTimerBJ(udg_timer_interchange[udg_temp_playernumber], false, 12.00)
    call BlzStartUnitAbilityCooldown(udg_casting_hero[udg_temp_playernumber], 'AINC', BlzGetAbilityCooldown('AINC', ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 )))
    call CreateNUnitsAtLoc(1, 'dmmy', udg_temp_player, udg_temp_point_caster, bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0A6', udg_dummy)
    call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
    call IssueTargetOrderBJ(udg_dummy, "slow", udg_temp_unit)
    call PolledWait(1.50)
    call DestroyLightning(l)
    set l=null
endfunction

