    call TriggerAddCondition(gg_trg_Axe_OnHit, Condition(function Trig_Axe_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Axe_OnHit, function Trig_Axe_OnHit_Actions)
endfunction

