    function MissilePause takes nothing returns nothing
        local integer missile= udg_Missile
        
        call s__Missiles_pause(missile,true)
    endfunction

    function MissileResume takes nothing returns nothing
        local integer missile= udg_Missile
        
        call s__Missiles_pause(missile,false)
