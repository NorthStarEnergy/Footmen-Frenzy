function Trig_fake_shops_insert_Actions takes nothing returns nothing
    if ( Trig_fake_shops_insert_Func002C() ) then
        // Fake Shops
        call CreateNUnitsAtLoc(1, 'n02J', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_SDtavern[1], 130.00)
        set udg_fake_shop[1]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02J', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_SDtavern[2], 130.00)
        set udg_fake_shop[2]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02J', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_SDtavern[3], 310.00)
        set udg_fake_shop[3]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02J', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_SDtavern[4], 310.00)
        set udg_fake_shop[4]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_tavern[1], 130.00)
        set udg_fake_shop[13]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_tavern[2], 130.00)
        set udg_fake_shop[14]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_tavern[3], 130.00)
        set udg_fake_shop[15]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_tavern[4], 310.00)
        set udg_fake_shop[16]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_tavern[5], 310.00)
        set udg_fake_shop[17]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_tavern[6], 310.00)
        set udg_fake_shop[18]=GetLastCreatedUnit()
        set udg_X=1
        loop
            exitwhen udg_X > 18
            call GroupAddUnitSimple(udg_fake_shop[udg_X], udg_fakeshops)
            set udg_X=udg_X + 1
        endloop
    else
        call DoNothing()
    endif
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

