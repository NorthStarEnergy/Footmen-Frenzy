function Trig_MODE_King_Of_The_Hill_Actions takes nothing returns nothing
    // Create the hill and get the mode started once this trigger runs:
    if ( Trig_MODE_King_Of_The_Hill_Func002C() ) then
        if ( Trig_MODE_King_Of_The_Hill_Func002Func002C() ) then
            set udg_KOTH_Start_Delay=260.00
            if udg_mode_debugmode then
                call StartTimerBJ(udg_KOTH_Setup_Timer, false, 10.00)
            else
            call StartTimerBJ(udg_KOTH_Setup_Timer, false, udg_KOTH_Start_Delay)
            endif
            //                                                                                                     
            call EnableTrigger(gg_trg_KOTH_Setup)
            set udg_wmd[11]="|cff00ffffKing Of The Hill:|r |cff00ff00On|r"
        else
            if udg_mode_debugmode then
                call StartTimerBJ(udg_KOTH_Setup_Timer, false, 10.00)
            else
            call StartTimerBJ(udg_KOTH_Setup_Timer, false, udg_KOTH_Start_Delay)
            endif
            //                                                                                                     
            call EnableTrigger(gg_trg_KOTH_Setup)
            set udg_wmd[11]="|cff00ffffKing Of The Hill:|r |cff00ff00On|r"
        endif
    else
    endif
endfunction

