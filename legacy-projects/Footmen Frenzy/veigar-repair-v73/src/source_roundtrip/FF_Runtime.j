function Trig_autopool_time_Func001Func001C takes nothing returns boolean
    if ( not SoloSub_CanReceiveGold(udg_autopoolto[udg_temp_playernumber]) ) then
        return false
    endif
    if ( not ( udg_autopoolto[udg_temp_playernumber] >= 1 ) ) then
        return false
    endif
    if ( not ( GetPlayerState(ConvertedPlayer(udg_temp_playernumber), PLAYER_STATE_RESOURCE_GOLD) > udg_pool_threshold[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

function FFP_Transfer takes integer senderId, integer targetId, integer requested returns integer
    local integer key
    local integer remaining
    local integer available
    local integer amount
    local player sender
    local player target
    if not FFR4_PoolingAllowed() or senderId < 1 or senderId > 12 or targetId < 1 or targetId > 12 or senderId == targetId or requested <= 0 then
        return 0
    endif
    set sender = ConvertedPlayer(senderId)
    set target = ConvertedPlayer(targetId)
    if not IsPlayerAlly(target, sender) or not SoloSub_CanReceiveGold(targetId) then
        set sender = null
        set target = null
        return 0
    endif
    set key = senderId * 16 + targetId
    set remaining = 5000 - FFP_PairSent[key]
    set available = GetPlayerState(sender, PLAYER_STATE_RESOURCE_GOLD)
    set amount = IMinBJ(requested, IMinBJ(remaining, available))
    if amount > 0 then
        call SetPlayerState(sender, PLAYER_STATE_RESOURCE_GOLD, available - amount)
        call SetPlayerState(target, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(target, PLAYER_STATE_RESOURCE_GOLD) + amount)
        set FFP_PairSent[key] = FFP_PairSent[key] + amount
        set FF_st_poolOut[senderId] = FF_st_poolOut[senderId] + amount
        set FF_st_poolIn[targetId] = FF_st_poolIn[targetId] + amount
    else
        set amount = 0
    endif
    set sender = null
    set target = null
    return amount
endfunction

function Trig_autopool_time_Actions takes nothing returns nothing
    local integer senderId = 1
    local integer targetId
    local integer amount
    local integer requested
    if not FFR4_PoolingAllowed() then
        return
    endif
    loop
        exitwhen senderId > 12
        set targetId = udg_autopoolto[senderId]
        if targetId >= 1 and targetId <= 12 and targetId != senderId and SoloSub_CanReceiveGold(targetId) then
            set requested = GetPlayerState(ConvertedPlayer(senderId), PLAYER_STATE_RESOURCE_GOLD) - udg_pool_threshold[senderId]
            if requested > 0 then
                set amount = FFP_Transfer(senderId, targetId, requested)
                if amount > 0 then
                    call DisplayTimedTextToPlayer(ConvertedPlayer(senderId), 0, 0, 1.00, I2S(amount) + " |cffffcc00Gold|r sent to " + GetPlayerName(ConvertedPlayer(targetId)))
                    call DisplayTimedTextToPlayer(ConvertedPlayer(targetId), 0, 0, 1.00, I2S(amount) + " |cffffcc00Gold|r received from " + GetPlayerName(ConvertedPlayer(senderId)))
                endif
                if FFP_PairSent[senderId * 16 + targetId] >= 5000 then
                    set udg_autopoolto[senderId] = 0
                    call DisplayTimedTextToPlayer(ConvertedPlayer(senderId), 0, 0, 5.00, "Pooling limit reached: 5000 gold to this ally. Choose another ally with -pool.")
                endif
            endif
        endif
        set senderId = senderId + 1
    endloop
endfunction

