function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005Func003Func012Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SovietSniper_Unit[1]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_SovietSniper_Unit[1], GetOwningPlayer(udg_SovietSniper_Unit[0])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SovietSniper_Unit[1], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_SovietSniper_Unit[1]) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_SovietSniper_Unit[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SovietSniper_Unit[1], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005Func003Func012A takes nothing returns nothing
    set udg_SovietSniper_Unit[1]=GetEnumUnit()
    if ( Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005Func003Func012Func002C() ) then
        call IssueTargetOrderBJ(udg_SovietSniper_Unit[1], "attack", udg_SovietSniper_Unit[0])
    else
    endif
endfunction

function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005Func003C takes nothing returns boolean
    if ( not ( ModuloInteger(udg_SovietSniper_DB_Duration[udg_SovietSniper_CV], 75) == 0 ) ) then
        return false
    endif
    if ( not ( udg_SovietSniper_DB_Duration[udg_SovietSniper_CV] != 75 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func005C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('ADEC', udg_SovietSniper_DB_Hero[udg_SovietSniper_CV]) > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Loop_Func002Func009Func021Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SovietSniper_Unit[1]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_SovietSniper_Unit[1], GetOwningPlayer(udg_SovietSniper_Unit[0])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SovietSniper_Unit[1], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_SovietSniper_Unit[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SovietSniper_Unit[1], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
