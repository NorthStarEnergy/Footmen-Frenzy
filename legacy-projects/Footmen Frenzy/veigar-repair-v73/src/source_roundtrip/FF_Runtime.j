        return false
    endif
    return true
endfunction

function Trig_set_hero_bounty_Func004001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_BountyHero) == 'H00U' )
endfunction

function Trig_set_hero_bounty_Func005001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_BountyHero) == 'N00O' )
endfunction

function Trig_set_hero_bounty_Func006001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_BountyHero) == 'H00T' )
endfunction

function Trig_set_hero_bounty_Func007001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_BountyHero) == 'E00V' )
endfunction

function Trig_set_hero_bounty_Actions takes nothing returns nothing
    set udg_BountyHero=GetTriggerUnit()
    set udg_temp_level=GetHeroLevel(udg_BountyHero)
    set udg_hero_bounty_multiplier=1.00
    if ( ( GetUnitTypeId(udg_BountyHero) == 'H00U' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=0.50
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_BountyHero) == 'N00O' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.25
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_BountyHero) == 'H00T' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.50
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_BountyHero) == 'E00V' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.10
    else
        call DoNothing()
    endif
    set udg_temp_real=( I2R(udg_hero_bounty_base[udg_temp_level]) * udg_hero_bounty_multiplier )
    call BlzSetUnitIntegerFieldBJ(udg_BountyHero, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_temp_real))
    call BlzSetUnitIntegerFieldBJ(udg_BountyHero, UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, 0)
    call BlzSetUnitIntegerFieldBJ(udg_BountyHero, UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, 0)
endfunction

function InitTrig_set_hero_bounty takes nothing returns nothing
    set gg_trg_set_hero_bounty=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_set_hero_bounty, EVENT_PLAYER_HERO_LEVEL)
    call TriggerAddCondition(gg_trg_set_hero_bounty, Condition(function Trig_set_hero_bounty_Conditions))
    call TriggerAddAction(gg_trg_set_hero_bounty, function Trig_set_hero_bounty_Actions)
endfunction

