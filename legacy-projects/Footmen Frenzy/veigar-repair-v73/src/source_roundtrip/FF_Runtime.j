function MissileAttach takes nothing returns nothing
        local integer missile= udg_Missile
        
        set bj_lastCreatedEffect=( s__MissileEffect_attach(s__Missiles_effect[( missile )] , ( udg_MissileAttachModel ) , ( ( udg_MissileAttachX ) * 1.0 ) , ( ( udg_MissileAttachY ) * 1.0 ) , ( ( udg_MissileAttachZ ) * 1.0 ) , ( ( udg_MissileAttachScale ) * 1.0 )) ) // INLINED!!
