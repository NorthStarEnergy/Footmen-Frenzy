    call TriggerAddCondition(gg_trg_HERO_Blooddancer_Illusions_summon, Condition(function Trig_HERO_Blooddancer_Illusions_summon_Conditions))
    call TriggerAddAction(gg_trg_HERO_Blooddancer_Illusions_summon, function Trig_HERO_Blooddancer_Illusions_summon_Actions)
endfunction

