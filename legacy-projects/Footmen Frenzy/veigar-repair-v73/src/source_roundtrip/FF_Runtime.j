function InitTrig_ITEM_limits takes nothing returns nothing
    set gg_trg_ITEM_limits=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ITEM_limits, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_ITEM_limits, Condition(function PBI_Allowed))
    call TriggerAddAction(gg_trg_ITEM_limits, function Trig_ITEM_limits_Actions)
endfunction

function Trig_ITEM_combo_limits_Func007Func003Func001Func003C takes nothing returns boolean
    if ( ( GetItemTypeId(UnitItemInSlotBJ(udg_temp_unit, udg_X)) == 'hval' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(UnitItemInSlotBJ(udg_temp_unit, udg_X)) == 'evtl' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ITEM_combo_limits_Func007Func003Func001C takes nothing returns boolean
    if ( not Trig_ITEM_combo_limits_Func007Func003Func001Func003C() ) then
        return false
    endif
    return true
endfunction

