    set udg_temp_player=GetOwningPlayer(udg_upgrading_tower[udg_temp_playernumber])
    call DialogClearBJ(udg_dlg_downgrade[udg_temp_playernumber])
    call DialogSetMessageBJ(udg_dlg_downgrade[udg_temp_playernumber], "TRIGSTR_1768")
    call DialogAddButtonBJ(udg_dlg_downgrade[udg_temp_playernumber], "TRIGSTR_1783")
    set udg_dlg_btn_downgrade_yes[udg_temp_playernumber]=GetLastCreatedButtonBJ()
    call DialogAddButtonBJ(udg_dlg_downgrade[udg_temp_playernumber], "TRIGSTR_1784")
    set udg_dlg_btn_downgrade_no[udg_temp_playernumber]=GetLastCreatedButtonBJ()
