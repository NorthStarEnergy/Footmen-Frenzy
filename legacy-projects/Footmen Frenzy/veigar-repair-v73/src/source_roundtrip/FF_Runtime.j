function Trig_SovietSniper_Golovu_Shot_Loop_Func002A takes nothing returns nothing
    set udg_SovietSniper=GetEnumUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004C() ) then
        // Wind-up animation:
        if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func003C() ) then
            set udg_SovietSniper_GS_Duration[udg_SovietSniper_CV]=( udg_SovietSniper_GS_Duration[udg_SovietSniper_CV] + 1 )
            //                                                                                                          
            if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func003Func005C() ) then
                call SetUnitAnimation(udg_SovietSniper, "stand ready")
            else
            endif
        else
            call GroupRemoveUnitSimple(udg_SovietSniper, udg_SovietSniper_GS_Caster_Group)
            if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func003Func004C() ) then
                call DisableTrigger(gg_trg_SovietSniper_Golovu_Shot_Loop)
            else
            endif
        endif
        //                                                                                                          
    else
        // Unleash animation:
        if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005C() ) then
            set udg_SovietSniper_GS_Duration[udg_SovietSniper_CV]=( udg_SovietSniper_GS_Duration[udg_SovietSniper_CV] + 1 )
            //                                                                                                          
            if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008C() ) then
                call SetUnitAnimation(udg_SovietSniper, "spell")
                call QueueUnitAnimationBJ(udg_SovietSniper, "stand")
            else
                //                                                                                                          
                if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func002C() ) then
                    set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper)
                    set udg_SovietSniper_Real[0]=AngleBetweenPoints(udg_SovietSniper_Point[0], udg_SovietSniper_GS_Point[udg_SovietSniper_CV])
                    set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], 128.00, udg_SovietSniper_Real[0])
                    call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "Abilities\\Weapons\\RocketMissile\\RocketMissile.mdl")
                    call BlzSetSpecialEffectHeight(GetLastCreatedEffectBJ(), 60.00)
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    call RemoveLocation(udg_SovietSniper_Point[0])
                    call RemoveLocation(udg_SovietSniper_Point[1])
                else
                endif
                //                                                                                                          
                if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005C() ) then
                    set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper)
                    set udg_SovietSniper_Real[0]=AngleBetweenPoints(udg_SovietSniper_Point[0], udg_SovietSniper_GS_Point[udg_SovietSniper_CV])
                    set udg_SovietSniper_Group[0]=CreateGroup()
                    set udg_SovietSniper_Integer[0]=GetUnitAbilityLevelSwapped('A08W', udg_SovietSniper)
                    //                                                                                                          
                    // Missile Properties:
                    set udg_MissileSource=udg_SovietSniper
                    set udg_MissileStart=GetUnitLoc(udg_SovietSniper)
                    set udg_MissileFinish=PolarProjectionBJ(udg_SovietSniper_Point[0], 2000.00, udg_SovietSniper_Real[0])
                    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
                    set udg_MissileModel="Konstrukt_SniperMissile01.mdl"
                    set udg_MissileScale=1.10
                    set udg_MissileStartZ=90.00
                    set udg_MissileFinishZ=90.00
                    set udg_MissileSpeed=3000.00
                    set udg_MissileArc=0.00
                    call TriggerExecute(gg_trg_MissileCreate)
                    //                                                                                                          
                    // Slow Dummy:
                    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_SovietSniper), udg_SovietSniper_Point[0], bj_UNIT_FACING)
                    set udg_SovietSniper_Unit[1]=GetLastCreatedUnit()
                    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_SovietSniper_Unit[1])
                    call UnitAddAbilityBJ('AGSS', udg_SovietSniper_Unit[1])
                    //                                                                                                          
                    // Get points offset in a line for railgun effect (special effects here):
                    //                                                                                                          
                    // GET DISTANCE:
                    // Note: This Integer[2] variable determines distance. The Distance is increased by 50 per 1, so a value of 10 = 500 distance, 20 = 1000 distance, 30 = 1500 distance, etc...
                    set udg_SovietSniper_Integer[1]=( 60 + ( 5 * udg_SovietSniper_Integer[0] ) )
                    //                                                                                                          
                    set udg_SovietSniper_Integer[2]=1
                    loop
                        exitwhen udg_SovietSniper_Integer[2] > udg_SovietSniper_Integer[1]
                        // Get targets:
                        set udg_SovietSniper_Point[1]=PolarProjectionBJ(udg_SovietSniper_Point[0], ( 50.00 * I2R(udg_SovietSniper_Integer[2]) ), udg_SovietSniper_Real[0])
                        set udg_SovietSniper_Group[1]=GetUnitsInRangeOfLocAll(110.00, udg_SovietSniper_Point[1])
                        call GroupAddGroup(udg_SovietSniper_Group[1], udg_SovietSniper_Group[0])
                        //                                                                                                          
                        // Trail effect:
                        call AddSpecialEffectLocBJ(udg_SovietSniper_Point[1], "Abilities\\Weapons\\Rifle\\RifleImpact.mdl")
                        call DestroyEffectBJ(GetLastCreatedEffectBJ())
                        //                                                                                                          
                        call RemoveLocation(udg_SovietSniper_Point[1])
                        call DestroyGroup(udg_SovietSniper_Group[1])
                        set udg_SovietSniper_Integer[2]=udg_SovietSniper_Integer[2] + 1
                    endloop
                    //                                                                                                          
                    call RemoveLocation(udg_SovietSniper_Point[0])
                    //                                                                                                          
                    // Deal damage and slow:
                    set udg_SovietSniper_Real[1]=udg_SovietSniper_GS_Damage_Per_Lvl[udg_SovietSniper_Integer[0]]
                    call ForGroupBJ(udg_SovietSniper_Group[0], function Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005Func037A)
                    //                                                                                                          
                    call DestroyGroup(udg_SovietSniper_Group[0])
                else
                    // Linger for another 0.40 seconds to allow the animation to complete fully:
                    if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005Func042C() ) then
                        call RemoveLocation(udg_SovietSniper_GS_Point[udg_SovietSniper_CV])
                        call BlzPauseUnitEx(udg_SovietSniper, false)
                        //                                                                                                          
                        call GroupRemoveUnitSimple(udg_SovietSniper, udg_SovietSniper_GS_Caster_Group)
                        if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func008Func005Func042Func006C() ) then
                            call DisableTrigger(GetTriggeringTrigger())
                        else
                        endif
                    else
                    endif
                endif
            endif
        else
            call RemoveLocation(udg_SovietSniper_GS_Point[udg_SovietSniper_CV])
            call BlzPauseUnitEx(udg_SovietSniper, false)
            //                                                                                                          
            call GroupRemoveUnitSimple(udg_SovietSniper, udg_SovietSniper_GS_Caster_Group)
            if ( Trig_SovietSniper_Golovu_Shot_Loop_Func002Func004Func005Func006C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        endif
    endif
endfunction

function Trig_SovietSniper_Golovu_Shot_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_SovietSniper_GS_Caster_Group, function Trig_SovietSniper_Golovu_Shot_Loop_Func002A)
endfunction

