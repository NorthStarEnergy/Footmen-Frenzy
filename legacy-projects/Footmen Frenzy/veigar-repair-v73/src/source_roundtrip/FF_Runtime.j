function Trig_CPP_Create_Pathing_Checker_Func003C takes nothing returns boolean
    if ( not ( udg_CPP_Pathing_Checker == null ) ) then
        return false
    endif
    return true
endfunction

function Trig_CPP_Create_Pathing_Checker_Actions takes nothing returns nothing
    // Create an Item that is used to test pathing:
    if ( Trig_CPP_Create_Pathing_Checker_Func003C() ) then
        set udg_CPP_Pathing_Checker=CreateItem('ICPP', 0, 0)
        call SetItemVisibleBJ(false, udg_CPP_Pathing_Checker)
        call SetItemInvulnerableBJ(udg_CPP_Pathing_Checker, true)
    else
    endif
endfunction

function InitTrig_CPP_Create_Pathing_Checker takes nothing returns nothing
