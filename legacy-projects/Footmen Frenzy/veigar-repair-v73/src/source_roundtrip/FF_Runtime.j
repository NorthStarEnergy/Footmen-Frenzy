    call TriggerAddAction(gg_trg_HERO_Ships_Doc_wards, function Trig_HERO_Ships_Doc_wards_Actions)
endfunction

function Trig_HERO_Tactician_Reinforcements_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Tactician_Reinforcements_Func006002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_SUMMONED) == true )
endfunction

function Trig_HERO_Tactician_Reinforcements_Func007A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped('A08M', GetEnumUnit(), udg_abilitylevel)
endfunction

function Trig_HERO_Tactician_Reinforcements_Actions takes nothing returns nothing
    local unit caster= GetTriggerUnit()
    local player owner= GetOwningPlayer(caster)
    local integer lvl= GetUnitAbilityLevelSwapped(GetSpellAbilityId(), caster)
    // udg_temp_player / udg_abilitylevel were set before the wait and read after it, so any
    // other trigger firing meanwhile handed the reinforcements to the wrong player or level.
    call TriggerSleepAction(0.50)
    set udg_temp_unit=caster
    set udg_temp_player=owner
    set udg_abilitylevel=lvl
    set udg_temp_unitgroup=GetUnitsOfPlayerMatching(owner, Condition(function Trig_HERO_Tactician_Reinforcements_Func006002002))
    call ForGroupBJ(udg_temp_unitgroup, function Trig_HERO_Tactician_Reinforcements_Func007A)
    call DestroyGroup(udg_temp_unitgroup)
    set caster=null
    set owner=null
endfunction

function InitTrig_HERO_Tactician_Reinforcements takes nothing returns nothing
    set gg_trg_HERO_Tactician_Reinforcements=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Tactician_Reinforcements, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Tactician_Reinforcements, Condition(function Trig_HERO_Tactician_Reinforcements_Conditions))
    call TriggerAddAction(gg_trg_HERO_Tactician_Reinforcements, function Trig_HERO_Tactician_Reinforcements_Actions)
endfunction

