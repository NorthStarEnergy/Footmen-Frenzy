function Trig_limit_amount_of_creeps_Actions takes nothing returns nothing
    set udg_temp_unit=GetSoldUnit()
    // v65: a substitute buys under their own observer id, exactly as they do
    // at the hero tavern. Hand the unit to the canonical slot BEFORE
    // udg_temp_player is read, or the per-team cap is measured against the
    // wrong team, the over-cap refund is paid into the observer pool, and
    // nothing in the 1-12 cleanup ever sees the unit.
    call SoloSub_ReownToSlot(udg_temp_unit)
    set udg_creep_gold_cost=0
    set udg_creep_gold_cost=BlzGetUnitIntegerField(udg_temp_unit, UNIT_IF_LUMBER_BOUNTY_AWARDED_BASE)
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_LUMBER_BOUNTY_AWARDED_BASE, 0)
    if ( Trig_limit_amount_of_creeps_Func006C() ) then
        call DisplayTextToForce(GetForceOfPlayer(udg_temp_player), ( "Creep Gold Cost: |cffffff00" + ( I2S(udg_creep_gold_cost) + "|r" ) ))
    else
        call DoNothing()
    endif
    set udg_creep=GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_limit_amount_of_creeps_Func007002002))
    call ForGroupBJ(udg_creep, function Trig_limit_amount_of_creeps_Func008A)
    set udg_temp_int=CountUnitsInGroup(udg_creep)
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(udg_temp_unit))
    if ( Trig_limit_amount_of_creeps_Func011C() ) then
        call RemoveUnit(udg_temp_unit)
        call DisplayTextToForce(udg_temp_playergroup, ( ( "|cffff0000Sorry, only " + I2S(( udg_temp_int - 1 )) ) + ( ( " " + GetUnitName(udg_temp_unit) ) + ( " allowed per team!|r - you have been refundend |cffffff00" + ( I2S(udg_creep_gold_cost) + "|r Gold." ) ) ) ))
        call AdjustPlayerStateBJ(udg_creep_gold_cost, udg_temp_player, PLAYER_STATE_RESOURCE_GOLD)
    else
        call DoNothing()
    endif
    call GroupClear(udg_creep)
    call DestroyForce(udg_temp_playergroup)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

function InitTrig_limit_amount_of_creeps takes nothing returns nothing
    set gg_trg_limit_amount_of_creeps=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_limit_amount_of_creeps, EVENT_PLAYER_UNIT_SELL)
    call TriggerAddAction(gg_trg_limit_amount_of_creeps, function Trig_limit_amount_of_creeps_Actions)
endfunction

