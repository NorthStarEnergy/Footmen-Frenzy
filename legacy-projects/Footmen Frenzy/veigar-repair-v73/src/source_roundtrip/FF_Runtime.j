function Trig_SovietSniper_Reposition_Cast_Actions takes nothing returns nothing
    set udg_SovietSniper=GetTriggerUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    set udg_SovietSniper_RP_Atk_On[udg_SovietSniper_CV]=false
    //                                                                                                          
    if ( Trig_SovietSniper_Reposition_Cast_Func007C() ) then
        // Add Attack Range:
        // (Blizzard broke this function but this setup works)
        call SetUnitAcquireRangeBJ(udg_SovietSniper, 850.00)
        call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 700.00)
        call BlzSetUnitWeaponRealFieldBJ(udg_SovietSniper, UNIT_WEAPON_RF_ATTACK_RANGE, 1, 700.00)
        call SetUnitAcquireRangeBJ(udg_SovietSniper, 850.00)
    else
    endif
    //                                                                                                          
    // Invis Dummy:
    set udg_SovietSniper_Point[0]=GetUnitLoc(udg_SovietSniper)
    //                                                                                                          
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_SovietSniper), udg_SovietSniper_Point[0], bj_UNIT_FACING)
    set udg_SovietSniper_Unit[0]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_SovietSniper_Unit[0])
    call IssueTargetOrderBJ(udg_SovietSniper_Unit[0], "invisibility", udg_SovietSniper)
    //                                                                                                          
    call RemoveLocation(udg_SovietSniper_Point[0])
    //                                                                                                          
    call GroupAddUnitSimple(udg_SovietSniper, udg_SovietSniper_RP_Caster_Group)
    call EnableTrigger(gg_trg_SovietSniper_Reposition_Loop)
endfunction

