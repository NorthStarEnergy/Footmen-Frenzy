function Trig_player_leaves_Actions takes nothing returns nothing
    if ( SoloSub_LeavePrelude() ) then
        return
    endif
    if ( Trig_player_leaves_Func001C() ) then
        set udg_temp_player=udg_Votekick_Target_Player
        set udg_Votekick_Defeat_Kicked_Player=false
    else
        set udg_temp_player=SoloSub_EffectiveLeaver()
    endif
    //                                                                                                     
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_temp_playernumber_ally_1=GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])
    set udg_temp_playernumber_ally_2=GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])
    set udg_autopoolto[udg_temp_playernumber]=0
    //                                                                                                     
    // KOTH - Check if they owned the hill and reset it if necessary:
    if ( Trig_player_leaves_Func009C() ) then
        set udg_KOTH_Should_Reset_Hill=true
        //                                                                                                     
        call ForForce(udg_team[udg_teamnumber[udg_temp_playernumber]], function Trig_player_leaves_Func009Func003A)
        //                                                                                                     
        if ( Trig_player_leaves_Func009Func005C() ) then
            call TriggerExecute(gg_trg_KOTH_Set_Neutral_Hill)
            call TriggerExecute(gg_trg_KOTH_Reset_Hill)
        else
        endif
    else
    endif
    //                                                                                                     
    call SetPlayerAllianceStateBJ(udg_temp_player, udg_ally1[udg_temp_playernumber], bj_ALLIANCE_ALLIED_ADVUNITS)
    call SetPlayerAllianceStateBJ(udg_temp_player, udg_ally2[udg_temp_playernumber], bj_ALLIANCE_ALLIED_ADVUNITS)
    call DisplayTimedTextToForce(udg_all_players, 3.00, ( GetPlayerName(ConvertedPlayer(udg_temp_playernumber)) + " has left the game.." ))
    //                                                                                                     
    // Uncle: Potential fix to leavers resources getting in the way:
    call MultiboardDisplayBJ(false, GetLastCreatedMultiboard())
    call MultiboardDisplayBJ(true, GetLastCreatedMultiboard())
    //                                                                                                     
    if ( Trig_player_leaves_Func020C() ) then
        set udg_player_active[udg_temp_playernumber]=false
        set udg_player_active[udg_temp_playernumber_ally_1]=false
        set udg_player_active[udg_temp_playernumber_ally_2]=false
        set SafeRemoval_GraceTicks=0
        call EnableTrigger(gg_trg_Kill_units_of_inactive_player)
        call ConditionalTriggerExecute(gg_trg_Kill_units_of_inactive_player)
        call EnableTrigger(gg_trg_Visibility)
        call ConditionalTriggerExecute(gg_trg_Visibility)
        call ConditionalTriggerExecute(gg_trg_END)
    else
        // This trigger never assigns udg_temp_playergroup, so the force ops that used to sit
        // here operated on another trigger's already-destroyed handle (and destroyed it twice).
        // Nothing reads the force, so they are gone.
        set udg_leave_or_votekick[udg_temp_playernumber]=true
        call EnableTrigger(gg_trg_BASE_destroy)
        call EnableTrigger(gg_trg_BASE_collect_gold)
        // v64: this is the branch where the base survives the leave, so the
        // gold is still sitting there and the allies have a decision to make.
        call LGOLD_Watch(udg_temp_playernumber)
        if ( Trig_player_leaves_Func020Func006C() ) then
            set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_temp_playernumber))
            call CreateNUnitsAtLoc(1, 'h02Q', udg_ally1[udg_temp_playernumber], udg_temp_point, bj_UNIT_FACING)
            set udg_Destroyer_Player_Number[GetUnitUserData(GetLastCreatedUnit())]=udg_temp_playernumber
            call RemoveLocation(udg_temp_point)
        else
            call DoNothing()
        endif
        if ( Trig_player_leaves_Func020Func007C() ) then
            set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_temp_playernumber))
            call CreateNUnitsAtLoc(1, 'h02Q', udg_ally2[udg_temp_playernumber], udg_temp_point, bj_UNIT_FACING)
            set udg_Destroyer_Player_Number[GetUnitUserData(GetLastCreatedUnit())]=udg_temp_playernumber
            call RemoveLocation(udg_temp_point)
        else
            call DoNothing()
        endif
    endif
    call EnableTrigger(gg_trg_check_if_team_active)
endfunction

