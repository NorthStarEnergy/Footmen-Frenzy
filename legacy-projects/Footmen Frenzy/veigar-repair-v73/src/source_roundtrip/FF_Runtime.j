function Trig_eight_Actions takes nothing returns nothing
    set udg_X_playernumber=1
    loop
        exitwhen udg_X_playernumber > 12
        set udg_X_base=0
        loop
            exitwhen udg_X_base > 13
            if ( Trig_eight_Func001Func001Func001C() ) then
                set udg_temp_point=GetUnitLoc(udg_base[udg_X_playernumber])
                set udg_spawnCount=udg_number_of_spawned_units[udg_X_playernumber]
                set udg_X=1
                loop
                    exitwhen udg_X > udg_spawnCount
                    call CreateNUnitsAtLoc(1, udg_spawn_unit[udg_X_base], ConvertedPlayer(udg_X_playernumber), udg_temp_point, bj_UNIT_FACING)
                    set udg_spawned_unit[udg_X]=GetLastCreatedUnit()
                    set udg_X=udg_X + 1
                endloop
                call RemoveLocation(udg_temp_point)
                // setting upgraded values
                set udg_temp_player=ConvertedPlayer(udg_X_playernumber)
                set udg_temp_level=0
                set udg_temp_level=GetPlayerTechCountSimple('Rhme', ConvertedPlayer(udg_X_playernumber))
                set udg_unit_att_num_dice_actual[udg_X_base]=( udg_unit_att_num_dice[udg_X_base] + udg_temp_level )
                set udg_temp_level=GetPlayerTechCountSimple('Rhar', ConvertedPlayer(udg_X_playernumber))
                set udg_unit_armor_actual[udg_X_base]=( udg_unit_armor[udg_X_base] + ( I2R(udg_temp_level) * 2.00 ) )
                // setting unit stats
                set udg_unit_att_actual[udg_X_base]=udg_unit_att_base[udg_X_base]
                if ( Trig_eight_Func001Func001Func001Func019C() ) then
                    set udg_temp_level=GetPlayerTechCountSimple('Robs', ConvertedPlayer(udg_X_playernumber))
                    if ( Trig_eight_Func001Func001Func001Func019Func005C() ) then
                        set udg_unit_HP_actual[udg_X_base]=( udg_unit_HP[udg_X_base] + 100 )
                        set udg_unit_att_actual[udg_X_base]=( udg_unit_att_actual[udg_X_base] + 3 )
                    else
                        set udg_unit_HP_actual[udg_X_base]=( ( udg_unit_HP[udg_X_base] + 100 ) + ( 45 * ( udg_temp_level - 1 ) ) )
                        set udg_unit_att_actual[udg_X_base]=( ( udg_unit_att_actual[udg_X_base] + 3 ) + ( 2 * ( udg_temp_level - 1 ) ) )
                    endif
                else
                    if ( Trig_eight_Func001Func001Func001Func019Func001C() ) then
                        set udg_temp_level=GetPlayerTechCountSimple('Rhan', ConvertedPlayer(udg_X_playernumber))
                        if ( Trig_eight_Func001Func001Func001Func019Func001Func005C() ) then
                            set udg_unit_HP_actual[udg_X_base]=( udg_unit_HP[udg_X_base] + 100 )
                        else
                            set udg_unit_HP_actual[udg_X_base]=( ( udg_unit_HP[udg_X_base] + 100 ) + ( 45 * ( udg_temp_level - 1 ) ) )
                        endif
                    else
                        set udg_unit_HP_actual[udg_X_base]=udg_unit_HP[udg_X_base]
                    endif
                endif
                if ( Trig_eight_Func001Func001Func001Func020C() ) then
                    set udg_temp_level=GetPlayerTechCountSimple('R004', ConvertedPlayer(udg_X_playernumber))
                    if ( Trig_eight_Func001Func001Func001Func020Func005C() ) then
                        set udg_unit_range_actual[udg_X_base]=( udg_unit_range[udg_X_base] + 100.00 )
                    else
                        set udg_unit_range_actual[udg_X_base]=( ( udg_unit_range[udg_X_base] + 100.00 ) + ( 55.00 * ( I2R(udg_temp_level) - 1 ) ) )
                    endif
                else
                    set udg_unit_range_actual[udg_X_base]=udg_unit_range[udg_X_base]
                endif
                set udg_temp_int=1
                loop
                    exitwhen udg_temp_int > udg_spawnCount
                    // xmas
                    if ( Trig_eight_Func001Func001Func001Func021Func002C() ) then
                        call UnitAddAbilityBJ('A0DD', udg_spawned_unit[udg_temp_int])
                    else
                        call DoNothing()
                    endif
                    // stats
                    set udg_Is_A_Spawn[GetUnitUserData(udg_spawned_unit[udg_temp_int])]=true
                    call BlzSetUnitArmor(udg_spawned_unit[udg_temp_int], udg_unit_armor_actual[udg_X_base])
                    call BlzSetUnitMaxHP(udg_spawned_unit[udg_temp_int], R2I(( I2R(udg_unit_HP_actual[udg_X_base]) * udg_hp_buff )))
                    call BlzSetUnitRealFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_RF_HP, GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_spawned_unit[udg_temp_int]))
                    call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_DEFENSE_TYPE, udg_unit_armor_type[udg_X_base])
                    call BlzSetUnitBaseDamage(udg_spawned_unit[udg_temp_int], udg_unit_att_actual[udg_X_base], 0)
                    call BlzSetUnitDiceNumber(udg_spawned_unit[udg_temp_int], udg_unit_att_num_dice_actual[udg_X_base], 0)
                    call BlzSetUnitDiceSides(udg_spawned_unit[udg_temp_int], udg_unit_att_dice_sides[udg_X_base], 0)
                    call BlzSetUnitWeaponRealFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, udg_unit_att_CD[udg_X_base])
                    call MF_SetAttackRange(udg_spawned_unit[udg_temp_int], udg_unit_range_actual[udg_X_base])
                    call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, udg_unit_level[udg_X_base])
                    // bounty
call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, udg_unit_bounty_base[udg_X_base])
                    call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, udg_unit_bounty_num_dice[udg_X_base])
call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, udg_unit_bounty_dice_sides[udg_X_base])
                    // footmen - invul premass
                    if ( Trig_eight_Func001Func001Func001Func021Func021C() ) then
                        call UnitAddAbilityBJ('Avul', udg_spawned_unit[udg_temp_int])
                    else
                        call DoNothing()
                    endif
                    // footmen autosend
                    if ( Trig_eight_Func001Func001Func001Func021Func023C() ) then
                        set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                        call IssuePointOrderLocBJ(udg_spawned_unit[udg_temp_int], "attack", udg_temp_point)
                        call RemoveLocation(udg_temp_point)
                    else
                        call IssueImmediateOrderBJ(udg_spawned_unit[udg_temp_int], "stop")
                    endif
                    // footmen level before 8 minutes
                    if ( Trig_eight_Func001Func001Func001Func021Func025C() ) then
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, 1)
                    else
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, 2)
                    endif
                    if ( Trig_eight_Func001Func001Func001Func021Func026C() ) then
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_LEVEL, 1)
                    else
                        call DoNothing()
                    endif
                    set udg_temp_int=udg_temp_int + 1
                endloop
            else
            endif
            set udg_X_base=udg_X_base + 1
        endloop
        set udg_X_base=31
        loop
            exitwhen udg_X_base > 43
            if ( Trig_eight_Func001Func002Func001C() ) then
                set udg_temp_point=GetUnitLoc(udg_base[udg_X_playernumber])
                set udg_spawnCount=udg_number_of_spawned_units[udg_X_playernumber]
                set udg_X=1
                loop
                    exitwhen udg_X > udg_spawnCount
                    call CreateNUnitsAtLoc(1, udg_spawn_unit[udg_X_base], ConvertedPlayer(udg_X_playernumber), udg_temp_point, bj_UNIT_FACING)
                    set udg_spawned_unit[udg_X]=GetLastCreatedUnit()
                    set udg_X=udg_X + 1
                endloop
                call RemoveLocation(udg_temp_point)
                // setting upgraded values
                set udg_temp_player=ConvertedPlayer(udg_X_playernumber)
                set udg_temp_level=0
                set udg_temp_level=GetPlayerTechCountSimple('Rhme', ConvertedPlayer(udg_X_playernumber))
                set udg_unit_att_num_dice_actual[udg_X_base]=( udg_unit_att_num_dice[udg_X_base] + udg_temp_level )
                set udg_temp_level=GetPlayerTechCountSimple('Rhar', ConvertedPlayer(udg_X_playernumber))
                set udg_unit_armor_actual[udg_X_base]=( udg_unit_armor[udg_X_base] + ( I2R(udg_temp_level) * 2.00 ) )
                // setting unit stats
                set udg_unit_att_actual[udg_X_base]=udg_unit_att_base[udg_X_base]
                if ( Trig_eight_Func001Func002Func001Func018C() ) then
                    set udg_temp_level=GetPlayerTechCountSimple('Robs', ConvertedPlayer(udg_X_playernumber))
                    if ( Trig_eight_Func001Func002Func001Func018Func005C() ) then
                        set udg_unit_HP_actual[udg_X_base]=( udg_unit_HP[udg_X_base] + 100 )
                        set udg_unit_att_actual[udg_X_base]=( udg_unit_att_actual[udg_X_base] + 3 )
                    else
                        set udg_unit_HP_actual[udg_X_base]=( ( udg_unit_HP[udg_X_base] + 100 ) + ( 45 * ( udg_temp_level - 1 ) ) )
                        set udg_unit_att_actual[udg_X_base]=( ( udg_unit_att_actual[udg_X_base] + 3 ) + ( 2 * ( udg_temp_level - 1 ) ) )
                    endif
                else
                    if ( Trig_eight_Func001Func002Func001Func018Func001C() ) then
                        set udg_temp_level=GetPlayerTechCountSimple('Rhan', ConvertedPlayer(udg_X_playernumber))
                        if ( Trig_eight_Func001Func002Func001Func018Func001Func005C() ) then
