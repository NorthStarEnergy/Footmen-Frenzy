    call EnableTrigger(gg_trg_Avalanche_Craggy_Exterior_Stun)
    call DisableTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_Avalanche_Craggy_Exterior_Learn takes nothing returns nothing
    set gg_trg_Avalanche_Craggy_Exterior_Learn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Avalanche_Craggy_Exterior_Learn, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_Avalanche_Craggy_Exterior_Learn, Condition(function Trig_Avalanche_Craggy_Exterior_Learn_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Craggy_Exterior_Learn, function Trig_Avalanche_Craggy_Exterior_Learn_Actions)
endfunction

