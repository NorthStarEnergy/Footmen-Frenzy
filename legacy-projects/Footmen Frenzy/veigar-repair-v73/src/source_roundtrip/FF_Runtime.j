function Trig_HERO_Swift_Strike_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetAttacker(), 'B01F') == true ) ) then
        return false
    endif
    if ( not ( udg_b1ik[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Swift_Strike_Actions takes nothing returns nothing
    set udg_temp_unit=GetAttacker()
    set udg_temp_target=GetAttackedUnitBJ()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_temp_degree=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    // action
    call AddSpecialEffectTargetUnitBJ("overhead", GetTriggerUnit(), "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl")
    call AddSpecialEffectLocBJ(udg_temp_point, "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

