function Trig_autopool_execute_Actions takes nothing returns nothing
    if not FFR4_PoolingAllowed() then
        return
    endif
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    // udg_temp_player is a shared scratch global that this trigger never sets, so the
    // confirmation used to go to whoever touched it last. Address the clicker directly.
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    if ( Trig_autopool_execute_Func004C() ) then
        if SoloSub_CanReceiveGold(GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])) then
            set udg_autopoolto[udg_temp_playernumber]=GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])
            call DisplayTextToForce(udg_temp_playergroup, ( "|cff00ff00Autopool activated!|r" + ( " all gold will be sent to: " + GetPlayerName(udg_ally1[udg_temp_playernumber]) ) ))
        else
            set udg_autopoolto[udg_temp_playernumber]=0
            call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "That ally is no longer available to receive gold. Autopool is off.")
        endif
    else
        call DoNothing()
    endif
    if ( Trig_autopool_execute_Func005C() ) then
        if SoloSub_CanReceiveGold(GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])) then
            set udg_autopoolto[udg_temp_playernumber]=GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])
            call DisplayTextToForce(udg_temp_playergroup, ( "|cff00ff00Autopool activated!|r" + ( " all gold will be sent to: " + GetPlayerName(udg_ally2[udg_temp_playernumber]) ) ))
        else
            set udg_autopoolto[udg_temp_playernumber]=0
            call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "That ally is no longer available to receive gold. Autopool is off.")
        endif
    else
        call DoNothing()
    endif
    if ( Trig_autopool_execute_Func006C() ) then
        call EnableTrigger(gg_trg_autopool_th_execute)
        call DialogClearBJ(udg_dlg_pool_th[udg_temp_playernumber])
        call DialogSetMessageBJ(udg_dlg_pool_th[udg_temp_playernumber], "TRIGSTR_1669")
        call DialogAddButtonBJ(udg_dlg_pool_th[udg_temp_playernumber], "TRIGSTR_1672")
        set udg_dlg_btn_pool_th_1[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogAddButtonBJ(udg_dlg_pool_th[udg_temp_playernumber], "TRIGSTR_1673")
        set udg_dlg_btn_pool_th_2[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogAddButtonBJ(udg_dlg_pool_th[udg_temp_playernumber], "TRIGSTR_1674")
        set udg_dlg_btn_pool_th_3[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogAddButtonBJ(udg_dlg_pool_th[udg_temp_playernumber], "TRIGSTR_1678")
        set udg_dlg_btn_pool_th_4[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogAddButtonBJ(udg_dlg_pool_th[udg_temp_playernumber], "TRIGSTR_1679")
        set udg_dlg_btn_pool_th_5[udg_temp_playernumber]=GetLastCreatedButtonBJ()
        call DialogDisplayBJ(true, udg_dlg_pool_th[udg_temp_playernumber], ConvertedPlayer(udg_temp_playernumber))
    else
        call DoNothing()
    endif
    if ( Trig_autopool_execute_Func007C() ) then
        set udg_autopoolto[udg_temp_playernumber]=0
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1680")
    else
        call DoNothing()
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

function InitTrig_autopool_execute takes nothing returns nothing
    set gg_trg_autopool_execute=CreateTrigger()
    call DisableTrigger(gg_trg_autopool_execute)
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[1])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[2])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[3])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[4])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[5])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[6])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[7])
    call TriggerRegisterDialogEventBJ(gg_trg_autopool_execute, udg_dlg_pool[8])
