function Trig_ITEM_limits_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_item=GetManipulatedItem()
    set udg_temp_int=0
    // Critical Katana
    set udg_temp_item_type='rat9'
    if ( Trig_ITEM_limits_Func007C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_limits_Func007Func003Func001C() ) then
                set udg_temp_int=( udg_temp_int + 1 )
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
        if ( Trig_ITEM_limits_Func007Func004C() ) then
            call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffff0000Only 1x |r" + ( GetItemName(udg_temp_item) + "|cffff0000 per hero allowed!|r" ) ))
        else
            call DoNothing()
        endif
        if ( Trig_ITEM_limits_Func007Func005C() ) then
            call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffff0000Cannot use this item with " + GetUnitName(udg_temp_unit) ))
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
    // Tusk of Pitlord
    set udg_temp_item_type='stwa'
    if ( Trig_ITEM_limits_Func010C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_limits_Func010Func002Func001C() ) then
                set udg_temp_int=( udg_temp_int + 1 )
            else
                call DoNothing()
            endif
