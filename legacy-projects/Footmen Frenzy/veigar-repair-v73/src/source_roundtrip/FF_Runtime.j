function FFCH_Init takes nothing returns nothing
    local trigger t=CreateTrigger()
    call FFCH_LoadData()
    set udg_FFCH_EndTimer=CreateTimer()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SELL_ITEM)
    call TriggerAddAction(t, function FFCH_Sell)
    set t=null
endfunction

function FFRandom_Stock takes nothing returns nothing
    local integer team = 1
    loop
        exitwhen team > 4
        if CarryTav_shop[team] != null then
            call RemoveUnitFromStock(CarryTav_shop[team], 'h004')
            if T66_RandomLeft[team] > 0 then
                call MF_StockUnit(CarryTav_shop[team], 'h004', T66_RandomLeft[team], 3)
            endif
        endif
        set team = team + 1
    endloop
endfunction

function P67_Enabled takes nothing returns boolean
    return udg_mode_pub and not FFR4Pro and not udg_mode_promode and not FFMode4K and not FFModePrivateVote and not udg_mode_inhouse and not udg_mode_debugmode and not udg_mode_overdrive and not udg_FFCH_Mode and not udg_mode_no_mass and udg_colossal_on
endfunction

function P67_ValidHero takes unit u returns boolean
    local integer pn
    if u == null or GetUnitTypeId(u) == 0 or not IsUnitType(u, UNIT_TYPE_HERO) or IsUnitIllusion(u) then
        return false
    endif
    set pn = GetPlayerId(GetOwningPlayer(u)) + 1
    if pn < 1 or pn > 12 then
        return false
    endif
    return udg_player_active[pn] and udg_herO[pn] == u
endfunction

function P67_Rate takes integer level, boolean reached4, boolean reached6, boolean massEnded, boolean firstColo returns real
    if level >= 7 then
        return P67_POST7_RATE
    endif
    if firstColo or (level < 4 and reached4) then
        return P67_CATCHUP_RATE
    endif
    if level < 6 and (massEnded or reached6) then
        return P67_APPROACH6_RATE
    endif
    return 100.00
endfunction

function P67_HeroRate takes unit u returns real
    local integer pn = GetPlayerId(GetOwningPlayer(u)) + 1
    // Keep the existing anti-cheat XP penalty authoritative.
    if udg_maphack[pn] then
        return 25.00
    endif
    return P67_Rate(GetHeroLevel(u), P67_Reached4, P67_Reached6, P67_MassEnded, P67_FirstColo)
endfunction

function P67_Refresh takes nothing returns nothing
    local integer pn = 1
    local unit u
    if not P67_Running or not P67_Enabled() then
        return
    endif
    // Discover both milestones before calculating anyone's rate. Slot order
    // must not affect catch-up, and a skipped level must still unlock it.
    loop
        exitwhen pn > 12
        set u = udg_herO[pn]
        if P67_ValidHero(u) then
            if GetHeroLevel(u) >= 4 then
                set P67_Reached4 = true
            endif
            if GetHeroLevel(u) >= 6 then
                set P67_Reached6 = true
            endif
        endif
        set pn = pn + 1
    endloop
    set pn = 1
    loop
        exitwhen pn > 12
        set u = udg_herO[pn]
        if P67_ValidHero(u) then
            call SetPlayerHandicapXPBJ(Player(pn - 1), P67_HeroRate(u))
        endif
        set pn = pn + 1
    endloop
    set u = null
endfunction

function P67_OnLevel takes nothing returns nothing
    if P67_ValidHero(GetTriggerUnit()) then
        call P67_Refresh()
    endif
endfunction

function P67_AddSupplement takes unit u, real amount returns nothing
    local integer pn
    local integer earned
    local real total
    if not P67_ValidHero(u) or amount <= 0.00 then
        return
    endif
    set pn = GetPlayerId(GetOwningPlayer(u)) + 1
    if P67_LastHero[pn] != u then
        set P67_LastHero[pn] = u
        set P67_Remainder[pn] = 0.00
    endif
    // These scripted supplements use SetHeroXP, so native handicap alone
    // cannot slow them. Preserve fractional XP from sharing and scaling.
    set total = P67_Remainder[pn] + amount * P67_HeroRate(u) * 0.01
    set earned = R2I(total)
    set P67_Remainder[pn] = total - I2R(earned)
    if earned > 0 then
        call SetHeroXP(u, GetHeroXP(u) + earned, true)
    endif
endfunction

function P67_MassFinished takes nothing returns nothing
    if P67_Enabled() then
        set P67_MassEnded = true
        call P67_Refresh()
    endif
endfunction

function P67_ColoSpawn takes nothing returns nothing
    if P67_Enabled() and udg_colossal_wave == 1 then
        // Activate before any of the first wave's kills can award XP.
        set P67_FirstColo = true
        call P67_Refresh()
    endif
endfunction

function P67_Start takes nothing returns nothing
    if P67_Running or not P67_Enabled() then
        return
    endif
    set P67_Running = true
    call P67_Refresh()
    // Covers hiring, repicks, substitutions and revives. This only sets the
    // rate: no timer, milestone or wave event awards any experience.
    call TimerStart(CreateTimer(), 1.00, true, function P67_Refresh)
    call DisplayTextToForce(GetPlayersAll(), "|cff00ffffPub XP:|r Earn boosted kill XP while catching up to level 7. From level 7 onward, kill XP is 70%.")
endfunction

function FFHire_CreateBuyer takes player p, real x, real y returns nothing
    local unit buyer = CreateUnit(p, 'h01G', x, y, 0.0)
    call UnitRemoveAbility(buyer, 'A01R')
    call UnitRemoveAbility(buyer, 'A01F')
    call UnitRemoveAbility(buyer, 'A01T')
    call SetUnitUseFood(buyer, false)
    call SetUnitPathing(buyer, false)
    call SetUnitX(buyer, x)
    call SetUnitY(buyer, y)
    call SetUnitInvulnerable(buyer, true)
    call SetUnitScale(buyer, 0.01, 0.01, 0.01)
    call SetUnitVertexColor(buyer, 255, 255, 255, 0)
    call BlzSetUnitName(buyer, "Hero hiring access")
    // Keep it present: ShowUnit(false) or Locust can exclude a shop patron.
    set T66_LastBuyer = buyer
    set buyer = null
endfunction

function FFHire_Prepare takes nothing returns nothing
    local integer pn = 1
    local integer team = 1
    local integer i
    local integer a
    local integer raw
    local integer idx
    local integer key
    local player p
    local unit shop
    local trigger chat
    if FFHire_Ready then
        return
    endif
    set FFHire_Ready = true
    loop
        exitwhen team > 4
        set T66_RandomLeft[team] = 3
        if CarryTav_shop[team] == null then
            set CarryTav_shop[team] = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n66A', -2624, 160 - I2R(team-1)*288, 270)
        endif
        call GroupAddUnit(udg_realshops, CarryTav_shop[team])
        call RemoveUnitFromStock(CarryTav_shop[team], 'H0R0')
        call BlzSetUnitName(CarryTav_shop[team], "Team " + I2S(team) + " - Carry Altar / Random Hero")
        set T66_Offers[team] = "Available taverns:|nCarry Altar: Random Hero (3 shared uses)"
        if udg_selected_mode == 3 then
            call BlzSetUnitName(udg_real_shop[team], "Team " + I2S(team) + " - Hero Tavern")
            // Record the exact stock, including the older/mirror draft paths.
            set key = GetHandleId(udg_real_shop[team])
            set i = 1
            loop
                exitwhen i > LoadInteger(T66_StockHash, key, 0)
                set raw = LoadInteger(T66_StockHash, key, i)
                set idx = 1
                loop
                    exitwhen idx > udg_total_hero_count or udg_hero_type[idx] == raw
                    set idx = idx + 1
                endloop
                if idx <= udg_total_hero_count and udg_hero_category[idx] >= 12 then
                    call RemoveUnitFromStock(udg_real_shop[team], raw)
                    call MF_StockUnit(CarryTav_shop[team], raw, 1, 1)
                else
                    set T66_Offers[team] = T66_Offers[team] + "|nTavern: " + GetObjectName(raw)
                endif
                set i = i + 1
            endloop
            set key = GetHandleId(CarryTav_shop[team])
            set i = 1
            loop
                exitwhen i > LoadInteger(T66_StockHash, key, 0)
                set raw = LoadInteger(T66_StockHash, key, i)
                set T66_Offers[team] = T66_Offers[team] + "|nAltar: " + GetObjectName(raw)
                set i = i + 1
            endloop
        elseif udg_selected_mode == 2 then
            set T66_Offers[team] = T66_Offers[team] + "|nAll Pick: all nine western taverns, full enabled roster."
        else
            set T66_Offers[team] = T66_Offers[team] + "|nAll Random: automatic hero assignment. Random altar available for an eligible repick."
        endif
        set T66_RecordQuest[team] = CreateQuest()
        call QuestSetTitle(T66_RecordQuest[team], "Team " + I2S(team) + " - Draft Record (v66)")
        call QuestSetIconPath(T66_RecordQuest[team], "ReplaceableTextures\\CommandButtons\\BTNAltarOfKings.blp")
        call QuestSetRequired(T66_RecordQuest[team], false)
        call QuestSetDiscovered(T66_RecordQuest[team], true)
        call T66_Position(team, false)
        set team = team + 1
    endloop
    loop
        exitwhen pn > 12
        set p = ConvertedPlayer(pn)
        set team = udg_teamnumber[pn]
        if GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING and team >= 1 and team <= 4 then
            if udg_selected_mode == 2 then
                call FFHire_CreateBuyer(p, -2688.0, -256.0)
                set T66_Buyer[pn] = T66_LastBuyer
            elseif udg_selected_mode == 3 then
                set shop = udg_real_shop[team]
                call FFHire_CreateBuyer(p, GetUnitX(shop), GetUnitY(shop))
                set T66_Buyer[pn] = T66_LastBuyer
            endif
            set shop = CarryTav_shop[team]
            call FFHire_CreateBuyer(p, GetUnitX(shop), GetUnitY(shop))
            set T66_CarryBuyer[pn] = T66_LastBuyer
        endif
        set pn = pn + 1
    endloop
    if udg_selected_mode != 2 then
        call T66_StopViews()
    endif
    set chat = CreateTrigger()
    set pn = 0
    loop
        exitwhen pn > 23
        call TriggerRegisterPlayerChatEvent(chat, Player(pn), "-draft", true)
        set pn = pn + 1
    endloop
    call TriggerAddAction(chat, function T66_ShowRecord)
    call TimerStart(CreateTimer(), 0.5, true, function T66_Record)
    call DisplayTextToForce(GetPlayersAll(), "v66: Team draft offers and picks are available to everyone in Quests (F9), or type -draft. Random Hero has 3 shared uses per team.")
    set chat = null
    set shop = null
    set p = null
endfunction

function Trig_Start_game_Actions takes nothing returns nothing
    call P67_Start()
    call FFHire_Prepare()
    call EnableTrigger(gg_trg_Update_Game_Time)
    if ( Trig_Start_game_Func001C() ) then
        // Create the Multiboard specialized for KOTH mode:
        call TriggerExecute(gg_trg_Multiboard_Create_with_KOTH)
        call ConditionalTriggerExecute(gg_trg_MODE_King_Of_The_Hill)
    else
        // Create the standard Multiboard:
        call TriggerExecute(gg_trg_Multiboard_Create)
    endif
    //                                                                                                     
    call StartTimerBJ(udg_Fortification_Aura_Timer, false, 330.00)
    //                                                                                                     
    // COLOSSALS: ON / OFF
    if ( Trig_Start_game_Func006C() ) then
        call EnableTrigger(gg_trg_colossal_variables)
        call ConditionalTriggerExecute(gg_trg_colossal_variables)
        set udg_wmd[2]=( "|cff00ffffColossals:|r |cff00ff00On|r" )
        call StartTimerBJ(udg_timer_colossal, false, udg_t_colossal_initial)
        call CreateTimerDialogBJ(udg_timer_colossal, ( "Colossal #" + ( I2S(udg_colossal_wave) + ( " / " + I2S(udg_colossal_max_wave) ) ) ))
        set udg_timer_window_colossal=GetLastCreatedTimerDialogBJ()
    else
        call DoNothing()
    endif
    //                                                                                                     
    // ADD AUTOSEND ABILITY TO MAIN
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_Start_game_Func009Func001C() ) then
            call UnitAddAbilityBJ('A06Y', udg_base[udg_X])
        else
            call UnitAddAbilityBJ('A06X', udg_base[udg_X])
        endif
        set udg_X=udg_X + 1
    endloop
    // OBS: Visibility
    set udg_X=13
    loop
        exitwhen udg_X > 24
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, gg_rct_T1_COMPLETE)
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, gg_rct_T2_COMPLETE)
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, gg_rct_T3_COMPLETE)
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, gg_rct_T4_COMPLETE)
        if udg_selected_mode == 2 then
            call T66_View(ConvertedPlayer(udg_X), gg_rct_TAVERN_AREA)
        endif
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, gg_rct_MAP_CENTER)
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, gg_rct_TOURNAMENT_WINNERS)
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, FF_Editor_Phoken)
        call CreateFogModifierRectBJ(true, ConvertedPlayer(udg_X), FOG_OF_WAR_VISIBLE, FF_Editor_HEROshowroom)
        set udg_X=udg_X + 1
    endloop
    // MODE: PRIV / PUB
    call EnableTrigger(gg_trg_autopool_time)
    call EnableTrigger(gg_trg_autopool_command)
    call EnableTrigger(gg_trg_autopool_execute)
    if ( Trig_Start_game_Func016C() ) then
        // MODE = PRIV
        call StartTimerBJ(udg_timer_trading, false, 0.00)
        set udg_autopoool_allowed=true
        call SetMapFlag(MAP_LOCK_RESOURCE_TRADING, true)
        set udg_startgold=275
        // Remove towers
        set udg_X=1
        loop
            exitwhen udg_X > 12
            call SetPlayerTechResearchedSwap('R00F', 1, ConvertedPlayer(udg_X))
            set udg_X=udg_X + 1
        endloop
        // Remove AutoSend
        set udg_X=1
        loop
            exitwhen udg_X > 12
            set udg_autosend[udg_X]=false
            call UnitRemoveAbilityBJ('A06X', udg_base[udg_X])
            call UnitRemoveAbilityBJ('A06Y', udg_base[udg_X])
            set udg_X=udg_X + 1
        endloop
        if ( Trig_Start_game_Func016Func025C() ) then
            set udg_startgold=275
        else
            // INCREASE FOOTMEN BOUNTY FOR PUB GAMES
            if ( Trig_Start_game_Func016Func025Func002C() ) then
                call DoNothing()
            else
                set udg_unit_bounty_base[0]=( udg_unit_bounty_base[0] + 0 )
            endif
        endif
    else
        // MODE = PUB
        set udg_autopoool_allowed=false
        call SetMapFlag(MAP_LOCK_RESOURCE_TRADING, true)
        set udg_startgold=100
        set udg_mode_pub=true
        // TRADE TIMER
        if not FFR4Pro and not udg_mode_debugmode and not FFMode4K then
            set udg_t_trading=1800.00
        elseif ( Trig_Start_game_Func016Func010C() ) then
            set udg_t_trading=3.00
        else
            set udg_t_trading=230.00
        endif
        if not FFR4NoPool or (udg_mode_pub and not FFR4Pro and not udg_mode_debugmode and not FFMode4K) then
            call StartTimerBJ(udg_timer_trading, false, udg_t_trading)
            call CreateTimerDialogBJ(udg_timer_trading, "Pooling unlock")
            set udg_timer_window_trading=GetLastCreatedTimerDialogBJ()
        endif
        call DestroyTrigger(GetTriggeringTrigger())
        set udg_X=1
        loop
            exitwhen udg_X > 12
            call SetPlayerTechResearchedSwap('Rorb', 1, ConvertedPlayer(udg_X))
            set udg_X=udg_X + 1
        endloop
        // [Uncle]
        // ADD CREEPS AFTER DELAY:
    endif
    call DoNothing()
    call TimerDialogDisplayBJ(true, udg_timer_window_colossal)
    // MODE: DEBUGMODE
    if ( Trig_Start_game_Func020C() ) then
        set udg_autopoool_allowed=true
        set udg_mode_overdrive=false
        call SetMapFlag(MAP_LOCK_RESOURCE_TRADING, true)
    else
        call DoNothing()
    endif
    // MODE: WONKY MODES
    if ( Trig_Start_game_Func022C() ) then
        set udg_autopoool_allowed=true
        call SetMapFlag(MAP_LOCK_RESOURCE_TRADING, true)
        set udg_startgold=140
        set udg_t_trading=5.00
    else
        call DoNothing()
    endif
    call SetPlayerTechResearchedSwap('R00N', 0, ConvertedPlayer(udg_X))
    if ( Trig_Start_game_Func020C() ) then
        call StartTimerBJ(udg_timer_upgradedelay, false, 0.00)
    else
        call StartTimerBJ(udg_timer_upgradedelay, false, 280.00)
    endif
    if ( Trig_Start_game_Func025C() ) then
        set udg_startgold=2000
        call TriggerExecute(gg_trg_MODE_777)
    else
        call DoNothing()
    endif
    if ( Trig_Start_game_Func026C() ) then
        set udg_startgold=99999
    else
        call DoNothing()
    endif
    // make towers invu premass
    set udg_temp_unitgroup=GetUnitsOfTypeIdAll('hwtw')
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_game_Func029A)
    // SHARE ALWAYS
    set udg_X=1
    loop
        exitwhen udg_X > 12
        call SetPlayerHandicapReviveTimeBJ(ConvertedPlayer(udg_X), 30.00)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_X), udg_ally1[udg_X], bj_ALLIANCE_ALLIED_UNITS)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_X), udg_ally2[udg_X], bj_ALLIANCE_ALLIED_UNITS)
        set udg_X=udg_X + 1
    endloop
    set udg_temp_unitgroup=GetUnitsOfTypeIdAll('h01G')
    call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_game_Func033A)
    call ForForce(udg_all_players, function Trig_Start_game_Func034A)
    if ( Trig_Start_game_Func035C() ) then
        call ForForce(GetPlayersAll(), function Trig_Start_game_Func035Func002A)
    else
        call ForForce(GetPlayersAll(), function Trig_Start_game_Func035Func001A)
    endif
    if FFMode4K then
        set udg_startgold=4000
    endif
    call ForForce(udg_all_players, function Trig_Start_game_Func036A)
    if udg_FFCH_Mode then
        call FFCH_Start()
    endif
    if FFR4NoPool and not udg_mode_pub then
        call FFR4_LockPooling()
    endif
    // START TIMERS
    call ConditionalTriggerExecute(gg_trg_start_timers)
    call FFRandom_Stock()
    // Give players who still have no hero two minutes from game start.
    call StartTimerBJ(FF_AutoPick_timer, false, 120.00)
    // TURN VOTING STUFF, ETC OFF
    call ConditionalTriggerExecute(gg_trg_Destroy_Triggers_1)
    set udg_X=1
    loop
        exitwhen udg_X > 4
        call RemoveLocation(udg_SDtavern[udg_X])
        set udg_X=udg_X + 1
    endloop
    set udg_X=1
    loop
        exitwhen udg_X > 6
        call RemoveLocation(udg_tavern[udg_X])
        set udg_X=udg_X + 1
    endloop
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_Start_game takes nothing returns nothing
    set gg_trg_Start_game=CreateTrigger()
    call TriggerAddAction(gg_trg_Start_game, function Trig_Start_game_Actions)
endfunction

function CarryTav_ShopFor takes integer whichTeam,integer whichCategory returns unit
    if ( whichCategory >= 12 and CarryTav_shop[whichTeam] != null ) then
        return CarryTav_shop[whichTeam]
    endif
    return udg_real_shop[whichTeam]
endfunction

function FFR_Index takes integer raw returns integer
    local integer i = 1
    loop
        exitwhen i > udg_total_hero_count
        if udg_hero_type[i] == raw then
            return i
        endif
        set i = i + 1
    endloop
    return 0
endfunction

function FFR_Category takes integer index returns integer
    local integer c = udg_hero_category[index]
    if c >= 12 then
        return 12
    endif
    if c == 5 or c == 11 then
        return c
    endif
    return 0
endfunction

function FFR_Allowed takes integer team, integer index returns boolean
    local integer c = FFR_Category(index)
    if MF_HeroDisabled(udg_hero_type[index]) then
        return false
    endif
    if team < 1 or team > 4 or index < 1 then
        return false
    endif
    if c == 12 and CarryTav_locked[team] then
        return false
    endif
    return c == 0 or not FFR_Locked[team * 20 + c]
endfunction

function FFR_Choose takes integer team returns integer
    local integer i = 1
    local integer count = 0
    local integer chosen = 0
    loop
        exitwhen i > udg_total_hero_count
        if udg_hero_category[i] > 0 and not FFR_Used[i] and FFR_Allowed(team, i) then
            set count = count + 1
            if GetRandomInt(1, count) == 1 then
                set chosen = i
            endif
        endif
        set i = i + 1
    endloop
    return chosen
endfunction

function FFR_Lock takes integer team, integer index returns nothing
    local integer c = FFR_Category(index)
    local integer i = 1
    local integer a
    if c == 0 or team < 1 or team > 4 then
        return
    endif
    set FFR_Locked[team * 20 + c] = true
    loop
        exitwhen i > FF_AutoPick_count[team]
        set a = team * 32 + i
        if FFR_Category(FFR_Index(FF_AutoPick_hero[a])) == c then
            call RemoveUnitFromStock(CarryTav_ShopFor(team, FF_AutoPick_category[a]), FF_AutoPick_hero[a])
            if c == 12 and OD_CarryTav_shop2[team] != null then
                call RemoveUnitFromStock(OD_CarryTav_shop2[team], FF_AutoPick_hero[a])
            endif
        endif
        set i = i + 1
    endloop
endfunction

function CarryTav_Register takes integer whichTeam,integer whichCategory,integer unitId returns nothing
    if ( whichCategory < 12 ) then
        return
    endif
    if ( whichTeam < 1 or whichTeam > 4 ) then
        return
    endif
    if ( CarryTav_count[whichTeam] >= 7 ) then
        return
    endif
    set CarryTav_count[whichTeam]=CarryTav_count[whichTeam] + 1
    set CarryTav_hero[whichTeam * 8 + CarryTav_count[whichTeam]]=unitId
endfunction

function CarryTav_MakeAltar takes integer whichTeam,real x,real y,real face returns nothing
    local location loc= Location(x, y)
    set CarryTav_count[whichTeam]=0
    set CarryTav_locked[whichTeam]=false
    call CreateNUnitsAtLoc(1, 'n66A', Player(PLAYER_NEUTRAL_PASSIVE), loc, face)
    set CarryTav_shop[whichTeam]=GetLastCreatedUnit()
    call BlzSetUnitName(CarryTav_shop[whichTeam], "Carry Tavern |cffff8000(MAX 1)|r")
    call RemoveLocation(loc)
    set loc=null
endfunction

function CarryTav_CreateAltars takes nothing returns nothing
    call CarryTav_MakeAltar(1 , - 3072.00 , 128.00 , 130.00)
    call CarryTav_MakeAltar(2 , - 2304.00 , 128.00 , 130.00)
    call CarryTav_MakeAltar(3 , - 2304.00 , - 640.00 , 310.00)
    call CarryTav_MakeAltar(4 , - 3072.00 , - 640.00 , 310.00)
endfunction

function CarryTav_LockTeam takes integer whichTeam returns nothing
    local integer i= 1
    if ( whichTeam < 1 or whichTeam > 4 ) then
        return
    endif
    if ( CarryTav_locked[whichTeam] or CarryTav_shop[whichTeam] == null ) then
        return
    endif
    set CarryTav_locked[whichTeam]=true
    loop
        exitwhen i > CarryTav_count[whichTeam]
        call MF_StockUnitBJ(CarryTav_hero[whichTeam * 8 + i], CarryTav_shop[whichTeam], 0, 0)
        if OD_CarryTav_shop2[whichTeam] != null then
            call MF_StockUnitBJ(CarryTav_hero[whichTeam * 8 + i], OD_CarryTav_shop2[whichTeam], 0, 0)
        endif
        set i=i + 1
    endloop
    set i = 1
    loop
        exitwhen i > LoadInteger(T66_StockHash, GetHandleId(CarryTav_shop[whichTeam]), 0)
        call RemoveUnitFromStock(CarryTav_shop[whichTeam], LoadInteger(T66_StockHash, GetHandleId(CarryTav_shop[whichTeam]), i))
        set i = i + 1
    endloop
    call DisplayTimedTextToForce(udg_team[whichTeam], 12.00, "|cffff8000Carry Tavern:|r your team has used its one carry pick.")
endfunction

function FF_AutoPick_HeroTaken takes integer unitId returns boolean
    local integer i= 1
    loop
        exitwhen i > 12
        if ( udg_herO[i] != null and GetUnitTypeId(udg_herO[i]) == unitId ) then
            return true
        endif
        set i=i + 1
    endloop
    return false
endfunction

function FF_AutoPick_GetTeamHero takes integer whichTeam returns integer
    local integer i= 1
    local integer candidates= 0
    local integer chosen= 0
    local integer autoIndex
    local boolean allowCarry= false
    if ( whichTeam < 1 or whichTeam > 4 ) then
        return 0
    endif
    if ( CarryTav_shop[whichTeam] != null and CarryTav_locked[whichTeam] == false ) then
        set allowCarry=true
    endif
    loop
        exitwhen i > FF_AutoPick_count[whichTeam]
        set autoIndex=whichTeam * 32 + i
        if ( (FF_AutoPick_category[autoIndex] < 12 or allowCarry) and FFR_Allowed(whichTeam, FFR_Index(FF_AutoPick_hero[autoIndex])) and not FF_AutoPick_HeroTaken(FF_AutoPick_hero[autoIndex]) ) then
            set candidates=candidates + 1
        endif
        set i=i + 1
    endloop
    if ( candidates == 0 ) then
        return 0
    endif
    set chosen=GetRandomInt(1, candidates)
    set i=1
    loop
        exitwhen i > FF_AutoPick_count[whichTeam]
        set autoIndex=whichTeam * 32 + i
        if ( (FF_AutoPick_category[autoIndex] < 12 or allowCarry) and FFR_Allowed(whichTeam, FFR_Index(FF_AutoPick_hero[autoIndex])) and not FF_AutoPick_HeroTaken(FF_AutoPick_hero[autoIndex]) ) then
            set chosen=chosen - 1
            if ( chosen == 0 ) then
                return FF_AutoPick_hero[autoIndex]
            endif
        endif
        set i=i + 1
    endloop
    return 0
endfunction

function FF_AutoPick_GetGenericHero takes boolean allowCarry returns integer
    local integer i= 1
    local integer candidates= 0
    local integer chosen= 0
    loop
        exitwhen i > udg_total_hero_count
        if ( udg_hero_type[i] != 0 and ( udg_hero_category[i] < 12 or allowCarry ) and not FF_AutoPick_HeroTaken(udg_hero_type[i]) ) then
            set candidates=candidates + 1
        endif
        set i=i + 1
    endloop
    if ( candidates == 0 ) then
        return 0
    endif
    set chosen=GetRandomInt(1, candidates)
    set i=1
    loop
        exitwhen i > udg_total_hero_count
        if ( udg_hero_type[i] != 0 and ( udg_hero_category[i] < 12 or allowCarry ) and not FF_AutoPick_HeroTaken(udg_hero_type[i]) ) then
            set chosen=chosen - 1
            if ( chosen == 0 ) then
                return udg_hero_type[i]
            endif
        endif
        set i=i + 1
    endloop
    return 0
endfunction

function FF_AutoPick_IsCarryHero takes integer unitId returns boolean
    local integer i= 1
    loop
        exitwhen i > udg_total_hero_count
        if ( udg_hero_type[i] == unitId ) then
            return udg_hero_category[i] >= 12
        endif
        set i=i + 1
    endloop
    return false
endfunction

function FF_AutoPick_Player takes integer playerNumber returns nothing
    local player p
    local integer teamNumber
    local integer heroId= 0
    if ( playerNumber < 1 or playerNumber > 12 ) then
        return
    endif
    set p=ConvertedPlayer(playerNumber)
    if ( GetPlayerSlotState(p) != PLAYER_SLOT_STATE_PLAYING or udg_herO[playerNumber] != null ) then
        return
    endif
    set teamNumber=udg_teamnumber[playerNumber]
    if ( udg_selected_mode == 3 ) then
        set heroId=FF_AutoPick_GetTeamHero(teamNumber)
        if ( heroId == 0 ) then
            if CarryTav_shop[teamNumber] != null then
                set heroId = udg_hero_type[FFR_Choose(teamNumber)]
            else
                set heroId = FF_AutoPick_GetGenericHero(false)
            endif
        endif
    else
        set heroId=FF_AutoPick_GetGenericHero(true)
    endif
    if ( heroId == 0 ) then
        return
    endif
    call DisplayTextToPlayer(p, 0, 0, "You did not choose a hero by 2:00. A random hero has been assigned.")
    call CreateNUnitsAtLoc(1, heroId, p, udg_loc_tavern, bj_UNIT_FACING)
endfunction

function FF_AutoPick_Actions takes nothing returns nothing
    local integer i= 1
    loop
        exitwhen i > 12
        call FF_AutoPick_Player(i)
        set i=i + 1
    endloop
endfunction

function FFRandom_Sold takes nothing returns nothing
    local unit sold = GetSoldUnit()
    local unit shop = GetSellingUnit()
    local player p
    local integer pn
    local integer team
    local integer index
    local integer i = 1
    local integer count = 0
    if GetUnitTypeId(sold) != 'h004' then
        set sold = null
        set shop = null
        return
    endif
    call SoloSub_ReownToSlot(sold)
    set p = GetOwningPlayer(sold)
    set pn = GetConvertedPlayerId(p)
    set team = udg_teamnumber[pn]
    call RemoveUnit(sold)
    if pn >= 1 and pn <= 12 and team >= 1 and team <= 4 and shop == CarryTav_shop[team] and T66_RandomLeft[team] > 0 and GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING and (udg_herO[pn] == null or udg_mode_debugmode) then
        set index = 0
        loop
            exitwhen i > udg_total_hero_count
            if udg_hero_type[i] != 0 and not MF_HeroDisabled(udg_hero_type[i]) and (udg_selected_mode != 3 or FFR_Allowed(team, i)) and (udg_hero_category[i] < 12 or not CarryTav_locked[team]) then
                set count = count + 1
                if GetRandomInt(1, count) == 1 then
                    set index = i
                endif
            endif
            set i = i + 1
        endloop
        if index > 0 then
            set T66_RandomLeft[team] = T66_RandomLeft[team] - 1
            call CreateNUnitsAtLoc(1, udg_hero_type[index], p, udg_loc_tavern, bj_UNIT_FACING)
            if udg_selected_mode == 3 then
                call UnitAddItemByIdSwapped('bspd', GetLastCreatedUnit())
            endif
            if udg_hero_category[index] >= 12 then
                call CarryTav_LockTeam(team)
            endif
        else
            call DisplayTextToPlayer(p, 0, 0, "No eligible heroes remain; your Random use was not consumed.")
        endif
    else
        call DisplayTextToPlayer(p, 0, 0, "Use your own team's Carry Altar while eligible to choose a hero. Each team has 3 shared Random uses.")
    endif
    call FFRandom_Stock()
    set sold = null
    set shop = null
    set p = null
endfunction

function FFRandom_Init takes nothing returns nothing
    local trigger t=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SELL)
    call TriggerAddAction(t,function FFRandom_Sold)
    set t=null
endfunction

function InitTrig_FF_AutoPick_2m takes nothing returns nothing
    call FFRandom_Init()
    set gg_trg_FF_AutoPick_2m=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_FF_AutoPick_2m, FF_AutoPick_timer)
