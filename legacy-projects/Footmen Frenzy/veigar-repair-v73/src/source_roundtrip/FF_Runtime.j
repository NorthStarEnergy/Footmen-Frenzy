        if ( Trig_ITEM_limits_Func010Func003C() ) then
            call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffff0000Only 1x |r" + ( GetItemName(udg_temp_item) + "|cffff0000 per hero allowed!|r" ) ))
        else
            call DoNothing()
        endif
        if ( Trig_ITEM_limits_Func010Func005C() ) then
            call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffff0000Cannot use this item with " + GetUnitName(udg_temp_unit) ))
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
    // Medallion of Glim
    set udg_temp_item_type='mcou'
    if ( Trig_ITEM_limits_Func013C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_limits_Func013Func003Func001C() ) then
                set udg_temp_int=( udg_temp_int + 1 )
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
        if ( Trig_ITEM_limits_Func013Func004C() ) then
            call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffff0000Only 1x |r" + ( GetItemName(udg_temp_item) + "|cffff0000 per hero allowed!|r" ) ))
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
    // Ring of Resilience
    set udg_temp_item_type='I02J'
    if ( Trig_ITEM_limits_Func016C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            if ( Trig_ITEM_limits_Func016Func003Func001C() ) then
                set udg_temp_int=( udg_temp_int + 1 )
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
        if ( Trig_ITEM_limits_Func016Func004C() ) then
            call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, GetItemTypeId(udg_temp_item)), udg_temp_unit)
            call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( "|cffff0000Only 1x |r" + ( GetItemName(udg_temp_item) + "|cffff0000 per hero allowed!|r" ) ))
        else
            call DoNothing()
        endif
    else
