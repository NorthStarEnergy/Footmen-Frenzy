    if ( not ( GetSpellAbilityId() == 'A09B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Pandero_Preserve_Func013C takes nothing returns boolean
    // Was a check for hero type 'E010'; now it cancels the hook of whichever
    // hero is holding one.
    if ( not ( udg_temp_target == udg_hook_caster[GetConvertedPlayerId(GetOwningPlayer(udg_temp_target))] ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Pandero_Preserve_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_target=GetSpellTargetUnit()
    set udg_temp_point=GetUnitLoc(udg_temp_target)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    call CreateNUnitsAtLocFacingLocBJ(1, 'h01K', udg_temp_player, udg_temp_point, udg_temp_point)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0FL', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0FL', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "rejuvination", udg_temp_target)
    call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_dummy)
    call RemoveLocation(udg_temp_point)
    if ( Trig_HERO_Pandero_Preserve_Func013C() ) then
        set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_target))
        call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_hook[udg_temp_playernumber])
        set udg_hook_send_active[udg_temp_playernumber]=false
        set udg_hook_return_active[udg_temp_playernumber]=false
        set udg_hook_target_aquired[udg_temp_playernumber]=false
        set udg_hook_target[udg_temp_playernumber]=null
        set udg_hook_caster[udg_temp_playernumber]=null
        call DestroyLightningBJ(udg_hook_lightning[udg_temp_playernumber])
        set udg_hook_lightning[udg_temp_playernumber]=null
        call RemoveLocation(udg_hook_location[udg_temp_playernumber])
        call RemoveLocation(udg_hook_start_location[udg_temp_playernumber])
        set udg_hook_location[udg_temp_playernumber]=null
        set udg_hook_start_location[udg_temp_playernumber]=null
    else
    endif
endfunction

function InitTrig_HERO_Pandero_Preserve takes nothing returns nothing
    set gg_trg_HERO_Pandero_Preserve=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Pandero_Preserve, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Pandero_Preserve, Condition(function Trig_HERO_Pandero_Preserve_Conditions))
    call TriggerAddAction(gg_trg_HERO_Pandero_Preserve, function Trig_HERO_Pandero_Preserve_Actions)
endfunction

function Trig_HERO_Pirate_Send_Ship_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Pirate_Send_Ship_Func008C takes nothing returns boolean
    if ( not ( udg_mode_debugmode == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Pirate_Send_Ship_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_ship_destination[udg_temp_playernumber]=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_real=( 522.00 * ( DistanceBetweenPoints(udg_temp_point_caster, udg_ship_destination[udg_temp_playernumber]) / 900.00 ) )
    if ( Trig_HERO_Pirate_Send_Ship_Func008C() ) then
        call DisplayTextToForce(udg_all_players, ( "temp real = " + R2S(udg_temp_real) ))
        call DisplayTextToForce(udg_all_players, ( "distance = " + R2S(DistanceBetweenPoints(udg_temp_point_caster, udg_ship_destination[udg_temp_playernumber])) ))
    else
    endif
    call CreateNUnitsAtLocFacingLocBJ(1, 'h02P', udg_temp_player, udg_temp_point_caster, udg_temp_point)
    set udg_dummy_ship[udg_temp_playernumber]=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_dummy_ship[udg_temp_playernumber], udg_temp_real)
    call UnitAddAbilityBJ('A05Q', udg_dummy_ship[udg_temp_playernumber])
    call SetUnitAbilityLevelSwapped('A05Q', udg_dummy_ship[udg_temp_playernumber], udg_abilitylevel)
    call IssuePointOrderLocBJ(udg_dummy_ship[udg_temp_playernumber], "move", udg_ship_destination[udg_temp_playernumber])
    call RemoveLocation(udg_temp_point_caster)
    call RemoveLocation(udg_ship_destination[udg_temp_playernumber])
    call StartTimerBJ(udg_timer_ship[udg_temp_playernumber], false, 2.10)
    call UnitApplyTimedLifeBJ(3.00, 'BTLF', udg_dummy_ship[udg_temp_playernumber])
endfunction

