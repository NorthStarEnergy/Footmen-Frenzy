    call TriggerAddCondition(gg_trg_HERO_Architect_Recruit, Condition(function Trig_HERO_Architect_Recruit_Conditions))
    call TriggerAddAction(gg_trg_HERO_Architect_Recruit, function Trig_HERO_Architect_Recruit_Actions)
