    if ( Trig_Rune_of_AMS_Func007Func001C() ) then
        call IssueTargetOrderBJ(udg_Rune_AMS_Dummy, "antimagicshell", GetEnumUnit())
    else
    endif
endfunction

function Trig_Rune_of_AMS_Actions takes nothing returns nothing
    set udg_Rune_AMS_Point=GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(GetTriggerUnit()), udg_Rune_AMS_Point, bj_UNIT_FACING)
    set udg_Rune_AMS_Dummy=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_Rune_AMS_Dummy)
    call UnitAddAbilityBJ('A0J2', udg_Rune_AMS_Dummy)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(750.00, udg_Rune_AMS_Point), function Trig_Rune_of_AMS_Func007A)
    call RemoveLocation(udg_Rune_AMS_Point)
endfunction

