    call TriggerRegisterTimerEventPeriodic(gg_trg_SovietSniper_Golovu_Shot_Loop, 0.02)
    call TriggerAddAction(gg_trg_SovietSniper_Golovu_Shot_Loop, function Trig_SovietSniper_Golovu_Shot_Loop_Actions)
endfunction

