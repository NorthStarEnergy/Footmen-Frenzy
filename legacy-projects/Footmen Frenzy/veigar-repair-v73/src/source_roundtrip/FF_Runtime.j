function Trig_Start_game_Func035Func002A takes nothing returns nothing
    call PanCameraToTimedLocForPlayer(GetEnumPlayer(), GetPlayerStartLocationLoc(GetEnumPlayer()), 1.00)
endfunction

function Trig_Start_game_Func035C takes nothing returns boolean
    if ( not ( udg_selected_mode == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Start_game_Func036Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Start_game_Func036A takes nothing returns nothing
    call SetPlayerStateBJ(GetEnumPlayer(), PLAYER_STATE_RESOURCE_GOLD, udg_startgold)
    // T1 Unavailable
    if ( Trig_Start_game_Func036Func003C() ) then
        call SetPlayerUnitAvailableBJ('h00W', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('h002', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('h00H', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('u00B', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('h00Z', false, GetEnumPlayer())
        // T3 Unavailable
        call SetPlayerUnitAvailableBJ('h00V', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('h00J', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('h003', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('e00G', false, GetEnumPlayer())
        call SetPlayerUnitAvailableBJ('h00I', false, GetEnumPlayer())
    else
        call DoNothing()
    endif
endfunction

function FFCH_SetNormalSpawns takes boolean enabled returns nothing
    local integer i=0
    loop
        exitwhen i > 50
        set ffgs_spawn_enabled[i]=enabled
        set i=i + 1
    endloop
endfunction

function FFCH_TeamOf takes integer playerNumber returns integer
    local integer t
    if playerNumber < 1 or playerNumber > 12 then
        return 0
    endif
    set t=udg_teamnumber[playerNumber]
    if t < 1 or t > 4 then
        return 0
    endif
    return t
endfunction

function FFCH_FindItem takes integer itemId returns integer
    local integer i=1
    loop
        exitwhen i > 96
        if udg_FFCH_Item[i] == itemId then
            return i
        endif
        set i=i + 1
    endloop
    return 0
endfunction

function FFCH_FindShop takes unit whichShop returns integer
    local integer i=1
    if whichShop == null then
        return 0
    endif
    loop
        exitwhen i > 32
        if udg_FFCH_Shop[i] == whichShop then
            return i
        endif
        set i=i + 1
    endloop
    return 0
endfunction

function FFCH_TeamHasAbility takes integer teamNumber,integer abilityId returns boolean
    local integer base=( teamNumber - 1 ) * 16
    local integer i=1
    loop
        exitwhen i > udg_FFCH_TeamAbilCount[teamNumber]
        if udg_FFCH_TeamAbil[base + i] == abilityId then
            return true
        endif
        set i=i + 1
    endloop
    return false
endfunction

function FFCH_TeamAddAbility takes integer teamNumber,integer abilityId returns nothing
    local integer n=udg_FFCH_TeamAbilCount[teamNumber] + 1
    if n > 16 then
        return
    endif
    set udg_FFCH_TeamAbilCount[teamNumber]=n
    set udg_FFCH_TeamAbil[( teamNumber - 1 ) * 16 + n]=abilityId
endfunction

function FFCH_Refund takes player buyer,unit whichShop,item sold,integer index returns nothing
    call SetPlayerState(buyer, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(buyer, PLAYER_STATE_RESOURCE_GOLD) + udg_FFCH_Price[index])
    if whichShop != null then
        call AddItemToStock(whichShop, udg_FFCH_Item[index], 1, 1)
    endif
    call RemoveItem(sold)
endfunction

function FFCH_Sell takes nothing returns nothing
    local item sold=GetSoldItem()
    local unit buyer=GetBuyingUnit()
    local unit whichShop=GetSellingUnit()
    local player owner=GetOwningPlayer(buyer)
    local integer index=FFCH_FindItem(GetItemTypeId(sold))
    local integer playerNumber=GetConvertedPlayerId(owner)
    local integer shopIndex=FFCH_FindShop(whichShop)
    local integer teamNumber=FFCH_TeamOf(playerNumber)
    local integer slot
    local integer abilityId
    if index == 0 or shopIndex == 0 or not udg_FFCH_Mode then
        // Not an FFCH item, or not one of our shops: leave the map's own shops alone.
        set sold=null
        set buyer=null
        set whichShop=null
        set owner=null
        return
    endif
    set slot=udg_FFCH_Slot[index]
    set abilityId=udg_FFCH_Ability[index]
    if teamNumber == 0 or ( shopIndex - 1 ) / 8 + 1 != teamNumber then
        call DisplayTextToPlayer(owner, 0, 0, "|cffff8080That build area belongs to another team.|r")
        call FFCH_Refund(owner , whichShop , sold , index)
    elseif buyer != udg_FFCH_Hero[playerNumber] then
        call DisplayTextToPlayer(owner, 0, 0, "|cffff8080Only your generated hero can learn spells.|r")
        call FFCH_Refund(owner , whichShop , sold , index)
    elseif udg_FFCH_PlayerSlot[playerNumber * 4 + slot] != 0 then
        call DisplayTextToPlayer(owner, 0, 0, "|cffff8080Your " + udg_FFCH_SlotName[slot] + " slot is already occupied.|r")
        call FFCH_Refund(owner , whichShop , sold , index)
    elseif slot == 1 and udg_FFCH_ZAoE[index] and udg_FFCH_TeamZAoE[teamNumber] != 0 then
        call DisplayTextToPlayer(owner, 0, 0, "|cffff8080Your team has already taken a spell from the Z AoE tavern.|r")
        call FFCH_Refund(owner , whichShop , sold , index)
    elseif FFCH_TeamHasAbility(teamNumber , abilityId) then
        call DisplayTextToPlayer(owner, 0, 0, "|cffff8080A teammate has already learned " + udg_FFCH_Name[index] + ".|r")
        call FFCH_Refund(owner , whichShop , sold , index)
    else
        set udg_FFCH_PlayerSlot[playerNumber * 4 + slot]=abilityId
        call FFCH_TeamAddAbility(teamNumber , abilityId)
        if slot == 1 and udg_FFCH_ZAoE[index] then
            set udg_FFCH_TeamZAoE[teamNumber]=abilityId
        endif
        call UnitAddAbility(buyer, abilityId)
        call SetUnitAbilityLevel(buyer, abilityId, 1)
        call DisplayTextToPlayer(owner, 0, 0, "|cff80ff80Learned " + udg_FFCH_Name[index] + " (" + udg_FFCH_SlotName[slot] + ").|r")
        call RemoveItem(sold)
    endif
    set sold=null
    set buyer=null
    set whichShop=null
    set owner=null
endfunction

function FFCH_EndBuild takes nothing returns nothing
    local integer i=1
    local location target
    loop
        exitwhen i > 32
        if udg_FFCH_Shop[i] != null then
            call RemoveUnit(udg_FFCH_Shop[i])
            set udg_FFCH_Shop[i]=null
        endif
        set i=i + 1
    endloop
    call FFCH_SetNormalSpawns(true)
    call EnableTrigger(gg_trg_FF_AutoPick_2m)
    set i=1
    loop
        exitwhen i > 12
        if udg_FFCH_Hero[i] != null then
            set target=GetPlayerStartLocationLoc(ConvertedPlayer(i))
            call SetUnitPositionLoc(udg_FFCH_Hero[i], target)
            call SelectUnitForPlayerSingle(udg_FFCH_Hero[i], ConvertedPlayer(i))
            call PanCameraToTimedLocForPlayer(ConvertedPlayer(i), target, 1.00)
            call RemoveLocation(target)
            set target=null
        endif
        set i=i + 1
    endloop
    call DisplayTimedTextToForce(GetPlayersAll(), 5.00, "Custom Hero shopping is closed. Your hero has entered the battlefield.")
endfunction

function FFCH_BuildArea takes integer teamNumber returns nothing
    local integer shopSlot=1
    local integer shopIndex
    local integer itemIndex
    local integer j
    local real angle
    local real cx=udg_FFCH_BuildX[teamNumber]
    local real cy=udg_FFCH_BuildY[teamNumber]
    loop
        exitwhen shopSlot > 8
        set shopIndex=( teamNumber - 1 ) * 8 + shopSlot
        set angle=I2R(shopSlot - 1) * 45.00 * bj_DEGTORAD
        set udg_FFCH_Shop[shopIndex]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n000', cx + 288.00 * Cos(angle), cy + 288.00 * Sin(angle), 270.00)
        set j=1
        loop
            exitwhen j > 12
            set itemIndex=( shopSlot - 1 ) * 12 + j
            call AddItemToStock(udg_FFCH_Shop[shopIndex], udg_FFCH_Item[itemIndex], 1, 1)
            set j=j + 1
        endloop
        set shopSlot=shopSlot + 1
    endloop
endfunction

function FFCH_Start takes nothing returns nothing
    local integer i=1
    local integer teamNumber
    local player p
    local unit u
    local real x
    local real y
    local real angle
    if not udg_FFCH_Mode then
        return
    endif
    // Keep normal waves and the automatic hero fallback out of shopping.
    call FFCH_SetNormalSpawns(false)
    call DisableTrigger(gg_trg_FF_AutoPick_2m)
    // One build centre per team, sat on that team's own quarter of the map so the
    // camera never has to leave its normal bounds.  ~4400 units apart.
    set udg_FFCH_BuildX[1]=- 2197.00
    set udg_FFCH_BuildY[1]=1941.00
    set udg_FFCH_BuildX[2]=2197.00
    set udg_FFCH_BuildY[2]=1941.00
    set udg_FFCH_BuildX[3]=2197.00
    set udg_FFCH_BuildY[3]=- 2411.00
    set udg_FFCH_BuildX[4]=- 2197.00
    set udg_FFCH_BuildY[4]=- 2411.00
    loop
        exitwhen i > 4
        set udg_FFCH_TeamZAoE[i]=0
        set udg_FFCH_TeamAbilCount[i]=0
        call FFCH_BuildArea(i)
        set i=i + 1
    endloop
    set i=1
    loop
        exitwhen i > 12
        set p=ConvertedPlayer(i)
        set teamNumber=FFCH_TeamOf(i)
        if teamNumber != 0 and GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING then
            // Three heroes per team, spaced around the middle of the ring.
            set angle=I2R(ModuloInteger(i - 1, 3)) * 120.00 * bj_DEGTORAD
            set x=udg_FFCH_BuildX[teamNumber] + 96.00 * Cos(angle)
            set y=udg_FFCH_BuildY[teamNumber] + 96.00 * Sin(angle)
            set u=CreateUnit(p, udg_hero_type[GetRandomInt(1, udg_total_hero_count)], x, y, 270.00)
            set udg_FFCH_Hero[i]=u
            set udg_herO[i]=u
            set udg_picked_hero[i]=GetUnitTypeId(u)
            set udg_FFCH_PlayerSlot[i * 4 + 1]=0
            set udg_FFCH_PlayerSlot[i * 4 + 2]=0
            set udg_FFCH_PlayerSlot[i * 4 + 3]=0
            set udg_FFCH_PlayerSlot[i * 4 + 4]=0
            call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, 1000)
            call FogModifierStart(CreateFogModifierRadius(p, FOG_OF_WAR_VISIBLE, udg_FFCH_BuildX[teamNumber], udg_FFCH_BuildY[teamNumber], 700.00, true, true))
            call SelectUnitForPlayerSingle(u, p)
            call PanCameraToTimedForPlayer(p, udg_FFCH_BuildX[teamNumber], udg_FFCH_BuildY[teamNumber], 0.00)
        endif
        set i=i + 1
    endloop
    set p=null
    set u=null
    call DisplayTimedTextToForce(GetPlayersAll(), 8.00, "Custom Hero mode: buy one spell for each of Z, X, C and V. Each spell can be taken only once per team. You have 45 seconds.")
    call TimerStart(udg_FFCH_EndTimer, 45.00, false, function FFCH_EndBuild)
endfunction

