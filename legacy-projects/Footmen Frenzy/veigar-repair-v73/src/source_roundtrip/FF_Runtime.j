function CPP_Add_Pathing takes location p,real radius,pathingtype pathingType returns nothing
        local real centerX= GetLocationX(p)
        local real centerY= GetLocationY(p)
        local real stepsX= radius / 16
        local real stepsY= radius / 16
        local real currentX= centerX - radius
        local real currentY
        local integer pathingTypeCount= 0
        local integer x= 0
        local integer y= 0

        // For debugging:
        //local effect sfx
    
        loop
            exitwhen currentX > centerX + radius
    
            set currentY=centerY - radius
    
            loop
                exitwhen currentY > centerY + radius
    
                set x=R2I(currentX)
                set y=R2I(currentY)
                set pathingTypeCount=LoadInteger(CPP_Hash, x, y)
                call SaveInteger(CPP_Hash, x, y, pathingTypeCount + 1)

                // Add pathing if this is the first instance of this pathing at the given coordinates
                if ( pathingTypeCount == 0 ) then
                    call SetTerrainPathable(currentX, currentY, pathingType, false)

                    // For debugging:
                    //set sfx = AddSpecialEffect("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", currentX, currentY)
                    //call BlzSetSpecialEffectScale(sfx, 0.4)
                    //call SaveEffectHandle(CPP_Hash_Debug, x, y, sfx) // debug
                endif
    
                set currentY=currentY + 16.0
            endloop
    
            set currentX=currentX + 16.0
        endloop

    endfunction

function CPP_Remove_Pathing takes location p,real radius,pathingtype pathingType returns nothing
        local real centerX= GetLocationX(p)
        local real centerY= GetLocationY(p)
        local real stepsX= radius / 16
        local real stepsY= radius / 16
        local real currentX= centerX - radius
        local real currentY
        local integer pathingTypeCount= 0
        local integer x= 0
        local integer y= 0
    
        loop
            exitwhen currentX > centerX + radius
    
            set currentY=centerY - radius
    
            loop
                exitwhen currentY > centerY + radius
    
                set x=R2I(currentX)
                set y=R2I(currentY)
                set pathingTypeCount=LoadInteger(CPP_Hash, x, y)
                call SaveInteger(CPP_Hash, x, y, pathingTypeCount - 1)

                // Remove pathing if this is the last instance of this pathing at the given coordinates
                if ( pathingTypeCount == 1 ) then
                    call SetTerrainPathable(currentX, currentY, pathingType, true)
                    //call DestroyEffect(LoadEffectHandle(CPP_Hash_Debug, x, y)) // debug
                endif
    
                set currentY=currentY + 16.0
            endloop
    
            set currentX=currentX + 16.0
        endloop

    endfunction

function s__File_open takes string filename returns integer
            local integer this= s__File_List[0]
       
            if ( this == 0 ) then
                set this=s__File_Counter + 1
                set s__File_Counter=this
            else
                set s__File_List[0]=s__File_List[this]
            endif
           
            set s__File_filename[this]=filename
            set s__File_buffer[this]=null
           
           
            return this
        endfunction

function s__File_write takes integer this,string contents returns integer
            local integer i= 0
            local integer c= 0
            local integer len= StringLength(contents)
            local integer lev= 0
            local string prefix= "-"
            local string chunk
           
            set s__File_buffer[this]=null
           
            // Check if the string is empty. If null, the contents will be cleared.
            if ( contents == "" ) then
                set len=len + 1
            endif
           
            // Begin to generate the file
            call PreloadGenClear()
            call PreloadGenStart()
            loop
                exitwhen i >= len
               
               
                set lev=0








               
                set chunk=SubString(contents, i, i + s__File_PreloadLimit)
                call Preload("\" )\ncall BlzSetAbilityTooltip(" + I2S(s__File_AbilityList[c]) + ", \"" + prefix + chunk + "\", " + I2S(lev) + ")\n//")
                set i=i + s__File_PreloadLimit
                set c=c + 1
            endloop
            call Preload("\" )\nendfunction\nfunction a takes nothing returns nothing\n //")
            call PreloadGenEnd(s__File_filename[this])
       
            return this
        endfunction

function s__File_clear takes integer this returns integer
            return s__File_write(this , null)
        endfunction

function s__File_readPreload takes integer this returns string
            local integer i= 0
            local integer lev= 0
            local string array original
            local string chunk= ""
            local string output= ""
           
            loop
                exitwhen i == s__File_AbilityCount
                set original[i]=BlzGetAbilityTooltip(s__File_AbilityList[i], 0)
                set i=i + 1
            endloop
           
            // Execute the preload file
            call Preloader(s__File_filename[this])
           
            // Read the output
            set i=0
            loop
                exitwhen i == s__File_AbilityCount
               
                set lev=0
               
                // Read from ability index 1 instead of 0 if
                // backwards compatability is enabled





               
                // Make sure the tooltip has changed
                set chunk=BlzGetAbilityTooltip(s__File_AbilityList[i], lev)
               
                if ( chunk == original[i] ) then
                    if ( i == 0 and output == "" ) then
                        return null // empty file
                    endif
                    return output
                endif
               
                // Check if the file is an empty string or null

                    if ( i == 0 ) then
                        if ( SubString(chunk, 0, 1) != "-" ) then
                            return null // empty file
                        endif
                        set chunk=SubString(chunk, 1, StringLength(chunk))
                    endif

               
                // Remove the prefix
                if ( i > 0 ) then
                    set chunk=SubString(chunk, 1, StringLength(chunk))
                endif
               
                // Restore the tooltip and append the chunk
                call BlzSetAbilityTooltip(s__File_AbilityList[i], original[i], lev)
               
                set output=output + chunk
               
                set i=i + 1
            endloop
           
            return output
        endfunction

function s__File_close takes integer this returns nothing
            if ( s__File_buffer[this] != null ) then
                call s__File_write(this , s__File_readPreload(this) + s__File_buffer[this])
                set s__File_buffer[this]=null
            endif
            set s__File_List[this]=s__File_List[0]
            set s__File_List[0]=this
        endfunction

function s__File_readEx takes integer this,boolean close returns string
            local string output= s__File_readPreload(this)
            local string buf= s__File_buffer[this]
       
            if ( close ) then
                call s__File_close(this)
            endif
           
            if ( output == null ) then
                return buf
            endif
           
            if ( buf != null ) then
                set output=output + buf
            endif
           
            return output
        endfunction

function s__File_read takes integer this returns string
            return s__File_readEx(this , false)
        endfunction

function s__File_readAndClose takes integer this returns string
            return s__File_readEx(this , true)
        endfunction

function s__File_appendBuffer takes integer this,string contents returns integer
            set s__File_buffer[this]=s__File_buffer[this] + contents
            return this
        endfunction

function s__File_readBuffer takes integer this returns string
            return s__File_buffer[this]
        endfunction

function s__File_writeBuffer takes integer this,string contents returns nothing
            set s__File_buffer[this]=contents
        endfunction

function s__File_create takes string filename returns integer
            return s__File_write(s__File_open(filename) , "")
        endfunction

function s__File_FileIO___FileInit__onInit takes nothing returns nothing
            local string originalTooltip
           
            // We can't use a single ability with multiple levels because
            // tooltips return the first level's value if the value hasn't
            // been set. This way we don't need to edit any object editor data.
            set s__File_AbilityList[0]='Amls'
            set s__File_AbilityList[1]='Aroc'
            set s__File_AbilityList[2]='Amic'
            set s__File_AbilityList[3]='Amil'
            set s__File_AbilityList[4]='Aclf'
            set s__File_AbilityList[5]='Acmg'
            set s__File_AbilityList[6]='Adef'
            set s__File_AbilityList[7]='Adis'
            set s__File_AbilityList[8]='Afbt'
            set s__File_AbilityList[9]='Afbk'
           
            // Backwards compatability check









           
            // Read check
            set s__File_ReadEnabled=( s__File_readEx(( s__File_write(s__File_open("FileTester.pld") , "FileIO_") ) , true) ) == "FileIO_" // INLINED!!
        endfunction

function FileIO_Write takes string filename,string contents returns nothing
        call s__File_close(s__File_write(s__File_open(filename) , contents))
    endfunction

function FileIO_Read takes string filename returns string
        return s__File_readEx(s__File_open(filename) , true)
    endfunction

function GST_DestroyTimer takes nothing returns nothing
        local timer t= GetExpiredTimer()
        call FlushChildHashtable(GST_Hash, GetHandleId(t))
        call PauseTimer(t)
        call DestroyTimer(t)
        set t=null
    endfunction

function GST_DestroyTimerById takes timer t returns nothing
        call FlushChildHashtable(GST_Hash, GetHandleId(t))
        call PauseTimer(t)
        call DestroyTimer(t)
        set t=null
    endfunction

function GST_RestartTimer takes nothing returns nothing
        local integer trigId= GetHandleId(udg_GST_Trigger)
        set GST_NewKey=( - 1000000000 + ( 100000 * LoadInteger(GST_Hash, - 1, trigId) ) )
        if ( GST_NewKey != - 1000000000 ) then
            // key already exists
            set GST_NewKey=GST_NewKey + udg_GST_RestartKey
        else
            // key doesn't exist, initialize it
            set GST_Index=GST_Index + 1
            set GST_NewKey=( - 1000000000 + ( 100000 * GST_Index ) ) + udg_GST_RestartKey
            call SaveInteger(GST_Hash, - 1, trigId, GST_Index)
        endif
    
        set udg_GST_Timer=LoadTimerHandle(GST_Hash, GST_NewKey, trigId)
    
        // remove the old timer stored at these keys
        if ( udg_GST_Timer != null ) then
            call PauseTimer(udg_GST_Timer)
            call DestroyTimer(udg_GST_Timer)
            call RemoveSavedInteger(GST_Hash, GST_NewKey, trigId)
        endif
    endfunction

function GST_Int_Expire takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer id= GetHandleId(t)
        local trigger trig= LoadTriggerHandle(GST_Hash, id, 2)
        local boolean repeating= LoadBoolean(GST_Hash, id, 1)
        set udg_GST_Integer1=LoadInteger(GST_Hash, id, 0)
    
        // run the GUI trigger
        call TriggerExecute(trig)
    
        // the timer is not repeating so destroy it
        if ( repeating == false ) then
            call FlushChildHashtable(GST_Hash, id)
            call PauseTimer(t)
            call DestroyTimer(t)
        endif
    
        // clean up memory leaks
        set t=null
        set trig=null
    endfunction

