function InitTrig_colossal_stats takes nothing returns nothing
    set gg_trg_colossal_stats=CreateTrigger()
    call DisableTrigger(gg_trg_colossal_stats)
    call TriggerAddAction(gg_trg_colossal_stats, function Trig_colossal_stats_Actions)
endfunction

function Trig_colossal_spawn_Conditions takes nothing returns boolean
    if ( not ( udg_colossal_on == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Func005C takes nothing returns boolean
    if ( not ( ModuloReal(I2R(udg_colossal_wave), 2.00) == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Func026Func001Func003Func001Func003C takes nothing returns boolean
    if ( ( ( udg_colossal_unit_id[udg_X_colo] - udg_colossal_wave_id ) == 0 ) ) then
        return true
    endif
    if ( ( ( udg_colossal_unit_id[udg_X_colo] - udg_colossal_wave_id ) == 10 ) ) then
        return true
    endif
    if ( ( ( udg_colossal_unit_id[udg_X_colo] - udg_colossal_wave_id ) == 20 ) ) then
        return true
    endif
    if ( ( ( udg_colossal_unit_id[udg_X_colo] - udg_colossal_wave_id ) == 30 ) ) then
        return true
    endif
    return false
endfunction

function Trig_colossal_spawn_Func026Func001Func003Func001C takes nothing returns boolean
    if ( not Trig_colossal_spawn_Func026Func001Func003Func001Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Func026Func001Func004Func001C takes nothing returns boolean
    if ( not ( udg_colossal_wave >= udg_colossal_min_wave[udg_X_colo] ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Func026Func001C takes nothing returns boolean
    if ( not ( udg_force_defeat[udg_temp_int] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Func028Func005C takes nothing returns boolean
    if ( not ( udg_colossal_wave_id == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Func028C takes nothing returns boolean
    if ( not ( udg_colossal_wave < udg_colossal_max_wave ) ) then
        return false
    endif
    return true
endfunction

function Trig_colossal_spawn_Actions takes nothing returns nothing
    call P67_ColoSpawn()
    call DestroyTimerDialogBJ(udg_timer_window_colossal)
    // SPAWN MID
    // Colossal
    if ( Trig_colossal_spawn_Func005C() ) then
        set udg_temp_point=Location(0, - 50.00)
        set udg_X_colo=2
        call CreateNUnitsAtLoc(1, 'n04C', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_temp_point, bj_UNIT_FACING)
    else
        set udg_temp_point=Location(0, - 350.00)
        call CreateNUnitsAtLoc(1, 'n04E', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_temp_point, bj_UNIT_FACING)
        set udg_X_colo=1
    endif
    set udg_spawned_colo=GetLastCreatedUnit()
    call PingMinimapLocForForceEx(udg_all_players, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_ATTACK, 100, 0.00, 0.00)
    set udg_colossal_aggro_range=300.00
    // calculate actual
    set udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
    set udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
    set udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
    // set
    call BlzSetUnitMaxHP(udg_spawned_colo, R2I(udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]))
    call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_HP, I2R(BlzGetUnitMaxHP(udg_spawned_colo)))
    call BlzSetUnitMaxMana(udg_spawned_colo, udg_colossal_unit_mp_base[udg_colossal_unit_id[udg_X_colo]])
    call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_MANA, I2R(BlzGetUnitMaxMana(udg_spawned_colo)))
    call BlzSetUnitBaseDamage(udg_spawned_colo, R2I(udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]), 0)
    call BlzSetUnitArmor(udg_spawned_colo, udg_colossal_unit_armor[udg_colossal_unit_id[udg_X_colo]])
    call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]))
    call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_ACQUISITION_RANGE, udg_colossal_aggro_range)
    call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_LEVEL, udg_colossal_unit_level[udg_colossal_unit_id[udg_X_colo]])
    call RemoveLocation(udg_temp_point)
    // SPAWN BASES
    set udg_colossal_aggro_range=250.00
    set udg_temp_int=1
    loop
        exitwhen udg_temp_int > 4
        if ( Trig_colossal_spawn_Func026Func001C() ) then
            call PingMinimapLocForForceEx(udg_all_players, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_ATTACK, 100, 0.00, 0.00)
            set udg_X_colo=3
            loop
                exitwhen udg_X_colo > 22
                if ( Trig_colossal_spawn_Func026Func001Func003Func001C() ) then
                    set udg_X=1
                    loop
                        exitwhen udg_X > udg_colossal_number_of_units[udg_X_colo]
                        call CreateNUnitsAtLoc(1, udg_colossal_unit_type[udg_colossal_unit_id[udg_X_colo]], Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_colossal_point[udg_temp_int], bj_UNIT_FACING)
                        set udg_spawned_colo=GetLastCreatedUnit()
                        // calculate actual
                        set udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
                        set udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
                        set udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
                        // set
                        call BlzSetUnitMaxHP(udg_spawned_colo, R2I(udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]))
                        call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_HP, I2R(BlzGetUnitMaxHP(udg_spawned_colo)))
                        call BlzSetUnitMaxMana(udg_spawned_colo, udg_colossal_unit_mp_base[udg_colossal_unit_id[udg_X_colo]])
                        call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_MANA, I2R(BlzGetUnitMaxMana(udg_spawned_colo)))
                        call BlzSetUnitBaseDamage(udg_spawned_colo, R2I(udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]), 0)
                        call BlzSetUnitArmor(udg_spawned_colo, udg_colossal_unit_armor[udg_colossal_unit_id[udg_X_colo]])
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]))
                        call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_ACQUISITION_RANGE, udg_colossal_aggro_range)
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_LEVEL, udg_colossal_unit_level[udg_colossal_unit_id[udg_X_colo]])
                        set udg_X=udg_X + 1
                    endloop
                else
                    call DoNothing()
                endif
                set udg_X_colo=udg_X_colo + 1
            endloop
            set udg_X_colo=23
            loop
                exitwhen udg_X_colo > 25
                if ( Trig_colossal_spawn_Func026Func001Func004Func001C() ) then
                    set udg_X=1
                    loop
                        exitwhen udg_X > udg_colossal_number_of_units[udg_X_colo]
                        call CreateNUnitsAtLoc(1, udg_colossal_unit_type[udg_colossal_unit_id[udg_X_colo]], Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_colossal_point[udg_temp_int], bj_UNIT_FACING)
                        set udg_spawned_colo=GetLastCreatedUnit()
                        // calculate actual
                        set udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_hp_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
                        set udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_dmg_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
                        set udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]=( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) + ( ( I2R(udg_colossal_unit_bounty_base[udg_colossal_unit_id[udg_X_colo]]) * I2R(udg_colossal_wave) ) * udg_colossal_difficulty ) )
                        // set
                        call BlzSetUnitMaxHP(udg_spawned_colo, R2I(udg_colossal_unit_hp_actual[udg_colossal_unit_id[udg_X_colo]]))
                        call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_HP, I2R(BlzGetUnitMaxHP(udg_spawned_colo)))
                        call BlzSetUnitMaxMana(udg_spawned_colo, udg_colossal_unit_mp_base[udg_colossal_unit_id[udg_X_colo]])
                        call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_MANA, I2R(BlzGetUnitMaxMana(udg_spawned_colo)))
                        call BlzSetUnitBaseDamage(udg_spawned_colo, R2I(udg_colossal_unit_dmg_actual[udg_colossal_unit_id[udg_X_colo]]), 0)
                        call BlzSetUnitArmor(udg_spawned_colo, udg_colossal_unit_armor[udg_colossal_unit_id[udg_X_colo]])
                        call BlzSetUnitIntegerFieldBJ(udg_spawned_colo, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_colossal_unit_bounty_actual[udg_colossal_unit_id[udg_X_colo]]))
                        call BlzSetUnitRealFieldBJ(udg_spawned_colo, UNIT_RF_ACQUISITION_RANGE, udg_colossal_aggro_range)
                        set udg_X=udg_X + 1
                    endloop
                else
                    call DoNothing()
                endif
                set udg_X_colo=udg_X_colo + 1
            endloop
        else
            call DoNothing()
        endif
        set udg_temp_int=udg_temp_int + 1
    endloop
    // start new timer
    if ( Trig_colossal_spawn_Func028C() ) then
        set udg_colossal_wave=( udg_colossal_wave + 1 )
        set udg_colossal_wave_id=( udg_colossal_wave_id + 1 )
        if ( Trig_colossal_spawn_Func028Func005C() ) then
            set udg_colossal_wave_id=1
        else
            call DoNothing()
        endif
        call StartTimerBJ(udg_timer_colossal, false, udg_t_colossal_reoccuring)
        call CreateTimerDialogBJ(udg_timer_colossal, ( "Colossal #" + ( I2S(udg_colossal_wave) + ( " / " + I2S(udg_colossal_max_wave) ) ) ))
        set udg_timer_window_colossal=GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ(true, udg_timer_window_colossal)
    else
        call DoNothing()
    endif
endfunction

function InitTrig_colossal_spawn takes nothing returns nothing
    set gg_trg_colossal_spawn=CreateTrigger()
    call DisableTrigger(gg_trg_colossal_spawn)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_colossal_spawn, udg_timer_colossal)
    call TriggerAddCondition(gg_trg_colossal_spawn, Condition(function Trig_colossal_spawn_Conditions))
    call TriggerAddAction(gg_trg_colossal_spawn, function Trig_colossal_spawn_Actions)
endfunction

