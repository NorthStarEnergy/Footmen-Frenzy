function Trig_autopool_th_execute_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    if ( Trig_autopool_th_execute_Func002C() ) then
        set udg_pool_threshold[udg_temp_playernumber]=0
    else
        call DoNothing()
    endif
    if ( Trig_autopool_th_execute_Func003C() ) then
        set udg_pool_threshold[udg_temp_playernumber]=50
    else
