function Trig_HERO_Shattering_Strike_Action_Func015002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Wrath_Caster)) == true )
endfunction

function Trig_HERO_Shattering_Strike_Action_Func016Func001Func002C takes nothing returns boolean
    if ( ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return true
    endif
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return true
    endif
    if ( ( BlzIsUnitInvulnerable(GetEnumUnit()) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_Shattering_Strike_Action_Func016Func001C takes nothing returns boolean
    if ( not Trig_HERO_Shattering_Strike_Action_Func016Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Action_Func016A takes nothing returns nothing
    if ( Trig_HERO_Shattering_Strike_Action_Func016Func001C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Wrath_Group)
    else
    endif
endfunction

function Trig_HERO_Shattering_Strike_Action_Func030C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Wrath_Group) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Action_Func032A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Wrath_Caster, GetEnumUnit(), udg_Wrath_Damage[0], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_HERO_Shattering_Strike_Action_Actions takes nothing returns nothing
    local integer i= 0
    loop
    exitwhen i > 24
    set i=i + 1
    if GetExpiredTimer() == udg_timer_wrath[i] then
    set udg_X=i
    set i=100
    endif
    endloop
    //                                                                                            
    set udg_Wrath_Caster=udg_herO[udg_X]
    set udg_Wrath_Level=GetUnitAbilityLevelSwapped('A0NB', udg_Wrath_Caster)
    // 145 base AoE + 32 to account for the average collision size
    set udg_temp_AoE=300.00
    set udg_Wrath_Group=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_wrath_point[udg_X], Condition(function Trig_HERO_Shattering_Strike_Action_Func015002003))
    call ForGroupBJ(udg_Wrath_Group, function Trig_HERO_Shattering_Strike_Action_Func016A)
    //                                                                                            
    // SLOW ALL UNITS
    set udg_Wrath_Damage[1]=250.00
    set udg_Wrath_Damage[2]=350.00
    set udg_Wrath_Damage[3]=500.00
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Wrath_Caster), udg_wrath_point[udg_X], bj_UNIT_FACING)
    set udg_dummy=GetLastCreatedUnit()
    call UnitAddAbilityBJ('A0LT', udg_dummy)
    call SetUnitAbilityLevelSwapped('A0LT', udg_dummy, udg_Wrath_Level)
    call IssueImmediateOrderBJ(udg_dummy, "stomp")
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', udg_dummy)
    //                                                                                            
    // Double damage on single target:
    if ( Trig_HERO_Shattering_Strike_Action_Func030C() ) then
        set udg_Wrath_Damage[0]=( udg_Wrath_Damage[udg_Wrath_Level] * 2.00 )
    else
        set udg_Wrath_Damage[0]=( udg_Wrath_Damage[udg_Wrath_Level] + 0.00 )
    endif
    //                                                                                            
    call ForGroupBJ(udg_Wrath_Group, function Trig_HERO_Shattering_Strike_Action_Func032A)
    //                                                                                            
    call RemoveLocation(udg_wrath_point[udg_X])
    call DestroyGroup(udg_Wrath_Group)
endfunction

function InitTrig_HERO_Shattering_Strike_Action takes nothing returns nothing
    set gg_trg_HERO_Shattering_Strike_Action=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[1])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[2])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[3])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[4])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[5])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[6])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[7])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[8])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[9])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[10])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[11])
    call TriggerRegisterTimerExpireEventBJ(gg_trg_HERO_Shattering_Strike_Action, udg_timer_wrath[12])
    call TriggerAddAction(gg_trg_HERO_Shattering_Strike_Action, function Trig_HERO_Shattering_Strike_Action_Actions)
endfunction

