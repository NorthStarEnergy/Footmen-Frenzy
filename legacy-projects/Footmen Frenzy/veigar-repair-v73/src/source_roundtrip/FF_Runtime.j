    if ( not ( udg_leaving_gold[udg_temp_playernumber] > 0 ) ) then
        return false
    endif
    if ( not ( udg_activeplayersinteam > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BASE_collect_gold_Actions takes nothing returns nothing
    set udg_temp_playernumber=udg_Destroyer_Player_Number[GetUnitUserData(GetTriggerUnit())]
    set udg_temp_player=ConvertedPlayer(udg_temp_playernumber)
    set udg_temp_playernumber_ally_1=GetConvertedPlayerId(udg_ally1[udg_temp_playernumber])
    set udg_temp_playernumber_ally_2=GetConvertedPlayerId(udg_ally2[udg_temp_playernumber])
    set udg_temp_playergroup=GetPlayersAllies(udg_temp_player)
    call ForceRemovePlayerSimple(udg_temp_player, udg_temp_playergroup)
    if ( Trig_BASE_collect_gold_Func007C() ) then
        call ForceRemovePlayerSimple(ConvertedPlayer(udg_temp_playernumber_ally_1), udg_temp_playergroup)
    else
    endif
    if ( Trig_BASE_collect_gold_Func008C() ) then
        call ForceRemovePlayerSimple(ConvertedPlayer(udg_temp_playernumber_ally_2), udg_temp_playergroup)
    else
    endif
    set udg_activeplayersinteam=CountPlayersInForceBJ(udg_temp_playergroup)
    set udg_leaving_gold[udg_temp_playernumber]=GetPlayerState(udg_temp_player, PLAYER_STATE_RESOURCE_GOLD)
    call SetPlayerStateBJ(udg_temp_player, PLAYER_STATE_RESOURCE_GOLD, 0)
    if ( Trig_BASE_collect_gold_Func012C() ) then
        call DisplayTextToForce(udg_temp_playergroup, ( "You receive " + ( I2S(( udg_leaving_gold[udg_temp_playernumber] / udg_activeplayersinteam )) + " Gold." ) ))
        call ForForce(udg_temp_playergroup, function Trig_BASE_collect_gold_Func012Func003A)
    else
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

