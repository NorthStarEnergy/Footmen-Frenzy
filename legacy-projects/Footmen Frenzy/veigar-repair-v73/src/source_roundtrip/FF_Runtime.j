        return false
    endif
    if ( not ( GetSpellAbilityId() == 'ASHS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Blink_Start_Func020C takes nothing returns boolean
    // udg_Akama is re-pointed at the captured blinker immediately after the wait.
    if ( not ( IsUnitAliveBJ(udg_Akama) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Blink_Start_Actions takes nothing returns nothing
    local unit blinker= GetTriggerUnit()
    set udg_Akama=blinker
    set udg_Akama_CV=GetUnitUserData(udg_Akama)
    //                                                                                                          
    set udg_Akama_Blink_Point[udg_Akama_CV]=GetUnitLoc(udg_Akama)
    //                                                                                                          
    call AddSpecialEffectLocBJ(udg_Akama_Blink_Point[udg_Akama_CV], "Abilities\\Spells\\Undead\\Possession\\PossessionTarget.mdl")
    set udg_Akama_Blink_Sfx[udg_Akama_CV]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.25)
    //                                                                                                          
    // Enable it:
    call BlzUnitDisableAbility(udg_Akama, 'ABLI', false, false)
    //                                                                                                          
    call PolledWait(5.00)
    //                                                                                                          
    // GetTriggerUnit() here would be a different Akama if one blinked during the 5s wait.
    set udg_Akama=blinker
    set udg_Akama_CV=GetUnitUserData(blinker)
    //                                                                                                          
    if udg_Akama_Blink_Sfx[udg_Akama_CV] != null then
    //                                                                                                          
    if ( Trig_Akama_Blink_Start_Func020C() ) then
        // Disable it:
        call BlzUnitDisableAbility(blinker, 'ABLI', true, false)
    else
    endif
    //                                                                                                          
    call DestroyEffectBJ(udg_Akama_Blink_Sfx[udg_Akama_CV])
    set udg_Akama_Blink_Sfx[udg_Akama_CV]=null
    endif
    set blinker=null
endfunction

function InitTrig_Akama_Blink_Start takes nothing returns nothing
    set gg_trg_Akama_Blink_Start=CreateTrigger()
    call DisableTrigger(gg_trg_Akama_Blink_Start)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Blink_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Akama_Blink_Start, Condition(function Trig_Akama_Blink_Start_Conditions))
    call TriggerAddAction(gg_trg_Akama_Blink_Start, function Trig_Akama_Blink_Start_Actions)
endfunction

function Trig_Akama_Blink_Return_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ABLI' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Akama_Blink_Return_Actions takes nothing returns nothing
    set udg_Akama=GetTriggerUnit()
    set udg_Akama_CV=GetUnitUserData(udg_Akama)
    //                                                                                                          
    set udg_Akama_Blink_Point[0]=GetUnitLoc(udg_Akama)
    call AddSpecialEffectLocBJ(udg_Akama_Blink_Point[0], "WarpStrikeUp.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_Akama_Blink_Point[0])
    //                                                                                                          
    call SetUnitPositionLoc(udg_Akama, udg_Akama_Blink_Point[udg_Akama_CV])
    call IssueImmediateOrderBJ(udg_Akama, "stop")
    call AddSpecialEffectLocBJ(udg_Akama_Blink_Point[udg_Akama_CV], "WarpStrike.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_Akama_Blink_Point[udg_Akama_CV])
    //                                                                                                          
    // Disable it:
    call DestroyEffectBJ(udg_Akama_Blink_Sfx[udg_Akama_CV])
    set udg_Akama_Blink_Sfx[udg_Akama_CV]=null
    call BlzUnitDisableAbility(udg_Akama, 'ABLI', true, false)
endfunction

function InitTrig_Akama_Blink_Return takes nothing returns nothing
    set gg_trg_Akama_Blink_Return=CreateTrigger()
    call DisableTrigger(gg_trg_Akama_Blink_Return)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Akama_Blink_Return, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Akama_Blink_Return, Condition(function Trig_Akama_Blink_Return_Conditions))
    call TriggerAddAction(gg_trg_Akama_Blink_Return, function Trig_Akama_Blink_Return_Actions)
endfunction

function Trig_Avalanche_Toss_Setup_Actions takes nothing returns nothing
    // Define the interval for Toss (shorter = more precise and smoother animation but less efficient):
    set udg_Avalanche_TS_Interval=0.02
    call TriggerRegisterTimerEventPeriodic(gg_trg_Avalanche_Toss_Loop, udg_Avalanche_TS_Interval)
    //                                                                                                                    
    // Define the amount of damage Toss deals to nearby enemy units [Put the level in the brackets]:
    set udg_Avalanche_TS_Damage[1]=90.00
    set udg_Avalanche_TS_Damage[2]=140.00
    set udg_Avalanche_TS_Damage[3]=200.00
    set udg_Avalanche_TS_Damage[4]=250.00
    set udg_Avalanche_TS_Damage[5]=330.00
    set udg_Avalanche_TS_Damage[6]=500.00
endfunction

function InitTrig_Avalanche_Toss_Setup takes nothing returns nothing
    set gg_trg_Avalanche_Toss_Setup=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_Avalanche_Toss_Setup, 0.00)
    call TriggerAddAction(gg_trg_Avalanche_Toss_Setup, function Trig_Avalanche_Toss_Setup_Actions)
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ATSS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Func006Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Avalanche_TS_Picked_Unit) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_Avalanche_TS_Picked_Unit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Avalanche_TS_Picked_Unit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Avalanche_TS_Picked_Unit, UNIT_TYPE_ANCIENT) == false ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0IL', udg_Avalanche_TS_Picked_Unit) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('ATCL', udg_Avalanche_TS_Picked_Unit) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Func006A takes nothing returns nothing
    set udg_Avalanche_TS_Picked_Unit=GetEnumUnit()
    if ( Trig_Avalanche_Toss_Begin_Cast_Func006Func002C() ) then
    else
        call GroupRemoveUnitSimple(udg_Avalanche_TS_Picked_Unit, udg_Avalanche_TS_Nearby_Group)
    endif
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Avalanche_TS_Nearby_Group) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avalanche_Toss_Begin_Cast_Actions takes nothing returns nothing
    set udg_Avalanche_TS_Source[0]=GetTriggerUnit()
    set udg_Avalanche_TS_Point[0]=GetUnitLoc(udg_Avalanche_TS_Source[0])
    //                                                                                                                    
    // Filter out unwanted units:
    set udg_Avalanche_TS_Nearby_Group=GetUnitsInRangeOfLocAll(350.00, udg_Avalanche_TS_Point[0])
    call ForGroupBJ(udg_Avalanche_TS_Nearby_Group, function Trig_Avalanche_Toss_Begin_Cast_Func006A)
    //                                                                                                                    
    call RemoveLocation(udg_Avalanche_TS_Point[0])
    //                                                                                                                    
    // If no unit was found then abort:
    if ( Trig_Avalanche_Toss_Begin_Cast_Func011C() ) then
        call IssueImmediateOrderBJ(GetTriggerUnit(), "stop")
    else
    endif
    //                                                                                                                    
    call DestroyGroup(udg_Avalanche_TS_Nearby_Group)
endfunction

function InitTrig_Avalanche_Toss_Begin_Cast takes nothing returns nothing
    set gg_trg_Avalanche_Toss_Begin_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Avalanche_Toss_Begin_Cast, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Avalanche_Toss_Begin_Cast, Condition(function Trig_Avalanche_Toss_Begin_Cast_Conditions))
    call TriggerAddAction(gg_trg_Avalanche_Toss_Begin_Cast, function Trig_Avalanche_Toss_Begin_Cast_Actions)
endfunction

function Trig_Avalanche_Toss_Start_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'ATSS' ) ) then
        return false
    endif
    return true
