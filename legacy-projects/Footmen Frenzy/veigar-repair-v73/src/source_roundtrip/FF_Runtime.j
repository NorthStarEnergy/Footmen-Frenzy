function InitTrig_autopool_command takes nothing returns nothing
    set gg_trg_autopool_command=CreateTrigger()
    call DisableTrigger(gg_trg_autopool_command)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(0), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(1), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(2), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(3), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(4), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(5), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(6), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(7), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(8), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(9), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(10), "-pool", false)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(11), "-pool", false)
    // "-p" is the short alias for "-pool". Registered as a prefix it also swallowed "-players"
    // (and made "-pool" match twice on this same trigger, firing it twice); exact match instead.
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(0), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(1), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(2), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(3), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(4), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(5), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(6), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(7), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(8), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(9), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(10), "-p", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_autopool_command, Player(11), "-p", true)
    call TriggerAddCondition(gg_trg_autopool_command, Condition(function Trig_autopool_command_Conditions))
    call TriggerAddAction(gg_trg_autopool_command, function Trig_autopool_command_Actions)
endfunction

