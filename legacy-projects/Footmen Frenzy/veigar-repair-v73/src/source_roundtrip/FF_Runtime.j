endfunction

function InitTrig_set_hero_numbers takes nothing returns nothing
    set gg_trg_set_hero_numbers=CreateTrigger()
    call TriggerAddAction(gg_trg_set_hero_numbers, function Trig_set_hero_numbers_Actions)
endfunction

