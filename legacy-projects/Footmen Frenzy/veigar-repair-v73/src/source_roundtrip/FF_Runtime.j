endfunction

function Trig_GM_send_messages_Func003Func001C takes nothing returns boolean
    if ( not ( udg_guided[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GM_send_messages_Actions takes nothing returns nothing
    set udg_guided_tip_number=( udg_guided_tip_number + 1 )
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_GM_send_messages_Func003Func001C() ) then
            set udg_temp_playergroup=GetForceOfPlayer(ConvertedPlayer(udg_X))
            call DisplayTextToForce(udg_temp_playergroup, ( ( ( "(Tip #|cffffff00 " + I2S(udg_guided_tip_number) ) + ( "|r of|cffffff00 " + ( I2S(udg_total_tips) + "|r) - |cff00ff00 " ) ) ) + udg_guided_tip[udg_guided_tip_number] ))
            if ( Trig_GM_send_messages_Func003Func001Func003C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func004C() ) then
                set udg_temp_point=GetUnitLoc(gg_unit_n01B_0055)
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                set udg_temp_point=GetUnitLoc(gg_unit_n01B_0056)
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func005C() ) then
                set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_X))
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func006C() ) then
                set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_X))
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func007C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func008C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            if ( Trig_GM_send_messages_Func003Func001Func009C() ) then
                set udg_temp_point=GetRectCenter(GetPlayableMapRect())
                call PingMinimapLocForForceEx(udg_temp_playergroup, udg_temp_point, 3.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
                call RemoveLocation(udg_temp_point)
            else
                call DoNothing()
            endif
            call DestroyForce(udg_temp_playergroup)
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_GM_send_messages takes nothing returns nothing
    set gg_trg_GM_send_messages=CreateTrigger()
    call DisableTrigger(gg_trg_GM_send_messages)
    call TriggerRegisterTimerEventPeriodic(gg_trg_GM_send_messages, 30.00)
    call TriggerAddCondition(gg_trg_GM_send_messages, Condition(function Trig_GM_send_messages_Conditions))
    call TriggerAddAction(gg_trg_GM_send_messages, function Trig_GM_send_messages_Actions)
endfunction

