function Trig_suicide_pressed_Func004Func001C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_dlg_forfeit_btn_no[udg_temp_playernumber] ) ) then
        return false
    endif
    return true
endfunction

