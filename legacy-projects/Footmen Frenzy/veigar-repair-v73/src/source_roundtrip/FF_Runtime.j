function Trig_KOTH_Reset_Hill_Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_KOTH_Hill) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Reset_Hill_Func017C takes nothing returns boolean
    if ( not ( udg_KOTH_Player != Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Reset_Hill_Actions takes nothing returns nothing
    // If the hill is still alive then remove it:
    if ( Trig_KOTH_Reset_Hill_Func002C() ) then
        call RemoveUnit(udg_KOTH_Hill)
    else
    endif
    //                                                                                                     
    // Recreate the hill:
    call CreateNUnitsAtLoc(1, 'koth', Player(PLAYER_NEUTRAL_PASSIVE), udg_centermap, bj_UNIT_FACING)
    set udg_KOTH_Hill=GetLastCreatedUnit()
    call BlzSetUnitMaxHP(udg_KOTH_Hill, udg_KOTH_HP)
    call SetUnitLifePercentBJ(udg_KOTH_Hill, 100)
    call BlzSetUnitIntegerFieldBJ(udg_KOTH_Hill, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, udg_KOTH_Gold_Bounty)
    call SetUnitVertexColorBJ(udg_KOTH_Hill, 100, 100, 100, 100.00)
    call DestroyEffectBJ(udg_KOTH_Invul)
    //                                                                                                     
    // Create or update the hill glow special effect:
    call TriggerExecute(gg_trg_KOTH_Create_Hill_Glow)
    //                                                                                                     
    // Only reduce it's life / regen if it's now under a Players control:
    if ( Trig_KOTH_Reset_Hill_Func017C() ) then
        call SetUnitAbilityLevelSwapped('AKOH', udg_KOTH_Hill, udg_KOTH_Level)
        call SetUnitInvulnerable(udg_KOTH_Hill, true)
        call AddSpecialEffectLocBJ(udg_centermap, "Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl")
        call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.00)
        set udg_KOTH_Invul=GetLastCreatedEffectBJ()
        call StartTimerBJ(udg_timer_KOTH_Invul, false, 3.00)
    else
        call SetUnitAbilityLevelSwapped('AKOH', udg_KOTH_Hill, 1)
    endif
    //                                                                                                     
    call TriggerExecute(gg_trg_KOTH_Update_Text)
endfunction

function InitTrig_KOTH_Reset_Hill takes nothing returns nothing
    set gg_trg_KOTH_Reset_Hill=CreateTrigger()
    call TriggerAddAction(gg_trg_KOTH_Reset_Hill, function Trig_KOTH_Reset_Hill_Actions)
endfunction

function Trig_KOTH_Create_Hill_Glow_Actions takes nothing returns nothing
    if udg_KOTH_Hill_Glow_SFX != null then
    //                                                                                                     
    // Update the color:
    call BlzSetSpecialEffectColorByPlayer(udg_KOTH_Hill_Glow_SFX, udg_KOTH_Player)
    //                                                                                                     
    else
    //                                                                                                     
    // Create the hill glow special effect:
    call AddSpecialEffectLocBJ(udg_centermap, "Spell_Marker_TC.mdx")
    set udg_KOTH_Hill_Glow_SFX=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(udg_KOTH_Hill_Glow_SFX, 1.50)
    call BlzSetSpecialEffectColorByPlayer(udg_KOTH_Hill_Glow_SFX, udg_KOTH_Player)
    call BlzSetSpecialEffectAlpha(udg_KOTH_Hill_Glow_SFX, 100)
    //                                                                                                     
    endif
endfunction

