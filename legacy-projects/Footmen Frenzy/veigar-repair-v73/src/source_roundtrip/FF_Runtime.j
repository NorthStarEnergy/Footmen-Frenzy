    if ( not ( GetSpellAbilityId() == 'A0EC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Thor_Mjolnir_Throw_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_point=GetSpellTargetLoc()
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_mjolnir_degree[udg_temp_playernumber]=AngleBetweenPoints(udg_temp_point_caster, udg_temp_point)
    call CreateNUnitsAtLoc(1, 'h049', udg_temp_player, udg_temp_point_caster, udg_mjolnir_degree[udg_temp_playernumber])
    set udg_dummy_mjolnir[udg_temp_playernumber]=GetLastCreatedUnit()
    set udg_mjolnir_level_Copy[GetUnitUserData(GetLastCreatedUnit())]=udg_abilitylevel
    set udg_mjolnir_location[udg_temp_playernumber]=udg_temp_point_caster
    set udg_mjolnir_active[udg_temp_playernumber]=true
    call EnableTrigger(gg_trg_HERO_Thor_Mjolnir_Loop)
    call RemoveLocation(udg_temp_point)
    call RemoveLocation(udg_temp_point_caster)
endfunction

