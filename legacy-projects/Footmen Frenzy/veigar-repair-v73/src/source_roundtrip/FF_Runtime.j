function Trig_KOTH_Setup_Func012C takes nothing returns boolean
    if ( not ( udg_mode_overdrive == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Setup_Actions takes nothing returns nothing
    // THIS TIMER IS STARTED IN: Game mode/Game/MODE King Of The Hill
    //                                                                                                     
    // Define your King of the Hill variables:
    //                                                                                                     
    // The starting gold of the hill:
    set udg_KOTH_Gold_Starting_Total=99999
    set udg_KOTH_Gold_Remaining=udg_KOTH_Gold_Starting_Total
    //                                                                                                     
    // The default amount of gold rewarded whenever the income timer expires:
    set udg_KOTH_Gold_Rewarded=6
    set udg_KOTH_Gold_Division_Bonus=1
    if ( Trig_KOTH_Setup_Func012C() ) then
        set udg_KOTH_Gold_Rewarded=6
    else
        call DoNothing()
    endif
    //                                                                                                     
    // How much gold remaining is needed for the income reward to increase:
    set udg_KOTH_Gold_Half_Remaining=89000
    //                                                                                                     
    // How much gold a team can earn before the Hill resets:
    if udg_mode_debugmode then
        set udg_KOTH_Gold_Reset_Amount=30
    else
        set udg_KOTH_Gold_Reset_Amount=300
    endif
    set udg_KOTH_Gold_Bounty=20
    //                                                                                                     
    // Create the starting hill:
    set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
    call CreateNUnitsAtLoc(1, 'koth', udg_KOTH_Player, udg_centermap, bj_UNIT_FACING)
    set udg_KOTH_Hill=GetLastCreatedUnit()
    call SetUnitVertexColorBJ(udg_KOTH_Hill, 100, 100, 100, 100.00)
    //                                                                                                     
    // Create the starting text:
    set udg_KOTH_Level=2
    call TriggerExecute(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    // Create the hero glow special effect:
    call TriggerExecute(gg_trg_KOTH_Create_Hill_Glow)
    //                                                                                                     
    //                                                                                                     
    // Starts timers for each level of the hill
    call StartTimerBJ(udg_KOTH_Second_Hill_Timer, false, 900.00)
    call StartTimerBJ(udg_KOTH_Third_Hill_Timer, false, 1800.00)
endfunction

function InitTrig_KOTH_Setup takes nothing returns nothing
    set gg_trg_KOTH_Setup=CreateTrigger()
    call DisableTrigger(gg_trg_KOTH_Setup)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_KOTH_Setup, udg_KOTH_Setup_Timer)
    call TriggerAddAction(gg_trg_KOTH_Setup, function Trig_KOTH_Setup_Actions)
endfunction

function SoloSub_MsgPlayer takes player p,string s returns nothing
    if p != null then
        call DisplayTimedTextToPlayer(p, 0.00, 0.00, 20.00, s)
    endif
endfunction

function SoloSub_MsgAll takes string s returns nothing
    call DisplayTimedTextToForce(udg_all_players, 20.00, s)
endfunction

function SoloSub_AllianceType takes integer i returns alliancetype
    if i == 0 then
        return ALLIANCE_PASSIVE
    elseif i == 1 then
        return ALLIANCE_HELP_REQUEST
    elseif i == 2 then
        return ALLIANCE_HELP_RESPONSE
    elseif i == 3 then
        return ALLIANCE_SHARED_XP
    elseif i == 4 then
        return ALLIANCE_SHARED_SPELLS
    elseif i == 5 then
        return ALLIANCE_SHARED_VISION
    elseif i == 6 then
        return ALLIANCE_SHARED_CONTROL
    endif
    return ALLIANCE_SHARED_ADVANCED_CONTROL
endfunction

function SoloSub_IsEffectivePlayer takes player p returns boolean
    local integer pid= GetPlayerId(p)
    if pid >= 0 and pid < 12 then
        return GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING or SoloSub_pendingPlayer[pid + 1] or SoloSub_observerForPlayer[pid + 1] != 0
    endif
    return SoloSub_playerForObserver[pid] == 0 and GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING
endfunction

function SoloSub_IsAvailableObserver takes integer observerId returns boolean
    local player observer
    if observerId < 12 or observerId >= 24 or SoloSub_playerForObserver[observerId] != 0 then
        return false
    endif
    set observer=Player(observerId)
    // RC6BOT HOST BEGIN
    if FF_IsBotName(GetPlayerName(observer)) then
        set observer=null
        return false
    endif
    // RC6BOT HOST END
    if GetPlayerSlotState(observer) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(observer) == MAP_CONTROL_USER and GetPlayerTeam(observer) == 4 then
        set observer=null
        return true
    endif
    set observer=null
    return false
endfunction

function SoloSub_SnapshotObserverAlliance takes integer observerId returns nothing
    local integer otherId= 0
    local integer fi
    local integer base
    local player observer= Player(observerId)
    local player other
    loop
        exitwhen otherId >= 24
        set other=Player(otherId)
        set base=observerId * 192 + otherId * 8
        set fi=0
        loop
            exitwhen fi >= 8
            set SoloSub_snapOut[base + fi]=GetPlayerAlliance(observer, other, SoloSub_AllianceType(fi))
            set SoloSub_snapIn[base + fi]=GetPlayerAlliance(other, observer, SoloSub_AllianceType(fi))
            set fi=fi + 1
        endloop
        set otherId=otherId + 1
    endloop
    set observer=null
    set other=null
endfunction

function SoloSub_RestoreObserverAlliance takes integer observerId returns nothing
    local integer otherId= 0
    local integer fi
    local integer base
    local player observer= Player(observerId)
    local player other
    loop
        exitwhen otherId >= 24
        set other=Player(otherId)
        set base=observerId * 192 + otherId * 8
        set fi=0
        loop
            exitwhen fi >= 8
            call SetPlayerAlliance(observer, other, SoloSub_AllianceType(fi), SoloSub_snapOut[base + fi])
            call SetPlayerAlliance(other, observer, SoloSub_AllianceType(fi), SoloSub_snapIn[base + fi])
            set fi=fi + 1
        endloop
        set otherId=otherId + 1
    endloop
    set observer=null
    set other=null
endfunction

function SoloSub_MirrorAlliance takes player lostPlayer,player observer,player other returns nothing
    local integer fi= 0
    loop
        exitwhen fi >= 8
        call SetPlayerAlliance(observer, other, SoloSub_AllianceType(fi), GetPlayerAlliance(lostPlayer, other, SoloSub_AllianceType(fi)))
        call SetPlayerAlliance(other, observer, SoloSub_AllianceType(fi), GetPlayerAlliance(other, lostPlayer, SoloSub_AllianceType(fi)))
        set fi=fi + 1
    endloop
endfunction

function SoloSub_RemoveObserverVision takes integer observerId returns nothing
    if SoloSub_observerFog[observerId] != null then
        call DestroyFogModifier(SoloSub_observerFog[observerId])
        set SoloSub_observerFog[observerId]=null
    endif
endfunction

function SoloSub_GrantObserverVision takes integer observerId returns nothing
    if SoloSub_observerFog[observerId] != null then
        call DestroyFogModifier(SoloSub_observerFog[observerId])
        set SoloSub_observerFog[observerId]=null
    endif
    call CreateFogModifierRectBJ(true, Player(observerId), FOG_OF_WAR_VISIBLE, GetPlayableMapRect())
    set SoloSub_observerFog[observerId]=GetLastCreatedFogModifier()
endfunction

function SoloSub_ReleaseObserver takes integer playerNumber returns nothing
    local integer storedObserver= SoloSub_observerForPlayer[playerNumber]
    local integer observerId= storedObserver - 1
    local player observer
    if storedObserver == 0 or observerId < 12 or observerId >= 24 then
        return
    endif
    set observer=Player(observerId)
    set SoloSub_observerForPlayer[playerNumber]=0
    set SoloSub_playerForObserver[observerId]=0
    call SoloSub_RestoreObserverAlliance(observerId)
    call SetPlayerTeam(observer, 4)
    call SetPlayerColor(observer, SoloSub_savedColor[observerId])
    if SoloSub_observerOriginalName[observerId] != "" then
        call SetPlayerName(observer, SoloSub_observerOriginalName[observerId])
        set SoloSub_observerOriginalName[observerId]=""
    endif
    // v60: close the resource proxy before the observer goes back to team 4.
    call SetPlayerState(observer, PLAYER_STATE_RESOURCE_GOLD, 0)
    call SetPlayerState(observer, PLAYER_STATE_RESOURCE_LUMBER, 0)
    call SetPlayerState(observer, PLAYER_STATE_RESOURCE_FOOD_CAP, 0)
    set SoloSub_goldShadow[observerId]=0
    set SoloSub_lumberShadow[observerId]=0
    call SoloSub_GrantObserverVision(observerId)
    set FF_oc_mode[observerId]=0
    set FF_oc_followed[observerId]=null
    call ResetToGameCameraForPlayer(observer, 0.00)
    call SoloSub_MsgPlayer(observer , "The inherited position was eliminated. You have returned to the observer team.")
    set observer=null
endfunction

function SoloSub_TryReplace takes player lostPlayer,integer observerId returns boolean
    local integer playerNumber= GetPlayerId(lostPlayer) + 1
    local integer otherId= 0
    local player observer
    local player other
    local string lostName
    if playerNumber < 1 or playerNumber > 12 or not SoloSub_pendingPlayer[playerNumber] or not SoloSub_IsAvailableObserver(observerId) or SoloSub_observerForPlayer[playerNumber] != 0 then
        return false
    endif
    set observer=Player(observerId)
    set lostName=GetPlayerName(lostPlayer)
    // Snapshot the observer's pre-substitution identity and diplomacy.
    if SoloSub_observerOriginalName[observerId] == "" then
        set SoloSub_observerOriginalName[observerId]=GetPlayerName(observer)
    endif
    set SoloSub_savedColor[observerId]=GetPlayerColor(observer)
    call SoloSub_SnapshotObserverAlliance(observerId)
    // Establish the mapping and clear the pending flag.
    set SoloSub_observerForPlayer[playerNumber]=observerId + 1
    set SoloSub_playerForObserver[observerId]=playerNumber
    set SoloSub_pendingPlayer[playerNumber]=false
    set SoloSub_pendingTicks[playerNumber]=0
    // Stop the rc3 spectator camera director for this slot (team change alone
    // drops it from FF_oc_CanObserve; also reset the view to free the camera).
    set FF_oc_mode[observerId]=0
    set FF_oc_followed[observerId]=null
    call ResetToGameCameraForPlayer(observer, 0.00)
    // Join the lost player's team and inherit their colour and diplomacy.
    call SetPlayerTeam(observer, GetPlayerTeam(lostPlayer))
    call SetPlayerColor(observer, GetPlayerColor(lostPlayer))
    loop
        exitwhen otherId >= 24
        if otherId != observerId then
            set other=Player(otherId)
            call SoloSub_MirrorAlliance(lostPlayer , observer , other)
        endif
        set otherId=otherId + 1
    endloop
    // Grant the observer shared advanced control of the canonical slot.
    call SetPlayerAlliance(lostPlayer, observer, ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(lostPlayer, observer, ALLIANCE_SHARED_VISION, true)
    call SetPlayerAlliance(lostPlayer, observer, ALLIANCE_SHARED_CONTROL, true)
    call SetPlayerAlliance(lostPlayer, observer, ALLIANCE_SHARED_ADVANCED_CONTROL, true)
    call SetPlayerAlliance(observer, lostPlayer, ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(observer, lostPlayer, ALLIANCE_SHARED_VISION, true)
    // Remove leftover full-map observer vision (keeps only allied vision).
    call SoloSub_RemoveObserverVision(observerId)
    // v60: the map stores identity in the CANONICAL slot's player name, in
    // the form "(HeroName) PlayerName" (Trig_TP_hero_Actions). The multiboard,
    // the kill feed and the -sub messages all read that, so point it at the
    // substitute instead of leaving the departed player's name in place.
    set udg_orig_player_name[playerNumber]=SoloSub_observerOriginalName[observerId]
    if udg_herO[playerNumber] != null then
        call SetPlayerName(lostPlayer, "(" + GetUnitName(udg_herO[playerNumber]) + ") " + udg_orig_player_name[playerNumber])
    else
        call SetPlayerName(lostPlayer, udg_orig_player_name[playerNumber])
    endif
    set udg_coloured_playername[playerNumber]=udg_colour[playerNumber] + GetPlayerName(lostPlayer) + "|r"
    // v60: let the substitute buy a hero. Only slots 1-12 get a food cap and
    // a hero limit at init, so an observer sits at cap 0 and the tavern
    // refuses the purchase before any trigger can run.
    call SetPlayerMaxHeroesAllowed(2, observer)
    call SetPlayerState(observer, PLAYER_STATE_RESOURCE_FOOD_CAP, 5)
    // v60: open the resource proxy at the slot's true balance.
    set SoloSub_goldShadow[observerId]=GetPlayerState(lostPlayer, PLAYER_STATE_RESOURCE_GOLD)
    call SetPlayerState(observer, PLAYER_STATE_RESOURCE_GOLD, SoloSub_goldShadow[observerId])
    set SoloSub_lumberShadow[observerId]=GetPlayerState(lostPlayer, PLAYER_STATE_RESOURCE_LUMBER)
    call SetPlayerState(observer, PLAYER_STATE_RESOURCE_LUMBER, SoloSub_lumberShadow[observerId])
    call SetPlayerName(observer, GetPlayerName(observer) + " (sub for " + lostName + ")")
    call SoloSub_MsgAll("|cff32cd32" + GetPlayerName(observer) + " has entered the game for " + lostName + ".|r")
    call SoloSub_MsgPlayer(observer , "You now have full control of " + lostName + "'s units, production, hero and resources.")
    set observer=null
    set other=null
    return true
endfunction

function SoloSub_ResetFlow takes nothing returns nothing
    if SoloSub_responseTimer != null then
        call PauseTimer(SoloSub_responseTimer)
    endif
    if SoloSub_selector != null then
        call DialogDisplayBJ(false, SoloSub_chooseDialog, SoloSub_selector)
    endif
    if SoloSub_chosenObserverId >= 12 and SoloSub_chosenObserverId < 24 then
        call DialogDisplayBJ(false, SoloSub_confirmDialog, Player(SoloSub_chosenObserverId))
    endif
    set SoloSub_selector=null
    set SoloSub_targetPlayerNumber=0
    set SoloSub_chosenObserverId=- 1
    set SoloSub_choosePage=1
    set SoloSub_flowActive=false
endfunction

function SoloSub_ResponseTimedOut takes nothing returns nothing
    if not SoloSub_flowActive then
        return
    endif
    if SoloSub_chosenObserverId >= 12 then
        call SoloSub_MsgPlayer(SoloSub_selector , GetPlayerName(Player(SoloSub_chosenObserverId)) + " did not answer the substitute request in time.")
        call SoloSub_MsgPlayer(Player(SoloSub_chosenObserverId) , "The substitute request expired.")
    else
        call SoloSub_MsgPlayer(SoloSub_selector , "The observer-selection menu expired.")
    endif
    call SoloSub_ResetFlow()
endfunction

function SoloSub_HasObserverOnPage takes integer page returns boolean
    local integer firstId= 12
    local integer lastId= 19
    if page == 2 then
        set firstId=20
        set lastId=23
    endif
    loop
        exitwhen firstId > lastId
        if SoloSub_IsAvailableObserver(firstId) then
            return true
        endif
        set firstId=firstId + 1
    endloop
    return false
endfunction

function SoloSub_RebuildChooseDialog takes nothing returns nothing
    local integer firstId= 12
    local integer lastId= 19
    local integer observerId= 12
    if SoloSub_choosePage == 2 then
        set firstId=20
        set lastId=23
    endif
    call DialogClearBJ(SoloSub_chooseDialog)
    call DialogSetMessageBJ(SoloSub_chooseDialog, "Choose a substitute for " + GetPlayerName(ConvertedPlayer(SoloSub_targetPlayerNumber)))
    loop
        exitwhen observerId >= 24
        set SoloSub_observerButton[observerId]=null
        set observerId=observerId + 1
    endloop
    set observerId=firstId
    loop
        exitwhen observerId > lastId
        if SoloSub_IsAvailableObserver(observerId) then
            call DialogAddButtonBJ(SoloSub_chooseDialog, GetPlayerName(Player(observerId)))
            set SoloSub_observerButton[observerId]=GetLastCreatedButtonBJ()
        endif
        set observerId=observerId + 1
    endloop
    if SoloSub_choosePage == 1 and SoloSub_HasObserverOnPage(2) then
        call DialogAddButtonBJ(SoloSub_chooseDialog, "Next page")
        set SoloSub_nextButton=GetLastCreatedButtonBJ()
    else
        set SoloSub_nextButton=null
    endif
    if SoloSub_choosePage == 2 then
        call DialogAddButtonBJ(SoloSub_chooseDialog, "Previous page")
        set SoloSub_prevButton=GetLastCreatedButtonBJ()
    else
        set SoloSub_prevButton=null
    endif
    call DialogAddButtonBJ(SoloSub_chooseDialog, "Cancel")
    set SoloSub_cancelButton=GetLastCreatedButtonBJ()
    call DialogDisplayBJ(true, SoloSub_chooseDialog, SoloSub_selector)
    call TimerStart(SoloSub_responseTimer, 30.00, false, function SoloSub_ResponseTimedOut)
endfunction

function SoloSub_CommandPlayerNumber takes player requester returns integer
    local integer requesterId=GetPlayerId(requester)
    local integer playerNumber=requesterId + 1
    if requesterId < 0 or requesterId >= 24 or GetPlayerSlotState(requester) != PLAYER_SLOT_STATE_PLAYING then
        return 0
    endif
    if requesterId >= 12 then
        set playerNumber=SoloSub_playerForObserver[requesterId]
        if playerNumber < 1 or playerNumber > 12 then
            return 0
        endif
        if SoloSub_observerForPlayer[playerNumber] != requesterId + 1 then
            return 0
        endif
    endif
    if not udg_player_active[playerNumber] or SoloSub_pendingPlayer[playerNumber] then
        return 0
    endif
    return playerNumber
endfunction

function SoloSub_CommandActions takes nothing returns nothing
    local player requester= GetTriggerPlayer()
    local integer requesterNumber=SoloSub_CommandPlayerNumber(requester)
    local integer playerNumber= 1
    local integer foundPlayerNumber= 0
    if SoloSub_flowActive then
        call SoloSub_MsgPlayer(requester , "A substitute request is already being decided. Try again shortly.")
        set requester=null
        return
    endif
    if requesterNumber == 0 then
        call SoloSub_MsgPlayer(requester , "Only an active teammate can choose a substitute.")
        set requester=null
        return
    endif
    // Lowest-numbered pending position that this requester is allied to.
    loop
        exitwhen playerNumber > 12
        if SoloSub_pendingPlayer[playerNumber] and IsPlayerAlly(ConvertedPlayer(requesterNumber), ConvertedPlayer(playerNumber)) then
            set foundPlayerNumber=playerNumber
            set playerNumber=13
        else
            set playerNumber=playerNumber + 1
        endif
    endloop
    if foundPlayerNumber == 0 then
        call SoloSub_MsgPlayer(requester , "There is no lost teammate you can currently choose a substitute for.")
        set requester=null
        return
    endif
    if not SoloSub_HasObserverOnPage(1) and not SoloSub_HasObserverOnPage(2) then
        call SoloSub_MsgPlayer(requester , "There are no available observers to invite.")
        set requester=null
        return
    endif
    set SoloSub_flowActive=true
    set SoloSub_selector=requester
    set SoloSub_targetPlayerNumber=foundPlayerNumber
    set SoloSub_choosePage=1
    if not SoloSub_HasObserverOnPage(1) then
        set SoloSub_choosePage=2
    endif
    call SoloSub_RebuildChooseDialog()
    set requester=null
endfunction

function SoloSub_ChooseActions takes nothing returns nothing
    local integer observerId= 12
    local button clicked= GetClickedButtonBJ()
    if not SoloSub_flowActive or GetTriggerPlayer() != SoloSub_selector then
        set clicked=null
        return
    endif
    if clicked == SoloSub_cancelButton then
        call SoloSub_ResetFlow()
        set clicked=null
        return
    endif
    if clicked == SoloSub_nextButton then
        set SoloSub_choosePage=2
        call SoloSub_RebuildChooseDialog()
        set clicked=null
        return
    endif
    if clicked == SoloSub_prevButton then
        set SoloSub_choosePage=1
        call SoloSub_RebuildChooseDialog()
        set clicked=null
        return
    endif
    loop
        exitwhen observerId >= 24
        if clicked == SoloSub_observerButton[observerId] and SoloSub_IsAvailableObserver(observerId) then
            set SoloSub_chosenObserverId=observerId
            call DialogDisplayBJ(false, SoloSub_chooseDialog, SoloSub_selector)
            call DialogClearBJ(SoloSub_confirmDialog)
            call DialogSetMessageBJ(SoloSub_confirmDialog, GetPlayerName(SoloSub_selector) + " wants you to substitute for " + GetPlayerName(ConvertedPlayer(SoloSub_targetPlayerNumber)) + ". Accept?")
            call DialogAddButtonBJ(SoloSub_confirmDialog, "Yes")
            set SoloSub_yesButton=GetLastCreatedButtonBJ()
            call DialogAddButtonBJ(SoloSub_confirmDialog, "No")
            set SoloSub_noButton=GetLastCreatedButtonBJ()
            call DialogDisplayBJ(true, SoloSub_confirmDialog, Player(observerId))
            call TimerStart(SoloSub_responseTimer, 30.00, false, function SoloSub_ResponseTimedOut)
            call SoloSub_MsgPlayer(SoloSub_selector , "Waiting for " + GetPlayerName(Player(observerId)) + " to accept or decline.")
            set observerId=24
        else
            set observerId=observerId + 1
        endif
    endloop
    set clicked=null
endfunction

function SoloSub_ConfirmActions takes nothing returns nothing
    local button clicked= GetClickedButtonBJ()
    local player observer
    local player lostPlayer
    if not SoloSub_flowActive or SoloSub_chosenObserverId < 12 or GetTriggerPlayer() != Player(SoloSub_chosenObserverId) then
        set clicked=null
        return
    endif
    set observer=Player(SoloSub_chosenObserverId)
    set lostPlayer=ConvertedPlayer(SoloSub_targetPlayerNumber)
    if clicked == SoloSub_yesButton then
        if not SoloSub_TryReplace(lostPlayer , SoloSub_chosenObserverId) then
            call SoloSub_MsgPlayer(observer , "That substitute request is no longer available.")
        endif
    elseif clicked == SoloSub_noButton then
        call SoloSub_MsgPlayer(SoloSub_selector , GetPlayerName(observer) + " declined the substitute request.")
        call SoloSub_MsgPlayer(observer , "You declined the substitute request.")
    endif
    call SoloSub_ResetFlow()
    set clicked=null
    set observer=null
    set lostPlayer=null
endfunction

function SoloSub_LeavePrelude takes nothing returns boolean
    local player leaver
    local integer leavingId
    local integer canonicalNumber
    local boolean reopen
    local integer poolSlot
    set SoloSub_leaveInheritNumber=0
    // v61: re-entered from SoloSub_PendingExpiry rather than by a real leave.
    // Point the stock cleanup at the abandoned slot and let it run.
    if SoloSub_abandonSlot != 0 then
        set SoloSub_leaveInheritNumber=SoloSub_abandonSlot
        set SoloSub_abandonSlot=0
        return false
    endif
    // Votekick executes this trigger manually (TriggerExecute), where
    // GetTriggerPlayer() is invalid; never treat a votekick as substitution.
    if udg_Votekick_Defeat_Kicked_Player then
        return false
    endif
    set leaver=GetTriggerPlayer()
    set leavingId=GetPlayerId(leaver)
    // The requester leaving mid-flow tears the open selection down.
    if SoloSub_flowActive and SoloSub_selector == leaver then
        call SoloSub_ResetFlow()
    endif
    if leavingId >= 0 and leavingId < 12 then
        // Ordinary gameplay-player leave: preserve the position for -sub, but
        // only if the slot is still an active gameplay participant.
        if udg_player_active[leavingId + 1] then
            // v61: only hold the position if somebody could actually take it.
            // With no observers in the lobby the stock leaver system must run
            // exactly as it did before -sub existed.
            if not SoloSub_HasObserverOnPage(1) and not SoloSub_HasObserverOnPage(2) then
                set leaver=null
                return false
            endif
            set SoloSub_pendingPlayer[leavingId + 1]=true
            set SoloSub_pendingTicks[leavingId + 1]=SoloSub_PENDING_SECONDS
            // v60: cancel any ally auto-pool aimed at this slot. Nobody is at
            // the keyboard, so the gold would be unreachable until a sub joins.
            set canonicalNumber=1
            loop
                exitwhen canonicalNumber > 12
                if udg_autopoolto[canonicalNumber] == leavingId + 1 then
                    set udg_autopoolto[canonicalNumber]=0
                endif
                set canonicalNumber=canonicalNumber + 1
            endloop
            call SoloSub_MsgAll(GetPlayerName(leaver) + " was lost. An active teammate has " + I2S(SoloSub_PENDING_SECONDS) + " seconds to type |cffffcc00-sub|r and invite an observer to take over, after which their base and gold pass to their allies.")
            set leaver=null
            return true
        endif
        set leaver=null
        return false
    endif
    // Observer (12-23) leaving.
    if SoloSub_playerForObserver[leavingId] == 0 then
        // Unassigned observer: never runs gameplay-position cleanup.
        if SoloSub_flowActive and SoloSub_chosenObserverId == leavingId then
            call SoloSub_MsgPlayer(SoloSub_selector , GetPlayerName(leaver) + " left before answering the substitute request.")
            call SoloSub_ResetFlow()
        endif
        set leaver=null
        return true
    endif
    // Substitute leaving. v62: the position is still alive, so hand it back
    // to the pool rather than tearing it down - a slot can be inherited any
    // number of times.
    set canonicalNumber=SoloSub_playerForObserver[leavingId]
    // Decide availability BEFORE severing the mapping. A departing observer
    // still reads PLAYER_SLOT_STATE_PLAYING during their own leave event, so
    // clearing first would let them count as an observer available to replace
    // themselves, and the position would sit pending with nobody able to take
    // it. While SoloSub_playerForObserver[leavingId] is still set,
    // SoloSub_IsAvailableObserver excludes them.
    set reopen=udg_player_active[canonicalNumber] and ( SoloSub_HasObserverOnPage(1) or SoloSub_HasObserverOnPage(2) )
    set SoloSub_observerForPlayer[canonicalNumber]=0
    set SoloSub_playerForObserver[leavingId]=0
    set SoloSub_observerOriginalName[leavingId]=""
    // The resource proxy for this observer is finished with; clearing the
    // shadow stops SoloSub_SyncResources from ever reading a stale figure if
    // the id is handed out again.
    set SoloSub_goldShadow[leavingId]=0
    if reopen then
        set SoloSub_pendingPlayer[canonicalNumber]=true
        set SoloSub_pendingTicks[canonicalNumber]=SoloSub_PENDING_SECONDS
        // Same reasoning as an ordinary leave: nobody is at the keyboard, so
        // pooled gold would be unreachable until the next substitute arrives.
        set poolSlot=1
        loop
            exitwhen poolSlot > 12
            if udg_autopoolto[poolSlot] == canonicalNumber then
                set udg_autopoolto[poolSlot]=0
            endif
            set poolSlot=poolSlot + 1
        endloop
        call SoloSub_MsgAll(GetPlayerName(leaver) + " has left. An active teammate has " + I2S(SoloSub_PENDING_SECONDS) + " seconds to type |cffffcc00-sub|r and put another observer into that position.")
        set leaver=null
        return true
    endif
    set SoloSub_leaveInheritNumber=canonicalNumber
    set leaver=null
    return false
endfunction

function SoloSub_EffectiveLeaver takes nothing returns player
    if SoloSub_leaveInheritNumber != 0 then
        return ConvertedPlayer(SoloSub_leaveInheritNumber)
    endif
    return GetTriggerPlayer()
endfunction

function SoloSub_OnPositionDestroyed takes integer playerNumber returns nothing
    if playerNumber < 1 or playerNumber > 12 then
        return
    endif
    if SoloSub_flowActive and SoloSub_targetPlayerNumber == playerNumber then
        call SoloSub_MsgPlayer(SoloSub_selector , "The position you were filling was eliminated. The request was cancelled.")
        call SoloSub_ResetFlow()
    endif
    set SoloSub_pendingPlayer[playerNumber]=false
    set SoloSub_pendingTicks[playerNumber]=0
    if SoloSub_observerForPlayer[playerNumber] != 0 then
        call SoloSub_ReleaseObserver(playerNumber)
    endif
endfunction

function SoloSub_PendingExpiry takes nothing returns nothing
    local integer slot= 1
    loop
        exitwhen slot > 12
        if SoloSub_pendingPlayer[slot] and SoloSub_pendingTicks[slot] > 0 then
            set SoloSub_pendingTicks[slot]=SoloSub_pendingTicks[slot] - 1
            if SoloSub_pendingTicks[slot] <= 0 then
                set SoloSub_pendingPlayer[slot]=false
                if SoloSub_flowActive and SoloSub_targetPlayerNumber == slot then
                    call SoloSub_ResetFlow()
                endif
                call SoloSub_MsgAll("|cffffcc00No substitute took over for " + GetPlayerName(ConvertedPlayer(slot)) + ". Their base and gold now pass to their allies.|r")
                set SoloSub_abandonSlot=slot
                call TriggerExecute(gg_trg_player_leaves)
            endif
        endif
        set slot=slot + 1
    endloop
endfunction

function SoloSub_CanReceiveGold takes integer slot returns boolean
    if slot < 1 or slot > 12 then
        return false
    endif
    if SoloSub_pendingPlayer[slot] then
        return false
    endif
    return udg_player_active[slot]
endfunction

function SoloSub_ReownToSlot takes unit u returns nothing
    local integer ownerId
    local integer slot
    if u == null then
        return
    endif
    set ownerId=GetPlayerId(GetOwningPlayer(u))
    if ownerId < 12 or ownerId >= 24 then
        return
    endif
    set slot=SoloSub_playerForObserver[ownerId]
    if slot < 1 or slot > 12 then
        return
    endif
    call SetUnitOwner(u, ConvertedPlayer(slot), true)
endfunction

function SoloSub_SyncResources takes nothing returns nothing
    local integer slot= 1
    local integer observerId
    local player observer
    local player canonical
    local integer trueGold
    local integer trueLumber
    local integer delta
    loop
        exitwhen slot > 12
        if SoloSub_observerForPlayer[slot] != 0 then
            set observerId=SoloSub_observerForPlayer[slot] - 1
            set observer=Player(observerId)
            set canonical=ConvertedPlayer(slot)
            set trueGold=GetPlayerState(canonical, PLAYER_STATE_RESOURCE_GOLD)
            set delta=SoloSub_goldShadow[observerId] - GetPlayerState(observer, PLAYER_STATE_RESOURCE_GOLD)
            if delta != 0 then
                set trueGold=trueGold - delta
                if trueGold < 0 then
                    set trueGold=0
                endif
                call SetPlayerState(canonical, PLAYER_STATE_RESOURCE_GOLD, trueGold)
            endif
            call SetPlayerState(observer, PLAYER_STATE_RESOURCE_GOLD, trueGold)
            set SoloSub_goldShadow[observerId]=trueGold
            set trueLumber=GetPlayerState(canonical, PLAYER_STATE_RESOURCE_LUMBER)
            set delta=SoloSub_lumberShadow[observerId] - GetPlayerState(observer, PLAYER_STATE_RESOURCE_LUMBER)
            if delta != 0 then
                set trueLumber=trueLumber - delta
                if trueLumber < 0 then
                    set trueLumber=0
                endif
                call SetPlayerState(canonical, PLAYER_STATE_RESOURCE_LUMBER, trueLumber)
            endif
            call SetPlayerState(observer, PLAYER_STATE_RESOURCE_LUMBER, trueLumber)
            set SoloSub_lumberShadow[observerId]=trueLumber
        endif
        set slot=slot + 1
    endloop
    set observer=null
    set canonical=null
endfunction

function InitTrig_SoloSub takes nothing returns nothing
    local integer playerId= 0
    local trigger commandTrigger= CreateTrigger()
    local trigger chooseTrigger= CreateTrigger()
    local trigger confirmTrigger= CreateTrigger()
    set SoloSub_chooseDialog=DialogCreate()
    set SoloSub_confirmDialog=DialogCreate()
    set SoloSub_responseTimer=CreateTimer()
    set SoloSub_syncTimer=CreateTimer()
    call TimerStart(SoloSub_syncTimer, 0.10, true, function SoloSub_SyncResources)
    set SoloSub_pendingTimer=CreateTimer()
    call TimerStart(SoloSub_pendingTimer, 1.00, true, function SoloSub_PendingExpiry)
    loop
        exitwhen playerId >= 12
        call TriggerRegisterPlayerChatEvent(commandTrigger, Player(playerId), "-sub", true)
        set playerId=playerId + 1
    endloop
    call TriggerAddAction(commandTrigger, function SoloSub_CommandActions)
    call TriggerRegisterDialogEventBJ(chooseTrigger, SoloSub_chooseDialog)
    call TriggerAddAction(chooseTrigger, function SoloSub_ChooseActions)
    call TriggerRegisterDialogEventBJ(confirmTrigger, SoloSub_confirmDialog)
    call TriggerAddAction(confirmTrigger, function SoloSub_ConfirmActions)
    set commandTrigger=null
    set chooseTrigger=null
    set confirmTrigger=null
endfunction

function Trig_KOTH_Income_Func006Func001C takes nothing returns boolean
    if ( not SoloSub_IsEffectivePlayer(GetEnumPlayer()) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func006A takes nothing returns nothing
    if ( Trig_KOTH_Income_Func006Func001C() ) then
        set udg_KOTH_Team_Size=( udg_KOTH_Team_Size + 1 )
    else
    endif
endfunction

function Trig_KOTH_Income_Func010C takes nothing returns boolean
    if ( not ( udg_KOTH_Team_Size == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func014A takes nothing returns nothing
    call AdjustPlayerStateBJ(( udg_KOTH_Gold_To_Add + udg_KOTH_Gold_Division_To_Add ), GetEnumPlayer(), PLAYER_STATE_RESOURCE_GOLD)
    // RC6BOT TELEMETRY BEGIN
    set FF_st_kothGold[GetConvertedPlayerId(GetEnumPlayer())] = FF_st_kothGold[GetConvertedPlayerId(GetEnumPlayer())] + udg_KOTH_Gold_To_Add + udg_KOTH_Gold_Division_To_Add
    // RC6BOT TELEMETRY END
    set udg_KOTH_Gold_Division_To_Add=0
endfunction

function Trig_KOTH_Income_Func024Func002C takes nothing returns boolean
    if ( not ( udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number] >= udg_KOTH_Gold_Reset_Amount ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func024Func005C takes nothing returns boolean
    if ( not ( udg_KOTH_Gold_Remaining <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Func024C takes nothing returns boolean
    if ( not ( udg_KOTH_Gold_Remaining <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Income_Actions takes nothing returns nothing
    // Adjust the hill gold remaining:
    set udg_KOTH_Gold_Remaining=( udg_KOTH_Gold_Remaining - udg_KOTH_Gold_Rewarded )
    //                                                                                                     
    // Count how many active players are in the killing team:
    set udg_KOTH_Team_Size=0
    call ForForce(udg_KOTH_Team, function Trig_KOTH_Income_Func006A)
    //                                                                                                     
    // Calculate how much gold each player should earn:
    set udg_KOTH_Gold_Division_To_Add=0
    if ( Trig_KOTH_Income_Func010C() ) then
        set udg_KOTH_Gold_Division_To_Add=udg_KOTH_Gold_Division_Bonus
    else
    endif
    set udg_KOTH_Gold_To_Add=( udg_KOTH_Gold_Rewarded / udg_KOTH_Team_Size )
    //                                                                                                     
    // Add the gold to each player:
    call ForForce(udg_KOTH_Team, function Trig_KOTH_Income_Func014A)
    //                                                                                                     
    // Calculate the total amount of gold that team has earned:
    set udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number]=( udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number] + udg_KOTH_Gold_Rewarded )
    set udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number]=( udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number] + udg_KOTH_Gold_Rewarded )
    //                                                                                                     
    call TriggerExecute(gg_trg_KOTH_Update_Board_Gold)
    call TriggerExecute(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    // Check for many different scenarios regarding the hill and it's remaining gold:
    if ( Trig_KOTH_Income_Func024C() ) then
        // The Hill is completely out of gold:
        call PauseTimerBJ(true, udg_KOTH_Income_Timer)
        call RemoveUnit(udg_KOTH_Hill)
        set udg_KOTH_Gold_Remaining=0
    else
        // The Hill is now down to half of it's total remaining gold:
        if ( Trig_KOTH_Income_Func024Func002C() ) then
            set udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number]=0
            set udg_KOTH_Player=Player(PLAYER_NEUTRAL_PASSIVE)
            call PauseTimerBJ(true, udg_KOTH_Income_Timer)
            call TriggerExecute(gg_trg_KOTH_Reset_Hill)
        else
        endif
        //                                                                                                     
        if ( Trig_KOTH_Income_Func024Func005C() ) then
            call TriggerExecute(gg_trg_KOTH_Gold_Depleted)
        else
        endif
    endif
endfunction

function InitTrig_KOTH_Income takes nothing returns nothing
    set gg_trg_KOTH_Income=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_KOTH_Income, udg_KOTH_Income_Timer)
    call TriggerAddAction(gg_trg_KOTH_Income, function Trig_KOTH_Income_Actions)
endfunction

function Trig_KOTH_Hill_Dies_Conditions takes nothing returns boolean
    if ( not ( udg_KOTH_Hill == GetTriggerUnit() ) ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Hill_Dies_Func002Func011C takes nothing returns boolean
    if ( ( GetKillingUnitBJ() == null ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(bj_PLAYER_NEUTRAL_VICTIM) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(bj_PLAYER_NEUTRAL_EXTRA) ) ) then
        return true
    endif
    return false
endfunction

function Trig_KOTH_Hill_Dies_Func002C takes nothing returns boolean
    if ( not Trig_KOTH_Hill_Dies_Func002Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_KOTH_Hill_Dies_Actions takes nothing returns nothing
    // Let's make sure that the hill goes back to Neutral if we can't find the Player that killed it:
    if ( Trig_KOTH_Hill_Dies_Func002C() ) then
        call TriggerExecute(gg_trg_KOTH_Set_Neutral_Hill)
    else
        // An actual Player killed the Hill - Let's give them control:
        set udg_KOTH_Player=GetOwningPlayer(GetKillingUnitBJ())
        if GetPlayerId(udg_KOTH_Player) < 12 then
            set DPS_Caps[GetConvertedPlayerId(udg_KOTH_Player)] = DPS_Caps[GetConvertedPlayerId(udg_KOTH_Player)] + 1
        elseif SoloSub_playerForObserver[GetPlayerId(udg_KOTH_Player)] >= 1 and SoloSub_playerForObserver[GetPlayerId(udg_KOTH_Player)] <= 12 then
            set DPS_Caps[SoloSub_playerForObserver[GetPlayerId(udg_KOTH_Player)]] = DPS_Caps[SoloSub_playerForObserver[GetPlayerId(udg_KOTH_Player)]] + 1
        endif
        set udg_KOTH_Team_Number=udg_teamnumber[GetConvertedPlayerId(udg_KOTH_Player)]
        set udg_KOTH_Team=udg_team[udg_KOTH_Team_Number]
        set udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number]=( udg_KOTH_Team_Gold_Earned_Total[udg_KOTH_Team_Number] + udg_KOTH_Gold_Bounty )
        call TriggerExecute(gg_trg_KOTH_Update_Board_Gold)
        set udg_KOTH_Team_Gold_Earned_Reset[udg_KOTH_Team_Number]=0
        call StartTimerBJ(udg_KOTH_Income_Timer, true, 3.00)
        call PingMinimapLocForForceEx(GetPlayersAll(), udg_centermap, 1, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 0.00, 0.00)
    endif
    //                                                                                                     
    // Some fancy special effects to show the Hill has been claimed:
    call AddSpecialEffectLocBJ(udg_centermap, "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    // Stop regenerating the hill's hp (this is just in case the regen still active):
    if udg_KOTH_Regen_SFX != null then
    call DestroyEffectBJ(udg_KOTH_Regen_SFX)
    endif
    //                                                                                                     
    // Recreate the hill:
    call TriggerExecute(gg_trg_KOTH_Reset_Hill)
endfunction

function InitTrig_KOTH_Hill_Dies takes nothing returns nothing
    set gg_trg_KOTH_Hill_Dies=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_KOTH_Hill_Dies, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_KOTH_Hill_Dies, Condition(function Trig_KOTH_Hill_Dies_Conditions))
    call TriggerAddAction(gg_trg_KOTH_Hill_Dies, function Trig_KOTH_Hill_Dies_Actions)
endfunction

function Trig_KOTH_Gold_Depleted_Actions takes nothing returns nothing
    call DisableTrigger(gg_trg_KOTH_Income)
    call DisableTrigger(gg_trg_KOTH_Hill_Dies)
    call DisableTrigger(gg_trg_KOTH_Gold_Depleted)
    call DisableTrigger(gg_trg_KOTH_Set_Neutral_Hill)
    call DisableTrigger(gg_trg_KOTH_Reset_Hill)
    call DisableTrigger(gg_trg_KOTH_Create_Hill_Glow)
    call DisableTrigger(gg_trg_KOTH_Update_Text)
    //                                                                                                     
    call PauseTimerBJ(true, udg_KOTH_Income_Timer)
    //                                                                                                     
    call AddSpecialEffectLocBJ(udg_centermap, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    call DestroyEffectBJ(udg_KOTH_Hill_Glow_SFX)
    call DestroyEffectBJ(udg_KOTH_Regen_SFX)
    call DestroyTextTagBJ(udg_KOTH_Floating_Text)
    //                                                                                                     
    call RemoveUnit(udg_KOTH_Hill)
endfunction

