function Trig_Multiboard_Create_Func001C takes nothing returns boolean
    if ( not ( udg_scoreboard_on == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Create_Func005C takes nothing returns boolean
    if ( not ( udg_scoreboard_on == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Create_Actions takes nothing returns nothing
    if ( Trig_Multiboard_Create_Func001C() ) then
        return
    else
    endif
    //                                                                                                     
    set udg_scoreboard_on=true
    // team board
    if ( Trig_Multiboard_Create_Func005C() ) then
        set udg_temp_real=95.00
        call CreateMultiboardBJ(3, 5, "TRIGSTR_11071")
        set udg_multiboard_kills=GetLastCreatedMultiboard()
        call MultiboardSetTitleText(udg_multiboard_kills, "Leaderboard - |cffffcc000:00|r")
        call MultiboardSetTitleTextColorBJ(udg_multiboard_kills, 30.00, 60.00, 50.00, udg_temp_real)
        call MultiboardSetItemStyleBJ(udg_multiboard_kills, 1, 1, false, false)
        call MultiboardSetItemValueBJ(udg_multiboard_kills, 2, 1, "TRIGSTR_11073")
        call MultiboardSetItemIconBJ(udg_multiboard_kills, 2, 1, "ReplaceableTextures\\CommandButtons\\BTNHumanArmorUpOne.blp")
        call MultiboardSetItemValueBJ(udg_multiboard_kills, 3, 1, "TRIGSTR_11078")
        call MultiboardSetItemIconBJ(udg_multiboard_kills, 3, 1, "ReplaceableTextures\\CommandButtons\\BTNArcaniteMelee.blp")
        set udg_X=1
        loop
            exitwhen udg_X > 4
            call MultiboardSetItemValueBJ(udg_multiboard_kills, 1, ( udg_X + 1 ), ( "Force " + I2S(udg_X) ))
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 1, ( udg_X + 1 ), true, false)
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 2, ( udg_X + 1 ), true, false)
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 3, ( udg_X + 1 ), true, false)
            set udg_X=udg_X + 1
        endloop
        set udg_X=1
        loop
            exitwhen udg_X > 5
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 1, udg_X, 7.00)
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 2, udg_X, 7.00)
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 3, udg_X, 7.00)
            set udg_X=udg_X + 1
        endloop
        call MultiboardDisplayBJ(false, udg_multiboard_kills)
    else
        call DoNothing()
    endif
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_Multiboard_Create takes nothing returns nothing
    set gg_trg_Multiboard_Create=CreateTrigger()
    call TriggerAddAction(gg_trg_Multiboard_Create, function Trig_Multiboard_Create_Actions)
endfunction

