        exitwhen udg_X > 12
        if ( Trig_HERO_Pirate_Explode_Ship_Func001Func001C() ) then
            call IssueImmediateOrderBJ(udg_dummy_ship[udg_X], "stomp")
            call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_ship[udg_X])
            set udg_unitgroup_kill=GetUnitsOfPlayerAndTypeId(ConvertedPlayer(udg_X), 'h02P')
            call ForGroupBJ(udg_unitgroup_kill, function Trig_HERO_Pirate_Explode_Ship_Func001Func001Func005002)
