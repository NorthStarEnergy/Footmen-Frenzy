    call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), ( I2S(udg_pool_threshold[udg_temp_playernumber]) + "|cffffff00 Gold|r will be held back for your personal use." ))
