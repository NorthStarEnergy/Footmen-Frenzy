    endif
    return true
endfunction

function Trig_Charge_Pos_2_and_Pos_3_Func034C takes nothing returns boolean
    if ( not ( udg_Avalanche_TR_Index == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Pos_2_and_Pos_3_Actions takes nothing returns nothing
    // Create a new instance of Trample:
    set udg_Avalanche_TR_Index=( udg_Avalanche_TR_Index + 1 )
    //                                                                                                                    
    // DEFINE THE ANIMATION PLAYED WHILE CHARGING:
    // Note: Each animation has it's own integer index. It starts at 0 and works it's way up.
    if ( Trig_Charge_Pos_2_and_Pos_3_Func008C() ) then
        set udg_Avalanche_TR_Animation[udg_Avalanche_TR_Index]=9
    else
        if ( Trig_Charge_Pos_2_and_Pos_3_Func008Func001C() ) then
            set udg_Avalanche_TR_Animation[udg_Avalanche_TR_Index]=5
            //                                                                                                                    
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            // The Storm Crow Form ability allows a non-Flying unit to have it's Flying Height adjusted:
            call UnitAddAbilityBJ('Arav', GetTriggerUnit())
            call UnitRemoveAbilityBJ('Arav', GetTriggerUnit())
            call SetUnitFlyHeightBJ(GetTriggerUnit(), 100.00, 0.00)
        else
        endif
    endif
    //                                                                                                          
    // Store data about Trample which we will reference in the For Loop:
    set udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index]=GetTriggerUnit()
    set udg_Avalanche_TR_Duration[udg_Avalanche_TR_Index]=0
    set udg_Avalanche_TR_Damage[udg_Avalanche_TR_Index]=( 40.00 + ( 45.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) )
    set udg_Avalanche_TR_Speed[udg_Avalanche_TR_Index]=40.00
    set udg_Avalanche_TR_Max_Duration[udg_Avalanche_TR_Index]=22
    set udg_Avalanche_TR_Interval[udg_Avalanche_TR_Index]=5
    if ( Trig_Charge_Pos_2_and_Pos_3_Func017C() ) then
        set udg_Avalanche_TR_Damage[udg_Avalanche_TR_Index]=( 50.00 + ( 55.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) )
        set udg_Avalanche_TR_Speed[udg_Avalanche_TR_Index]=40.00
        set udg_Avalanche_TR_Max_Duration[udg_Avalanche_TR_Index]=22
        set udg_Avalanche_TR_Interval[udg_Avalanche_TR_Index]=9
    else
        call DoNothing()
    endif
    set udg_Avalanche_TR_Group_Limit[udg_Avalanche_TR_Index]=CreateGroup()
    //                                                                                                          
    set udg_Avalanche_TR_Point[0]=GetUnitLoc(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index])
    set udg_Avalanche_TR_Point[1]=GetSpellTargetLoc()
    set udg_Avalanche_TR_Angle[udg_Avalanche_TR_Index]=AngleBetweenPoints(udg_Avalanche_TR_Point[0], udg_Avalanche_TR_Point[1])
    //                                                                                                          
    // Create the Dummy unit that will Stun (cast War Stomp):
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index]), udg_Avalanche_TR_Point[0], bj_UNIT_FACING)
    set udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Index]=GetLastCreatedUnit()
    call UnitAddAbilityBJ('ATRS', udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Index])
    call SetUnitAbilityLevelSwapped('ATRS', udg_Avalanche_TR_Dummy[udg_Avalanche_TR_Index], GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Avalanche_TR_Caster[udg_Avalanche_TR_Index]))
    //                                                                                                          
    call RemoveLocation(udg_Avalanche_TR_Point[0])
    call RemoveLocation(udg_Avalanche_TR_Point[1])
    //                                                                                                          
    // Start the Trample loop:
    if ( Trig_Charge_Pos_2_and_Pos_3_Func034C() ) then
        call EnableTrigger(gg_trg_Avalanche_Trample_Loop)
    else
    endif
endfunction

