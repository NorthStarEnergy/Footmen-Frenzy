function InitTrig_eight takes nothing returns nothing
    set gg_trg_eight=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_eight, udg_spawnTimer)
    call TriggerAddCondition(gg_trg_eight, Condition(function Trig_eight_Conditions))
    call TriggerAddAction(gg_trg_eight, function Trig_eight_Actions)
endfunction

