function Trig_SovietSniper_Decoy_Bomb_Cast_Func006C takes nothing returns boolean
    if ( not ( udg_SovietSniper_DB_Damage_Per_Lvl[1] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SovietSniper_Decoy_Bomb_Cast_Actions takes nothing returns nothing
    set udg_SovietSniper=GetTriggerUnit()
    set udg_SovietSniper_CV=GetUnitUserData(udg_SovietSniper)
    //                                                                                                          
    // Define damage scaling per level (once):
    if ( Trig_SovietSniper_Decoy_Bomb_Cast_Func006C() ) then
        set udg_SovietSniper_DB_Damage_Per_Lvl[1]=75.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[2]=125.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[3]=175.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[4]=200.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[5]=275.00
        set udg_SovietSniper_DB_Damage_Per_Lvl[6]=400.00
    else
    endif
    //                                                                                                          
    // Missile Properties:
    set udg_MissileData=udg_SovietSniper_CV
    set udg_MissileSource=udg_SovietSniper
    set udg_MissileStart=GetUnitLoc(udg_SovietSniper)
    set udg_MissileFinish=GetSpellTargetLoc()
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="Units\\Creeps\\HeroTinkerFactory\\HeroTinkerFactoryMissle.mdl"
    set udg_MissileScale=1.20
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=25.00
    set udg_MissileSpeed=700.00
    //                                                                                                     
    // Arc should be between 0.00 and 80.00:
    set udg_MissileArc=40.00
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onFinish=gg_trg_SovietSniper_Decoy_Bomb_Create_Bomb
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
endfunction

function InitTrig_SovietSniper_Decoy_Bomb_Cast takes nothing returns nothing
    set gg_trg_SovietSniper_Decoy_Bomb_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SovietSniper_Decoy_Bomb_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SovietSniper_Decoy_Bomb_Cast, Condition(function Trig_SovietSniper_Decoy_Bomb_Cast_Conditions))
