function Trig_ITEM_Wall_taunt_Actions takes nothing returns nothing
    if ( Trig_ITEM_Wall_taunt_Func001C() ) then
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_10771")
    else
        call DoNothing()
    endif
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point=GetUnitLoc(udg_temp_unit)
