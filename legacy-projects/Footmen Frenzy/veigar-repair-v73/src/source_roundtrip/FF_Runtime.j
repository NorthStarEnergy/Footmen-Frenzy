    set gg_trg_HERO_Queen_Spiderling_Swarm=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Queen_Spiderling_Swarm, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Queen_Spiderling_Swarm, Condition(function Trig_HERO_Queen_Spiderling_Swarm_Conditions))
    call TriggerAddAction(gg_trg_HERO_Queen_Spiderling_Swarm, function Trig_HERO_Queen_Spiderling_Swarm_Actions)
