    call UnitAddAbilityBJ('A098', udg_dummy)
    call SetUnitAbilityLevelSwapped('A098', udg_dummy, udg_abilitylevel)
    call IssueTargetOrderBJ(udg_dummy, "acidbomb", udg_temp_target)
