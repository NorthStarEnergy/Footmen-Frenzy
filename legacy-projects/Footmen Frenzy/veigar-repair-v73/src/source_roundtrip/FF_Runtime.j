function Trig_Medivh_Gust_Cast_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'ATOR' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0NN' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Medivh_Gust_Cast_Conditions takes nothing returns boolean
    if ( not Trig_Medivh_Gust_Cast_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Medivh_Gust_Cast_Func022C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Medivh_Gust_Cast_Actions takes nothing returns nothing
    // Shockwave System variables:
    set udg_SW_Max=( udg_SW_Max + 1 )
    set udg_SW_Caster[udg_SW_Max]=GetTriggerUnit()
    set udg_SW_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_SW_Point[1]=GetSpellTargetLoc()
    set udg_SW_Lvl[udg_SW_Max]=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
    set udg_SW_WaveEffect[udg_SW_Max]="Abilities\\Spells\\Other\\Tornado\\TornadoElementalSmall.mdl"
    set udg_SW_WaveEffectEnd[udg_SW_Max]=""
    set udg_SW_LoopingSfx[udg_SW_Max]=false
    set udg_SW_ExtraEffectTargetCheck[udg_SW_Max]=true
    set udg_SW_ExtraEffectTarget[udg_SW_Max]=gg_trg_Medivh_Gust_Stun
    set udg_SW_AffectAlly[udg_SW_Max]=false
    set udg_SW_AffectEnemy[udg_SW_Max]=true
    set udg_SW_AffectAir[udg_SW_Max]=true
    set udg_SW_AffectGround[udg_SW_Max]=true
    set udg_SW_AffectStructure[udg_SW_Max]=false
    set udg_SW_OneInstance[udg_SW_Max]=true
    set udg_SW_AttackType[udg_SW_Max]=ATTACK_TYPE_NORMAL
    set udg_SW_DamageType[udg_SW_Max]=DAMAGE_TYPE_MAGIC
    set udg_SW_Attachment="origin"
    if ( Trig_Medivh_Gust_Cast_Func022C() ) then
        set udg_SW_WaveEffect[udg_SW_Max]="units\\human\\WaterElemental\\WaterElemental"
    else
    endif
    //                                                                                                                         
    // ====================================================
    // STATS PER LEVEL:
    set udg_SW_Damage[1]=70.00
    set udg_SW_Damage[2]=120.00
    set udg_SW_Damage[3]=155.00
    set udg_SW_Damage[4]=210.00
    set udg_SW_Damage[5]=275.00
    set udg_SW_Damage[6]=425.00
    set udg_SW_Distance[1]=700.00
    set udg_SW_Distance[2]=800.00
    set udg_SW_Distance[3]=850.00
    set udg_SW_Distance[4]=900.00
    set udg_SW_Distance[5]=950.00
    set udg_SW_Distance[6]=1000.00
    // Define any constant values here (values that don't change per level):
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_SW_AreaInitial[GetForLoopIndexA()]=150.00
        set udg_SW_AreaFinal[GetForLoopIndexA()]=165.00
        set udg_SW_Speed[GetForLoopIndexA()]=1025.00
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // ====================================================
    //                                                                                                                         
    call TriggerExecute(gg_trg_Shockwave_Cast)
    //                                                                                                                         
    // Note: The Dummy is created after running Shockwave Cast up above.
    // Change the Dummy unit's size to scale the Missile art:
    call SetUnitScalePercent(udg_SW_Dummy[udg_SW_Max], 400.00, 400.00, 400.00)
endfunction

function InitTrig_Medivh_Gust_Cast takes nothing returns nothing
    set gg_trg_Medivh_Gust_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Medivh_Gust_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Medivh_Gust_Cast, Condition(function Trig_Medivh_Gust_Cast_Conditions))
    call TriggerAddAction(gg_trg_Medivh_Gust_Cast, function Trig_Medivh_Gust_Cast_Actions)
endfunction

function Trig_Medivh_Gust_Stun_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_SW_HitUnit, GetOwningPlayer(udg_SW_Caster[udg_SW_Loop])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_SW_HitUnit) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_SW_HitUnit) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_SW_HitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( udg_Jaina_Elapsed_Time[GetUnitUserData(udg_SW_HitUnit)] == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Medivh_Gust_Stun_Func007C takes nothing returns boolean
    if ( not ( udg_Jaina_Target_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Medivh_Gust_Stun_Actions takes nothing returns nothing
    set udg_Jaina_Target=udg_SW_HitUnit
    set udg_Jaina_CV=GetUnitUserData(udg_Jaina_Target)
    //                                                                                                                         
    // Add the target to the target group used in Jaina Loop:
    call GroupAddUnitSimple(udg_Jaina_Target, udg_Jaina_Group)
    set udg_Jaina_Target_Count=( udg_Jaina_Target_Count + 1 )
    if ( Trig_Medivh_Gust_Stun_Func007C() ) then
        call EnableTrigger(gg_trg_Medivh_Gust_Loop)
    else
    endif
    //                                                                                                                         
    // ====================================================
    // STATS PER LEVEL:
    //                                                                                                                         
    // Set Duration of Air Time:
    set udg_Jaina_Duration_Per_Level[1]=0.40
    set udg_Jaina_Duration_Per_Level[2]=0.40
    set udg_Jaina_Duration_Per_Level[3]=0.40
    set udg_Jaina_Duration_Per_Level[4]=0.40
    set udg_Jaina_Duration_Per_Level[5]=0.40
    set udg_Jaina_Duration_Per_Level[6]=0.50
    //                                                                                                                         
    // Set Max Height in Air:
    set udg_Jaina_Height_Per_Level[1]=300.00
    set udg_Jaina_Height_Per_Level[2]=300.00
    set udg_Jaina_Height_Per_Level[3]=350.00
    set udg_Jaina_Height_Per_Level[4]=375.00
    set udg_Jaina_Height_Per_Level[5]=400.00
    set udg_Jaina_Height_Per_Level[6]=425.00
    //                                                                                                                         
    // NOTE: YOU CAN MODIFY THE STUN DURATION BY EDITING THE DUMMY ABILITY: Tornado (Jaina - Stun - Dummy)
    //                                                                                                                         
    // ====================================================
    //                                                                                                                         
    // Setup the rest of the variables (don't change):
    set udg_Jaina_Duration[udg_Jaina_CV]=udg_Jaina_Duration_Per_Level[udg_SW_Lvl[udg_SW_Loop]]
    set udg_Jaina_Height[udg_Jaina_CV]=udg_Jaina_Height_Per_Level[udg_SW_Lvl[udg_SW_Loop]]
    set udg_Jaina_Elapsed_Time[udg_Jaina_CV]=0.00
    set udg_Jaina_Rate[udg_Jaina_CV]=( 2.00 * udg_Jaina_Height[udg_Jaina_CV] )
    set udg_Jaina_Factor[udg_Jaina_CV]=( 1.00 / udg_Jaina_Duration[udg_Jaina_CV] )
    //                                                                                                                         
    // Dummy - Stun:
    call CreateNUnitsAtLoc(1, 'dmmy', GetOwningPlayer(udg_SW_Caster[udg_SW_Loop]), udg_SW_NextPoint[1], bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(0.20, 'BTLF', GetLastCreatedUnit())
    call UnitAddAbilityBJ('AJTD', GetLastCreatedUnit())
    call SetUnitAbilityLevelSwapped('AJTD', GetLastCreatedUnit(), udg_SW_Lvl[udg_SW_Loop])
    call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_Jaina_Target)
endfunction

function InitTrig_Medivh_Gust_Stun takes nothing returns nothing
