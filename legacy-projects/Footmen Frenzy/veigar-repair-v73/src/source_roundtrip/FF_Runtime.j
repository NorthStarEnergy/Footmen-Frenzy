function FFRacial_ShareResearch takes nothing returns nothing
    local integer research = GetResearched()
    local player owner = GetTriggerPlayer()
    local player target = null
    local integer slot = 0
    local integer level = 0
    local integer candidate = 0
    if research != 'Rhan' and research != 'Robs' and research != 'R004' and research != 'R00O' then
        set owner = null
        return
    endif
    // Use the highest completed racial tier; never downgrade allied progress.
    loop
        exitwhen slot >= 12
        set target = Player(slot)
        if target == owner or IsPlayerAlly(target, owner) then
            set candidate = GetPlayerTechCount(target, 'Rhan', true)
            if candidate > level then
                set level = candidate
            endif
            set candidate = GetPlayerTechCount(target, 'Robs', true)
            if candidate > level then
                set level = candidate
            endif
            set candidate = GetPlayerTechCount(target, 'R004', true)
            if candidate > level then
                set level = candidate
            endif
            set candidate = GetPlayerTechCount(target, 'R00O', true)
            if candidate > level then
                set level = candidate
            endif
        endif
        set slot = slot + 1
    endloop
    set slot = 0
    loop
        exitwhen slot >= 12
        set target = Player(slot)
        if target == owner or IsPlayerAlly(target, owner) then
            if GetPlayerTechCount(target, 'Rhan', true) < level then
                call SetPlayerTechResearched(target, 'Rhan', level)
            endif
            if GetPlayerTechCount(target, 'Robs', true) < level then
                call SetPlayerTechResearched(target, 'Robs', level)
            endif
            if GetPlayerTechCount(target, 'R004', true) < level then
                call SetPlayerTechResearched(target, 'R004', level)
            endif
            if GetPlayerTechCount(target, 'R00O', true) < level then
                call SetPlayerTechResearched(target, 'R00O', level)
            endif
        endif
        set slot = slot + 1
    endloop
    set target = null
    set owner = null
endfunction

function FFRacial_Init takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddAction(t, function FFRacial_ShareResearch)
    set t = null
endfunction

