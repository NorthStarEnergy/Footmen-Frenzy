function Trig_MODE_GUI_show_Actions takes nothing returns nothing
    local player p=Player(0)
    local integer pn=1
    set udg_Host=p
    call FFStart_ClearSelectors()
    call FFR4_LockPooling()
    set FFR4Pro=false
    set FFR4NoPool=true
    // RC6BOT HOST BEGIN
    if FF_hostBotGame then
        call PauseTimer(udg_Host_AFK_Timer)
        call PauseTimer(udg_timer_voting)
        set FFModeStage=0
        call ConditionalTriggerExecute(gg_trg_MODE_set_pub_game_default)
        set p=null
        return
    endif
    // RC6BOT HOST END
    call DialogClear(udg_dlg_mode[pn])
    call DialogSetMessage(udg_dlg_mode[pn], "Choose Game Type (10 seconds)")
    set udg_dlg_btn_mode_01[pn]=DialogAddButton(udg_dlg_mode[pn], "Pub Mode", 0)
    set udg_dlg_btn_mode_02[pn]=DialogAddButton(udg_dlg_mode[pn], "Pro Mode", 0)
    set udg_dlg_btn_mode_03[pn]=DialogAddButton(udg_dlg_mode[pn], "Custom Mode", 0)
    set udg_dlg_btn_mode_04[pn]=DialogAddButton(udg_dlg_mode[pn], "Debug Mode", 0)
    call DialogDisplay(p, udg_dlg_mode[pn], true)
    call FFMode_BeginCountdown(1)
    set p=null
endfunction

