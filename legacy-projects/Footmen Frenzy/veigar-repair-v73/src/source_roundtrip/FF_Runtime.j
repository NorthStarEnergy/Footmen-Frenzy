    endif
    return true
endfunction

function Trig_HERO_Shattering_Strike_Effect_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Shattering_Strike_Effect_Func001Func001C() ) then
            set udg_Wrath_Effect[udg_X]=false
            call AddSpecialEffectLocBJ(udg_wrath_point[udg_X], "war3mapImported\\FrostBoltRainV.mdx")
            call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.50)
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

