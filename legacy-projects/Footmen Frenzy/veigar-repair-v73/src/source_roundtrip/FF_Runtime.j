    if IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) and GetWidgetLife(GetEnumUnit()) > 0.405 then
        call KillUnit(GetEnumUnit())
    endif
    call RemoveUnit(GetEnumUnit())
endfunction

