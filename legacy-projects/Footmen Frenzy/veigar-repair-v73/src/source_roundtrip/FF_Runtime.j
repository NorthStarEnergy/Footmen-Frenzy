    set gg_trg_UNIT_Crypt_Fiend_Unburrow=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_UNIT_Crypt_Fiend_Unburrow, EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_UNIT_Crypt_Fiend_Unburrow, Condition(function Trig_UNIT_Crypt_Fiend_Unburrow_Conditions))
