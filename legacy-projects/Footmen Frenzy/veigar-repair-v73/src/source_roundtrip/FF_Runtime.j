function InitTrig_summon_hero_for_player takes nothing returns nothing
    set gg_trg_summon_hero_for_player=CreateTrigger()
    call DisableTrigger(gg_trg_summon_hero_for_player)
    call TriggerRegisterPlayerChatEvent(gg_trg_summon_hero_for_player, Player(0), "-hero", false)
