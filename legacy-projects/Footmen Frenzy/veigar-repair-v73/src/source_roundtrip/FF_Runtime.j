function FF_DebugOpenHiring takes player p returns nothing
    local integer i = 1
    if not udg_mode_debugmode then
        return
    endif
    call SetPlayerMaxHeroesAllowed(-1, p)
    call SetPlayerState(p, PLAYER_STATE_FOOD_CAP_CEILING, 300)
    call SetPlayerState(p, PLAYER_STATE_RESOURCE_FOOD_CAP, 300)
    loop
        exitwhen i > udg_total_hero_count
        call SetPlayerTechMaxAllowed(p, udg_hero_type[i], -1)
        set i = i + 1
    endloop
endfunction

function FF_DebugHeroReady takes unit u returns nothing
    if not udg_mode_debugmode or u == null or GetUnitTypeId(u) == 0 or not IsUnitType(u, UNIT_TYPE_HERO) or GetPlayerId(GetOwningPlayer(u)) >= 12 then
        return
    endif
    // Extra heroes must not gradually consume the finite engine food ceiling.
    call SetUnitUseFood(u, false)
    if GetHeroLevel(u) < 18 then
        call SetHeroLevel(u, 18, false)
    endif
endfunction

function FF_DebugHireComplete takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer key = GetHandleId(t)
    local unit u = LoadUnitHandle(FF_DebugHireHash, key, 0)
    local unit shop = LoadUnitHandle(FF_DebugHireHash, key, 1)
    local integer kind = LoadInteger(FF_DebugHireHash, key, 2)
    if udg_mode_debugmode then
        // Run after sale/enter-region handlers and the engine's stock decrement.
        call FF_DebugHeroReady(u)
        if GetUnitTypeId(shop) != 0 then
            call RemoveUnitFromStock(shop, kind)
            call MF_StockUnit(shop, kind, 2, 2)
        endif
    endif
    call FlushChildHashtable(FF_DebugHireHash, key)
    call DestroyTimer(t)
    set u = null
    set shop = null
    set t = null
endfunction

function FF_DebugHeroSold takes nothing returns nothing
    local unit u = GetSoldUnit()
    local timer t
    local integer key
    if udg_mode_debugmode and IsUnitType(u, UNIT_TYPE_HERO) and GetPlayerId(GetOwningPlayer(u)) < 12 then
        set t = CreateTimer()
        set key = GetHandleId(t)
        call SaveUnitHandle(FF_DebugHireHash, key, 0, u)
        call SaveUnitHandle(FF_DebugHireHash, key, 1, GetSellingUnit())
        call SaveInteger(FF_DebugHireHash, key, 2, GetUnitTypeId(u))
        call TimerStart(t, 0.0, false, function FF_DebugHireComplete)
    endif
    set t = null
    set u = null
endfunction

function FF_TestExtraHero takes unit u returns nothing
    local player p = GetOwningPlayer(u)
    local location home = GetPlayerStartLocationLoc(p)
    local integer i = 1
    // Preserve udg_herO / udg_picked_hero so the original hero's systems keep working.
    call SetUnitPositionLoc(u, home)
    call RemoveLocation(home)
    if u == udg_herO[GetConvertedPlayerId(p)] or IsUnitInGroup(u, FF_TestRecruited) then
        set home = null
        set p = null
        return
    endif
    call GroupAddUnit(FF_TestRecruited, u)
    loop
        exitwhen i > udg_total_hero_count
        if udg_hero_type[i] == GetUnitTypeId(u) then
            call SetHeroStr(u, R2I(udg_hero_STR_base[i]), true)
            call SetHeroAgi(u, R2I(udg_hero_AGI_base[i]), true)
            call SetHeroInt(u, R2I(udg_hero_INT_base[i]), true)
            call BlzSetUnitRealField(u, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[i])
            call BlzSetUnitRealField(u, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[i])
            call BlzSetUnitRealField(u, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[i])
            call SetUnitMoveSpeed(u, udg_hero_move_base[i])
            call BlzSetUnitRealField(u, UNIT_RF_TURN_RATE, udg_hero_turnrate[i])
            exitwhen true
        endif
        set i = i + 1
    endloop
    call UnitAddItemById(u, 'stwp')
    call UnitAddItemById(u, 'I001')
    call UnitAddItemById(u, 'pinv')
    call UnitAddItemById(u, 'hslv')
    call SetPlayerMaxHeroesAllowed(-1, p)
    call SelectUnitForPlayerSingle(u, p)
    call FF_DebugHeroReady(u)
    set home = null
    set p = null
endfunction

function Trig_TP_hero_Actions takes nothing returns nothing
    local boolean randomPick = false
    local integer randomIndex = 0
    local integer randomTeam = 0
    local unit randomUnit = null
    set udg_temp_unit=GetTriggerUnit()
    // v60: a substitute buys the hero under their own observer id. Give it to
    // the canonical slot before anything reads the owner, or every array this
    // trigger writes (udg_herO, udg_picked_hero, stats, items) lands outside
    // the 1-12 range and the hero never registers.
    call SoloSub_ReownToSlot(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(GetOwningPlayer(udg_temp_unit))
    if udg_mode_debugmode and udg_temp_playernumber >= 1 and udg_temp_playernumber <= 12 and udg_herO[udg_temp_playernumber] != null then
        call FF_TestExtraHero(udg_temp_unit)
        return
    endif
    if GetUnitTypeId(udg_temp_unit) == 'H0R0' then
        set randomTeam = udg_teamnumber[udg_temp_playernumber]
        if udg_selected_mode != 3 or udg_mode_mirror or udg_tp_kill[udg_temp_playernumber] then
            call RemoveUnit(udg_temp_unit)
            return
        endif
        set randomIndex = FFR_Choose(randomTeam)
        if randomIndex == 0 then
            call DisplayTextToPlayer(GetOwningPlayer(udg_temp_unit), 0, 0, "No eligible un-seeded heroes remain.")
            call RemoveUnit(udg_temp_unit)
            return
        endif
        set FFR_Used[randomIndex] = true
        call DisableTrigger(gg_trg_TP_hero)
        set randomUnit = CreateUnit(GetOwningPlayer(udg_temp_unit), udg_hero_type[randomIndex], GetUnitX(udg_temp_unit), GetUnitY(udg_temp_unit), bj_UNIT_FACING)
        call EnableTrigger(gg_trg_TP_hero)
        call RemoveUnit(udg_temp_unit)
        set udg_temp_unit = randomUnit
        set randomUnit = null
        set randomPick = true
    endif
    if udg_selected_mode == 3 and not udg_mode_mirror and CarryTav_shop[udg_teamnumber[udg_temp_playernumber]] != null and not udg_tp_kill[udg_temp_playernumber] then
        set randomTeam = udg_teamnumber[udg_temp_playernumber]
        set randomIndex = FFR_Index(GetUnitTypeId(udg_temp_unit))
        if not FFR_Allowed(randomTeam, randomIndex) then
            call DisplayTextToPlayer(GetOwningPlayer(udg_temp_unit), 0, 0, "Your team has already used this hero category.")
            call RemoveUnit(udg_temp_unit)
            return
        endif
        set FFR_Used[randomIndex] = true
        call FFR_Lock(randomTeam, randomIndex)
    endif
    set udg_temp_point=GetPlayerStartLocationLoc(GetOwningPlayer(udg_temp_unit))
    // Madness mode
    if ( Trig_TP_hero_Func005C() ) then
        set udg_X=1
        loop
            exitwhen udg_X > 6
            set udg_madness_playernumber[udg_X]=( udg_X + 6 )
            set udg_X=udg_X + 1
        endloop
        set udg_X=7
        loop
            exitwhen udg_X > 12
            set udg_madness_playernumber[udg_X]=( udg_X - 6 )
            set udg_X=udg_X + 1
        endloop
        set udg_temp_playernumber=udg_madness_playernumber[udg_temp_playernumber]
        set udg_temp_point=GetPlayerStartLocationLoc(ConvertedPlayer(udg_temp_playernumber))
        call SetUnitOwner(udg_temp_unit, ConvertedPlayer(udg_temp_playernumber), true)
    else
        call DoNothing()
    endif
    // TP HERO
    if ( Trig_TP_hero_Func007C() ) then
        set udg_tp_kill[udg_temp_playernumber]=true
        set udg_herO[udg_temp_playernumber]=udg_temp_unit
        call ForGroupBJ(udg_realshops, function Trig_TP_hero_Func007Func004A)
        call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
        // Starting Items
        call UnitAddItemByIdSwapped('stwp', udg_temp_unit)
        call UnitAddItemByIdSwapped('I001', udg_temp_unit)
        call UnitAddItemByIdSwapped('pinv', udg_temp_unit)
        call UnitAddItemByIdSwapped('hslv', udg_temp_unit)
        if randomPick then
            call UnitAddItemByIdSwapped('bspd', udg_temp_unit)
        endif
        if ( Trig_TP_hero_Func007Func012C() ) then
            call UnitAddItemByIdSwapped('I01C', udg_temp_unit)
        else
            call DoNothing()
        endif
        if ( Trig_TP_hero_Func007Func013C() ) then
            call AddHeroXPSwapped(1700, udg_temp_unit, false)
        else
        endif
        call PanCameraToTimedLocForPlayer(ConvertedPlayer(udg_temp_playernumber), udg_temp_point, 1.00)
        call zoom_RestoreFromCacheForPlayer(Player(udg_temp_playernumber - 1))
        call SetPlayerName(ConvertedPlayer(udg_temp_playernumber), ( ( "(" + ( GetUnitName(udg_temp_unit) + ") " ) ) + udg_orig_player_name[udg_temp_playernumber] ))
        set udg_coloured_playername[udg_temp_playernumber]=( udg_colour[udg_temp_playernumber] + ( GetPlayerName(ConvertedPlayer(udg_temp_playernumber)) + "|r" ) )
        // Assign Hero #
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            if ( Trig_TP_hero_Func007Func019Func001C() ) then
                set udg_picked_hero[udg_temp_playernumber]=udg_X
                // SD only 1x carry
                if ( Trig_TP_hero_Func007Func019Func001Func003C() ) then
                    call CarryTav_LockTeam(udg_teamnumber[udg_temp_playernumber])
                else
                    call DoNothing()
                endif
                // set hero stats
                if ( Trig_TP_hero_Func007Func019Func001Func005C() ) then
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_STRENGTH, ( R2I(udg_hero_STR_base[udg_X]) + ( R2I(udg_hero_STR_inc[udg_X]) * 5 ) ))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_INTELLIGENCE, ( R2I(udg_hero_INT_base[udg_X]) + ( R2I(udg_hero_INT_inc[udg_X]) * 5 ) ))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_AGILITY, ( R2I(udg_hero_AGI_base[udg_X]) + ( R2I(udg_hero_AGI_inc[udg_X]) * 5 ) ))
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[udg_X])
                    call SetUnitMoveSpeed(udg_temp_unit, udg_hero_move_base[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_TURN_RATE, udg_hero_turnrate[udg_X])
                else
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_STRENGTH, R2I(udg_hero_STR_base[udg_X]))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_AGILITY, R2I(udg_hero_AGI_base[udg_X]))
                    call BlzSetUnitIntegerFieldBJ(udg_temp_unit, UNIT_IF_INTELLIGENCE, R2I(udg_hero_INT_base[udg_X]))
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_STRENGTH_PER_LEVEL, udg_hero_STR_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_AGILITY_PER_LEVEL, udg_hero_AGI_inc[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_INTELLIGENCE_PER_LEVEL, udg_hero_INT_inc[udg_X])
                    call SetUnitMoveSpeed(udg_temp_unit, udg_hero_move_base[udg_X])
                    call BlzSetUnitRealFieldBJ(udg_temp_unit, UNIT_RF_TURN_RATE, udg_hero_turnrate[udg_X])
                endif
            else
                call DoNothing()
            endif
            set udg_X=udg_X + 1
        endloop
    else
        if ( Trig_TP_hero_Func007Func001C() ) then
            call RemoveUnit(udg_temp_unit)
        else
            call DoNothing()
        endif
    endif
    call ConditionalTriggerExecute(gg_trg_admin_level)
    set udg_X=udg_temp_playernumber
    set udg_temp_level=1
    set udg_hero_bounty_multiplier=1.00
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'H00U' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=0.50
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'H00T' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.50
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'E00V' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.10
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'N00O' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.10
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'E00O' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.25
    else
        call DoNothing()
    endif
    if ( ( GetUnitTypeId(udg_herO[udg_X]) == 'N00N' ) ) then // INLINED!!
        set udg_hero_bounty_multiplier=1.00
    else
        call DoNothing()
    endif
    set udg_temp_real=( I2R(udg_hero_bounty_base[udg_temp_level]) * udg_hero_bounty_multiplier )
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(udg_temp_real))
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, 0)
    call BlzSetUnitIntegerFieldBJ(udg_herO[udg_X], UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, 0)
    call RemoveLocation(udg_temp_point)
    call FF_DebugHeroReady(udg_temp_unit)
endfunction

function T66_HeroSold takes nothing returns nothing
    local unit u = GetSoldUnit()
    local unit shop = GetSellingUnit()
    local integer team = 1
    if IsUnitType(u, UNIT_TYPE_HERO) and not RectContainsUnit(gg_rct_TAVERN_AREA, u) then
        loop
            exitwhen team > 4
            if shop == udg_real_shop[team] or shop == CarryTav_shop[team] then
                call SetUnitPosition(u, GetRectCenterX(gg_rct_TAVERN_AREA), GetRectCenterY(gg_rct_TAVERN_AREA))
                exitwhen true
            endif
            set team = team + 1
        endloop
    endif
    set u = null
    set shop = null
endfunction

function InitTrig_TP_hero takes nothing returns nothing
    local trigger debugSales = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(debugSales, EVENT_PLAYER_UNIT_SELL)
    call TriggerAddAction(debugSales, function T66_HeroSold)
    call TriggerAddAction(debugSales, function FF_DebugHeroSold)
    set debugSales = null
    set gg_trg_TP_hero=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_TP_hero, gg_rct_TAVERN_AREA)
    call TriggerAddCondition(gg_trg_TP_hero, Condition(function Trig_TP_hero_Conditions))
    call TriggerAddAction(gg_trg_TP_hero, function Trig_TP_hero_Actions)
endfunction

