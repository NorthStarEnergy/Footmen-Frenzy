function Trig_MH_shop_redirect_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_fakeshops) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MH_shop_redirect_Func001Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_fake_shop[udg_X] ) ) then
        return false
    endif
    return true
endfunction

function Trig_MH_shop_redirect_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 23
        if ( Trig_MH_shop_redirect_Func001Func001C() ) then
            call ClearSelectionForPlayer(GetTriggerPlayer())
            call SelectUnitForPlayerSingle(udg_real_shop[udg_X], GetTriggerPlayer())
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_MH_shop_redirect takes nothing returns nothing
    set gg_trg_MH_shop_redirect=CreateTrigger()
    call DisableTrigger(gg_trg_MH_shop_redirect)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(0), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(1), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(2), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(3), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(4), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(5), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(6), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(7), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(8), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(9), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(10), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_redirect, Player(11), true)
    call TriggerAddCondition(gg_trg_MH_shop_redirect, Condition(function Trig_MH_shop_redirect_Conditions))
    call TriggerAddAction(gg_trg_MH_shop_redirect, function Trig_MH_shop_redirect_Actions)
endfunction

function Trig_MH_shop_click_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_fakeshops) == true ) ) then
        return false
    endif
    if ( not ( udg_mh_status == true ) ) then
        return false
    endif
    if ( not ( udg_player_active[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        return false
    endif
    if ( not ( udg_maphack[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_MH_shop_click_Func001C takes nothing returns boolean
    if ( not ( udg_MH_player_clicks[GetConvertedPlayerId(GetTriggerPlayer())] < udg_MH_security_lv ) ) then
        return false
    endif
    return true
endfunction

function Trig_MH_shop_click_Actions takes nothing returns nothing
    if ( Trig_MH_shop_click_Func001C() ) then
        set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1100")
        call DestroyForce(udg_temp_playergroup)
    else
        call DisplayTextToForce(udg_all_players, ( ( "oopsie daisy, looks like " + GetPlayerName(GetTriggerPlayer()) ) + " is using a maphack!" ))
        call SetPlayerName(GetTriggerPlayer(), ( GetPlayerName(GetTriggerPlayer()) + "  [MAPHACKER]" ))
        set udg_maphack[GetConvertedPlayerId(GetTriggerPlayer())]=true
        call SetPlayerHandicapXPBJ(GetTriggerPlayer(), 25.00)
    endif
    set udg_MH_player_clicks[GetConvertedPlayerId(GetTriggerPlayer())]=( udg_MH_player_clicks[GetConvertedPlayerId(GetTriggerPlayer())] + 1 )
endfunction

function InitTrig_MH_shop_click takes nothing returns nothing
    set gg_trg_MH_shop_click=CreateTrigger()
    call DisableTrigger(gg_trg_MH_shop_click)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(0), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(1), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(2), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(3), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(4), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(5), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(6), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(7), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(8), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(9), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(10), true)
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_MH_shop_click, Player(11), true)
    call TriggerAddCondition(gg_trg_MH_shop_click, Condition(function Trig_MH_shop_click_Conditions))
    call TriggerAddAction(gg_trg_MH_shop_click, function Trig_MH_shop_click_Actions)
endfunction

function Trig_MH_hide_fake_shop_rat_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A028' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'AHta' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'Andt' ) ) then
        return true
    endif
    return false
