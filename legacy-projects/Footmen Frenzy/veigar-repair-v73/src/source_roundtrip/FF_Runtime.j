    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_autorevive_Func002002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_autorevive_Func004A takes nothing returns nothing
    // udg_temp_unit is the hero captured before the wait; GetTriggerUnit() here would be stale.
    call IssueTargetOrderBJ(GetEnumUnit(), "revive", udg_temp_unit)
    call DisplayTextToForce(udg_temp_playergroup, ( "Your Hero " + ( GetUnitName(udg_temp_unit) + " will be automatically revived." ) ))
endfunction

function Trig_autorevive_Actions takes nothing returns nothing
    local unit deadHero= GetTriggerUnit()
    local player owner= GetOwningPlayer(deadHero)
    // Event responses are not reliable after a wait: if this trigger fires again while this
    // thread sleeps, the natives below return the NEWER event. Locals are per-thread, so the
    // values are captured up front and the shared globals rebuilt from them after the wait.
    call TriggerSleepAction(10.00)
    set udg_temp_unit=deadHero
    set udg_temp_unitgroup=GetUnitsOfPlayerMatching(owner, Condition(function Trig_autorevive_Func002002002))
    set udg_temp_playergroup=GetForceOfPlayer(owner)
    call ForGroupBJ(udg_temp_unitgroup, function Trig_autorevive_Func004A)
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyForce(udg_temp_playergroup)
    set deadHero=null
    set owner=null
endfunction

function InitTrig_autorevive takes nothing returns nothing
    set gg_trg_autorevive=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_autorevive, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_autorevive, Condition(function Trig_autorevive_Conditions))
    call TriggerAddAction(gg_trg_autorevive, function Trig_autorevive_Actions)
endfunction

