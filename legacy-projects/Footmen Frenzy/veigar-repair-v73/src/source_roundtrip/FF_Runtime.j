function Trig_ITEM_Forked_Fury_NEW_Func006Func003Func010C takes nothing returns boolean
    if ( ( udg_random_integer[udg_temp_playernumber] == 3 ) ) then
        return true
    endif
    if ( ( udg_random_integer[udg_temp_playernumber] == 7 ) ) then
        return true
    endif
    if ( ( udg_random_integer[udg_temp_playernumber] == 15 ) ) then
        return true
    endif
    if ( ( udg_random_integer[udg_temp_playernumber] == 12 ) ) then
        return true
    endif
    return false
endfunction

