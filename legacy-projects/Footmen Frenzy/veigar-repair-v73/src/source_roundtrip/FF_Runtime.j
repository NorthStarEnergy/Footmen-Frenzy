function Trig_Charge_Pos_2_and_Pos_3_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A08G' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0D3' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0AP' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0ST' ) ) then
        return true
    endif
    return false
endfunction

