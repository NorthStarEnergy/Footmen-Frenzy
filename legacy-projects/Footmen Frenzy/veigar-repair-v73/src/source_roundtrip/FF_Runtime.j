function Trig_HERO_POTM_Owls_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n03F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n00W' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n03G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n00X' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n03H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'n00B' ) ) then
        return true
    endif
    return false
endfunction

function Trig_HERO_POTM_Owls_Conditions takes nothing returns boolean
    if ( not ( false == true ) ) then
        return false
    endif
    if ( not Trig_HERO_POTM_Owls_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_POTM_Owls_Func008C takes nothing returns boolean
    if ( not ( udg_abilitylevel >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_POTM_Owls_Actions takes nothing returns nothing
    local unit owl= GetSummonedUnit()
    // Event responses are not reliable after a wait: if this trigger fires again while this
    // thread sleeps, the natives below return the NEWER event. Locals are per-thread, so the
    // values are captured up front and the shared globals rebuilt from them after the wait.
    call TriggerSleepAction(0.50)
    set udg_spawned_unit[1]=owl
    set udg_temp_player=GetOwningPlayer(owl)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_abilitylevel=GetUnitAbilityLevelSwapped('AEst', udg_herO[udg_temp_playernumber])
    if ( Trig_HERO_POTM_Owls_Func008C() ) then
        call UnitAddAbilityBJ('A0D4', owl)
        call SetUnitAbilityLevelSwapped('A0D4', owl, udg_abilitylevel)
    else
        call DoNothing()
    endif
    set owl=null
endfunction

function InitTrig_HERO_POTM_Owls takes nothing returns nothing
    set gg_trg_HERO_POTM_Owls=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_POTM_Owls, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddCondition(gg_trg_HERO_POTM_Owls, Condition(function Trig_HERO_POTM_Owls_Conditions))
    call TriggerAddAction(gg_trg_HERO_POTM_Owls, function Trig_HERO_POTM_Owls_Actions)
endfunction

