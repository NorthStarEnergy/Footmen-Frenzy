        call DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), ( "TRIGGER, UNIT: " + GetUnitName(GetTriggerUnit()) ))
        call DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()), ( "LEVEL: " + I2S(udg_frostbolt_upgrade_level[udg_teamnumber[udg_temp_int]]) ))
    else
    endif
endfunction

