        exitwhen udg_temp_playernumber > 12
        if ( Trig_Hero_Skills_Func001Func001C() ) then
            call DisplayTextToForce(GetPlayersAll(), ( I2S(udg_temp_playernumber) + " - selected" ))
            call SelectUnitForPlayerSingle(udg_herO[udg_temp_playernumber], ConvertedPlayer(udg_temp_playernumber))
            call ForceUIKeyBJ(ConvertedPlayer(udg_temp_playernumber), "O")
            call TriggerSleepAction(0.10)
