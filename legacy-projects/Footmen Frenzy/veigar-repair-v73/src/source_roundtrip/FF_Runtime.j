    set udg_Guardian_Unit[4]=GetTriggerUnit()
    set udg_Guardian_EC_Ability=GetSpellAbilityId()
    set udg_Guardian_Integer[4]=( GetUnitAbilityLevelSwapped(udg_Guardian_EC_Ability, udg_Guardian_Unit[4]) - 1 )
    set udg_Guardian_Integer[5]=BlzGetUnitAbilityManaCost(udg_Guardian_Unit[4], udg_Guardian_EC_Ability, udg_Guardian_Integer[4])
    //                                                                                                                    
    if ( Trig_Guardian_Energy_Chamber_Ally_Cast_Func006C() ) then
        set udg_Guardian_Point[4]=GetUnitLoc(udg_Guardian_Unit[4])
        call ForGroupBJ(udg_Guardian_EC_Group, function Trig_Guardian_Energy_Chamber_Ally_Cast_Func006Func002A)
        call RemoveLocation(udg_Guardian_Point[4])
    else
    endif
endfunction

