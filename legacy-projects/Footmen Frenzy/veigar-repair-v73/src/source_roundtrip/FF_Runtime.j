    if ( not ( udg_voting_mode == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vote_Timer_Expires_Actions takes nothing returns nothing
    if FFStartDialog != null then
        call DialogDisplay(udg_Host,FFStartDialog,false)
    endif
    // Normal Vote Timer Expired (first time):
    if ( Trig_Vote_Timer_Expires_Func002C() ) then
        // Unsure if I'm supposed to hide this here:
        if udg_timer_window_voting != null then
            call TimerDialogDisplayBJ(false, udg_timer_window_voting)
            call DestroyTimerDialog(udg_timer_window_voting)
            set udg_timer_window_voting=null
        endif
        set udg_voting=false
        set udg_X=1
        loop
            exitwhen udg_X > 12
            set udg_AP_votes=( udg_AP_votes + udg_AP[udg_X] )
            set udg_AR_votes=( udg_AR_votes + udg_AR[udg_X] )
            set udg_SD_votes=( udg_SD_votes + udg_SD[udg_X] )
            set udg_X=udg_X + 1
        endloop
        call DisplayTextToForce(udg_all_players, ( I2S(udg_AR_votes) + " Votes for AR mode" ))
        call DisplayTextToForce(udg_all_players, ( I2S(udg_AP_votes) + " Votes for AP mode" ))
        call DisplayTextToForce(udg_all_players, ( I2S(udg_SD_votes) + " Votes for SD mode" ))
        if ( Trig_Vote_Timer_Expires_Func002Func008C() ) then
            call EnableTrigger(gg_trg_Start_AP)
            call ConditionalTriggerExecute(gg_trg_Start_AP)
            call ConditionalTriggerExecute(gg_trg_Start_game)
        else
            if ( Trig_Vote_Timer_Expires_Func002Func008Func001C() ) then
                call EnableTrigger(gg_trg_Start_AR)
                call ConditionalTriggerExecute(gg_trg_Start_AR)
                call ConditionalTriggerExecute(gg_trg_Start_game)
            else
                if ( Trig_Vote_Timer_Expires_Func002Func008Func001Func002C() ) then
                    call EnableTrigger(gg_trg_Start_SD)
                    call ConditionalTriggerExecute(gg_trg_Start_SD)
                    call ConditionalTriggerExecute(gg_trg_Start_game)
                else
                    if FFModePrivateVote then
                        call FFMode_ForcePub()
                    else
                        call DisplayTextToForce(udg_all_players, "Vote tied or no votes were cast. Defaulting to SD mode.")
                        call EnableTrigger(gg_trg_Start_SD)
                        call ConditionalTriggerExecute(gg_trg_Start_SD)
                        call ConditionalTriggerExecute(gg_trg_Start_game)
                    endif
                endif
            endif
        endif
    else
    endif
endfunction

