    return true
endfunction

function Trig_HERO_Architect_Recruit_Actions takes nothing returns nothing
    local player casterPlayer=GetOwningPlayer(GetSpellAbilityUnit())
    set udg_temp_playernumber=GetConvertedPlayerId(casterPlayer)
    set udg_temp_player=ConvertedPlayer(udg_temp_playernumber)
    set udg_casting_hero[udg_temp_playernumber]=GetSpellAbilityUnit()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_casting_hero[udg_temp_playernumber])
    set udg_targeted_unit=GetSpellTargetUnit()
    set udg_temp_point_caster=GetUnitLoc(udg_casting_hero[udg_temp_playernumber])
    set udg_temp_real=0.00
    set udg_temp_X[1]=2
    set udg_temp_X[2]=3
    set udg_temp_X[3]=3
    set udg_temp_X[4]=3
    set udg_temp_X[5]=4
    set udg_temp_X[6]=4
    set udg_X_base=0
    loop
        exitwhen udg_X_base > 25
        if ( Trig_HERO_Architect_Recruit_Func014Func001C() ) then
            set udg_temp_real=( udg_temp_real + 1 )
            // setting upgraded values
            set udg_temp_level=0
            set udg_temp_level=GetPlayerTechCountSimple('Rhme', casterPlayer)
            set udg_unit_att_num_dice_actual[udg_X_base]=( udg_unit_att_num_dice[udg_X_base] + udg_temp_level )
            set udg_temp_level=GetPlayerTechCountSimple('Rhar', casterPlayer)
            set udg_unit_armor_actual[udg_X_base]=( udg_unit_armor[udg_X_base] + ( I2R(udg_temp_level) * 2.00 ) )
            // setting unit stats
            set udg_unit_att_actual[udg_X_base]=udg_unit_att_base[udg_X_base]
            if ( Trig_HERO_Architect_Recruit_Func014Func001Func013C(casterPlayer) ) then
                set udg_temp_level=GetPlayerTechCountSimple('Robs', casterPlayer)
                if ( Trig_HERO_Architect_Recruit_Func014Func001Func013Func005C() ) then
                    set udg_unit_HP_actual[udg_X_base]=( udg_unit_HP[udg_X_base] + 150 )
                    set udg_unit_att_actual[udg_X_base]=( udg_unit_att_actual[udg_X_base] + 4 )
                else
                    set udg_unit_HP_actual[udg_X_base]=( ( udg_unit_HP[udg_X_base] + 150 ) + ( 60 * ( udg_temp_level - 1 ) ) )
                    set udg_unit_att_actual[udg_X_base]=( ( udg_unit_att_actual[udg_X_base] + 4 ) + ( 2 * ( udg_temp_level - 1 ) ) )
                endif
            else
                if ( Trig_HERO_Architect_Recruit_Func014Func001Func013Func001C(casterPlayer) ) then
                    set udg_temp_level=GetPlayerTechCountSimple('Rhan', casterPlayer)
                    if ( Trig_HERO_Architect_Recruit_Func014Func001Func013Func001Func005C() ) then
                        set udg_unit_HP_actual[udg_X_base]=( udg_unit_HP[udg_X_base] + 150 )
                    else
                        set udg_unit_HP_actual[udg_X_base]=( ( udg_unit_HP[udg_X_base] + 150 ) + ( 45 * ( udg_temp_level - 1 ) ) )
                    endif
                else
                    set udg_unit_HP_actual[udg_X_base]=udg_unit_HP[udg_X_base]
                endif
            endif
            set udg_temp_int=1
            loop
                exitwhen udg_temp_int > udg_temp_X[udg_abilitylevel]
                call CreateNUnitsAtLoc(1, GetUnitTypeId(udg_targeted_unit), casterPlayer, udg_temp_point_caster, bj_UNIT_FACING)
                set udg_spawned_unit[udg_temp_int]=GetLastCreatedUnit()
                call UnitApplyTimedLifeBJ(60.00, 'BTLF', udg_spawned_unit[udg_temp_int])
                call BlzSetUnitMaxHP(udg_spawned_unit[udg_temp_int], udg_unit_HP_actual[udg_X_base])
                call BlzSetUnitRealFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_RF_HP, I2R(udg_unit_HP_actual[udg_X_base]))
                call BlzSetUnitArmor(udg_spawned_unit[udg_temp_int], udg_unit_armor_actual[udg_X_base])
                call BlzSetUnitBaseDamage(udg_spawned_unit[udg_temp_int], udg_unit_att_actual[udg_X_base], 0)
                call BlzSetUnitDiceNumber(udg_spawned_unit[udg_temp_int], udg_unit_att_num_dice_actual[udg_X_base], 0)
                call BlzSetUnitDiceSides(udg_spawned_unit[udg_temp_int], udg_unit_att_dice_sides[udg_X_base], 0)
                call BlzSetUnitAttackCooldown(udg_spawned_unit[udg_temp_int], udg_unit_att_CD[udg_X_base], 1)
                call MF_SetAttackRange(udg_spawned_unit[udg_temp_int], udg_unit_range[udg_X_base])
                // bounty
                call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, udg_unit_bounty_base[udg_X_base])
                call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, udg_unit_bounty_num_dice[udg_X_base])
                call BlzSetUnitIntegerFieldBJ(udg_spawned_unit[udg_temp_int], UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, udg_unit_bounty_dice_sides[udg_X_base])
                // colour
                call UnitAddTypeBJ(UNIT_TYPE_ANCIENT, udg_spawned_unit[udg_temp_int])
                call SetUnitVertexColorBJ(udg_spawned_unit[udg_temp_int], 55.00, 55.00, 55.00, 0)
                set udg_temp_int=udg_temp_int + 1
            endloop
        else
            call DoNothing()
        endif
        set udg_X_base=udg_X_base + 1
    endloop
    if ( Trig_HERO_Architect_Recruit_Func015C() ) then
        call DisplayTextToForce(GetForceOfPlayer(ConvertedPlayer(udg_temp_playernumber)), "TRIGSTR_1763")
        call BlzEndUnitAbilityCooldown(udg_casting_hero[udg_temp_playernumber], GetSpellAbilityId())
    else
        call DoNothing()
    endif
    call RemoveLocation(udg_temp_point_caster)
    set casterPlayer=null
endfunction

