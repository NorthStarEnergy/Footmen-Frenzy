function Trig_Multiboard_Create_with_KOTH_Actions takes nothing returns nothing
    if ( Trig_Multiboard_Create_with_KOTH_Func001C() ) then
        return
    else
    endif
    //                                                                                                     
    set udg_scoreboard_on=true
    // team board
    if ( Trig_Multiboard_Create_with_KOTH_Func005C() ) then
        set udg_temp_real=95.00
        call CreateMultiboardBJ(4, 5, "TRIGSTR_11094")
        set udg_multiboard_kills=GetLastCreatedMultiboard()
        call MultiboardSetTitleText(udg_multiboard_kills, "Leaderboard - |cffffcc000:00|r")
        call MultiboardSetTitleTextColorBJ(udg_multiboard_kills, 30.00, 60.00, 50.00, udg_temp_real)
        call MultiboardSetItemStyleBJ(udg_multiboard_kills, 1, 1, false, false)
        call MultiboardSetItemStyleBJ(udg_multiboard_kills, 2, 1, false, true)
        call MultiboardSetItemIconBJ(udg_multiboard_kills, 2, 1, "ReplaceableTextures\\CommandButtons\\BTNArcaniteMelee.blp")
        call MultiboardSetItemStyleBJ(udg_multiboard_kills, 3, 1, false, true)
        call MultiboardSetItemIconBJ(udg_multiboard_kills, 3, 1, "ReplaceableTextures\\CommandButtons\\BTNAbility_Hunter_SniperShot.blp")
        call MultiboardSetItemIconBJ(udg_multiboard_kills, 4, 1, "ReplaceableTextures\\CommandButtons\\BTNGoldMine.blp")
        call MultiboardSetItemStyleBJ(udg_multiboard_kills, 4, 1, false, true)
        set udg_X=1
        loop
            exitwhen udg_X > 4
            call MultiboardSetItemValueBJ(udg_multiboard_kills, 1, ( udg_X + 1 ), ( "T" + I2S(udg_X) ))
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 1, ( udg_X + 1 ), true, false)
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 2, ( udg_X + 1 ), true, false)
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 3, ( udg_X + 1 ), true, false)
            call MultiboardSetItemStyleBJ(udg_multiboard_kills, 4, ( udg_X + 1 ), true, false)
            set udg_X=udg_X + 1
        endloop
        set udg_X=1
        loop
            exitwhen udg_X > 5
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 1, udg_X, 1.70)
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 2, udg_X, 3.50)
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 3, udg_X, 2.60)
            call MultiboardSetItemWidthBJ(udg_multiboard_kills, 4, udg_X, 4.50)
            set udg_X=udg_X + 1
        endloop
        call MultiboardDisplayBJ(false, udg_multiboard_kills)
    else
        call DoNothing()
    endif
endfunction

