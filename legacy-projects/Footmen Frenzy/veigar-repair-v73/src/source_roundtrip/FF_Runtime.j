function Trig_MODE_1v1_Actions takes nothing returns nothing
    // REDISTRIBUTE PLAYERS IF NECCESARY
    // START PRIV
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_11570")
    call StartTimerBJ(udg_timer_voting, false, 0.00)
    call EnableTrigger(gg_trg_Start_AP)
    call ConditionalTriggerExecute(gg_trg_Start_AP)
    call ConditionalTriggerExecute(gg_trg_Start_game)
    call ConditionalTriggerExecute(gg_trg_MODE_set_inhouse)
    call DialogDisplayBJ(false, udg_dlg_mode[1], Player(0))
    // REMOVE TOWERS
    set udg_temp_unitgroup=GetUnitsOfTypeIdAll('hwtw')
    call ForGroupBJ(udg_temp_unitgroup, function Trig_MODE_1v1_Func013A)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

