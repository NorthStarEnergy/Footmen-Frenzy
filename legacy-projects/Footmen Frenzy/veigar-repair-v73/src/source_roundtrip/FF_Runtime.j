    set st__Missiles_move=CreateTrigger()
    call TriggerAddCondition(st__Missiles_move, Condition(function sa__Missiles_move))
    set st__MMD__QueueNode_onDestroy=CreateTrigger()
    call TriggerAddCondition(st__MMD__QueueNode_onDestroy, Condition(function sa__MMD__QueueNode_onDestroy))
    set st___prototype4[1]=CreateTrigger()
    call TriggerAddAction(st___prototype4[1], function sa___prototype4_TimerUtils___init)
    call TriggerAddCondition(st___prototype4[1], Condition(function sa___prototype4_TimerUtils___init))

call ExecuteFunc("s__File_FileIO___FileInit__onInit")


call ExecuteFunc("s__WorldBounds_WorldBounds___WorldBoundInit__onInit")








