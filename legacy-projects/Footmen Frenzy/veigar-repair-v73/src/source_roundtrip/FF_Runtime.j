function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001C takes nothing returns boolean
    if ( not Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Actions takes nothing returns nothing
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001C() ) then
            set udg_StaffJungle_start_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func003C() ) then
                set udg_StaffJungle_location[udg_X]=GetUnitLoc(udg_herO[udg_X])
                set udg_StaffJungle_active[udg_X]=false
            else
                set udg_StaffJungle_location[udg_X]=PolarProjectionBJ(udg_StaffJungle_location[udg_X], 20.00, udg_StaffJungle_degree[udg_X])
            endif
            call SetUnitPositionLocFacingBJ(udg_dummy_Jungle[udg_X], udg_StaffJungle_location[udg_X], udg_StaffJungle_degree[udg_X])
            set udg_StaffJungle_target[udg_X]=GetUnitsInRangeOfLocMatching(110.00, udg_StaffJungle_location[udg_X], Condition(function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func005002003))
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func006C() ) then
                call SetUnitPositionLocFacingBJ(udg_herO[udg_X], udg_StaffJungle_location[udg_X], udg_StaffJungle_degree[udg_X])
                call AddSpecialEffectLocBJ(udg_StaffJungle_location[udg_X], "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                call UnitAddAbilityBJ('A0RF', udg_dummy_Jungle[udg_X])
                call SetUnitAbilityLevelSwapped('A0RF', udg_dummy_Jungle[udg_X], udg_StaffJungle_level[GetUnitUserData(udg_dummy_Jungle[udg_X])])
                call IssueImmediateOrderBJ(udg_dummy_Jungle[udg_X], "stomp")
                call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy_Jungle[udg_X])
                call RemoveLocation(udg_StaffJungle_location[udg_X])
                call RemoveLocation(udg_StaffJungle_start_location[udg_X])
                set udg_StaffJungle_active[udg_X]=false
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            if ( Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Func001Func001Func007C() ) then
                call RemoveUnit(udg_dummy_Jungle[udg_X])
                call RemoveLocation(udg_StaffJungle_location[udg_X])
                set udg_StaffJungle_active[udg_X]=false
                call RemoveLocation(udg_StaffJungle_start_location[udg_X])
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
            call DestroyGroup(udg_StaffJungle_target[udg_X])
        else
            call DoNothing()
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_HERO_Monkey_Staff_of_the_Jungle_Loop takes nothing returns nothing
    set gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop, 0.02)
    call TriggerAddAction(gg_trg_HERO_Monkey_Staff_of_the_Jungle_Loop, function Trig_HERO_Monkey_Staff_of_the_Jungle_Loop_Actions)
endfunction

function Trig_Holy_Crash_Setup_Actions takes nothing returns nothing
    // ==============================================================
    // DEFINE the amount of damage it deals to nearby enemy units [Put the level in the brackets]:
    set udg_HCr_Setup_Damage[1]=225.00
    set udg_HCr_Setup_Damage[2]=325.00
    set udg_HCr_Setup_Damage[3]=425.00
    set udg_HCr_Setup_Damage[4]=250.00
    set udg_HCr_Setup_Damage[5]=350.00
    set udg_HCr_Setup_Damage[6]=460.00
    //                                                                                                                    
    // DEFINE the amount of life it restores to nearby allied units [Put the level in the brackets]:
    set udg_HCr_Setup_Heal[1]=100.00
    set udg_HCr_Setup_Heal[2]=200.00
    set udg_HCr_Setup_Heal[3]=300.00
    set udg_HCr_Setup_Heal[4]=125.00
    set udg_HCr_Setup_Heal[5]=175.00
    set udg_HCr_Setup_Heal[6]=230.00
    //                                                                                                                    
    // DEFINE the minimum distance that can be traveled, this should be at least 1:
    set udg_HCr_Setup_Min_Distance=200.00
    // ==============================================================
endfunction

function InitTrig_Holy_Crash_Setup takes nothing returns nothing
    set gg_trg_Holy_Crash_Setup=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_Holy_Crash_Setup, 0.00)
    call TriggerAddAction(gg_trg_Holy_Crash_Setup, function Trig_Holy_Crash_Setup_Actions)
endfunction

function Trig_Holy_Crash_Cast_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'AHCR' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Holy_Crash_Cast_Conditions takes nothing returns boolean
    if ( not Trig_Holy_Crash_Cast_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Func010Func002C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] <= 125.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Func010C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] < udg_HCr_Setup_Min_Distance ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Func043C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Cast_Actions takes nothing returns nothing
    set udg_HCr_Caster=GetTriggerUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    set udg_HCr_Point[1]=GetSpellTargetLoc()
    set udg_HCr_Distance[udg_HCr_CV]=DistanceBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Level[udg_HCr_CV]=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_HCr_Caster)
    //                                                                                                                    
    // Enforce a minimum distance:
    if ( Trig_Holy_Crash_Cast_Func010C() ) then
        // This is a fix for if you target yourself with the ability:
        if ( Trig_Holy_Crash_Cast_Func010Func002C() ) then
            call RemoveLocation(udg_HCr_Point[1])
            set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Setup_Min_Distance, GetUnitFacing(udg_HCr_Caster))
        else
        endif
        set udg_HCr_Distance[udg_HCr_CV]=udg_HCr_Setup_Min_Distance
    else
    endif
    //                                                                                                                    
    //                                                                                                                    
    // ==============================================================
    // DEFINE the duration and max height (if it's confusing just change the very first number in each):
    set udg_HCr_Duration[udg_HCr_CV]=( 0.40 + ( udg_HCr_Distance[udg_HCr_CV] / 1200.00 ) )
    set udg_HCr_Height[udg_HCr_CV]=( 850.00 + ( udg_HCr_Distance[udg_HCr_CV] / 8.00 ) )
    // ==============================================================
    //                                                                                                                    
    //                                                                                                                    
    // Calculate angle, speed and height adjustment math:
    set udg_HCr_Angle[udg_HCr_CV]=AngleBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Speed[0]=( udg_HCr_Distance[udg_HCr_CV] / udg_HCr_Duration[udg_HCr_CV] )
    set udg_HCr_Speed[udg_HCr_CV]=( udg_HCr_Speed[0] * 0.02 )
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.00
    set udg_HCr_Height_Rate[udg_HCr_CV]=( 2.00 * udg_HCr_Height[udg_HCr_CV] )
    set udg_HCr_Height_Factor[udg_HCr_CV]=( 1.00 / udg_HCr_Duration[udg_HCr_CV] )
    //                                                                                                                    
    // For some reason Collision no longer turns off/on (1.35/1.36 bug):
    call SetUnitPathing(udg_HCr_Caster, false)
    //                                                                                                                    
    // This allows a non-Flying unit to have it's Flying Height adjusted:
    call UnitAddAbilityBJ('Arav', udg_HCr_Caster)
    call UnitRemoveAbilityBJ('Arav', udg_HCr_Caster)
    //                                                                                                                    
    call GroupAddUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
    set udg_HCr_Caster_Count=( udg_HCr_Caster_Count + 1 )
    call SetUnitInvulnerable(udg_HCr_Caster, true)
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Turn on the Loop trigger which moves the caster:
    if ( Trig_Holy_Crash_Cast_Func043C() ) then
        call EnableTrigger(gg_trg_Holy_Crash_Loop)
    else
    endif
endfunction

function InitTrig_Holy_Crash_Cast takes nothing returns nothing
    set gg_trg_Holy_Crash_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Holy_Crash_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Holy_Crash_Cast, Condition(function Trig_Holy_Crash_Cast_Conditions))
    call TriggerAddAction(gg_trg_Holy_Crash_Cast, function Trig_Holy_Crash_Cast_Actions)
endfunction

function Trig_Holy_Crash_Loop_Func002Func004C takes nothing returns boolean
    if ( not ( udg_HCr_Elapsed_Time[udg_HCr_CV] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func001C takes nothing returns boolean
    if ( ( udg_HCr_Elapsed_Time[udg_HCr_CV] >= udg_HCr_Duration[udg_HCr_CV] ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_HCr_Caster) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func005C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_HCr_Target[0], GetOwningPlayer(udg_HCr_Caster)) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_HCr_Target[0]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HCr_Target[0], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HCr_Target[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HCr_Target[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016Func008A takes nothing returns nothing
    set udg_HCr_Target[0]=GetEnumUnit()
    if ( Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002C() ) then
        // DAMAGE
        if ( Trig_Holy_Crash_Loop_Func002Func026Func016Func008Func002Func002C() ) then
            call UnitDamageTargetBJ(udg_HCr_Caster, udg_HCr_Target[0], udg_HCr_Setup_Damage[udg_HCr_Level[udg_HCr_CV]], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
            call AddSpecialEffectTargetUnitBJ("origin", udg_HCr_Target[0], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissile.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            // APPLY KNOCK-UP EFFECT - (Note: Height is not perfect so use a higher value than normal):
            set udg_KnockUp_Target=udg_HCr_Target[0]
            set udg_KnockUp_Height=400.00
            set udg_KnockUp_Duration=1.00
            call TriggerExecute(gg_trg_KnockUp_Apply)
        else
            // HEAL
        endif
    else
    endif
endfunction

function Trig_Holy_Crash_Loop_Func002Func026Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HCr_Caster) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002Func026C takes nothing returns boolean
    if ( not Trig_Holy_Crash_Loop_Func002Func026Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Crash_Loop_Func002A takes nothing returns nothing
    set udg_HCr_Caster=GetEnumUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    //                                                                                                                    
    if ( Trig_Holy_Crash_Loop_Func002Func004C() ) then
        // This is a triggered Stun (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, true)
        set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.01
        //                                                                                                                    
        // Optional animation to be played while in the air:
        call SetUnitAnimation(udg_HCr_Caster, "attack")
        call QueueUnitAnimationBJ(udg_HCr_Caster, "stand")
        call AddSpecialEffectTargetUnitBJ("weapon", udg_HCr_Caster, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    //                                                                                                                    
    // Time_Elapsed should increase by the Periodic Interval amount (0.02 by default):
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=( udg_HCr_Elapsed_Time[udg_HCr_CV] + 0.02 )
    //                                                                                                                    
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    //                                                                                                                    
    // Get the destination:
    set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Speed[udg_HCr_CV], udg_HCr_Angle[udg_HCr_CV])
    //                                                                                                                    
    call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[1])
    call SetUnitX(udg_HCr_Caster, GetLocationX(udg_HCr_Point[1]))
    call SetUnitY(udg_HCr_Caster, GetLocationY(udg_HCr_Point[1]))
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Adjust flying height of the unit:
    set udg_HCr_Height[0]=( ( udg_HCr_Height_Rate[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) - ( udg_HCr_Height_Factor[udg_HCr_CV] * ( udg_HCr_Height_Rate[udg_HCr_CV] * ( udg_HCr_Elapsed_Time[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) ) ) )
    call SetUnitFlyHeightBJ(udg_HCr_Caster, ( GetUnitDefaultFlyHeight(udg_HCr_Caster) + udg_HCr_Height[0] ), 0.00)
    //                                                                                                                    
    // Check if the duration is finished or if the caster died:
    if ( Trig_Holy_Crash_Loop_Func002Func026C() ) then
        call GroupRemoveUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
        call SetUnitInvulnerable(udg_HCr_Caster, false)
        set udg_HCr_Caster_Count=( udg_HCr_Caster_Count - 1 )
        if ( Trig_Holy_Crash_Loop_Func002Func026Func005C() ) then
            call DisableTrigger(gg_trg_Holy_Crash_Loop)
        else
        endif
        //                                                                                                                    
        // For some reason Collision no longer turns off/on (1.35/1.36 bug):
        call SetUnitPathing(udg_HCr_Caster, true)
        //                                                                                                                    
        // This removes a triggered Stun from the unit (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, false)
        //                                                                                                                    
        call SetUnitFlyHeightBJ(udg_HCr_Caster, GetUnitDefaultFlyHeight(udg_HCr_Caster), 0.00)
        //                                                                                                                    
        // Damage and slow if the caster unit is still alive:
        if ( Trig_Holy_Crash_Loop_Func002Func026Func016C() ) then
            set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
            call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[0])
            call SetUnitInvulnerable(udg_HCr_Caster, false)
            //                                                                                                                    
            //                                                                                                                    
            // Damage nearby enemy units and heal nearby allied units:
            set udg_HCr_Nearby_Group=GetUnitsInRangeOfLocAll(BlzGetAbilityRealLevelField(BlzGetUnitAbility(udg_HCr_Caster, 'AHCR'), ABILITY_RLF_AREA_OF_EFFECT, ( udg_HCr_Level[udg_HCr_CV] - 1 )), udg_HCr_Point[0])
            call ForGroupBJ(udg_HCr_Nearby_Group, function Trig_Holy_Crash_Loop_Func002Func026Func016Func008A)
            //                                                                                                                    
            call RemoveLocation(udg_HCr_Point[0])
            call DestroyGroup(udg_HCr_Nearby_Group)
        else
        endif
    else
    endif
    //                                                                                                                    
endfunction

function Trig_Holy_Crash_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_HCr_Caster_Group, function Trig_Holy_Crash_Loop_Func002A)
endfunction

function InitTrig_Holy_Crash_Loop takes nothing returns nothing
    set gg_trg_Holy_Crash_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Holy_Crash_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Holy_Crash_Loop, 0.02)
    call TriggerAddAction(gg_trg_Holy_Crash_Loop, function Trig_Holy_Crash_Loop_Actions)
endfunction

function Trig_Pounce_Cast_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0W4' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0W3' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0W5' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Pounce_Cast_Conditions takes nothing returns boolean
    if ( not Trig_Pounce_Cast_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func008C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0W4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func009C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0W3' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func010C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0W5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func013Func002C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] <= 125.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func013C takes nothing returns boolean
    if ( not ( udg_HCr_Distance[udg_HCr_CV] < udg_HCr_Setup_Min_Distance ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Func046C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Cast_Actions takes nothing returns nothing
    set udg_HCr_Caster=GetTriggerUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    set udg_HCr_Point[1]=GetSpellTargetLoc()
    set udg_HCr_Distance[udg_HCr_CV]=DistanceBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Level[udg_HCr_CV]=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_HCr_Caster)
    if ( Trig_Pounce_Cast_Func008C() ) then
        set udg_HCr_Setup_Damage[1]=75.00
    else
    endif
    if ( Trig_Pounce_Cast_Func009C() ) then
        set udg_HCr_Setup_Damage[1]=100.00
    else
    endif
    if ( Trig_Pounce_Cast_Func010C() ) then
        set udg_HCr_Setup_Damage[1]=175.00
    else
    endif
    //                                                                                                                    
    // Enforce a minimum distance:
    if ( Trig_Pounce_Cast_Func013C() ) then
        // This is a fix for if you target yourself with the ability:
        if ( Trig_Pounce_Cast_Func013Func002C() ) then
            call RemoveLocation(udg_HCr_Point[1])
            set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Setup_Min_Distance, GetUnitFacing(udg_HCr_Caster))
        else
        endif
        set udg_HCr_Distance[udg_HCr_CV]=udg_HCr_Setup_Min_Distance
    else
    endif
    //                                                                                                                    
    //                                                                                                                    
    // ==============================================================
    // DEFINE the duration and max height (if it's confusing just change the very first number in each):
    set udg_HCr_Duration[udg_HCr_CV]=( 0.30 + ( udg_HCr_Distance[udg_HCr_CV] / 1200.00 ) )
    set udg_HCr_Height[udg_HCr_CV]=( 250.00 + ( udg_HCr_Distance[udg_HCr_CV] / 8.00 ) )
    // ==============================================================
    //                                                                                                                    
    //                                                                                                                    
    // Calculate angle, speed and height adjustment math:
    set udg_HCr_Angle[udg_HCr_CV]=AngleBetweenPoints(udg_HCr_Point[0], udg_HCr_Point[1])
    set udg_HCr_Speed[0]=( udg_HCr_Distance[udg_HCr_CV] / udg_HCr_Duration[udg_HCr_CV] )
    set udg_HCr_Speed[udg_HCr_CV]=( udg_HCr_Speed[0] * 0.02 )
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.00
    set udg_HCr_Height_Rate[udg_HCr_CV]=( 2.00 * udg_HCr_Height[udg_HCr_CV] )
    set udg_HCr_Height_Factor[udg_HCr_CV]=( 1.00 / udg_HCr_Duration[udg_HCr_CV] )
    //                                                                                                                    
    // For some reason Collision no longer turns off/on (1.35/1.36 bug):
    call SetUnitPathing(udg_HCr_Caster, false)
    //                                                                                                                    
    // This allows a non-Flying unit to have it's Flying Height adjusted:
    call UnitAddAbilityBJ('Arav', udg_HCr_Caster)
    call UnitRemoveAbilityBJ('Arav', udg_HCr_Caster)
    //                                                                                                                    
    call GroupAddUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
    set udg_HCr_Caster_Count=( udg_HCr_Caster_Count + 1 )
    call SetUnitInvulnerable(udg_HCr_Caster, true)
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Turn on the Loop trigger which moves the caster:
    if ( Trig_Pounce_Cast_Func046C() ) then
        call EnableTrigger(gg_trg_Pounce_Loop)
    else
    endif
endfunction

function InitTrig_Pounce_Cast takes nothing returns nothing
    set gg_trg_Pounce_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Pounce_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Pounce_Cast, Condition(function Trig_Pounce_Cast_Conditions))
    call TriggerAddAction(gg_trg_Pounce_Cast, function Trig_Pounce_Cast_Actions)
endfunction

function Trig_Pounce_Loop_Func002Func003C takes nothing returns boolean
    if ( not ( udg_HCr_Elapsed_Time[udg_HCr_CV] <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Loop_Func002Func025Func001C takes nothing returns boolean
    if ( ( udg_HCr_Elapsed_Time[udg_HCr_CV] >= udg_HCr_Duration[udg_HCr_CV] ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_HCr_Caster) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_Pounce_Loop_Func002Func025Func004C takes nothing returns boolean
    if ( not ( udg_HCr_Caster_Count == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Loop_Func002Func025Func015Func008Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_HCr_Target[0], GetOwningPlayer(udg_HCr_Caster)) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_HCr_Target[0]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HCr_Target[0], UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Loop_Func002Func025Func015Func008Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HCr_Target[0]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_HCr_Target[0], UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Loop_Func002Func025Func015Func008A takes nothing returns nothing
    set udg_HCr_Target[0]=GetEnumUnit()
    if ( Trig_Pounce_Loop_Func002Func025Func015Func008Func002C() ) then
        // DAMAGE
        if ( Trig_Pounce_Loop_Func002Func025Func015Func008Func002Func002C() ) then
            call UnitDamageTargetBJ(udg_HCr_Caster, udg_HCr_Target[0], udg_HCr_Setup_Damage[udg_HCr_Level[udg_HCr_CV]], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
            call AddSpecialEffectTargetUnitBJ("origin", udg_HCr_Target[0], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissile.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //                                                                                                                    
            // APPLY KNOCK-UP EFFECT - (Note: Height is not perfect so use a higher value than normal):
            set udg_KnockUp_Target=udg_HCr_Target[0]
            set udg_KnockUp_Height=250.00
            set udg_KnockUp_Duration=1.00
            call TriggerExecute(gg_trg_KnockUp_Apply)
        else
            // HEAL
        endif
    else
    endif
endfunction

function Trig_Pounce_Loop_Func002Func025Func015C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HCr_Caster) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Loop_Func002Func025C takes nothing returns boolean
    if ( not Trig_Pounce_Loop_Func002Func025Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Pounce_Loop_Func002A takes nothing returns nothing
    set udg_HCr_Caster=GetEnumUnit()
    set udg_HCr_CV=GetUnitUserData(udg_HCr_Caster)
    if ( Trig_Pounce_Loop_Func002Func003C() ) then
        // This is a triggered Stun (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, true)
        set udg_HCr_Elapsed_Time[udg_HCr_CV]=0.01
        //                                                                                                                    
        // Optional animation to be played while in the air:
        call SetUnitAnimation(udg_HCr_Caster, "attack")
        call QueueUnitAnimationBJ(udg_HCr_Caster, "stand")
        call AddSpecialEffectTargetUnitBJ("weapon", udg_HCr_Caster, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    //                                                                                                                    
    // Time_Elapsed should increase by the Periodic Interval amount (0.02 by default):
    set udg_HCr_Elapsed_Time[udg_HCr_CV]=( udg_HCr_Elapsed_Time[udg_HCr_CV] + 0.02 )
    //                                                                                                                    
    set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
    //                                                                                                                    
    // Get the destination:
    set udg_HCr_Point[1]=PolarProjectionBJ(udg_HCr_Point[0], udg_HCr_Speed[udg_HCr_CV], udg_HCr_Angle[udg_HCr_CV])
    //                                                                                                                    
    call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[1])
    call SetUnitX(udg_HCr_Caster, GetLocationX(udg_HCr_Point[1]))
    call SetUnitY(udg_HCr_Caster, GetLocationY(udg_HCr_Point[1]))
    //                                                                                                                    
    call RemoveLocation(udg_HCr_Point[0])
    call RemoveLocation(udg_HCr_Point[1])
    //                                                                                                                    
    // Adjust flying height of the unit:
    set udg_HCr_Height[0]=( ( udg_HCr_Height_Rate[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) - ( udg_HCr_Height_Factor[udg_HCr_CV] * ( udg_HCr_Height_Rate[udg_HCr_CV] * ( udg_HCr_Elapsed_Time[udg_HCr_CV] * udg_HCr_Elapsed_Time[udg_HCr_CV] ) ) ) )
    call SetUnitFlyHeightBJ(udg_HCr_Caster, ( GetUnitDefaultFlyHeight(udg_HCr_Caster) + udg_HCr_Height[0] ), 0.00)
    //                                                                                                                    
    // Check if the duration is finished or if the caster died:
    if ( Trig_Pounce_Loop_Func002Func025C() ) then
        call GroupRemoveUnitSimple(udg_HCr_Caster, udg_HCr_Caster_Group)
        set udg_HCr_Caster_Count=( udg_HCr_Caster_Count - 1 )
        if ( Trig_Pounce_Loop_Func002Func025Func004C() ) then
            call DisableTrigger(gg_trg_Pounce_Loop)
        else
        endif
        //                                                                                                                    
        // For some reason Collision no longer turns off/on (1.35/1.36 bug):
        call SetUnitPathing(udg_HCr_Caster, true)
        //                                                                                                                    
        // This removes a triggered Stun from the unit (It uses a counter system +1, -1 for tracking stun state):
        call BlzPauseUnitEx(udg_HCr_Caster, false)
        //                                                                                                                    
        call SetUnitFlyHeightBJ(udg_HCr_Caster, GetUnitDefaultFlyHeight(udg_HCr_Caster), 0.00)
        //                                                                                                                    
        // Damage and slow if the caster unit is still alive:
        if ( Trig_Pounce_Loop_Func002Func025Func015C() ) then
            set udg_HCr_Point[0]=GetUnitLoc(udg_HCr_Caster)
            call SetUnitPositionLoc(udg_HCr_Caster, udg_HCr_Point[0])
            call SetUnitInvulnerable(udg_HCr_Caster, false)
            //                                                                                                                    
            //                                                                                                                    
            // Damage nearby enemy units and heal nearby allied units:
            set udg_HCr_Nearby_Group=GetUnitsInRangeOfLocAll(225.00, udg_HCr_Point[0])
            call ForGroupBJ(udg_HCr_Nearby_Group, function Trig_Pounce_Loop_Func002Func025Func015Func008A)
            //                                                                                                                    
            call RemoveLocation(udg_HCr_Point[0])
            call DestroyGroup(udg_HCr_Nearby_Group)
        else
        endif
    else
    endif
    //                                                                                                                    
endfunction

function Trig_Pounce_Loop_Actions takes nothing returns nothing
    call ForGroupBJ(udg_HCr_Caster_Group, function Trig_Pounce_Loop_Func002A)
endfunction

function InitTrig_Pounce_Loop takes nothing returns nothing
    set gg_trg_Pounce_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Pounce_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Pounce_Loop, 0.02)
    call TriggerAddAction(gg_trg_Pounce_Loop, function Trig_Pounce_Loop_Actions)
endfunction

function Trig_Staff_of_the_River_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0R7' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Staff_of_the_River_Actions takes nothing returns nothing
    set udg_MonkeyKing=GetTriggerUnit()
    // DEFINE HEALING PER LEVEL:
    set udg_Jungle_Heal[1]=85.00
    set udg_Jungle_Heal[2]=125.00
    set udg_Jungle_Heal[3]=180.00
    set udg_Jungle_Heal[4]=225.00
    set udg_Jungle_Heal[5]=275.00
    set udg_Jungle_Heal[6]=375.00
    //                                                                                                     
    set udg_Jungle_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_Jungle_Point[1]=GetSpellTargetLoc()
    set udg_Jungle_Angle=AngleBetweenPoints(udg_Jungle_Point[0], udg_Jungle_Point[1])
    //                                                                                                     
    // Missile Properties:
    set udg_MissileSource=GetTriggerUnit()
    set udg_MissileStart=PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 150.00, udg_Jungle_Angle)
    set udg_MissileFinish=PolarProjectionBJ(udg_Jungle_Point[0], 1000.00, udg_Jungle_Angle)
    set udg_MissileOwner=GetOwningPlayer(udg_MissileSource)
    set udg_MissileModel="war3mapImported\\Scepter of the Tides.mdx"
    set udg_MissileScale=3.00
    set udg_MissileCollision=90.00
    set udg_MissileStartZ=90.00
    set udg_MissileFinishZ=90.00
    set udg_MissileSpeed=1300.00
    set udg_MissileVision=300.00
    set udg_MissileData=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_MissileSource)
    //                                                                                                     
    // Missile Events:
    set udg_Missile_onHit=gg_trg_Staff_of_the_River_OnHit
    //                                                                                                     
    // Launch Missile:
    call TriggerExecute(gg_trg_MissileCreate)
    //                                                                                                     
    call RemoveLocation(udg_Jungle_Point[0])
    call RemoveLocation(udg_Jungle_Point[1])
endfunction

function InitTrig_Staff_of_the_River takes nothing returns nothing
    set gg_trg_Staff_of_the_River=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Staff_of_the_River, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Staff_of_the_River, Condition(function Trig_Staff_of_the_River_Conditions))
    call TriggerAddAction(gg_trg_Staff_of_the_River, function Trig_Staff_of_the_River_Actions)
endfunction

function Trig_Staff_of_the_River_OnHit_Conditions takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_MissileHitUnit, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_MissileHitUnit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_MissileHitUnit, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Staff_of_the_River_OnHit_Func009Func002C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Jungle_Target, udg_MissileOwner) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Jungle_Target) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Jungle_Target, UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(udg_Jungle_Target, UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Staff_of_the_River_OnHit_Func009A takes nothing returns nothing
    set udg_Jungle_Target=GetEnumUnit()
    if ( Trig_Staff_of_the_River_OnHit_Func009Func002C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call SetUnitLifeBJ(GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + udg_Jungle_Heal[0] ))
    else
        call DoNothing()
    endif
endfunction

function Trig_Staff_of_the_River_OnHit_Actions takes nothing returns nothing
    set udg_MissileDestroy=true
    set udg_Jungle_Heal[0]=udg_Jungle_Heal[udg_MissileData]
    call SetUnitPositionLocFacingBJ(udg_MonkeyKing, udg_MissilePosition, udg_Jungle_Angle)
    call AddSpecialEffectLocBJ(udg_MissilePosition, "war3mapImported\\Culling Slash.mdx")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.50)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //                                                                                                     
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(425.00, GetUnitLoc(udg_MissileSource)), function Trig_Staff_of_the_River_OnHit_Func009A)
endfunction

function InitTrig_Staff_of_the_River_OnHit takes nothing returns nothing
    set gg_trg_Staff_of_the_River_OnHit=CreateTrigger()
    call TriggerAddCondition(gg_trg_Staff_of_the_River_OnHit, Condition(function Trig_Staff_of_the_River_OnHit_Conditions))
    call TriggerAddAction(gg_trg_Staff_of_the_River_OnHit, function Trig_Staff_of_the_River_OnHit_Actions)
endfunction

