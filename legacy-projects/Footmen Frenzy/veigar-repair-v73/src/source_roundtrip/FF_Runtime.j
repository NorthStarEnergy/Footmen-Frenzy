function BTM_AttachBook takes integer pn returns nothing
    local integer book
    if udg_base[pn] == null then
        return
    endif
    set book=BTM_BookFor(GetUnitTypeId(udg_base[pn]))
    if book != 0 then
        call UnitAddAbility(udg_base[pn], book)
    endif
endfunction

function BTM_OnUpgradeFinish takes nothing returns nothing
    // Update base variable has already re-pointed udg_base[] by the time this
    // runs: its trigger is created in FF_Editor_InitTriggers, ours in
    // FF_Editor_RunInitialization, and same-event triggers fire in creation order.
    if IsUnitType(GetTriggerUnit(), UNIT_TYPE_TOWNHALL) then
        call BTM_AttachBook(GetConvertedPlayerId(GetTriggerPlayer()))
    endif
endfunction

function BTM_OnCast takes nothing returns nothing
    local integer pn= GetConvertedPlayerId(GetTriggerPlayer())
    local integer tgt= BTM_TargetOf(GetSpellAbilityId())
    if tgt == 0 then
        return
    endif
    // Allied/shared-control players may select this base, but may not tech it.
    if GetOwningPlayer(GetTriggerUnit()) != GetTriggerPlayer() then
        return
    endif
    if udg_base[pn] == null then
        return
    endif
    if IsUnitAliveBJ(udg_base[pn]) != true then
        return
    endif
    // Open the gate just long enough for the order to be accepted. BUT_Tick
    // closes it again, and BUT_OnUpgradeFinish closes it on success, so a
    // cancelled or unaffordable upgrade cannot leave the buttons live.
    set BUT_quiet[pn]=true
    set BUT_armed[pn]=true
    set BUT_ticks[pn]=3
    call SetPlayerTechResearched(ConvertedPlayer(pn), 'R0TC', 1)
    call IssueImmediateOrderById(udg_base[pn], tgt)
endfunction

function BTM_Init takes nothing returns nothing
    local integer i= 1
    local trigger tCast= CreateTrigger()
    local trigger tDone= CreateTrigger()

    call TriggerRegisterAnyUnitEventBJ(tCast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddAction(tCast, function BTM_OnCast)
    call TriggerRegisterAnyUnitEventBJ(tDone, EVENT_PLAYER_UNIT_UPGRADE_FINISH)
    call TriggerAddAction(tDone, function BTM_OnUpgradeFinish)

    loop
        exitwhen i > 12
        set BUT_quiet[i]=false
        call BTM_AttachBook(i)
        set i=i + 1
    endloop

    set tCast=null
    set tDone=null
endfunction

function LGOLD_Stop takes integer pn returns nothing
    set LGOLD_active[pn]=false
    set LGOLD_ticks[pn]=0
endfunction

function LGOLD_TellOne takes player ally,string msg returns nothing
    if ally == null then
        return
    endif
    if not udg_player_active[GetConvertedPlayerId(ally)] then
        return
    endif
    call DisplayTimedTextToPlayer(ally, 0, 0, LGOLD_SHOW_SECONDS, msg)
endfunction

function LGOLD_Tell takes integer pn returns nothing
    local string msg
    set msg="|cffffcc00" + GetPlayerName(ConvertedPlayer(pn)) + "|r left with |cffffcc00" + I2S(GetPlayerState(ConvertedPlayer(pn), PLAYER_STATE_RESOURCE_GOLD)) + "|r gold. Destroy their base to split it."
    call LGOLD_TellOne(udg_ally1[pn] , msg)
    call LGOLD_TellOne(udg_ally2[pn] , msg)
    set msg=null
endfunction

function LGOLD_Sweep takes nothing returns nothing
    local integer pn= 1
    loop
        exitwhen pn > 12
        if LGOLD_active[pn] then
            // Trig_BASE_destroy_Actions nulls udg_base[] the moment the base
            // dies, which is also when the gold is paid out - nothing left to
            // report. Self-terminating, so the four payout sites stay untouched.
            if udg_base[pn] == null then
                call LGOLD_Stop(pn)
            else
                set LGOLD_ticks[pn]=LGOLD_ticks[pn] - 1
                if LGOLD_ticks[pn] <= 0 then
                    set LGOLD_ticks[pn]=LGOLD_PERIOD_SECONDS
                    call LGOLD_Tell(pn)
                endif
            endif
        endif
        set pn=pn + 1
    endloop
endfunction

function LGOLD_Watch takes integer pn returns nothing
    set LGOLD_active[pn]=true
    set LGOLD_ticks[pn]=1
endfunction

function LGOLD_Init takes nothing returns nothing
    local integer i= 1
    loop
        exitwhen i > 12
        set LGOLD_active[i]=false
        set LGOLD_ticks[i]=0
        set i=i + 1
    endloop
    set LGOLD_timer=CreateTimer()
    call TimerStart(LGOLD_timer, 1.00, true, function LGOLD_Sweep)
endfunction

