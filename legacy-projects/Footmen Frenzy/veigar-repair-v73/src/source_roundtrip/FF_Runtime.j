function InitTrig_eight_mass_bonus takes nothing returns nothing
    set gg_trg_eight_mass_bonus=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_eight_mass_bonus, udg_spawnMassTimer)
    call TriggerAddCondition(gg_trg_eight_mass_bonus, Condition(function Trig_eight_mass_bonus_Conditions))
    call TriggerAddAction(gg_trg_eight_mass_bonus, function Trig_eight_mass_bonus_Actions)
endfunction

function Trig_Footmen_Level_2_Actions takes nothing returns nothing
    // Footmen spawn as Level 2 again:
    set udg_Footmen_Is_Level_2=true
    call DisplayTextToForce(udg_all_players, "TRIGSTR_7208")
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_Footmen_Level_2 takes nothing returns nothing
    set gg_trg_Footmen_Level_2=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_Footmen_Level_2, 600.00)
    call TriggerAddAction(gg_trg_Footmen_Level_2, function Trig_Footmen_Level_2_Actions)
endfunction

