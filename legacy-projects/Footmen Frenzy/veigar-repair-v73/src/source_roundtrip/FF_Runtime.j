function FFGS_LivingSpawnFilter takes nothing returns boolean
    local unit u= GetFilterUnit()
    local boolean result= IsUnitAliveBJ(u) and udg_Is_A_Spawn[GetUnitUserData(u)]
    set u=null
    return result
endfunction

function FFGS_CountLivingSpawns takes player whichPlayer returns integer
    local integer n
    call GroupEnumUnitsOfPlayer(ffgs_count_group, whichPlayer, Condition(function FFGS_LivingSpawnFilter))
    set n=BlzGroupGetSize(ffgs_count_group)
    call GroupClear(ffgs_count_group)
    return n
endfunction

function FFGS_CountLivingOfType takes integer unitId,player whichPlayer returns integer
    local integer n
    local integer i=0
    local unit u
    set bj_livingPlayerUnitsTypeId=unitId
    call GroupEnumUnitsOfPlayer(ffgs_count_group, whichPlayer, filterLivingPlayerUnitsOfTypeId)
    set n=BlzGroupGetSize(ffgs_count_group)
    loop
        exitwhen i >= F35_MassPoolCount
        set u=F35_MassPool[i]
        if GetUnitTypeId(u) == unitId and GetWidgetLife(u) > 0.405 and GetOwningPlayer(u) == whichPlayer and not IsUnitInGroup(u, ffgs_count_group) then
            set n=n + 1
        endif
        set i=i + 1
    endloop
    set u=null
    call GroupClear(ffgs_count_group)
    return n
endfunction

function FFGS_ComputeStats takes integer idx,integer pn returns nothing
    local player p= ConvertedPlayer(pn)
    local integer lvl

    set udg_unit_att_num_dice_actual[idx]=( udg_unit_att_num_dice[idx] + GetPlayerTechCountSimple('Rhme', p) )
    set udg_unit_armor_actual[idx]=( udg_unit_armor[idx] + ( I2R(GetPlayerTechCountSimple('Rhar', p)) * 2.00 ) )
    set udg_unit_att_actual[idx]=udg_unit_att_base[idx]

    if ffgs_obs_enabled[idx] and ( GetPlayerTechCountSimple('Robs', p) > 0 ) then
        set lvl=GetPlayerTechCountSimple('Robs', p)
        if lvl == 1 then
            set udg_unit_HP_actual[idx]=( udg_unit_HP[idx] + 100 )
            set udg_unit_att_actual[idx]=( udg_unit_att_actual[idx] + 3 )
        else
            set udg_unit_HP_actual[idx]=( ( udg_unit_HP[idx] + 100 ) + ( 45 * ( lvl - 1 ) ) )
            set udg_unit_att_actual[idx]=( ( udg_unit_att_actual[idx] + 3 ) + ( 2 * ( lvl - 1 ) ) )
        endif
    else
        if ffgs_han_enabled[idx] and ( GetPlayerTechCountSimple('Rhan', p) > 0 ) then
            set lvl=GetPlayerTechCountSimple('Rhan', p)
            if lvl == 1 then
                set udg_unit_HP_actual[idx]=( udg_unit_HP[idx] + 100 )
            else
                set udg_unit_HP_actual[idx]=( ( udg_unit_HP[idx] + 100 ) + ( ffgs_han_hp_per_level[idx] * ( lvl - 1 ) ) )
            endif
        else
            set udg_unit_HP_actual[idx]=udg_unit_HP[idx]
        endif
    endif

    if ffgs_r004_enabled[idx] and ( GetPlayerTechCountSimple('R004', p) > 0 ) then
        set lvl=GetPlayerTechCountSimple('R004', p)
        if lvl == 1 then
            set udg_unit_range_actual[idx]=( udg_unit_range[idx] + 100.00 )
        else
            set udg_unit_range_actual[idx]=( ( udg_unit_range[idx] + 100.00 ) + ( 55.00 * ( I2R(lvl) - 1 ) ) )
        endif
    else
        set udg_unit_range_actual[idx]=udg_unit_range[idx]
    endif

    set p=null
endfunction

function FFR7_MassSpeedExpire takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer key=GetHandleId(t)
    local unit u=LoadUnitHandle(FFR7_MassSpeedHash, key, 0)
    if u != null and GetUnitTypeId(u) != 0 then
        call SetUnitMoveSpeed(u, LoadReal(FFR7_MassSpeedHash, key, 1))
    endif
    call FlushChildHashtable(FFR7_MassSpeedHash, key)
    call DestroyTimer(t)
    set u=null
    set t=null
endfunction

function FFR7_ApplyMassSpeed takes unit u returns nothing
    local timer t
    local integer key
    if u == null or not udg_mass_active or udg_mode_no_mass or IsUnitHidden(u) then
        return
    endif
    if GetUnitTypeId(u) != 'hfoo' and GetUnitTypeId(u) != 'h060' then
        return
    endif
    if FFR7_MassSpeedHash == null then
        set FFR7_MassSpeedHash=InitHashtable()
    endif
    set t=CreateTimer()
    set key=GetHandleId(t)
    call SaveUnitHandle(FFR7_MassSpeedHash, key, 0, u)
    call SaveReal(FFR7_MassSpeedHash, key, 1, GetUnitMoveSpeed(u))
    call SetUnitMoveSpeed(u, GetUnitMoveSpeed(u) * 1.30)
    call TimerStart(t, 6.00, false, function FFR7_MassSpeedExpire)
    set t=null
endfunction

function MF_SetAttackRange takes unit u, real desired returns nothing
    local real primary = BlzGetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 0)
    local real secondary = BlzGetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1)
    call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1, desired - primary + secondary)
endfunction

function FFGS_ApplyUnit takes unit u, integer idx, integer pn returns nothing
    if u == null then
        return
    endif
    // xmas
    if ffgs_xmas_enabled[idx] and ( udg_xmas[pn] == true ) then
        call UnitAddAbility(u, 'A0DD')
    endif
    // stats
    set udg_Is_A_Spawn[GetUnitUserData(u)] = true
    call BlzSetUnitArmor(u, udg_unit_armor_actual[idx])
    call BlzSetUnitMaxHP(u, R2I(( I2R(udg_unit_HP_actual[idx]) * udg_hp_buff )))
    call BlzSetUnitRealField(u, UNIT_RF_HP, GetUnitState(u, UNIT_STATE_MAX_LIFE))
    call BlzSetUnitIntegerField(u, UNIT_IF_DEFENSE_TYPE, udg_unit_armor_type[idx])
    call BlzSetUnitBaseDamage(u, udg_unit_att_actual[idx], 0)
    call BlzSetUnitDiceNumber(u, udg_unit_att_num_dice_actual[idx], 0)
    call BlzSetUnitDiceSides(u, udg_unit_att_dice_sides[idx], 0)
    call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, udg_unit_att_CD[idx])
    call MF_SetAttackRange(u, udg_unit_range_actual[idx])
    call BlzSetUnitIntegerField(u, UNIT_IF_LEVEL, udg_unit_level[idx])
    if udg_mode_overdrive then

    endif
    // bounty
    call BlzSetUnitIntegerField(u, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, udg_unit_bounty_base[idx])
    call BlzSetUnitIntegerField(u, UNIT_IF_GOLD_BOUNTY_AWARDED_NUMBER_OF_DICE, udg_unit_bounty_num_dice[idx])
    call BlzSetUnitIntegerField(u, UNIT_IF_GOLD_BOUNTY_AWARDED_SIDES_PER_DIE, udg_unit_bounty_dice_sides[idx])
    call FFR7_ApplyMassSpeed(u)
    // footmen - invul premass
    if ffgs_footmen_rules[idx] and ( udg_spawnprotection == true ) then
        call UnitAddAbility(u, 'Avul')
    endif
    // Non-footmen send before mass; footmen wait for Mass START.
    if udg_mode_overdrive and ( ( not ffgs_footmen_rules[idx] ) or ( udg_mass_active == true ) ) and ( udg_autosend[pn] == true ) then
        call IssuePointOrder(u, "attack", ffgs_center_x, ffgs_center_y)
    elseif ffgs_autosend_enabled[idx] and ( ( not ffgs_footmen_rules[idx] ) or ( udg_mass_active == true ) ) and ( udg_autosend[pn] == true ) and ( ( ffgs_mass_mode == false ) or ( udg_mode_no_mass == false ) ) then
        call IssuePointOrder(u, "attack", ffgs_center_x, ffgs_center_y)
    else
        call IssueImmediateOrder(u, "stop")
    endif
    // footmen level before 8 minutes
    if ffgs_force_level_two[idx] then
        if ( udg_Footmen_Is_Level_2 == false ) and ffgs_footmen_rules[idx] then
            call BlzSetUnitIntegerField(u, UNIT_IF_LEVEL, 1)
        else
            call BlzSetUnitIntegerField(u, UNIT_IF_LEVEL, 2)
        endif
        if ( udg_Footmen_Is_Level_2 == false ) and ( udg_mode_overdrive == true ) and ffgs_footmen_rules[idx] then
            call BlzSetUnitIntegerField(u, UNIT_IF_LEVEL, 1)
        endif
    endif
endfunction

function F35_MassEnabled takes nothing returns boolean
    return udg_mode_pub and not udg_mode_inhouse and not udg_mode_no_mass
endfunction

function F35_StageFootman takes unit u, integer pn returns nothing
    local integer team=(pn - 1) / 3
    local integer slot=ModuloInteger(pn - 1, 3)
    local integer n=F35_PlayerStaged[pn]
    local real along=I2R(slot * 7 + ModuloInteger(n, 7)) * 48.0
    local real depth=I2R(n / 7) * 32.0
    local real x=128.0 + along + depth
    local real y=1088.0 - along + depth
    if team == 0 or team == 3 then
        set x=-x
    endif
    if team == 2 or team == 3 then
        set y=-y
    endif
    call ShowUnit(u, false)
    call PauseUnit(u, true)
    call SetUnitInvulnerable(u, true)
    call SetUnitUseFood(u, false)
    call SetUnitPathing(u, false)
    call SetUnitX(u, ffgs_center_x + x)
    call SetUnitY(u, ffgs_center_y + y)
    set F35_PlayerStaged[pn]=n + 1
    set F35_MassPool[F35_MassPoolCount]=u
    set F35_MassPoolCount=F35_MassPoolCount + 1
endfunction

function F35_ReleaseMass takes nothing returns nothing
    local integer i=0
    local integer pn
    local unit u
    if F35_MassReleased then
        return
    endif
    set F35_MassReleased=true
    loop
        exitwhen i >= F35_MassPoolCount
        set u=F35_MassPool[i]
        set pn=GetPlayerId(GetOwningPlayer(u)) + 1
        if GetUnitTypeId(u) != 0 and GetWidgetLife(u) > 0.405 and pn >= 1 and pn <= 12 and udg_player_active[pn] and IsUnitAliveBJ(udg_base[pn]) then
            call FFGS_ComputeStats(0, pn)
            call FFGS_ApplyUnit(u, 0, pn)
            call SetUnitPathing(u, true)
            call SetUnitUseFood(u, true)
            call SetUnitInvulnerable(u, false)
            call UnitRemoveAbility(u, 'Avul')
            call ShowUnit(u, true)
            call FFR7_ApplyMassSpeed(u)
            call PauseUnit(u, false)
            if udg_autosend[pn] then
                call IssuePointOrder(u, "attack", ffgs_center_x, ffgs_center_y)
            endif
        else
            call RemoveUnit(u)
        endif
        set F35_MassPool[i]=null
        set i=i + 1
    endloop
    set F35_MassPoolCount=0
    set u=null
endfunction

function FFGS_SpawnForPlayer takes integer idx, integer pn, integer count returns nothing
    local player p = ConvertedPlayer(pn)
    local real x = GetUnitX(udg_base[pn])
    local real y = GetUnitY(udg_base[pn])
    local integer i = 1
    local boolean stage=idx == 0 and not F35_MassReleased and F35_MassEnabled()

    loop
        exitwhen i > count
        set ffgs_new_unit[i] = CreateUnit(p, udg_spawn_unit[idx], x, y, bj_UNIT_FACING)
        if stage then
            call F35_StageFootman(ffgs_new_unit[i], pn)
        endif
        set i = i + 1
    endloop

    call FFGS_ComputeStats(idx, pn)

    set i = 1
    loop
        exitwhen i > count
        call FFGS_ApplyUnit(ffgs_new_unit[i], idx, pn)
        set ffgs_new_unit[i] = null
        set i = i + 1
    endloop

    set p = null
endfunction

function FFGS_PlayerEligible takes integer idx,integer pn,integer count returns boolean
    if count <= 0 then
        return false
    endif
    if udg_unit_production[pn] != true then
        return false
    endif
    if IsUnitAliveBJ(udg_base[pn]) != true then
        return false
    endif
    if GetUnitTypeId(udg_base[pn]) != udg_base_type[idx] then
        return false
    endif
    if ffgs_spawn_enabled_player[51 * pn + idx] == false then
        return false
    endif
    // RC5 allows a full wave while existing units of this type are at most 60.
    if FFGS_CountLivingOfType(udg_spawn_unit[idx] , ConvertedPlayer(pn)) > ffgs_unit_type_limit then
        return false
    endif
    return true
endfunction

function FFGS_ProcessIndex takes integer idx returns nothing
    local integer pn= 1
    loop
        exitwhen pn > ffgs_player_batch
        if FFGS_PlayerEligible(idx , pn , udg_number_of_spawned_units[pn]) then
            call FFGS_SpawnForPlayer(idx , pn , udg_number_of_spawned_units[pn])
        endif
        set pn=pn + 1
    endloop
    // Preserve the legacy loop index for other existing callers.
    set udg_X_playernumber=ffgs_player_batch + 1
endfunction

function FFGS_Tick takes nothing returns nothing
    local integer idx= 0
    loop
        exitwhen idx > 50
        if ffgs_spawn_ticks[idx] > 0 then
            set ffgs_spawn_countdown[idx]=ffgs_spawn_countdown[idx] - 1
            if ffgs_spawn_countdown[idx] <= 0 then
                set ffgs_spawn_countdown[idx]=ffgs_spawn_ticks[idx]
                if ffgs_spawn_enabled[idx] and ffgs_spawn_unlocked[idx] and ( udg_balanced == false ) then
                    call FFGS_ProcessIndex(idx)
                endif
            endif
        endif
        set idx=idx + 1
    endloop
endfunction

function FFGS_MassBonusSpawn takes nothing returns nothing
    local integer pn= 1
    local integer count
    set udg_Mass_Cycle=( udg_Mass_Cycle + 1 )
    if udg_Mass_Bonus_Spawns[udg_Mass_Cycle] == 0 then
        call PauseTimer(udg_spawnMassTimer)
    endif
    if ffgs_mass_bonus_enabled == false then
        return
    endif
    set count=udg_Mass_Bonus_Spawns[udg_Mass_Cycle]
    set ffgs_mass_mode=true
    loop
        exitwhen pn > ffgs_player_batch
        if FFGS_PlayerEligible(0 , pn , count) then
            call FFGS_SpawnForPlayer(0 , pn , count)
        endif
        set pn=pn + 1
    endloop
    set ffgs_mass_mode=false
    set udg_X_playernumber=ffgs_player_batch + 1
endfunction

function FFGS_UnlockPhase takes integer phase returns nothing
    local integer idx= 0
    if phase <= ffgs_max_phase_unlocked then
        return
    endif
    set ffgs_max_phase_unlocked=phase
    loop
        exitwhen idx > 50
        if ( ffgs_spawn_unlocked[idx] == false ) and ( ffgs_spawn_unlock_phase[idx] > 0 ) and ( ffgs_spawn_unlock_phase[idx] <= phase ) then
            set ffgs_spawn_unlocked[idx]=true
            if ffgs_unlock_free_running_phase == false then
                set ffgs_spawn_countdown[idx]=ffgs_spawn_ticks[idx]
            endif
        endif
        set idx=idx + 1
    endloop
endfunction

function FFGS_InitBehaviourTables takes nothing returns nothing
    local integer i= 0
    loop
        exitwhen i > 50
        set ffgs_xmas_enabled[i]=( ( i <= 20 ) or ( i >= 31 ) )
        set ffgs_obs_enabled[i]=false
        set ffgs_han_enabled[i]=false
        set ffgs_han_hp_per_level[i]=45
        set ffgs_r004_enabled[i]=false
        set ffgs_force_level_two[i]=( ( i <= 13 ) or ( ( i >= 31 ) and ( i <= 43 ) ) )
        set ffgs_autosend_enabled[i]=( ( i <= 13 ) or ( ( i >= 31 ) and ( i <= 43 ) ) )
        set ffgs_footmen_rules[i]=( i == 0 )
        set i=i + 1
    endloop

    set ffgs_han_enabled[1]=true
    set ffgs_han_enabled[2]=true
    set ffgs_han_enabled[14]=true
    set ffgs_han_enabled[34]=true
    set ffgs_han_enabled[35]=true
    set ffgs_han_enabled[49]=true

    set ffgs_obs_enabled[6]=true
    set ffgs_obs_enabled[10]=true
    set ffgs_obs_enabled[11]=true
    set ffgs_obs_enabled[12]=true
    set ffgs_obs_enabled[24]=true
    set ffgs_obs_enabled[25]=true
    set ffgs_obs_enabled[29]=true
    set ffgs_obs_enabled[30]=true
    set ffgs_obs_enabled[40]=true
    set ffgs_obs_enabled[41]=true
    set ffgs_obs_enabled[42]=true
    set ffgs_obs_enabled[43]=true

    set ffgs_r004_enabled[3]=true
    set ffgs_r004_enabled[4]=true
    set ffgs_r004_enabled[5]=true
    set ffgs_r004_enabled[15]=true
    set ffgs_r004_enabled[32]=true
    set ffgs_r004_enabled[33]=true
    set ffgs_r004_enabled[46]=true
endfunction

function FFGS_SchedulerStart takes nothing returns nothing
    local integer idx = 0
    local integer pn = 1
    local integer t

    if ffgs_scheduler_started then
        return
    endif
    if ffgs_scheduler_enabled == false then
        return
    endif
    set ffgs_scheduler_started = true

    set ffgs_center_x = GetRectCenterX(GetPlayableMapRect())
    set ffgs_center_y = GetRectCenterY(GetPlayableMapRect())
    set ffgs_count_group = CreateGroup()
    if ( ffgs_player_batch < 1 ) or ( ffgs_player_batch > 12 ) then
        set ffgs_player_batch = 12
        set ffgs_validation_errors = ffgs_validation_errors + 1
    endif
    if ffgs_tick_seconds <= 0.00 then
        set ffgs_tick_seconds = 0.25
        set ffgs_validation_errors = ffgs_validation_errors + 1
    endif

    call FFGS_InitBehaviourTables()

    loop
        exitwhen pn > 12
        set idx = 0
        loop
            exitwhen idx > 50
            set ffgs_spawn_enabled_player[51 * pn + idx] = true
            set idx = idx + 1
        endloop

        if udg_mode_overdrive then
        endif
        set pn = pn + 1
    endloop
    set idx = 0

    loop
        exitwhen idx > 50
        if ( udg_spawn_unit[idx] == 0 ) or ( udg_base_type[idx] == 0 ) then
            set ffgs_spawn_enabled[idx] = false
            set ffgs_validation_errors = ffgs_validation_errors + 1
        endif
        if ffgs_spawn_interval[idx] <= 0.00 then
            set ffgs_spawn_enabled[idx] = false
            set ffgs_validation_errors = ffgs_validation_errors + 1
        endif
        if ffgs_spawn_enabled[idx] then
            set t = R2I(( ffgs_spawn_interval[idx] / ffgs_tick_seconds ) + 0.5)
            if t < 1 then
                set t = 1
            endif
        else
            set t = 0
        endif
        set ffgs_spawn_ticks[idx] = t
        set ffgs_spawn_countdown[idx] = t
        set idx = idx + 1
    endloop

    if ffgs_legacy_triggers_disabled then
        call DisableTrigger(gg_trg_eight_start_timer)
        call DisableTrigger(gg_trg_eight)
        call DisableTrigger(gg_trg_five)
        call DisableTrigger(gg_trg_ten)
        call DisableTrigger(gg_trg_eight_new)
        call DisableTrigger(gg_trg_ten_new)
        call DisableTrigger(gg_trg_twelve_new)
        call PauseTimer(udg_spawnTimer)
    endif

    set ffgs_scheduler_timer = CreateTimer()
    call TimerStart(ffgs_scheduler_timer, ffgs_tick_seconds, true, function FFGS_Tick)
endfunction

function BUT_Revoke takes integer pn returns nothing
    if BUT_isAI[pn] then
        return
    endif
    if BUT_armed[pn] then
        set BUT_armed[pn]=false
        set BUT_ticks[pn]=0
        call SetPlayerTechResearched(ConvertedPlayer(pn), 'R0TC', 0)
        if BUT_quiet[pn] then
            set BUT_quiet[pn]=false
        else
            call DisplayTimedTextToPlayer(ConvertedPlayer(pn), 0, 0, 8, "|cffffcc00Base tech options re-locked.|r Type -tech to unlock.")
        endif
    endif
endfunction

function BUT_Tick takes nothing returns nothing
    local integer pn= 1
    loop
        exitwhen pn > 12
        if BUT_armed[pn] then
            set BUT_ticks[pn]=BUT_ticks[pn] - 1
            if BUT_ticks[pn] <= 0 then
                call BUT_Revoke(pn)
            endif
        endif
        set pn=pn + 1
    endloop
endfunction

function BUT_OnChat takes nothing returns nothing
    local integer pn= GetConvertedPlayerId(GetTriggerPlayer())
    if BUT_isAI[pn] then
        return
    endif
    if BUT_armed[pn] then
        call BUT_Revoke(pn)
        return
    endif
    set BUT_armed[pn]=true
    set BUT_ticks[pn]=BUT_window
    call SetPlayerTechResearched(GetTriggerPlayer(), 'R0TC', 1)
    call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 8, "|cff00ff00Base tech options unlocked for " + I2S(BUT_window) + "s.|r Type -tech again to re-lock.")
endfunction

function BUT_OnUpgradeFinish takes nothing returns nothing
    if IsUnitType(GetTriggerUnit(), UNIT_TYPE_TOWNHALL) then
        call BUT_Revoke(GetConvertedPlayerId(GetTriggerPlayer()))
    endif
endfunction

function BUT_Init takes nothing returns nothing
    local integer i= 0
    local trigger tChat= CreateTrigger()
    local trigger tDone= CreateTrigger()

    loop
        exitwhen i > 11
        call TriggerRegisterPlayerChatEvent(tChat, Player(i), "-tech", true)
        set i=i + 1
    endloop
    call TriggerAddAction(tChat, function BUT_OnChat)

    call TriggerRegisterAnyUnitEventBJ(tDone, EVENT_PLAYER_UNIT_UPGRADE_FINISH)
    call TriggerAddAction(tDone, function BUT_OnUpgradeFinish)

    set i=1
    loop
        exitwhen i > 12
        set BUT_armed[i]=false
        set BUT_ticks[i]=0
        set BUT_isAI[i]=udg_AI_player[i]
        if BUT_isAI[i] then
            call SetPlayerTechResearched(ConvertedPlayer(i), 'R0TC', 1)
        endif
        set i=i + 1
    endloop

    set BUT_tickTimer=CreateTimer()
    call TimerStart(BUT_tickTimer, 1.00, true, function BUT_Tick)
    set tChat=null
    set tDone=null
endfunction

