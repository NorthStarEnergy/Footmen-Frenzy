function Trig_UNIT_Clockwerk_Goblin_Kaboom_Actions takes nothing returns nothing
    set udg_temp_playernumber=GetConvertedPlayerId(GetTriggerPlayer())
    set udg_temp_casting_unit=GetSpellAbilityUnit()
    set udg_temp_unit=GetSpellTargetUnit()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_casting_unit)
    // start action
    if ( Trig_UNIT_Clockwerk_Goblin_Kaboom_Func007C() ) then
        call UnitAddAbilityBJ('A0RC', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_UNIT_Clockwerk_Goblin_Kaboom_Func008C() ) then
        call UnitAddAbilityBJ('A0RD', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_UNIT_Clockwerk_Goblin_Kaboom_Func009C() ) then
        call UnitAddAbilityBJ('Asdg', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_UNIT_Clockwerk_Goblin_Kaboom_Func010C() ) then
        call UnitAddAbilityBJ('Asd2', udg_temp_unit)
    else
        call DoNothing()
    endif
    if ( Trig_UNIT_Clockwerk_Goblin_Kaboom_Func011C() ) then
        call UnitAddAbilityBJ('Asd3', udg_temp_unit)
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_temp_unit, "selfdestruct", udg_temp_point_caster)
    call AddSpecialEffectLocBJ(udg_temp_point_caster, "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_temp_point_caster)
endfunction

