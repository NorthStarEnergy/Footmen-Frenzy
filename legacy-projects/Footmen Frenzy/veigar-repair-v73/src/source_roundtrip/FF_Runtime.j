function Trig_Start_SD_Actions takes nothing returns nothing
    set udg_Host_Picked_A_Game_Mode=true
    //                                                                                                                                     
    call EnableTrigger(gg_trg_swap_command)
    call EnableTrigger(gg_trg_swap_execute)
    set udg_selected_mode=3
    if ( Trig_Start_SD_Func006C() ) then
        set udg_game_mode_display[3]=" MM"
        call DisplayTextToForce(udg_all_players, "TRIGSTR_13268")
    else
        set udg_game_mode_display[3]=" SD"
        call DisplayTextToForce(udg_all_players, "TRIGSTR_13285")
        call DisplayTextToForce(udg_all_players, "TRIGSTR_13416")
    endif
    call EnableSelect(true, true)
    if udg_timer_window_voting != null then
        call TimerDialogDisplayBJ(false, udg_timer_window_voting)
    endif
    call StartTimerBJ(udg_timer_repick, false, 220.00)
    call CreateTimerDialogBJ(udg_timer_repick, "TRIGSTR_13432")
    set udg_timer_window_repick=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_timer_window_repick)
    // VISIBILITY
    set udg_X=1
    loop
        exitwhen udg_X > 12
        call FogModifierStop(udg_Tavern_Visibility[udg_X])
        set udg_X=udg_X + 1
    endloop
    call ForForce(udg_team[1], function Trig_Start_SD_Func015A)
    call ForForce(udg_team[2], function Trig_Start_SD_Func016A)
    call ForForce(udg_team[3], function Trig_Start_SD_Func017A)
    call ForForce(udg_team[4], function Trig_Start_SD_Func018A)
    // ADD HEROS INTO TAVERNS
    set udg_temp_int=GetRandomInt(1, 2)
    if ( Trig_Start_SD_Func021C() ) then
        set udg_hero_category[90]=0
    else
        set udg_hero_category[85]=0
    endif
    if ( Trig_Start_SD_Func022C() ) then
        // CHANGE SOME OF THE HEROS CATEGORIES IF PRIV MODE
        if ( Trig_Start_SD_Func022Func029C() ) then
            set udg_numberofSDcategories=6
        else
            set udg_numberofSDcategories=18
        endif
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            call ForGroupBJ(GetUnitsOfTypeIdAll(udg_hero_type[udg_X]), function Trig_Start_SD_Func022Func030Func001A)
            set udg_X=udg_X + 1
        endloop
        // Real Shops
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[1], 130.00)
        set udg_real_shop[1]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[2], 130.00)
        set udg_real_shop[2]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[3], 310.00)
        set udg_real_shop[3]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[4], 310.00)
        set udg_real_shop[4]=GetLastCreatedUnit()
        // ADD HEROS INTO TAVERNS
        if ( Trig_Start_SD_Func022Func041C() ) then
            set udg_mm_combo_id=GetRandomInt(0, udg_mm_max)
            set udg_X=1
            loop
                exitwhen udg_X > 4
                call MF_StockUnitBJ(udg_hero_type[udg_mm_hero_1[udg_mm_combo_id]], udg_real_shop[udg_X], 1, 1)
                call MF_StockUnitBJ(udg_hero_type[udg_mm_hero_2[udg_mm_combo_id]], udg_real_shop[udg_X], 1, 1)
                call MF_StockUnitBJ(udg_hero_type[udg_mm_hero_3[udg_mm_combo_id]], udg_real_shop[udg_X], 1, 1)
                set udg_X=udg_X + 1
            endloop
        else
            // CarryTav: second altar per team for categories 12-18
            if ( udg_numberofSDcategories >= 12 ) then
                call CarryTav_CreateAltars()
            endif
            set udg_X=1
            loop
                exitwhen udg_X > 4
                set FF_AutoPick_count[udg_X]=0
                set udg_X=udg_X + 1
            endloop
            set udg_temp_int=1
            loop
                exitwhen udg_temp_int > 4
                set udg_X_category=1
                loop
                    exitwhen udg_X_category > udg_numberofSDcategories
                    call ForGroupBJ(GetRandomSubGroup(1, udg_hero_category_group[udg_X_category]), function Trig_Start_SD_Func022Func041Func001Func001Func001A)
                    set udg_X_category=udg_X_category + 1
                endloop
                set udg_temp_int=udg_temp_int + 1
            endloop
        endif
        set udg_temp_unitgroup=GetUnitsInRectOfPlayer(gg_rct_ALL_HERO, Player(PLAYER_NEUTRAL_PASSIVE))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_SD_Func022Func043A)
        call DestroyGroup(udg_temp_unitgroup)
        set udg_X=1
        loop
            exitwhen udg_X > udg_numberofSDcategories
            call DestroyGroup(udg_hero_category_group[udg_X])
            set udg_X=udg_X + 1
        endloop
        call DestroyGroup(udg_temp_unitgroup)
        call DestroyTrigger(GetTriggeringTrigger())
    else
        call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ALL_HERO, Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_Start_SD_Func022Func002A)
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            call CreateNUnitsAtLoc(1, udg_hero_type[udg_X], Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_EXILE), bj_UNIT_FACING)
            set udg_X=udg_X + 1
        endloop
        set udg_all_heros=GetUnitsInRectOfPlayer(gg_rct_ALL_HERO, Player(PLAYER_NEUTRAL_PASSIVE))
        set udg_total_hero_count=CountUnitsInGroup(udg_all_heros)
        set udg_X=1
        loop
            exitwhen udg_X > udg_total_hero_count
            call ForGroupBJ(GetRandomSubGroup(1, udg_all_heros), function Trig_Start_SD_Func022Func006Func001A)
            set udg_X=udg_X + 1
        endloop
        // Real Shops
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[1], 130.00)
        set udg_real_shop[1]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[2], 130.00)
        set udg_real_shop[2]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[3], 310.00)
        set udg_real_shop[3]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'n02I', Player(PLAYER_NEUTRAL_PASSIVE), udg_SDtavern[4], 310.00)
        set udg_real_shop[4]=GetLastCreatedUnit()
        set udg_X=1
        loop
            exitwhen udg_X > 4
            call GroupAddUnitSimple(udg_real_shop[udg_X], udg_realshops)
            set udg_X=udg_X + 1
        endloop
        // Team 1
        set udg_X=1
        loop
            exitwhen udg_X > 11
            call MF_StockUnitBJ(udg_hero[udg_X], udg_real_shop[1], 1, 1)
            set udg_X=udg_X + 1
        endloop
        // Team 2
        set udg_X=12
        loop
            exitwhen udg_X > 23
            call MF_StockUnitBJ(udg_hero[udg_X], udg_real_shop[2], 1, 1)
            set udg_X=udg_X + 1
        endloop
        // Team 3
        set udg_X=24
        loop
            exitwhen udg_X > 35
            call MF_StockUnitBJ(udg_hero[udg_X], udg_real_shop[3], 1, 1)
            set udg_X=udg_X + 1
        endloop
        // Team 4
        set udg_X=36
        loop
            exitwhen udg_X > 47
            call MF_StockUnitBJ(udg_hero[udg_X], udg_real_shop[4], 1, 1)
            set udg_X=udg_X + 1
        endloop
        // delete heros
        set udg_temp_unitgroup=GetUnitsInRectOfPlayer(gg_rct_ALL_HERO, Player(PLAYER_NEUTRAL_PASSIVE))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Start_SD_Func022Func027A)
    endif
    call DestroyGroup(udg_temp_unitgroup)
    call DestroyGroup(udg_temp_unitgroup2)
    call DestroyGroup(udg_temp_unitgroup3)
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

