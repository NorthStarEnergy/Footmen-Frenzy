    elseif clicked == udg_dlg_colossal_no then
        set udg_colossal_on=false
        set udg_wmd[2]="|cff00ffffColossals:|r |cffff0000Off|r"
        call FFMode_StartPrivateVote()
    endif
    set clicked=null
endfunction

