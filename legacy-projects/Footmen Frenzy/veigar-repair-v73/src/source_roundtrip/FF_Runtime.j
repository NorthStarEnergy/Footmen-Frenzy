    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] > 2 ) ) then
        return false
    endif
    if ( not ( udg_Guardian_FF_Level[udg_Guardian_FF_Index] <= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Func001Func003Func030C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Index == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Func001Func003C takes nothing returns boolean
    if ( not ( udg_Guardian_FF_Duration[udg_Guardian_FF_Loop] <= 0.01 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Force_Field_Loop_Actions takes nothing returns nothing
    set udg_Guardian_FF_Loop=1
    loop
        exitwhen udg_Guardian_FF_Loop > udg_Guardian_FF_Index
        set udg_Guardian_FF_Duration[udg_Guardian_FF_Loop]=( udg_Guardian_FF_Duration[udg_Guardian_FF_Loop] - 0.02 )
        //                                                                                                                    
        if ( Trig_Guardian_Force_Field_Loop_Func001Func003C() ) then
            // Disable Detonate:
            set udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])]=( udg_Guardian_FF_Count[GetUnitUserData(udg_Guardian_FF_Caster[udg_Guardian_FF_Loop])] - 1 )
            //                                                                                                                    
            set udg_Guardian_Integer[0] = 0
            loop
                exitwhen udg_Guardian_Integer[0] >= GFW_Count(udg_Guardian_FF_Level[udg_Guardian_FF_Loop])
                set udg_Guardian_Point[udg_Guardian_Integer[0]] = GFW_Point(udg_Guardian_FF_Loop, udg_Guardian_Integer[0])
                call CPP_Remove_Pathing(udg_Guardian_Point[udg_Guardian_Integer[0]], 75.6, PATHING_TYPE_ANY)
                call DestroyEffect(AddSpecialEffectLoc("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", udg_Guardian_Point[udg_Guardian_Integer[0]]))
                set udg_Guardian_Integer[0] = udg_Guardian_Integer[0] + 1
            endloop
            call TriggerExecute(gg_trg_Guardian_Force_Field_Damage)
            set udg_Guardian_Integer[0] = 0
            loop
                exitwhen udg_Guardian_Integer[0] >= GFW_Count(udg_Guardian_FF_Level[udg_Guardian_FF_Loop])
                call RemoveLocation(udg_Guardian_Point[udg_Guardian_Integer[0]])
                set udg_Guardian_Point[udg_Guardian_Integer[0]] = null
                set udg_Guardian_Integer[0] = udg_Guardian_Integer[0] + 1
            endloop
            // Transfer data:
            call RemoveLocation(udg_Guardian_FF_Point[udg_Guardian_FF_Loop])
            set udg_Guardian_FF_Point[udg_Guardian_FF_Loop]=udg_Guardian_FF_Point[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Duration[udg_Guardian_FF_Loop]=udg_Guardian_FF_Duration[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Angle[udg_Guardian_FF_Loop]=udg_Guardian_FF_Angle[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Level[udg_Guardian_FF_Loop]=udg_Guardian_FF_Level[udg_Guardian_FF_Index]
            set udg_Guardian_FF_Caster[udg_Guardian_FF_Loop]=udg_Guardian_FF_Caster[udg_Guardian_FF_Index]
            //                                                                                                                    
            // HASHTABLE:
            set udg_Guardian_Integer[0]=0
            loop
                exitwhen udg_Guardian_Integer[0] > 4
                set udg_DDE_Effect=LoadEffectHandleBJ(udg_Guardian_Integer[0], udg_Guardian_FF_Loop, udg_Guardian_FF_Hash)
                set udg_DDE_Duration=0.00
                set udg_DDE_Hide_Death_Animation=true
                call TriggerExecute(gg_trg_DDE_Destroy_Effect)
                //                                                                                                                    
                set udg_DDE_Effect=LoadEffectHandleBJ(udg_Guardian_Integer[0], udg_Guardian_FF_Index, udg_Guardian_FF_Hash)
                if udg_DDE_Effect != null then
                call SaveEffectHandleBJ(udg_DDE_Effect, udg_Guardian_Integer[0], udg_Guardian_FF_Loop, udg_Guardian_FF_Hash)
                endif
                set udg_Guardian_Integer[0]=udg_Guardian_Integer[0] + 1
            endloop
            //                                                                                                                    
            // Remove this instance from the loop:
            set udg_Guardian_FF_Index=( udg_Guardian_FF_Index - 1 )
            set udg_Guardian_FF_Loop=( udg_Guardian_FF_Loop - 1 )
            //                                                                                                                    
            if ( Trig_Guardian_Force_Field_Loop_Func001Func003Func030C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
            endif
        else
        endif
        set udg_Guardian_FF_Loop=udg_Guardian_FF_Loop + 1
    endloop
endfunction

