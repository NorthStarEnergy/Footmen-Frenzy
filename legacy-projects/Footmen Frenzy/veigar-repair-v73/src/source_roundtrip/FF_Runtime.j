function Trig_MODE_1v1_check_Actions takes nothing returns nothing
    set udg_temp_int=0
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_MODE_1v1_check_Func002Func001C() ) then
            set udg_temp_int=( udg_temp_int + 1 )
        else
        endif
        set udg_X=udg_X + 1
    endloop
    if ( Trig_MODE_1v1_check_Func003C() ) then
        set udg_mode_1v1=true
        call ConditionalTriggerExecute(gg_trg_MODE_1v1)
    else
    endif
endfunction

