function zoom__ApplyFog takes integer cameraDistance returns nothing
    call SetCameraField(CAMERA_FIELD_FARZ, 10000.00, 0.00)
    // Keep linear distance fog beyond the camera far plane, including default terrain fog.
    call SetTerrainFogEx(0, 10000.00, 11000.00, 0.00, 0.00, 0.00, 0.00)
endfunction

function zoom__Zoom takes integer cameraDistance,boolean withMessaging returns integer
    local boolean wasValid= false
    local integer previousCameraDistance= R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE))
    if ( previousCameraDistance == cameraDistance ) then
        if ( withMessaging ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Already at target zoom level")
        endif
    else

        if ( cameraDistance > zoom__gMaxDistance ) then
            set cameraDistance=zoom__gMaxDistance
        elseif ( cameraDistance < zoom__gMinDistance ) then
            set cameraDistance=zoom__gMinDistance
        else
            set wasValid=true
        endif

        if ( withMessaging and not ( wasValid ) ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Valid zoom range: " + I2S(zoom__gMinDistance) + " up to " + I2S(zoom__gMaxDistance))
        endif
    
        if ( withMessaging ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "New zoom level: " + I2S(cameraDistance))
        endif
        call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, cameraDistance, 0.00)
    endif
    call zoom__ApplyFog(cameraDistance)
    return cameraDistance
endfunction

function zoom__UpdateSliderLabel takes integer cameraDistance returns nothing
    call BlzFrameSetText(zoom__sliderLabel, I2S(cameraDistance))
endfunction

function zoom__UpdateLockButton takes player p returns nothing
    local integer playerId= GetPlayerId(p)
    if ( GetLocalPlayer() == p ) then
        call BlzFrameSetEnable(zoom__slider, not zoom__sliderLocked[playerId])
        if ( zoom__sliderLocked[playerId] ) then
            call BlzFrameSetText(zoom__lockLabel, "|cffff3030X|r")
        else
            call BlzFrameSetText(zoom__lockLabel, "|cffffffffX|r")
        endif
    endif
endfunction

function zoom__handleLockButton takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer playerId= GetPlayerId(p)
    set zoom__sliderLocked[playerId]=not zoom__sliderLocked[playerId]
    call zoom__UpdateLockButton(p)
    if ( GetLocalPlayer() == p ) then
        call BlzFrameSetEnable(zoom__lockButton, false)
        call BlzFrameSetEnable(zoom__lockButton, true)
    endif
    set p=null
endfunction

function zoom__Save takes integer cameraDistance returns nothing
    local integer file= s__File_open(zoom__gFileName)
    call s__File_write(file , I2S(cameraDistance))
    call s__File_close(file)
endfunction

function zoom__handleSegment takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer playerId= GetPlayerId(p)
    local integer cameraDistance
    if ( GetLocalPlayer() == p and not zoom__sliderLocked[playerId] ) then
        set cameraDistance=R2I(BlzGetTriggerFrameValue())
        set cameraDistance=zoom__Zoom(cameraDistance , false)
        call zoom__UpdateSliderLabel(cameraDistance)
        call zoom__Save(cameraDistance)
    endif
    set p=null
endfunction

function zoom__CreateSlider takes nothing returns nothing
    local framehandle gameUI= BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0)
    local framehandle minimap=BlzGetOriginFrame(ORIGIN_FRAME_MINIMAP, 0)
    local trigger sliderTrigger= CreateTrigger()
    local trigger lockTrigger= CreateTrigger()
    if ( not BlzLoadTOCFile("war3mapImported\\templates.toc") ) then
        call BJDebugMsg("|cffff0000Zoom UI failed to load templates.toc.|r")
    endif
    call BlzLoadTOCFile("MiniFootsUI.toc")
    set zoom__slider=BlzCreateFrame("MiniFootsZoomSlider", gameUI, 0, 0)
    set zoom__sliderLabel=BlzCreateFrame("EscMenuLabelTextTemplate", zoom__slider, 0, 0)
    call BlzFrameClearAllPoints(zoom__slider)
    call BlzFrameSetPoint(zoom__slider, FRAMEPOINT_LEFT, minimap, FRAMEPOINT_RIGHT, 0.033, 0.0)
    call BlzFrameSetSize(zoom__slider, 0.012, 0.095)
    call BlzFrameSetLevel(zoom__slider, 20)
    call BlzFrameSetPoint(zoom__sliderLabel, FRAMEPOINT_TOP, zoom__slider, FRAMEPOINT_BOTTOM, 0.0, -0.003)
    call BlzFrameSetEnable(zoom__sliderLabel, false)
    call BlzFrameSetTextColor(zoom__sliderLabel, 0xFFFFCC00)
    call BlzFrameSetFont(zoom__sliderLabel, "Fonts\\FRIZQT__.TTF", 0.009, 0)
    call BlzFrameSetSize(zoom__sliderLabel, 0.035, 0.012)
    call BlzFrameSetMinMaxValue(zoom__slider, I2R(zoom__gMinDistance), I2R(zoom__gMaxDistance))
    call BlzFrameSetStepSize(zoom__slider, 1.00)
    call BlzFrameSetEnable(zoom__slider, true)
    call BlzFrameSetVisible(zoom__slider, true)
    set zoom__lockButton=BlzCreateFrame("ScriptDialogButton", gameUI, 0, 0)
    call BlzFrameSetPoint(zoom__lockButton, FRAMEPOINT_BOTTOM, zoom__slider, FRAMEPOINT_TOP, 0.0, 0.003)
    call BlzFrameSetSize(zoom__lockButton, 0.025, 0.020)
    call BlzFrameSetLevel(zoom__lockButton, 21)
    call BlzFrameSetVisible(zoom__lockButton, true)
    call BlzFrameSetText(zoom__lockButton, "")
    set zoom__lockLabel=BlzCreateFrameByType("TEXT", "", zoom__lockButton, "", 0)
    call BlzFrameSetPoint(zoom__lockLabel, FRAMEPOINT_CENTER, zoom__lockButton, FRAMEPOINT_CENTER, 0.0, 0.0)
    call BlzFrameSetEnable(zoom__lockLabel, false)
    call BlzFrameSetSize(zoom__lockLabel, 0.010, 0.010)
    call BlzFrameSetTextAlignment(zoom__lockLabel, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(zoom__lockLabel, 0.55)
    call BlzFrameSetLevel(zoom__lockLabel, 11)
    call BlzFrameSetText(zoom__lockLabel, "|cffffffffX|r")
    call BlzTriggerRegisterFrameEvent(sliderTrigger, zoom__slider, FRAMEEVENT_SLIDER_VALUE_CHANGED)
    call TriggerAddAction(sliderTrigger, function zoom__handleSegment)
    call BlzTriggerRegisterFrameEvent(lockTrigger, zoom__lockButton, FRAMEEVENT_CONTROL_CLICK)
    call TriggerAddAction(lockTrigger, function zoom__handleLockButton)
    call BlzFrameSetValue(zoom__slider, GetCameraField(CAMERA_FIELD_TARGET_DISTANCE))
    call zoom__UpdateSliderLabel(R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)))
    set minimap=null
    set gameUI=null
    set sliderTrigger=null
    set lockTrigger=null
endfunction

function zoom__RestoreFromFile takes nothing returns nothing
    local integer file= s__File_open(zoom__gFileName)
    local string input= ( s__File_readEx(( file ) , false) )
    local integer cameraDistance= S2I(SubString(input, 0, 4))
    call s__File_close(file)
    // No saved file yet (S2I of an empty read is 0) means "leave the default camera alone".
    // Passing 0 through clamped a first-time player all the way in to zoom__gMinDistance.
    if ( cameraDistance > 0 ) then
        call zoom__Zoom(cameraDistance , false)
    endif
endfunction

function zoom__handleChatCommand takes nothing returns nothing
    local string commandText= GetEventPlayerChatString()
    local string cameraDistanceStr
    local integer cameraDistance= 0
    if ( SubString(commandText, 0, 3) == "-z " ) then
        set cameraDistanceStr=SubString(commandText, 3, StringLength(commandText))
    else
        set cameraDistanceStr=SubString(commandText, 6, StringLength(commandText))
    endif
    if ( GetLocalPlayer() == GetTriggerPlayer() ) then
        if ( cameraDistanceStr != " " ) then
            set cameraDistance=S2I(cameraDistanceStr)
        endif
        if ( cameraDistance == 0 ) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Invalid zoom command usage. Example: \"-z 2500\" or \"-zoom 2500\"")
        else
            set cameraDistance=zoom__Zoom(cameraDistance , true)
            call BlzFrameSetValue(zoom__slider, I2R(cameraDistance))
            call zoom__UpdateSliderLabel(cameraDistance)
            call zoom__Save(cameraDistance)
        endif
    endif
endfunction

function zoom__handleInfoChatCommand takes nothing returns nothing
    if ( GetLocalPlayer() == GetTriggerPlayer() ) then
        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Current zoom level: " + I2S(R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE))))
    endif
endfunction

function zoom_RestoreFromCacheForPlayer takes player p returns nothing
    if ( GetLocalPlayer() == p ) then
        call zoom__RestoreFromFile()
    endif
endfunction

function zoom_RestoreForAllPlayersFromCache takes nothing returns nothing
    local integer i= 0
    loop
    exitwhen i >= 24
        if ( GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING ) then
            if ( GetLocalPlayer() == Player(i) ) then
                call zoom__RestoreFromFile()
            endif
        endif
        set i=i + 1
    endloop
endfunction

function zoom_Init takes nothing returns nothing
    local integer i= 0
    local trigger setTrigger= CreateTrigger()
    local trigger infoTrigger= CreateTrigger()
    loop
    exitwhen i >= 24
        call TriggerRegisterPlayerChatEvent(setTrigger, Player(i), "-zoom ", false)
        call TriggerRegisterPlayerChatEvent(setTrigger, Player(i), "-z ", false)
        call TriggerRegisterPlayerChatEvent(infoTrigger, Player(i), "-zoom", true)
        call TriggerRegisterPlayerChatEvent(infoTrigger, Player(i), "-z", true)
        set i=i + 1
    endloop
    call TriggerAddAction(setTrigger, function zoom__handleChatCommand)
    call TriggerAddAction(infoTrigger, function zoom__handleInfoChatCommand)
    call zoom__ApplyFog(R2I(GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)))
    call zoom_RestoreForAllPlayersFromCache()
    call TimerStart(CreateTimer(), 0.50, false, function zoom__CreateSlider)
endfunction

function InitTrig_Camera_Zoom takes nothing returns nothing
    call zoom_Init()
endfunction

function FFR4_PoolingAllowed takes nothing returns boolean
    return not FFR4NoPool and not udg_mode_promode and udg_autopoool_allowed
endfunction

function FFR4_LockPooling takes nothing returns nothing
    local integer i=1
    set udg_autopoool_allowed=false
    call SetMapFlag(MAP_LOCK_RESOURCE_TRADING, true)
    call PauseTimer(udg_timer_trading)
    if udg_timer_window_trading != null then
        call TimerDialogDisplayBJ(false, udg_timer_window_trading)
    endif
    loop
        exitwhen i > 12
        set udg_autopoolto[i]=0
        set i=i+1
    endloop
endfunction

function FFStart_RemoveSelector takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function FFStart_ClearSelectors takes nothing returns nothing
    local group g=GetUnitsOfTypeIdAll('h01G')
    call ForGroup(g,function FFStart_RemoveSelector)
    call DestroyGroup(g)
    set g=GetUnitsOfTypeIdAll('h03Y')
    call ForGroup(g,function FFStart_RemoveSelector)
    call DestroyGroup(g)
    set g=null
endfunction

function FFStart_Select takes nothing returns nothing
    local integer i=1
    local button b=GetClickedButton()
    if GetTriggerPlayer() != udg_Host or not udg_voting then
        set b=null
        return
    endif
    if b != FFStartSD and b != FFStartAR and b != FFStartAP then
        set b=null
        return
    endif
    loop
        exitwhen i > 12
        set udg_SD[i]=0
        set udg_AR[i]=0
        set udg_AP[i]=0
        if b == FFStartSD then
            set udg_SD[i]=1
        elseif b == FFStartAR then
            set udg_AR[i]=1
        else
            set udg_AP[i]=1
        endif
        set i=i+1
    endloop
    call DialogDisplay(udg_Host,FFStartDialog,false)
    call StartTimerBJ(udg_timer_voting,false,0.01)
    set b=null
endfunction

function FFStart_ShowSelection takes nothing returns nothing
    local trigger t
    if FFStartDialog == null then
        set FFStartDialog=DialogCreate()
        set t=CreateTrigger()
        call TriggerRegisterDialogEvent(t,FFStartDialog)
        call TriggerAddAction(t,function FFStart_Select)
        set t=null
    endif
    call DialogClear(FFStartDialog)
    call DialogSetMessage(FFStartDialog,"Hero selection (10 seconds)")
    set FFStartSD=DialogAddButton(FFStartDialog,"Single Draft (SD)",0)
    set FFStartAR=DialogAddButton(FFStartDialog,"All Random (AR)",0)
    set FFStartAP=DialogAddButton(FFStartDialog,"All Pick (AP)",0)
    call DialogDisplay(udg_Host,FFStartDialog,true)
endfunction

function FFMode_HideMenus takes nothing returns nothing
    local player p=udg_Host
    local integer pn=GetConvertedPlayerId(p)
    call DialogDisplay(p, udg_dlg_mode[pn], false)
    call DialogDisplay(p, udg_dlg_colossal, false)
    call DialogDisplay(p, udg_dlg_colossal_amount, false)
    set p=null
endfunction

function FFMode_BeginCountdown takes integer stage returns nothing
    set FFModeStage=stage
    set udg_Host_Picked_A_Game_Mode=false
    call TimerStart(udg_Host_AFK_Timer, 10.00, false, null)
endfunction

function FFMode_Resolve takes nothing returns nothing
    set FFModeStage=0
    set udg_Host_Picked_A_Game_Mode=true
    call PauseTimer(udg_Host_AFK_Timer)
endfunction

function FFMode_ForcePub takes nothing returns nothing
    call FFMode_HideMenus()
    call PauseTimer(udg_Host_AFK_Timer)
    call PauseTimer(udg_timer_voting)
    set FFModeStage=0
    set FFR4Pro=false
    set FFR4NoPool=true
    set FFMode4K=false
    set FFModePrivateVote=false
    set udg_FFCH_Mode=false
    set udg_mode_overdrive=false
    set udg_Host_Picked_A_Game_Mode=true
    call DisplayTimedTextToForce(GetPlayersAll(),4.00,"No choice was made in 10 seconds. Starting Pub Default mode.")
    call ConditionalTriggerExecute(gg_trg_MODE_set_pub_game_default)
endfunction

function FFMode_ShowCustomMenu takes nothing returns nothing
