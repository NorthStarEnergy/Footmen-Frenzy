    if ( not ( udg_sinkhole_time[udg_X] >= 60 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001C takes nothing returns boolean
    if ( not ( udg_sinkhole_active[udg_X] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Myrmidon_Sinkhole_suck_Actions takes nothing returns nothing
    local group enumGroup
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001C() ) then
            set enumGroup=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_X), Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func001001002))
            call ForGroup(enumGroup, function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func001A)
            call DestroyGroup(enumGroup)
            set udg_temp_AoE=( 300.00 + ( 100.00 * I2R(udg_temp_int) ) )
            set udg_waterfall_units[udg_X]=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_waterfall_mid[udg_X], Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func004002003))
            set enumGroup=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_X), Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func005001002))
            call GroupRemoveGroup(enumGroup, udg_waterfall_units[udg_X])
            call DestroyGroup(enumGroup)
            set enumGroup=GetUnitsInRangeOfLocMatching(udg_temp_AoE, udg_waterfall_mid[udg_X], Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func006001003))
            call GroupRemoveGroup(enumGroup, udg_waterfall_units[udg_X])
            call DestroyGroup(enumGroup)
            call ForGroup(udg_waterfall_units[udg_X], function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func007A)
            call DestroyGroup(udg_waterfall_units[udg_X])
            set udg_waterfall_units[udg_X]=null
            set enumGroup=null
            set udg_sinkhole_time[udg_X]=( udg_sinkhole_time[udg_X] + 1 )
            if ( Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009C() ) then
                set enumGroup=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_X), Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func001001002))
                call ForGroup(enumGroup, function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func001A)
                call DestroyGroup(enumGroup)
                call PlaySoundAtPointBJ(gg_snd_ThunderClapCaster, 100, udg_waterfall_point[udg_X], 0)
                call CreateNUnitsAtLoc(1, 'h02B', ConvertedPlayer(udg_X), udg_waterfall_mid[udg_X], bj_UNIT_FACING)
                call UnitApplyTimedLifeBJ(0.50, 'BTLF', GetLastCreatedUnit())
                set enumGroup=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_X), Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func005001002))
                call ForGroup(enumGroup, function Trig_HERO_Myrmidon_Sinkhole_suck_Func001Func001Func009Func005A)
                call DestroyGroup(enumGroup)
                set enumGroup=null
                set udg_sinkhole_time[udg_X]=0
                call RemoveLocation(udg_waterfall_mid[udg_X])
                call ConditionalTriggerExecute(gg_trg_HERO_Myrmidon_Sinkhole_end)
            else
            endif
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

function InitTrig_HERO_Myrmidon_Sinkhole_suck takes nothing returns nothing
    set gg_trg_HERO_Myrmidon_Sinkhole_suck=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_HERO_Myrmidon_Sinkhole_suck, 0.05)
    call TriggerAddCondition(gg_trg_HERO_Myrmidon_Sinkhole_suck, Condition(function Trig_HERO_Myrmidon_Sinkhole_suck_Conditions))
    call TriggerAddAction(gg_trg_HERO_Myrmidon_Sinkhole_suck, function Trig_HERO_Myrmidon_Sinkhole_suck_Actions)
endfunction

