function Trig_Tentacle_Mass_Root_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tentacle_Mass_Root_Func005Func003C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tentacle_Mass_Root_Func005Func004C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tentacle_Mass_Root_Func005Func005C takes nothing returns boolean
    if ( not ( udg_abilitylevel == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tentacle_Mass_Root_Func005A takes nothing returns nothing
    // udg_abilitylevel was captured before the wait; re-reading the event here would be stale.
    call SetUnitAbilityLevelSwapped('A03W', GetEnumUnit(), udg_abilitylevel)
    if ( Trig_Tentacle_Mass_Root_Func005Func003C() ) then
        call BlzSetUnitMaxHP(GetEnumUnit(), 1000)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_HP, 1000.00)
        call BlzSetUnitArmor(GetEnumUnit(), 7.00)
        call BlzSetUnitBaseDamage(GetEnumUnit(), 48, 0)
        call BlzSetUnitDiceNumber(GetEnumUnit(), 2, 0)
        call BlzSetUnitDiceSides(GetEnumUnit(), 5, 0)
    else
        call DoNothing()
    endif
    if ( Trig_Tentacle_Mass_Root_Func005Func004C() ) then
        // Unit Stats
        call BlzSetUnitMaxHP(GetEnumUnit(), 1500)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_HP, 1500.00)
        call BlzSetUnitArmor(GetEnumUnit(), 12.00)
        call BlzSetUnitBaseDamage(GetEnumUnit(), 70, 0)
        call BlzSetUnitDiceNumber(GetEnumUnit(), 5, 0)
        call BlzSetUnitDiceSides(GetEnumUnit(), 2, 0)
    else
        call DoNothing()
    endif
    if ( Trig_Tentacle_Mass_Root_Func005Func005C() ) then
        // Unit Stats
        call BlzSetUnitMaxHP(GetEnumUnit(), 2000)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_HP, 2000.00)
        call BlzSetUnitArmor(GetEnumUnit(), 15.00)
        call BlzSetUnitBaseDamage(GetEnumUnit(), 80, 0)
        call BlzSetUnitDiceNumber(GetEnumUnit(), 1, 0)
        call BlzSetUnitDiceSides(GetEnumUnit(), 11, 0)
    else
        call DoNothing()
    endif
endfunction

function Trig_Tentacle_Mass_Root_Actions takes nothing returns nothing
    local unit caster= GetSpellAbilityUnit()
    local integer lvl= GetUnitAbilityLevelSwapped(GetSpellAbilityId(), caster)
    local group summons
    // Event responses are not reliable after a wait: if this trigger fires again while this
    // thread sleeps, the natives below return the NEWER event. Locals are per-thread, so the
    // values are captured up front and the shared globals rebuilt from them after the wait.
    call TriggerSleepAction(0.50)
    set udg_temp_unit=caster
    set udg_temp_player=GetOwningPlayer(caster)
    set udg_abilitylevel=lvl
    set summons=GetUnitsOfPlayerAndTypeId(udg_temp_player, 'o018')
    call ForGroup(summons, function Trig_Tentacle_Mass_Root_Func005A)
    call DestroyGroup(summons)
    set caster=null
    set summons=null
endfunction

function InitTrig_Tentacle_Mass_Root takes nothing returns nothing
    set gg_trg_Tentacle_Mass_Root=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Tentacle_Mass_Root, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Tentacle_Mass_Root, Condition(function Trig_Tentacle_Mass_Root_Conditions))
    call TriggerAddAction(gg_trg_Tentacle_Mass_Root, function Trig_Tentacle_Mass_Root_Actions)
endfunction

