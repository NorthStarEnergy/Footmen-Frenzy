function Trig_page_system_Actions takes nothing returns nothing
    set udg_temp_unit=GetSoldUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    if ( GetUnitTypeId(udg_temp_unit) == 'u01C' ) then
        call SetUnitOwner(udg_temp_unit, Player(PLAYER_NEUTRAL_PASSIVE), false)
        call SelectUnitForPlayerSingle(udg_temp_unit, udg_temp_player)
        return
    endif
    if ( Trig_page_system_Func004C() ) then
        set udg_temp_point=GetUnitLoc(udg_temp_unit)
        call ClearSelectionForPlayer(udg_temp_player)
        call RemoveUnit(udg_temp_unit)
        set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(512.00, udg_temp_point, Condition(function Trig_page_system_Func004Func005002003))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_page_system_Func004Func006A)
