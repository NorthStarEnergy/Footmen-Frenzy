function Trig_Kill_units_of_inactive_player_Actions takes nothing returns nothing
    set SafeRemoval_GraceTicks=SafeRemoval_GraceTicks + 1
    if SafeRemoval_GraceTicks < 20 then
        return
    endif
    set udg_X=1
    loop
        exitwhen udg_X > 12
        if ( Trig_Kill_units_of_inactive_player_Func001Func001C() ) then
            // Uncle: Some units shouldn't get removed:
            set udg_unitgroup_kill=GetUnitsOfPlayerMatching(ConvertedPlayer(udg_X), Condition(function Trig_Kill_units_of_inactive_player_Func001Func001Func002002002))
            call ForGroupBJ(udg_unitgroup_kill, function Trig_Kill_units_of_inactive_player_Func001Func001Func003002)
            call DestroyGroup(udg_unitgroup_kill)
        else
        endif
        set udg_X=udg_X + 1
    endloop
endfunction

