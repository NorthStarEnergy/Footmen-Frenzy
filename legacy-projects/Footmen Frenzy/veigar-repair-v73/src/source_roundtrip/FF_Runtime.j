function OD_ApplyBonusTavernGate takes nothing returns nothing
    local integer i = 1
    loop
        exitwhen i > 12
        call SetPlayerUnitAvailableBJ('hhou', false, ConvertedPlayer(i))
        set i = i + 1
    endloop
endfunction

function Trig_MODE_set_pub_game_default_Actions takes nothing returns nothing
    set udg_Host_Picked_A_Game_Mode=true
    //                                                                                                                                     
    // SET BASE VARIABLES
    set FFMode4K=false
    set FFModePrivateVote=false
    set udg_FFCH_Mode=false
    set udg_mode_overdrive=false
    set udg_mode_promode=false
    if FFR4Pro then
        set udg_game_mode_display[1]=" Pro Mode"
    else
        set udg_game_mode_display[1]=" Pub Mode"
        set udg_wmd[10]="|cff00ffffNo Pool:|r |cff00ff00On|r"
    endif
    set udg_mode_inhouse=false
    set udg_mode_pub=true
    set udg_mode_koth=true
    call DisplayTextToForce(udg_all_players, ( ( "|cff32cd32" + GetPlayerName(udg_Host) ) + " has selected" + udg_game_mode_display[1] + ".|r" ))
    //   
    // ENABLE DEFAULT PUB MODES & COLOSSAL
    set udg_colossal_on=true
    set udg_colossal_max_wave=10
    //   
    call EnableTrigger(gg_trg_Start_SD)
    call ConditionalTriggerExecute(gg_trg_Start_SD)
    call ConditionalTriggerExecute(gg_trg_Start_game)
    call OD_ApplyBonusTavernGate()
endfunction

