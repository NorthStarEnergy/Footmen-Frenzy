    call TriggerAddCondition(gg_trg_HERO_Swift_Strike, Condition(function Trig_HERO_Swift_Strike_Conditions))
    call TriggerAddAction(gg_trg_HERO_Swift_Strike, function Trig_HERO_Swift_Strike_Actions)
endfunction

