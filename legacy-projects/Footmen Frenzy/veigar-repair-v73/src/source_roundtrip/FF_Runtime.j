function Trig_Upgrades_level_Func002A takes nothing returns nothing
    // BASE AURA
    if ( Trig_Upgrades_level_Func002Func004C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func004Func002002002))
        set udg_temp_ability='A05L'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func004Func005A)
    else
        call DoNothing()
    endif
    if ( Trig_Upgrades_level_Func002Func005C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func005Func002002002))
        set udg_temp_ability='A05P'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func005Func005A)
    else
        call DoNothing()
    endif
    if ( Trig_Upgrades_level_Func002Func006C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func006Func002002002))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func006Func004A)
    else
        call DoNothing()
    endif
    if ( Trig_Upgrades_level_Func002Func007C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_temp_unitgroup=GetUnitsOfPlayerMatching(GetEnumPlayer(), Condition(function Trig_Upgrades_level_Func002Func007Func002002002))
        set udg_temp_ability='A05M'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func007Func005A)
    else
        call DoNothing()
    endif
    // TOWER UPGRADE
    if ( Trig_Upgrades_level_Func002Func009C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
        set udg_frostbolt_upgrade_level[udg_teamnumber[GetConvertedPlayerId(GetTriggerPlayer())]]=udg_temp_int
        call ForGroupBJ(GetUnitsOfPlayerAndTypeId(GetEnumPlayer(), 'hgtw'), function Trig_Upgrades_level_Func002Func009Func004A)
        set udg_temp_ability='Awfb'
        call ForGroupBJ(udg_temp_unitgroup, function Trig_Upgrades_level_Func002Func009Func006A)
    else
        call DoNothing()
    endif
    // BUILDING UPGRADE
    if ( Trig_Upgrades_level_Func002Func011C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
    else
        call DoNothing()
    endif
    // CREEP UPGRADES
    if ( Trig_Upgrades_level_Func002Func013C() ) then
        call SetPlayerTechResearchedSwap(GetResearched(), udg_temp_int, GetEnumPlayer())
    else
        call DoNothing()
    endif
    set udg_temp_int=GetPlayerTechCountSimple(GetResearched(), GetTriggerPlayer())

endfunction

function Trig_Upgrades_level_Actions takes nothing returns nothing
    set udg_temp_int=GetPlayerTechCountSimple(GetResearched(), GetTriggerPlayer())
    call ForForce(GetPlayersAllies(GetTriggerPlayer()), function Trig_Upgrades_level_Func002A)
    // MESSAGE TO OTHER PLAYERS
    set udg_temp_point=GetUnitLoc(GetTriggerUnit())
    call PingMinimapLocForForceEx(GetForceOfPlayer(GetEnumPlayer()), udg_temp_point, 1.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 100)
    call RemoveLocation(udg_temp_point)
    set udg_temp_playergroup=GetPlayersAllies(GetTriggerPlayer())
    call DisplayTextToForce(udg_temp_playergroup, ( "Research completed for Team " + I2S(udg_teamnumber[GetConvertedPlayerId(GetTriggerPlayer())]) ))
    call DestroyForce(udg_temp_playergroup)
    call DestroyGroup(udg_temp_unitgroup)
endfunction

