function Trig_HERO_Santa_Snowball_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Santa_Snowball_Func008C takes nothing returns boolean
    if ( not ( udg_mode_debugmode == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Santa_Snowball_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_player=GetOwningPlayer(udg_temp_unit)
    set udg_temp_playernumber=GetConvertedPlayerId(udg_temp_player)
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_ship_destination[udg_temp_playernumber]=GetSpellTargetLoc()
    set udg_abilitylevel=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_temp_unit)
    set udg_temp_real=( 522.00 * ( DistanceBetweenPoints(udg_temp_point_caster, udg_ship_destination[udg_temp_playernumber]) / 1000.00 ) )
    if ( Trig_HERO_Santa_Snowball_Func008C() ) then
        call DisplayTextToForce(udg_all_players, ( "temp real = " + R2S(udg_temp_real) ))
        call DisplayTextToForce(udg_all_players, ( "distance = " + R2S(DistanceBetweenPoints(udg_temp_point_caster, udg_ship_destination[udg_temp_playernumber])) ))
    else
    endif
    call CreateNUnitsAtLocFacingLocBJ(1, 'h03R', udg_temp_player, udg_temp_point_caster, udg_temp_point)
    set udg_dummy_ship[udg_temp_playernumber]=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_dummy_ship[udg_temp_playernumber], udg_temp_real)
    call UnitAddAbilityBJ('A0LR', udg_dummy_ship[udg_temp_playernumber])
    call SetUnitAbilityLevelSwapped('A0LR', udg_dummy_ship[udg_temp_playernumber], udg_abilitylevel)
    call IssuePointOrderLocBJ(udg_dummy_ship[udg_temp_playernumber], "move", udg_ship_destination[udg_temp_playernumber])
    call RemoveLocation(udg_temp_point_caster)
    call RemoveLocation(udg_ship_destination[udg_temp_playernumber])
    call StartTimerBJ(udg_timer_ship[udg_temp_playernumber], false, 2.30)
    call UnitApplyTimedLifeBJ(2.50, 'BTLF', udg_dummy_ship[udg_temp_playernumber])
endfunction

function InitTrig_HERO_Santa_Snowball takes nothing returns nothing
    set gg_trg_HERO_Santa_Snowball=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Santa_Snowball, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HERO_Santa_Snowball, Condition(function Trig_HERO_Santa_Snowball_Conditions))
    call TriggerAddAction(gg_trg_HERO_Santa_Snowball, function Trig_HERO_Santa_Snowball_Actions)
endfunction

function Trig_HERO_Ships_Doc_wards_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0B6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_HERO_Ships_Doc_wards_Func007A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped('A0CQ', GetEnumUnit(), udg_abilitylevel)
endfunction

function Trig_HERO_Ships_Doc_wards_Actions takes nothing returns nothing
    local unit caster= GetSpellAbilityUnit()
    local integer lvl= GetUnitAbilityLevelSwapped(GetSpellAbilityId(), caster)
    local group wards
    // Event responses are not reliable after a wait: if this trigger fires again while this
    // thread sleeps, the natives below return the NEWER event. Locals are per-thread, so the
    // values are captured up front and the shared globals rebuilt from them after the wait.
    call TriggerSleepAction(0.50)
    set udg_temp_unit=caster
    set udg_temp_player=GetOwningPlayer(caster)
    set udg_abilitylevel=lvl
    set wards=GetUnitsOfPlayerAndTypeId(udg_temp_player, 'o00W')
    call ForGroup(wards, function Trig_HERO_Ships_Doc_wards_Func007A)
    call DestroyGroup(wards)
    set caster=null
    set wards=null
endfunction

function InitTrig_HERO_Ships_Doc_wards takes nothing returns nothing
    set gg_trg_HERO_Ships_Doc_wards=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HERO_Ships_Doc_wards, EVENT_PLAYER_UNIT_SPELL_EFFECT)
