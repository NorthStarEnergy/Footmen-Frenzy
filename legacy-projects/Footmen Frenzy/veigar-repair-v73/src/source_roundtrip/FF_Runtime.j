        call ForGroupBJ(udg_temp_unitgroup, function Trig_page_system_Func011Func006A)
    else
        call DoNothing()
    endif
    if ( Trig_page_system_Func012C() ) then
        set udg_temp_point=GetUnitLoc(udg_temp_unit)
        call ClearSelectionForPlayer(udg_temp_player)
        call RemoveUnit(udg_temp_unit)
        set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(512.00, udg_temp_point, Condition(function Trig_page_system_Func012Func005002003))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_page_system_Func012Func006A)
    else
        call DoNothing()
    endif
    if ( Trig_page_system_Func013C() ) then
        set udg_temp_point=GetUnitLoc(udg_temp_unit)
        call ClearSelectionForPlayer(udg_temp_player)
        call RemoveUnit(udg_temp_unit)
        set udg_temp_unitgroup=GetUnitsInRangeOfLocMatching(512.00, udg_temp_point, Condition(function Trig_page_system_Func013Func005002003))
        call ForGroupBJ(udg_temp_unitgroup, function Trig_page_system_Func013Func006A)
    else
        call DoNothing()
    endif
    call DestroyGroup(udg_temp_unitgroup)
endfunction

