function Trig_MASS_timer_Func004C takes nothing returns boolean
    if ( not ( udg_mode_inhouse == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MASS_timer_Actions takes nothing returns nothing
    // MASS TIMER: 1 min 30
    set udg_t_premass=ffgs_premass_seconds
    if ( Trig_MASS_timer_Func004C() ) then
        set udg_t_premass=ffgs_premass_seconds
    else
        call DoNothing()
    endif
    //                     
    // Bonus footies 5 seconds before Mass:
    call StartTimerBJ(udg_timer_premass_bonus, false, ( udg_t_premass - ffgs_premass_bonus_lead ))
    //                     
    call StartTimerBJ(udg_timer_premass, false, udg_t_premass)
    call CreateTimerDialogBJ(udg_timer_premass, "TRIGSTR_1138")
    set udg_timer_window_premass=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_timer_window_premass)
    //                     
endfunction

function InitTrig_MASS_timer takes nothing returns nothing
    set gg_trg_MASS_timer=CreateTrigger()
    call DisableTrigger(gg_trg_MASS_timer)
    call TriggerRegisterTimerEventSingle(gg_trg_MASS_timer, 0.10)
    call TriggerAddAction(gg_trg_MASS_timer, function Trig_MASS_timer_Actions)
endfunction

function Trig_keep_footy_in_base_Conditions takes nothing returns boolean
    if F35_MassEnabled() and IsUnitHidden(GetTriggerUnit()) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_timer_premass) > 0.00 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'hfoo' or GetUnitTypeId(GetTriggerUnit()) == 'h060' ) ) then
        return false
    endif
    return true
endfunction

function Trig_keep_footy_in_base_Func009C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_timer) <= 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_keep_footy_in_base_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_playergroup=GetForceOfPlayer(GetOwningPlayer(udg_temp_unit))
    set udg_temp_real=AngleBetweenPoints(udg_centermap, GetUnitLoc(udg_temp_unit))
    set udg_temp_point=PolarProjectionBJ(GetUnitLoc(udg_temp_unit), 100.00, udg_temp_real)
    call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
    call IssueImmediateOrderBJ(udg_temp_unit, "stop")
    call RemoveLocation(udg_temp_point)
    if ( Trig_keep_footy_in_base_Func009C() ) then
        call StartTimerBJ(udg_timer, false, 1.00)
        call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1137")
    else
    endif
    call DestroyForce(udg_temp_playergroup)
endfunction

function InitTrig_keep_footy_in_base takes nothing returns nothing
    set gg_trg_keep_footy_in_base=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_keep_footy_in_base, gg_rct_CENTER)
    call TriggerAddCondition(gg_trg_keep_footy_in_base, Condition(function Trig_keep_footy_in_base_Conditions))
    call TriggerAddAction(gg_trg_keep_footy_in_base, function Trig_keep_footy_in_base_Actions)
endfunction

function Trig_MASS_PRE_START_BONUS_Actions takes nothing returns nothing
    // Define the number of footmen that spawn every 20 seconds (first spawn happens NOW):
    set udg_Mass_Bonus_Spawns[1]=ffgs_mass_bonus_spawns[1]
    set udg_Mass_Bonus_Spawns[2]=ffgs_mass_bonus_spawns[2]
    set udg_Mass_Bonus_Spawns[3]=ffgs_mass_bonus_spawns[3]
    set udg_Mass_Bonus_Spawns[4]=ffgs_mass_bonus_spawns[4]
    set udg_Mass_Bonus_Spawns[5]=ffgs_mass_bonus_spawns[5]
    set udg_Mass_Bonus_Spawns[6]=ffgs_mass_bonus_spawns[6]
    set udg_Mass_Bonus_Spawns[7]=ffgs_mass_bonus_spawns[7]
    set udg_Mass_Bonus_Spawns[8]=ffgs_mass_bonus_spawns[8]
    //                     
    // Create bonus footies and begin the bonus timer for extra footies throughout mass:
    call StartTimerBJ(udg_spawnMassTimer, true, ffgs_mass_bonus_interval)
    call ConditionalTriggerExecute(gg_trg_eight_mass_bonus)
endfunction

