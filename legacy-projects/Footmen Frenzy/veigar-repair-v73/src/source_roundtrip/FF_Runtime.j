function Trig_colossal_death_Actions takes nothing returns nothing
    set udg_col_killing_unit=GetKillingUnitBJ()
    set udg_col_killing_player=GetOwningPlayer(GetKillingUnitBJ())
    set udg_col_dying_unit=GetTriggerUnit()
    set udg_col_dying_unit_type=GetUnitTypeId(udg_col_dying_unit)
    set udg_col_death_point=GetUnitLoc(udg_col_dying_unit)
    //                                                                                                   
    // The AoE Heal can be found inside of here:
    if ( Trig_colossal_death_Func010C() ) then
        call CreateItemLoc(udg_colossal_dropped_item[1], udg_col_death_point)
        call SetItemCharges(GetLastCreatedItem(), 1)
    else
        // AoE Heal ->
        if ( Trig_colossal_death_Func010Func002C() ) then
            call CreateItemLoc(udg_colossal_dropped_item[21], udg_col_death_point)
        else
            if ( Trig_colossal_death_Func010Func002Func003C() ) then
                call CreateItemLoc(udg_colossal_dropped_item[31], udg_col_death_point)
            else
                if ( Trig_colossal_death_Func010Func002Func003Func003C() ) then
                    call CreateItemLoc(udg_colossal_dropped_item[61], udg_col_death_point)
                else
                    if ( Trig_colossal_death_Func010Func002Func003Func003Func001C() ) then
                        call CreateItemLoc(udg_colossal_dropped_item[1], udg_col_death_point)
                    else
                        if ( Trig_colossal_death_Func010Func002Func003Func003Func001Func001C() ) then
                            call CreateItemLoc(udg_colossal_dropped_item[2], udg_col_death_point)
                        else
                        endif
                    endif
                endif
            endif
        endif
    endif
    //                                                                                                   
    call RemoveLocation(udg_col_death_point)
endfunction

function InitTrig_colossal_death takes nothing returns nothing
    set gg_trg_colossal_death=CreateTrigger()
    call DisableTrigger(gg_trg_colossal_death)
