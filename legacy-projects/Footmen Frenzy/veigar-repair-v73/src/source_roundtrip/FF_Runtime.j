function Trig_MODE_GUI_execute_Actions takes nothing returns nothing
    local player p=GetTriggerPlayer()
    local integer pn=1
    local button clicked=GetClickedButton()
    if p != Player(0) then
        set clicked=null
        set p=null
        return
    endif
    set udg_temp_playernumber=pn
    set udg_mode_set_by_host=true
    set udg_game_mode_display[2]=" Host"
    if FFModeStage == 1 then
        if clicked == udg_dlg_btn_mode_01[pn] or clicked == udg_dlg_btn_mode_02[pn] then
            set FFR4Pro=clicked == udg_dlg_btn_mode_02[pn]
            set FFR4NoPool=not FFR4Pro
            call FFMode_Resolve()
            call ConditionalTriggerExecute(gg_trg_MODE_set_pub_game_default)
        elseif clicked == udg_dlg_btn_mode_04[pn] then
            call FFMode_Resolve()
            set FFR4Pro=false
            set FFR4NoPool=false
            set FFMode4K=false
            set FFModePrivateVote=false
            set udg_FFCH_Mode=false
            set udg_mode_overdrive=false
            set udg_mode_inhouse=false
            set udg_mode_pub=true
            set udg_mode_koth=true
            call EnableTrigger(gg_trg_Start_Vote)
            call ConditionalTriggerExecute(gg_trg_Start_Vote)
            call EnableTrigger(gg_trg_Vote_Timer_Expires)
            call EnableTrigger(gg_trg_debugmode)
            call ConditionalTriggerExecute(gg_trg_debugmode)
        elseif clicked == udg_dlg_btn_mode_03[pn] then
            call PauseTimer(udg_Host_AFK_Timer)
            set FFModeStage=0
            call TimerStart(FFModeMenuTimer, 0.01, false, function FFMode_ShowCustomMenu)
        endif
    elseif FFModeStage == 2 then
        if clicked == udg_dlg_btn_mode_01[pn] then
            call FFMode_Resolve()
            call ConditionalTriggerExecute(gg_trg_MODE_set_inhouse)
        elseif clicked == udg_dlg_btn_mode_02[pn] then
            call FFMode_Resolve()
            call ConditionalTriggerExecute(gg_trg_MODE_set_pro_mode)
        endif
    endif
    set clicked=null
    set p=null
endfunction

