function Trig_kill_blink_shop_t1_Conditions takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetTriggerUnit(), Player(0)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_kill_blink_shop_t1_Actions takes nothing returns nothing
    set udg_temp_unit=GetTriggerUnit()
    set udg_temp_point_caster=GetUnitLoc(udg_temp_unit)
    set udg_temp_degree=AngleBetweenPoints(udg_temp_point_caster, GetRectCenter(gg_rct_ENTIRE_MAP))
    set udg_temp_point=PolarProjectionBJ(udg_temp_point_caster, 350.00, udg_temp_degree)
    call SetUnitPositionLoc(udg_temp_unit, udg_temp_point)
    call UnitRemoveItemSwapped(GetItemOfTypeFromUnitBJ(udg_temp_unit, 'ankh'), udg_temp_unit)
    call KillUnit(udg_temp_unit)
    set udg_temp_playergroup=GetForceOfPlayer(GetTriggerPlayer())
    call DisplayTextToForce(udg_temp_playergroup, "TRIGSTR_1109")
    call DestroyForce(udg_temp_playergroup)
    call RemoveLocation(udg_temp_point)
endfunction

