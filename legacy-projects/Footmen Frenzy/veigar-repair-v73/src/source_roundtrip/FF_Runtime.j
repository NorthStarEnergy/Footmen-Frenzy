function Trig_setting_video_cam_Func006C takes nothing returns boolean
    if ( not ( udg_X == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_setting_video_cam_Actions takes nothing returns nothing
    set udg_X=S2I(SubStringBJ(GetEventPlayerChatString(), 5, 6))
    call DisplayTextToForce(GetPlayersAll(), ( "setting view to camera# " + I2S(udg_X) ))
    if ( Trig_setting_video_cam_Func004C() ) then
        call ResetToGameCameraForPlayer(Player(0), 0)
    else
    endif
    if ( Trig_setting_video_cam_Func005C() ) then
        call CameraSetupApplyForPlayer(false, gg_cam_Camera_001, Player(0), 0)
    else
    endif
    if ( Trig_setting_video_cam_Func006C() ) then
        call CameraSetupApplyForPlayer(false, gg_cam_Camera_002, Player(0), 0)
    else
    endif
endfunction

function InitTrig_setting_video_cam takes nothing returns nothing
    set gg_trg_setting_video_cam=CreateTrigger()
    // v50: the legacy view-camera chat listener is retired. The -cam command now
    // belongs to the observer spectator camera (FF_ObserverCamera_Init), which
    // registers it for every slot and enforces the observer-only rule itself.
    call TriggerAddCondition(gg_trg_setting_video_cam, Condition(function Trig_setting_video_cam_Conditions))
    call TriggerAddAction(gg_trg_setting_video_cam, function Trig_setting_video_cam_Actions)
endfunction

