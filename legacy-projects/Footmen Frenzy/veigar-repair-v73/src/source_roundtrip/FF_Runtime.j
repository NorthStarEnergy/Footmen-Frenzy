function Trig_MODE_colossal_amount_GUI_execute_Actions takes nothing returns nothing
    local button clicked=GetClickedButton()
    local integer i=1
    local boolean chosen=false
    if FFModeStage != 4 then
        set clicked=null
        return
    endif
    loop
        exitwhen i > 10
        if clicked == udg_dlg_btn_colossal_amount[i] then
            set udg_colossal_max_wave=i
            set chosen=true
            call DisplayTextToForce(udg_all_players, I2S(udg_colossal_max_wave) + " colossals selected.")
        endif
        set i=i + 1
    endloop
    if chosen then
        call FFMode_StartPrivateVote()
    endif
    set clicked=null
endfunction

