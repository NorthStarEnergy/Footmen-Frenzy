function FFV30_FootmenForPlayer takes player p returns group
    local group all=GetUnitsOfPlayerAll(p)
    local group result=CreateGroup()
    local unit u
    local integer id
    loop
        set u=FirstOfGroup(all)
        exitwhen u == null
        call GroupRemoveUnit(all, u)
        set id=GetUnitTypeId(u)
        if id == 'h060' or id == 'hfoo' then
            call GroupAddUnit(result, u)
        endif
    endloop
    call DestroyGroup(all)
    return result
endfunction

function FFV30_ClearFootmanInvulnerability takes nothing returns nothing
    local unit u=GetEnumUnit()
    call UnitRemoveAbility(u, 'Avul')
    set u=null
endfunction

function FFV30_ClearPlayerFootmen takes nothing returns nothing
    local integer i=0
    local group g
    loop
        exitwhen i >= 12
        set g=FFV30_FootmenForPlayer(Player(i))
        call ForGroup(g, function FFV30_ClearFootmanInvulnerability)
        call DestroyGroup(g)
        set i=i + 1
    endloop
    set g=null
endfunction

function F35_MassPoint takes integer pn returns location
    local integer team=(pn - 1) / 3
    local integer slot=ModuloInteger(pn - 1, 3)
    local real x=400.0 + I2R(slot) * 336.0
    local real y=1072.0 - I2R(slot) * 336.0
    if not F35_MassEnabled() then
        return Location(GetLocationX(udg_player_start[pn]), GetLocationY(udg_player_start[pn]))
    endif
    if team == 0 or team == 3 then
        set x=-x
    endif
    if team == 2 or team == 3 then
        set y=-y
    endif
    return Location(ffgs_center_x + x, ffgs_center_y + y)
endfunction

function Trig_Mass_START_Actions takes nothing returns nothing
    local group massFootmen
    call TimerDialogDisplayBJ(false, udg_timer_window_premass)
    if ( Trig_Mass_START_Func002C() ) then
        call DestroyTextTagBJ(udg_game_mode_floating_text)
        call DestroyTextTagBJ(udg_wonky_mode_floating_text)
        set udg_t_mass=ffgs_mass_duration_special
        call TimerDialogDisplayBJ(false, udg_timer_window_premass)
        call StartTimerBJ(udg_timer_mass, false, udg_t_mass)
        call CreateTimerDialogBJ(udg_timer_mass, "TRIGSTR_10294")
        set udg_timer_window_mass=GetLastCreatedTimerDialogBJ()
        set udg_spawnprotection=false
        set udg_mass_active=true
        call DisableTrigger(gg_trg_keep_footy_in_base)
        call FFV30_ClearPlayerFootmen()
        set udg_X=1
        loop
            exitwhen udg_X > 12
            call SetPlayerHandicapReviveTimeBJ(ConvertedPlayer(udg_X), 100.00)
            set udg_number_of_spawned_units[udg_X]=1
            set massFootmen=FFV30_FootmenForPlayer(ConvertedPlayer(udg_X))
            call ForGroup(massFootmen, function Trig_Mass_START_Func002Func030Func003A)
            call DestroyGroup(massFootmen)
            set massFootmen=null
            set udg_X=udg_X + 1
        endloop
        call DestroyGroup(udg_temp_unitgroup)
        call ConditionalTriggerExecute(gg_trg_Destroy_Triggers_2)
        call DestroyTrigger(GetTriggeringTrigger())
    else
        call PlaySoundBJ(gg_snd_TheHornOfCenarius)
        call DestroyTextTagBJ(udg_game_mode_floating_text)
        call DestroyTextTagBJ(udg_wonky_mode_floating_text)
        set udg_t_mass=ffgs_mass_duration_normal
        call StartTimerBJ(udg_timer_mass, false, udg_t_mass)
        call CreateTimerDialogBJ(udg_timer_mass, "TRIGSTR_10294")
        set udg_timer_window_mass=GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ(true, udg_timer_window_mass)
        if ( Trig_Mass_START_Func002Func009C() ) then
            call TimerDialogDisplayBJ(false, udg_timer_window_mass)
        else
            call DoNothing()
        endif
        set udg_spawnprotection=false
        set udg_mass_active=true
        call DisableTrigger(gg_trg_keep_footy_in_base)
        call FFV30_ClearPlayerFootmen()
        // AUTOSEND
        set udg_X=1
        loop
            exitwhen udg_X > 12
            if ( Trig_Mass_START_Func002Func014Func001C() ) then
                call IssuePointOrderLocBJ(udg_herO[udg_X], "attack", udg_centermap)
            else
                call DoNothing()
            endif
            call SetPlayerHandicapReviveTimeBJ(ConvertedPlayer(udg_X), 100.00)
            set udg_number_of_spawned_units[udg_X]=1
            set massFootmen=FFV30_FootmenForPlayer(ConvertedPlayer(udg_X))
            call ForGroup(massFootmen, function Trig_Mass_START_Func002Func014Func004A)
            call DestroyGroup(massFootmen)
            set massFootmen=null
            set udg_X=udg_X + 1
        endloop
        call F35_ReleaseMass()
        // AUTO BEASTSCROLL
        set udg_X_playernumber=1
        loop
            exitwhen udg_X_playernumber > 12
            if ( Trig_Mass_START_Func002Func016Func001C() ) then
                set udg_temp_point=F35_MassPoint(udg_X_playernumber)
                call CreateNUnitsAtLoc(1, 'h01K', ConvertedPlayer(udg_X_playernumber), udg_temp_point, bj_UNIT_FACING)
                call RemoveLocation(udg_temp_point)
                set udg_dummy=GetLastCreatedUnit()
                call UnitAddAbilityBJ('A0H5', udg_dummy)
                call IssueImmediateOrderBJ(udg_dummy, "roar")
                call UnitApplyTimedLifeBJ(0.10, 'BTLF', udg_dummy)
            else
                call DoNothing()
            endif
            set udg_X_playernumber=udg_X_playernumber + 1
        endloop
        call DestroyGroup(udg_temp_unitgroup)
        call ConditionalTriggerExecute(gg_trg_Destroy_Triggers_2)
        call DestroyTrigger(GetTriggeringTrigger())
    endif
    call F35_ReleaseMass()
endfunction

