        return false
    endif
    return true
endfunction

function Trig_Summon_Dragons_Func002C takes nothing returns boolean
    if ( not ( udg_Summon_Dragons_Level == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summon_Dragons_Actions takes nothing returns nothing
    // DEFINE THE DIFFERENT DRAGON VARIABLES:
    if ( Trig_Summon_Dragons_Func002C() ) then
        set udg_Summon_Dragons_Duration[1]=40.00
        set udg_Summon_Dragons_Duration[2]=40.00
        set udg_Summon_Dragons_Duration[3]=40.00
        set udg_Summon_Dragons_Duration[4]=40.00
        set udg_Summon_Dragons_Duration[5]=40.00
        set udg_Summon_Dragons_Duration[6]=40.00
        //                                                                                                                    
        // Dragon #1:
        set udg_Summon_Dragons_Type_1[1]='n059'
        set udg_Summon_Dragons_Type_1[2]='n05A'
        set udg_Summon_Dragons_Type_1[3]='n05B'
        set udg_Summon_Dragons_Type_1[4]='n05C'
        set udg_Summon_Dragons_Type_1[5]='n05E'
        set udg_Summon_Dragons_Type_1[6]='n05D'
        //                                                                                                                    
        // Dragon #2:
        set udg_Summon_Dragons_Type_2[1]='n053'
        set udg_Summon_Dragons_Type_2[2]='n054'
        set udg_Summon_Dragons_Type_2[3]='n055'
        set udg_Summon_Dragons_Type_2[4]='n056'
        set udg_Summon_Dragons_Type_2[5]='n057'
        set udg_Summon_Dragons_Type_2[6]='n058'
    else
    endif
    // ===============================================
    //                                                                                                                    
    set udg_Summon_Dragons_Level=GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())
    //                                                                                                                    
    set udg_Summon_Dragons_Point[0]=GetUnitLoc(GetTriggerUnit())
    set udg_Summon_Dragons_Point[1]=PolarProjectionBJ(udg_Summon_Dragons_Point[0], 128.00, ( GetUnitFacing(GetTriggerUnit()) + 90.00 ))
    set udg_Summon_Dragons_Point[2]=PolarProjectionBJ(udg_Summon_Dragons_Point[0], 128.00, ( GetUnitFacing(GetTriggerUnit()) - 90.00 ))
    //                                                                                                                    
    // Dragon #1:
    call CreateNUnitsAtLoc(1, udg_Summon_Dragons_Type_1[udg_Summon_Dragons_Level], GetOwningPlayer(GetTriggerUnit()), udg_Summon_Dragons_Point[1], GetUnitFacing(GetTriggerUnit()))
    call UnitApplyTimedLifeBJ(udg_Summon_Dragons_Duration[udg_Summon_Dragons_Level], 'BTLF', GetLastCreatedUnit())
    call UnitAddTypeBJ(UNIT_TYPE_SUMMONED, GetLastCreatedUnit())
    //                                                                                                                    
    // Dragon #2:
    call CreateNUnitsAtLoc(1, udg_Summon_Dragons_Type_2[udg_Summon_Dragons_Level], GetOwningPlayer(GetTriggerUnit()), udg_Summon_Dragons_Point[2], GetUnitFacing(GetTriggerUnit()))
    call UnitApplyTimedLifeBJ(udg_Summon_Dragons_Duration[udg_Summon_Dragons_Level], 'BTLF', GetLastCreatedUnit())
    call UnitAddTypeBJ(UNIT_TYPE_SUMMONED, GetLastCreatedUnit())
    //                                                                                                                    
    call RemoveLocation(udg_Summon_Dragons_Point[0])
    call RemoveLocation(udg_Summon_Dragons_Point[1])
    call RemoveLocation(udg_Summon_Dragons_Point[2])
endfunction

function InitTrig_Summon_Dragons takes nothing returns nothing
    set gg_trg_Summon_Dragons=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Summon_Dragons, EVENT_PLAYER_UNIT_SPELL_EFFECT)
