+    loop
+        exitwhen i >= StringLength(line)
+        if SubString(line,i,i+1) == " " then
+            set converted=converted+"|"
+        else
+            set converted=converted+SubString(line,i,i+1)
+        endif
+        set i=i+1
+    endloop
+    return FFPS_Field(converted,which)
+endfunction
